<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetCabinetControl" Id="{82301626-c59a-4d6c-ac78-2e8e2d6a8e41}" SpecialFunc="None">
    <Declaration><![CDATA[// X1 (BROTLib 0.26.0, specs/design/ui-tiers-and-hmi-gateway.md section 13): the read-only I_Cabinet view for the HMI gateway and the
// MQTT comm layer. ControlMode is the existing Local/Remote key inKeyLocal (the one MAIN uses for manual mode), the other four
// signals are inputs that the site MAIN wires (SafetyHandling.estop/.error/.RestartPending, PendantControl.bEnable).
FUNCTION_BLOCK FB_MonetCabinetControl IMPLEMENTS BROTLib.I_Cabinet
VAR_INPUT
	bEstop				: BOOL;	// MAIN: SafetyHandling.estop (E-stop pressed or not yet released)
	bSafetyError		: BOOL;	// MAIN: SafetyHandling.error (TwinSAFE group in error)
	bSafetyAckPending	: BOOL;	// MAIN: SafetyHandling.RestartPending (E-stop released, restart/acknowledge not run yet)
	bPendantActive		: BOOL;	// MAIN: PendantControl.bEnable (the pendant enable key, conservative: key on = pendant holds authority)
	iTelescope			: I_Telescope;	// optional: held parked while the cabinet temperature is critical (#32)
END_VAR
VAR_OUTPUT
	bCabinetOverTemp	: BOOL;	// cabinet temperature (BT1) is critical (>60°C, until <50°C); parks iTelescope if set
	// #24 D9 (specs/design/monetcommon-safe-states.md "Roof"): the roof should be closed because the cabinet temperature is
	// critical. A signal only, nothing in this library acts on it; the site MAIN closes the roof on it together with
	// FB_MonetTelescopeControl.bCloseRoofRequest (behind the same enable switch bRoofCloseOnErrorEnable, only in automatic).
	// Equal to bCabinetOverTemp: the same hysteresis (set above 60°C, held until below 50°C), no latch beyond that and no reset
	// needed. Updated in every call; a broken sensor (overrange) also requests the close.
	bCloseRoofRequest	: BOOL;
END_VAR
VAR
	// AT%I*/AT%Q* below are mapped directly on this FB: only one instance per PLC is
	// supported, a second instance would collide on the same physical hardware.
	inKeyLocal			AT%I*: BOOL;	//DIN3 0.2
	inButtonStart		AT%I*: BOOL;	//DIN4 0.3
	inButtonStop		AT%I*: BOOL;	//DIN5 0.4
	inButtonReset		AT%I*: BOOL;	//DIN8 0.7
	inCabinetTemp		AT%I*: INT;		//BT1	
	inKeyClearBrakes	AT%I*: BOOL;	//DIN15 1.6
	outLampPower		AT%Q*: BOOL;	//DOUT1 0.0
	outLampManual		AT%Q*: BOOL;	//DOUT2 0.1
	outLampError		AT%Q*: BOOL;	//DOUT3 0.2	
	cabinetTemp				: REAL;
	tempWarning				: SR;
	tempCritical			: SR;
	tempEvent				: FB_EventLog;
	tempCriticalEvent		: FB_EventLog;
	blinkErrorLamp			: FB_BLINK;
	blinkPowerLamp			: FB_BLINK;
	commTimer 				: TON := (PT:=T#5S);
	fbComm					: I_Comm;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// check temperature
cabinetTemp := INT_TO_REAL(inCabinetTemp) / 10.0;
tempWarning(SET1 := cabinetTemp > 50.0, RESET := cabinetTemp < 40.0);
tempCritical(SET1 := cabinetTemp > 60.0, RESET := cabinetTemp < 50.0);
bCabinetOverTemp := tempCritical.Q1;
// #24 D9 (owner decision): a critical cabinet temperature parks everything, the roof included. This block has no roof, so
// it only requests the close; the site MAIN acts on it like on TelescopeControl.bCloseRoofRequest.
bCloseRoofRequest := bCabinetOverTemp;

// #32: park while the electronics are too hot. Park ends with the drives disabled, the brake closed and the
// hydraulics off, which removes the heat sources; a stop would leave them running. Held every scan like
// FB_MonetMqttWatchdog: a no-op once parked, and any new move ends parked again until the temperature is below
// 50°C. A broken sensor reads overrange (3276.7°C) and also parks. The roof close is requested by bCloseRoofRequest.
IF bCabinetOverTemp AND iTelescope <> 0 THEN
	iTelescope.Park();
END_IF

// blinking lights
blinkErrorLamp(Q => outLampError);
blinkPowerLamp(Q => outLampPower);

// telemetry
commTimer(IN:=TRUE);
IF commTimer.Q THEN
	commTimer(IN:=FALSE);
	fbComm.PublishLREAL('electronics', 'base', 'MainCabinetTemperature', cabinetTemp);
END_IF

// events
tempEvent(	
	Trigger 		:= tempWarning.Q1, 
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'Main cabinet temperature warning:	%s',
	OnMessage 		:= LREAL_TO_FMTSTR(cabinetTemp, 1, TRUE),
	comm			:= fbComm);
tempCriticalEvent(	
	Trigger 		:= tempCritical.Q1, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'Main cabinet temperature is critical, parking the telescope:	%s!',
	OnMessage 		:= LREAL_TO_FMTSTR(cabinetTemp, 1, TRUE),
	comm			:= fbComm);


]]></ST>
    </Implementation>
    <Method Name="AreBreakesCleared" Id="{febea358-d684-4605-9606-4cfb2e03d90b}">
      <Declaration><![CDATA[// deprecated: kept for existing callers (MONETN, MONETS MAIN), use AreBrakesCleared instead
METHOD PUBLIC AreBreakesCleared : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AreBreakesCleared := THIS^.AreBrakesCleared();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AreBrakesCleared" Id="{f1e9f4c4-2b3a-4a1e-9a4f-8f7e8f1c9d2a}">
      <Declaration><![CDATA[METHOD PUBLIC AreBrakesCleared : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AreBrakesCleared := inKeyClearBrakes;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{7d550def-2f64-47d1-ac2f-11dc091e5629}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains	: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode		: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;	   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbComm := comm;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsResetPushed" Id="{c5f0543d-d2ee-4085-9cc6-f6a37ba59d95}">
      <Declaration><![CDATA[METHOD PUBLIC IsResetPushed : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
