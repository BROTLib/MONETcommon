    </Method>
    <Property Name="KeyLocal" Id="{ad8e8c92-5a56-4bc4-94dd-dcc3a456a9f1}">
      <Declaration><![CDATA[PROPERTY KeyLocal : BOOL]]></Declaration>
      <Get Name="Get" Id="{8be1cdac-bba1-4a4a-bac4-cea38f645137}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[KeyLocal := inKeyLocal;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ControlMode" Id="{8bb9f718-d8fc-42b1-bccb-285d6901d794}">
      <Declaration><![CDATA[// The Local/Remote key (inKeyLocal TRUE = Local, the polarity MAIN already uses for the manual mode).
PROPERTY ControlMode : BROTLib.E_ControlMode]]></Declaration>
      <Get Name="Get" Id="{6c5e69a5-e3d2-4bd4-9f65-8e5c2eadf67b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF inKeyLocal THEN
            ControlMode := BROTLib.E_ControlMode.local;
          ELSE
            ControlMode := BROTLib.E_ControlMode.remote;
          END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SwitchPresent" Id="{fd675ba8-9982-4348-b6a6-2cb36900bc2d}">
