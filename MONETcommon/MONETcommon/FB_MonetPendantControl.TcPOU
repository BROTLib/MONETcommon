<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetPendantControl" Id="{e2b10f6c-d16d-4403-9ebe-8d8a369c8dbd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MonetPendantControl
VAR_INPUT
	eTelescopeMode		: E_TelescopeMode;
	// #24 step 6: the concrete block stays, the pendant also calls Stop() and reads bError, which I_MirrorCovers does not carry
	fbCovers			: REFERENCE TO HalfBROT.FB_CoverControl;
	// #24 step 6: an interface, the pendant only uses I_Focus members (Enable, Ready, In*Limit, Move*, Reset, Error).
	// fbBrake/fbHydraulics are gone (never read); MAIN drops its two lines.
	fbFocus		 		: BROTLib.I_Focus;
	fbElevation			: REFERENCE TO FB_ElevationControl;
	fbAzimuth	 		: REFERENCE TO FB_AzimuthControl;
	fbDerotator			: REFERENCE TO FB_DerotatorControl;
	tEnableRelease		: TIME := T#2S;		// #3: an Enable the pendant set is dropped this long after the pendant lets go of the function
	tSelectionDebounce	: TIME := T#100MS;	// #3: the selector must read the same this long before the pendant drives that function
	// #177: in automatic mode selector 5-8 nudge the pointing offsets of the telescope (never Enable/Move* of an axis).
	iTelescope			: BROTLib.I_AltAzTelescope;	// offsets (read+write) and ReadyState; 0 = no nudges
	stMotion			: BROTLib.ST_MotionConfig;	// goto elevation window for the elevation nudge
	tCycle				: TIME := T#0S;				// 0 = PLC task cycle time; tests set it
	// nudge values (degrees, mm); suggestions to confirm on site (plan 2026-11-06-pendant-offsets-automatic-177, 3.4)
	fElAzStep			: LREAL := 5.0/3600.0;		// tap
	fElAzRateSlow		: LREAL := 10.0/3600.0;		// per second, held fSlowAfter..fFastAfter
	fElAzRateFast		: LREAL := 60.0/3600.0;		// per second, held longer than fFastAfter
	fElAzMax			: LREAL := 600.0/3600.0;	// |offset| limit
	fDerotStep			: LREAL := 0.02;
	fDerotRateSlow		: LREAL := 0.1;
	fDerotRateFast		: LREAL := 1.0;
	fDerotMax			: LREAL := 90.0;
	fFocusStep			: LREAL := 0.02;			// mm per step
	fFocusRange			: LREAL := 1.0;				// mm, |target - base| limit
	fSlowAfter			: LREAL := 0.5;				// s held until the slow rate
	fFastAfter			: LREAL := 3.0;				// s held until the fast rate
	fFocusRepeatAfter	: LREAL := 1.0;				// s held until the focus steps repeat
	fFocusRepeatEvery	: LREAL := 0.5;				// s between repeated focus steps
END_VAR
VAR_OUTPUT
	bEnable				: BOOL;
END_VAR
VAR
	fbComm				: I_Comm;
	nSelection			: UINT;		// program selection of the pendant control
	bError				: BOOL;		// pendant disconnected or selector at 0; only lights the error lamp (#12)
	bHorn				: BOOL;		// no AT %Q*, not wired: nothing sounds (HalfBROT #12)
	fbStartTrigger		: R_TRIG;
	fbUpTrigger			: R_TRIG;
	fbDownTrigger		: R_TRIG;	
	fbResetTrigger		: R_TRIG;
	// covers, key on: hold-to-run of the whole sequence (HalfBROT cover plan 2026-10-12)
	bCoverJogUp			: BOOL;
	bCoverJogDown		: BOOL;
	bCoverJogActive		: BOOL;		// the pendant started the running open/close and stops it on release
	fbCoverUpTrigger	: R_TRIG;
	fbCoverDownTrigger	: R_TRIG;
	// #3: release the jog when the pendant lets go of a function (key off, selector change, selector 0). The pendant only
	// writes the function it owns; with the key off the axes belong to the telescope (automatic) or to the Visu (manual).
	nSelectionLast		: UINT;		// selector of the last scan (debounce)
	tonSelectionStable	: TON;		// the selector read the same for tSelectionDebounce
	nSelectionStable	: UINT;		// nSelection once stable, else 0
	nDriven				: UINT;		// function 5-8 the pendant drives in this scan, 0 = none
	nOwned				: UINT;		// function 5-8 whose Move*/Enable the pendant wrote in the last scan, 0 = none
	bOwnedEnable		: BOOL;		// the last Enable the pendant wrote for nOwned
	nEnablePending		: UINT;		// function whose Enable is dropped when tonEnableRelease expires, 0 = none
	tonEnableRelease	: TON;
	// #177 nudges in automatic mode
	bManual				: BOOL;
	bAuto				: BOOL;
	bNudgeOk			: BOOL;		// automatic, key, stable selector, enable button, telescope online
	bNudgeArmed			: BOOL;		// a press counts only after a scan with bNudgeOk and no direction pressed
	nNudgeSel			: UINT;		// function the nudge state belongs to
	nNudge				: UINT;		// function nudged in this scan, 0 = none (online view)
	fHeld				: LREAL;	// s the direction has been held
	fFocusAccum			: LREAL;
	fFocusBase			: LREAL;	// focus target before the pendant started stepping
	fFocusLast			: LREAL;	// the last target the pendant wrote
	bFocusBaseSet		: BOOL;

	//DIN17 2.0
	// AT%I*/AT%Q* below are mapped directly on this FB: only one instance per PLC is
	// supported, a second instance would collide on the same physical hardware.
	IbBCD0				AT%I*: BOOL;
	IbBCD2				AT%I*: BOOL;
	IbBCD4				AT%I*: BOOL;
	IbBCD8				AT%I*: BOOL;
	IbResetButton		AT%I*: BOOL;
	IbDirectionUp		AT%I*: BOOL;
	IbDirectionDown		AT%I*: BOOL;
	IbEnableKey			AT%I*: BOOL;
	IbEnableButton		AT%I*: BOOL;
	IbDirectionLeft		AT%I*: BOOL;
	IbDirectionRight	AT%I*: BOOL;

	ObLampUp			AT%Q*: BOOL;
	ObLampDown			AT%Q*: BOOL;
	ObLampRight			AT%Q*: BOOL;
	ObLampLeft			AT%Q*: BOOL;
	ObLampError			AT%Q*: BOOL;	
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 
This program is responsible for the manual control of the telescope.
all movable parts can be controlled from here. This is mainly for testing and
maintenance.
WARNING! Some of the safety routines are disabled, when operating the telescope manually.
*)
// calculate the value of the selector
nSelection := 1*BOOL_TO_UINT(IbBCD0) + 
			 2*BOOL_TO_UINT(IbBCD2) + 
			 4*BOOL_TO_UINT(IbBCD4) +
			 8*BOOL_TO_UINT(IbBCD8);

// selector reads 0: pendant disconnected (or selector at 0). Only lights the error lamp, no stop (HalfBROT #12)
bError := (nSelection = 0);

// disable all the lamps
ObLampLeft := FALSE;
ObLampRight := FALSE;
ObLampUp := FALSE;
ObLampDown := FALSE;
bHorn := FALSE;

fbUpTrigger(CLK := IbDirectionUp);
fbDownTrigger(CLK := IbDirectionDown);
// error lamp: bError by default (also with the key off); the selected function overwrites it below with its own
// error. Was a no-op, so the lamp kept its last value when the selector moved (HalfBROT #12)
ObLampError := bError;

// covers, key on, selection 1-3: hold-to-run of the whole sequence (open 1->3->2, close 2->3->1); the cover block does
// the order, interlock, timeout and dead time. A run the pendant started stops when the button is released, the key
// goes off or the selector leaves 1-3 (#10, #3 for the covers). After an error a new press is needed (edge, not level).
bCoverJogUp := IbEnableKey AND nSelection >= 1 AND nSelection <= 3 AND IbDirectionUp AND NOT IbDirectionDown;
bCoverJogDown := IbEnableKey AND nSelection >= 1 AND nSelection <= 3 AND IbDirectionDown AND NOT IbDirectionUp;
fbCoverUpTrigger(CLK := bCoverJogUp);
fbCoverDownTrigger(CLK := bCoverJogDown);
IF __ISVALIDREF(fbCovers) THEN
	IF fbCoverDownTrigger.Q THEN
		fbCovers.Close();
		bCoverJogActive := TRUE;
	ELSIF fbCoverUpTrigger.Q THEN
		fbCovers.Open();
		bCoverJogActive := TRUE;
	ELSIF bCoverJogActive AND NOT bCoverJogUp AND NOT bCoverJogDown THEN
		fbCovers.Stop();
		bCoverJogActive := FALSE;
	END_IF
END_IF

// #3: what the pendant drives in this scan: the selected function, with the key on and the selector stable. When the pendant
// lets go of a function it has written (key off, selector change, selector 0, cable pulled), Move* of that function is set
// FALSE once, and Enable too after tEnableRelease if the pendant had set it. Nothing is written for a function the pendant
// does not own: with the key off the axes belong to the telescope (automatic) or the Visu (manual).
tonSelectionStable(IN := (nSelection = nSelectionLast), PT := tSelectionDebounce);
nSelectionLast := nSelection;
nSelectionStable := SEL(tonSelectionStable.Q, 0, nSelection);
bManual := (eTelescopeMode = E_TelescopeMode.manual);
bAuto := (eTelescopeMode = E_TelescopeMode.automatic);
// #177: the pendant drives Enable/Move* only in manual; leaving manual is one more release trigger
nDriven := SEL(bManual AND IbEnableKey AND tonSelectionStable.Q, 0, nSelection);
IF nOwned <> 0 AND nOwned <> nDriven THEN
	_ReleaseMove(nFunction := nOwned);
	IF bOwnedEnable THEN
		IF nEnablePending <> 0 AND nEnablePending <> nOwned THEN
			_DropEnable(nFunction := nEnablePending);	// one drop at a time: the earlier one is not left enabled
		END_IF
		nEnablePending := nOwned;
	END_IF
	nOwned := 0;
	bOwnedEnable := FALSE;
END_IF
IF nEnablePending <> 0 AND nEnablePending = nDriven THEN
	nEnablePending := 0;	// the same function is selected again: the enable button decides again
END_IF
IF bAuto THEN
	nEnablePending := 0;	// #177: in automatic the telescope owns Enable; a pending drop is discarded, not deferred
END_IF
tonEnableRelease(IN := (nEnablePending <> 0), PT := tEnableRelease);
IF tonEnableRelease.Q THEN
	_DropEnable(nFunction := nEnablePending);
	nEnablePending := 0;
END_IF

// #177: automatic mode, selector 5-8: nudge the offsets (before the key check: the arming needs the scans with the key off)
_Nudge();

// enabled?
bEnable := IbEnableKey;
IF NOT bEnable THEN
	RETURN;
END_IF

// reset or start pushed?
fbResetTrigger(CLK := IbResetButton);
fbStartTrigger(CLK := IbEnableButton);

// enable only the selected item and connect lamps and buttons accordingly. #177: selector 5-8 jog Enable/Move* in manual
// mode only (automatic: _Nudge above, off: nothing).
CASE SEL(nSelectionStable >= 5 AND nSelectionStable <= 8 AND NOT bManual, nSelectionStable, 0) OF
	1, 2, 3:	// covers: lamps only; the hold-to-run is above the RETURN
		IF __ISVALIDREF(fbCovers) THEN
			ObLampUp := fbCovers.Opened;
			ObLampDown := fbCovers.Closed;
			ObLampError := fbCovers.bError;
		END_IF

	4:	// Nasmyth / mirror M3 control
		
	5:	// Focus Control
		IF fbFocus <> 0 THEN
			nOwned := 5;
			bOwnedEnable := IbEnableButton;
			fbFocus.Enable := IbEnableButton;			
			ObLampUp := fbFocus.Enable AND fbFocus.Ready AND NOT fbFocus.InPosLimit;
			ObLampDown := fbFocus.Enable AND fbFocus.Ready AND NOT fbFocus.InNegLimit;
			fbFocus.MovePos := IbDirectionUp;
			fbFocus.MoveNeg := IbDirectionDown;
			IF fbResetTrigger.Q THEN
				fbFocus.Reset();
			END_IF
			ObLampError := fbFocus.Error;
		END_IF
							
	6:	// Derotator control: no hardware limit switches, the soft limits in the NC axis (XAE) and fMin/MaxPosition stop it
		IF __ISVALIDREF(fbDerotator) THEN
			nOwned := 6;
			bOwnedEnable := IbEnableButton;
			fbDerotator.Enable := IbEnableButton;
			ObLampLeft  := fbDerotator.Ready;
			ObLampRight := fbDerotator.Ready;
			fbDerotator.MoveNeg := IbDirectionLeft;
			fbDerotator.MovePos := IbDirectionRight;
			ObLampError := fbDerotator.Error;
			IF fbResetTrigger.Q THEN
				fbDerotator.Reset();
			END_IF
		END_IF
		
							
	7:	// Elevation Control
		IF __ISVALIDREF(fbElevation) THEN
			nOwned := 7;
			bOwnedEnable := IbEnableButton;
			fbElevation.Enable := IbEnableButton;
			fbElevation.MovePos := IbDirectionUp AND fbElevation.inDigitalInputs.0;
			fbElevation.MoveNeg := IbDirectionDown AND fbElevation.inDigitalInputs.1;
			ObLampUp := fbElevation.inDigitalInputs.0;
			ObLampDown := fbElevation.inDigitalInputs.1;
			ObLampError := fbElevation.bError;
			IF fbResetTrigger.Q THEN
				fbElevation.Reset();
			END_IF
		END_IF
		
	8:	// Azimuth Control
		IF __ISVALIDREF(fbAzimuth) THEN
			nOwned := 8;
			bOwnedEnable := IbEnableButton;
			fbAzimuth.Enable := IbEnableButton;
			ObLampLeft := fbAzimuth.inDigitalInputs.0; // NOT GVL_Telescope.azimut_limit_switch;
			ObLampRight := fbAzimuth.inDigitalInputs.1; // NOT GVL_Telescope.azimut_limit_switch;
			fbAzimuth.MoveNeg := IbDirectionLeft AND fbAzimuth.inDigitalInputs.0;
			fbAzimuth.MovePos := IbDirectionRight AND fbAzimuth.inDigitalInputs.1;
			ObLampError := fbAzimuth.Error;
			IF fbResetTrigger.Q THEN
				fbAzimuth.Reset();
			END_IF
		END_IF

END_CASE
]]></ST>
    </Implementation>
    <Method Name="_Nudge" Id="{3c1f5a7e-8d24-4b6a-9e51-6a0d2b7c4f19}">
      <Declaration><![CDATA[// #177: automatic mode, selector 5-8, enable button held: nudge the sky-frame pointing offset of the telescope (7 elevation,
// 8 azimuth, 6 derotator) or step the focus target (5). Never writes Enable/Move* of an axis.
METHOD PRIVATE _Nudge
VAR
	fDt			: LREAL;
	nDir		: INT;
	fDelta		: LREAL;
	fOld		: LREAL;
	fMax		: LREAL;
	fPos		: LREAL;
	bFocusStep	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nNudge := 0;
bNudgeOk := bAuto AND IbEnableKey AND tonSelectionStable.Q AND IbEnableButton AND nSelectionStable >= 5 AND nSelectionStable <= 8
	AND iTelescope <> 0;
IF bNudgeOk THEN
	bNudgeOk := (iTelescope.ReadyState = 1.0);	// online, as the MQTT focus (BROTLib#74)
END_IF

// direction: exactly one of the two buttons of the function
IF nSelectionStable = 5 OR nSelectionStable = 7 THEN
	nDir := BOOL_TO_INT(IbDirectionUp AND NOT IbDirectionDown) - BOOL_TO_INT(IbDirectionDown AND NOT IbDirectionUp);
ELSE
	nDir := BOOL_TO_INT(IbDirectionRight AND NOT IbDirectionLeft) - BOOL_TO_INT(IbDirectionLeft AND NOT IbDirectionRight);
END_IF

// arming: a direction held through a mode change, key on, enable press or selector change does nothing until released
IF NOT bNudgeOk OR nSelectionStable <> nNudgeSel THEN
	bNudgeArmed := FALSE;
ELSIF NOT IbDirectionUp AND NOT IbDirectionDown AND NOT IbDirectionLeft AND NOT IbDirectionRight THEN
	bNudgeArmed := TRUE;
END_IF
nNudgeSel := nSelectionStable;

// lamps: direction lamps while a nudge would be accepted, error lamp for a telescope error
IF bAuto AND IbEnableKey AND nSelectionStable >= 5 AND nSelectionStable <= 8 AND iTelescope <> 0 THEN
	ObLampError := bError OR iTelescope.ReadyState < 0.0;
	IF bNudgeOk THEN
		IF nSelectionStable = 5 OR nSelectionStable = 7 THEN
			ObLampUp := TRUE;
			ObLampDown := TRUE;
		ELSE
			ObLampLeft := TRUE;
			ObLampRight := TRUE;
		END_IF
	END_IF
END_IF

IF NOT (bNudgeOk AND bNudgeArmed AND nDir <> 0) THEN
	fHeld := 0.0;
	fFocusAccum := 0.0;
	RETURN;
END_IF

// dt in seconds: the task cycle time unless a test sets tCycle
IF tCycle > T#0S THEN
	fDt := TIME_TO_LREAL(tCycle) * 0.001;
ELSE
	fDt := UDINT_TO_LREAL(_TaskInfo[GETCURTASKINDEXEX()].CycleTime) * 1.0E-7;
END_IF
fDt := MAX(fDt, 1.0E-6);

// how far this scan: a tap is one step, then slow and fast rates (focus: one step every fFocusRepeatEvery after fFocusRepeatAfter)
fDelta := 0.0;
bFocusStep := FALSE;
CASE nSelectionStable OF
	7, 8:
		fMax := fElAzMax;
		IF fHeld = 0.0 THEN
			fDelta := nDir * fElAzStep;
		ELSIF fHeld >= fFastAfter THEN
			fDelta := nDir * fElAzRateFast * fDt;
		ELSIF fHeld >= fSlowAfter THEN
			fDelta := nDir * fElAzRateSlow * fDt;
		END_IF
	6:
		fMax := fDerotMax;
		IF fHeld = 0.0 THEN
			fDelta := nDir * fDerotStep;
		ELSIF fHeld >= fFastAfter THEN
			fDelta := nDir * fDerotRateFast * fDt;
		ELSIF fHeld >= fSlowAfter THEN
			fDelta := nDir * fDerotRateSlow * fDt;
		END_IF
	5:
		IF fHeld = 0.0 THEN
			bFocusStep := TRUE;
		ELSIF fHeld >= fFocusRepeatAfter THEN
			fFocusAccum := fFocusAccum + fDt;
			IF fFocusAccum >= fFocusRepeatEvery THEN
				fFocusAccum := fFocusAccum - fFocusRepeatEvery;
				bFocusStep := TRUE;
			END_IF
		END_IF
		IF bFocusStep THEN
			fDelta := nDir * fFocusStep;
		END_IF
END_CASE
fHeld := fHeld + fDt;
IF fDelta = 0.0 THEN
	RETURN;
END_IF

// apply: read-modify-write in this scan (an MQTT write of the last scan is the base); the new value is refused when it
// leaves the limit, except that an offset beyond the limit can always be reduced
CASE nSelectionStable OF
	7:
		IF __ISVALIDREF(fbElevation) THEN
			fOld := iTelescope.AltitudeOffset;
			fPos := fbElevation.Position + fDelta;
			IF (ABS(fOld + fDelta) <= fMax OR ABS(fOld + fDelta) < ABS(fOld))
				AND fPos >= stMotion.fGotoMinElevation AND fPos <= stMotion.fGotoMaxElevation THEN
				iTelescope.AltitudeOffset := fOld + fDelta;
				nNudge := 7;
			END_IF
		END_IF
	8:
		fOld := iTelescope.AzimuthOffset;	// sky frame: FB_MonetTelescopeControl applies F_AzimuthOffsetOnAxis
		IF ABS(fOld + fDelta) <= fMax OR ABS(fOld + fDelta) < ABS(fOld) THEN
			iTelescope.AzimuthOffset := fOld + fDelta;
			nNudge := 8;
		END_IF
	6:
		IF __ISVALIDREF(fbDerotator) THEN
			fOld := iTelescope.DerotatorOffset;
			fPos := fbDerotator.Position + fDelta;
			IF (ABS(fOld + fDelta) <= fMax OR ABS(fOld + fDelta) < ABS(fOld))
				AND fPos >= fbDerotator.fMinPosition AND fPos <= fbDerotator.fMaxPosition THEN
				iTelescope.DerotatorOffset := fOld + fDelta;
				nNudge := 6;
			END_IF
		END_IF
	5:
		IF fbFocus <> 0 THEN
			// the base is the target before the pendant started; a new target from elsewhere (MQTT focus) re-bases
			IF NOT bFocusBaseSet OR fbFocus.Position <> fFocusLast THEN
				fFocusBase := fbFocus.Position;
				bFocusBaseSet := TRUE;
			END_IF
			fPos := fbFocus.Position + fDelta;
			IF ABS(fPos - fFocusBase) <= fFocusRange AND fPos >= fbFocus.MinPosition AND fPos <= fbFocus.MaxPosition THEN
				fbFocus.Position := fPos;
				fFocusLast := fPos;
				nNudge := 5;
			END_IF
		END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReleaseMove" Id="{ba987d59-44d6-43e4-a7bf-f9aeebcb6b84}">
      <Declaration><![CDATA[// #3: the pendant lets go of function 5-8: its jog commands are set FALSE once (Enable: _DropEnable)
METHOD PRIVATE _ReleaseMove
VAR_INPUT
	nFunction	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nFunction OF
	5:
		IF fbFocus <> 0 THEN
			fbFocus.MovePos := FALSE;
			fbFocus.MoveNeg := FALSE;
		END_IF
	6:
		IF __ISVALIDREF(fbDerotator) THEN
			fbDerotator.MovePos := FALSE;
			fbDerotator.MoveNeg := FALSE;
		END_IF
	7:
		IF __ISVALIDREF(fbElevation) THEN
			fbElevation.MovePos := FALSE;
			fbElevation.MoveNeg := FALSE;
		END_IF
	8:
		IF __ISVALIDREF(fbAzimuth) THEN
			fbAzimuth.MovePos := FALSE;
			fbAzimuth.MoveNeg := FALSE;
		END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_DropEnable" Id="{fee5b0c3-ee8c-42f5-a888-e2ebe37a4fa2}">
      <Declaration><![CDATA[// #3: the Enable the pendant had set for function 5-8 is dropped (tEnableRelease after the pendant let go of it)
METHOD PRIVATE _DropEnable
VAR_INPUT
	nFunction	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nFunction OF
	5:
		IF fbFocus <> 0 THEN
			fbFocus.Enable := FALSE;
		END_IF
	6:
		IF __ISVALIDREF(fbDerotator) THEN
			fbDerotator.Enable := FALSE;
		END_IF
	7:
		IF __ISVALIDREF(fbElevation) THEN
			fbElevation.Enable := FALSE;
		END_IF
	8:
		IF __ISVALIDREF(fbAzimuth) THEN
			fbAzimuth.Enable := FALSE;
		END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{377c4b19-44fb-4929-801b-86205f66218e}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbComm 	:= comm;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_MonetPendantControl.FB_Init">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>