<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="Global_Version" Id="{4c7c84a7-bebe-4299-bc08-b7c1375cfec9}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	// Mirrors Beckhoff's own Global_Version.stLibVersion_* pattern (see ST_LibVersion),
	// which only covers Tc2_*/Tc3_* library references, not custom ones -- until now: this
	// GVL uses Beckhoff's own naming exactly, so it merges into a consumer's Global_Version.
	// Kept in sync with <ProjectVersion> in MONETcommon.plcproj at release time.
	stLibVersion_MONETcommon : ST_LibVersion := (
		iMajor := 0,
		iMinor := 4,
		iBuild := 0,
		iRevision := 0,
		nFlags := 1,
		sVersion := '0.4.0'
	);
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
