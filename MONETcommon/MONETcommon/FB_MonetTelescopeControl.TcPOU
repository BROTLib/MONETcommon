<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetTelescopeControl" Id="{392c90d3-a441-4c8d-a752-42b25b49f5cd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MonetTelescopeControl EXTENDS FB_AltAzTelescopeControl IMPLEMENTS I_AltAzTelescope
VAR_INPUT
	fbFocus				: I_Focus;
	// the concrete block, not I_MirrorCovers: an E-stop / safety error stops the covers (Stop(), which I_MirrorCovers does not carry,
	// as for the pendant). MAIN passes its HalfBROT.FB_CoverControl instance as before (fbCovers := CoverControl).
	fbCovers			: REFERENCE TO HalfBROT.FB_CoverControl;
	fbBrake				: I_Brake;
	fbHydraulics   		: I_Hydraulics;
	fbElevation			: REFERENCE TO FB_ElevationControl;
	fbAzimuth			: REFERENCE TO FB_AzimuthControl;
	fbDerotator			: REFERENCE TO FB_DerotatorControl;

	fbPointing			: REFERENCE TO FB_PointingModelForward;
	fbPointingInverse	: REFERENCE TO FB_PointingModelInversion;

	bBrakeClearing		: BOOL	:= TRUE;

	// BROTLib#33: use the live weather (MQTT, pybrotlib.weather) in the refraction of eq2hor/hor2eq. FALSE (default) keeps
	// the estimate from the site altitude. A value is used only if it is valid (not stale) and plausible for the site
	// (BROTLib.F_RefractionWeather); anything else falls back to the estimate, pressure and temperature independently.
	// Switch on per site after the on-sky check (MONETcommon#30).
	bLiveWeatherRefraction	: BOOL := FALSE;

	// #236: the derotator offset is applied to the running track at this rate at most (deg/s). A step in the setpoint of the
	// external setpoint generator takes the AX5206 down (F324 excessive position command value deviation, seen with a 2 deg step
	// on MONET/S, MS-165). The pendant nudges (5 arcsec tap, up to 60 arcsec/s) stay far below. 0 = no limit (old behaviour).
	fDerotatorOffsetRate	: LREAL := 0.5;
	// MONETN 2026-11-11 (specs/plans/2026-11-11-altaz-offset-ramp.md): during a track the elevation/azimuth pointing offsets reach
	// the axis setpoint through FB_OffsetRamp (velocity <= fOffsetVelocity, change of velocity <= fOffsetAcceleration per s), not as
	// a one-scan step: with the AX5125 in mode 11 (lag-less) a 0.01 deg step rang with 50-70 % overshoot. 0.01 deg takes about
	// 0.43 s, a 5 arcsec pendant tap 0.15 s, 10 arcmin 1.8 s. The same ramp blends the jump at the start of a track (the setpoint
	// starts at the axis position, up to fTrackStartBlendMax). fOffsetAcceleration = 0 restores the old steps (both).
	fOffsetAcceleration		: LREAL := 0.2;	// deg/s^2 (the azimuth value is the sky offset, before F_AzimuthOffsetOnAxis)
	fOffsetVelocity			: LREAL := 0.5;	// deg/s
	fTrackStartBlendMax		: LREAL := 0.5;	// deg; a larger gap at the start of a track is not blended (a turn or a fault, old behaviour)
	// #251: a new fRightAscension/fDeclination written while tracking (Visu binding, ADS client) is blended into the el/az/derotator
	// setpoints like the track start (gap <= fTrackStartBlendMax) instead of a one-scan step. A larger gap, or a derotator gap above
	// fRetargetDerotatorMax, leaves the scan without writing setpoints and takes the stop/goto/track path. fOffsetAcceleration = 0
	// disables the blend. #252: the derotator has the same track-start blend (ramp: acceleration fOffsetAcceleration, velocity
	// at most fDerotatorOffsetRate), the offset hold of #246 (bDerotatorOffsetLocked) is unchanged.
	fRetargetDerotatorMax	: LREAL := 0.5;	// deg; the derotator blends like elevation and azimuth since #252 (it was 0.005 before: a step it allows)
	// #251: the move onto the track keeps the target of its start. If the target moved by more than fTrackStartBlendMax while it
	// ran (a direct RA/Dec write, the Visu), the move is started again (a new Execute edge latches the new target) instead of
	// stepping the setpoint at MoveDone; at most nMoveRestartMax times per axis and track start, then the old step (and a log entry).
	// #264: the derotator restarts too, and after nMoveRestartMax it ramps the gap out instead of the step (a step faults its drive).
	nMoveRestartMax			: UINT := 3;
	tCycle					: TIME := T#10MS;	// PLC task cycle time (10 ms on MONETS and MONETN); _TaskInfo is not visible in a library
	// BROTLib#167 (needs BROTLib 0.21.1: FB_BaseAxis.SetFeedFromPosition): TRUE feeds the NC setpoint generator of elevation and azimuth with the velocity and acceleration
	// of the fed position (FB_Axis.FeedFromPosition, CycleTime = tCycle) instead of the fixed values that follow the lag. FALSE (default)
	// keeps the old feed. Not for the derotator (its drive and the F324 history are different; not part of #167).
	bFeedFromPosition		: BOOL := FALSE;

	// #155: SafetyHandling.error, wired in MAIN. FALSE (default) means the safety block of the brake is not enforced.
	bSafetyError		: BOOL;

	// Test seam (plan decision 4): every long timeout of this telescope (600 s, 2 min, 12 h) is divided by it. Production
	// leaves it at 1. Per instance, because TcUnit runs all suites in the same PLC cycles.

	// #24 step 2c: the motion limits of this telescope (move velocities, timeouts, goto/track elevation windows, horizon
	// margin, azimuth/derotator track margin and time cap). The defaults are the literals of 0.11.x, so a MAIN that does
	// not set it behaves as before. Checked every scan with BROTLib.F_MotionConfigValid: an invalid configuration is
	// software error 16#32 (like 16#31), the defaults stay in use until it is fixed.
	stMotion			: BROTLib.ST_MotionConfig;

	// DEPRECATED (#24 D2, removed in the next minor): use stMotion. An alias set to a value other than its old default
	// (below) wins over the stMotion field; that is logged once (WARN). Left at the default, stMotion applies.
	// fElevationMoveVelocity = stMotion.fElevationMoveVelocity: every commanded elevation move (Goto/Home/Park/PowerOn/
	// Slew and the move onto a track target, not the computed tracking rate), M6.
	fElevationMoveVelocity : LREAL := 5.0;
	// #2 (F_AxisTurn) = stMotion.fAzimuthTrackMargin, fDerotatorTrackMargin, fAzimuthTrackTimeCap, fDerotatorTrackTimeCap
	fAzimuthTrackMargin		: LREAL := 1.0;
	fDerotatorTrackMargin	: LREAL := 1.0;
	fAzimuthTrackTimeCap	: LREAL := 14400.0;
	fDerotatorTrackTimeCap	: LREAL := 14400.0;
END_VAR
VAR_OUTPUT
	fDerotatorSign		: LREAL := 1.0;	// derotator
	
	fElevationPointingOffset : LREAL;
	fAzimuthPointingOffset : LREAL;
	fElevationPointingOffset2 : LREAL;
	fAzimuthPointingOffset2 : LREAL;
	
	fRightAscensionCurrentSky: LREAL;
	fDeclinationCurrentSky: LREAL;

	fDerotatorVelocity	: LREAL;	// rotational velocity of the derotator
	fElevationVelocity	: LREAL;	// rotational velocity of the elevation
	fAzimuthVelocity	: LREAL;	// rotational velocity of the elevation

	// weather handed to the refraction of eq2hor and both hor2eq calls (BROTLib#33); published as WEATHER.REFRACTION.*
	fRefractionPressure		: LREAL;	// hPa, 0.0 = estimate from altitude
	fRefractionTemperature	: LREAL;	// deg C, only meaningful if bRefractionTemperatureSet
	bRefractionTemperatureSet	: BOOL;	// FALSE = estimate from altitude

	// #24 step 7 PR 1 (plan D9, specs/design/monetcommon-safe-states.md "Roof"): the roof should be closed. A signal only, nothing
	// in this library acts on it; the site MAIN closes the roof on it (behind its enable switch, only in automatic). Set by the
	// serious error classes only: an Az/El/Der axis error, a hydraulics error, E-stop, safety error, power failure (NOT bMainReady).
	// Not by the focus error or the software errors (bError) and not by bPowerFailure (a power-on failure). Latched on the rising
	// edge of a cause, cleared by bReset once no cause is active. Updated in every automatic scan; in manual (SuspendAutomatic)
	// it keeps the value of the last automatic scan.
	bCloseRoofRequest	: BOOL;

	// #24 step 5 (aim 3): the command requests of this block. Until 0.14.x the inherited inputs bPower, bGoHome, bPark, bTrack,
	// bGoto, bSlew, bStop, bReset were written by this block (set by the methods, cleared when a command ended); now the inputs
	// are read-only and edge-triggered and these latches carry the request. Set by the methods (Init, Home, Park, Track/TrackRaDec/
	// MoveRaDec, Slew/MoveAltAz, Stop, Reset) and by the rising edge of the matching input, cleared by this block when the
	// command ends, is dropped or aborted, exactly where the input used to be cleared. TRUE = requested or running (bGotoActive
	// also while a goto waits for the abort stop of the move it replaces); a status for the Visu and diagnostics, read-only.
	// Comments in this block written before step 5 name the request by its input (bGoto meaning bGotoActive, and so on).
END_VAR
VAR
	bRefractionLive				: BOOL;	// at least one live value is used
	bRefractionPressureRejected	: BOOL;	// live pressure valid but implausible for the site (logged on the rising edge)
	bRefractionTemperatureRejected	: BOOL;
	rtrigPressureRejected	: R_TRIG;
	rtrigTemperatureRejected	: R_TRIG;
	bTargetBelowHorizonWarn	: BOOL;	// #94: goto/track requested with the RA/Dec target below fHorizon, taken before the dispatch can clear bGoto
	// M1: internal (non-axis) errors from the Goto/Home/Slew state machines, latched
	// until bReset since bError/nErrorID are otherwise recomputed from the axes every
	// scan and would silently wipe these within the same cycle they're set in.
	nSoftwareErrorID	: UINT;
	sSoftwareErrorText	: STRING(80);	// #24 step 3b: what the last _RaiseSoftwareError reported (ADS diagnostics only, not logged), '' after a reset
	SoftwareErrorEvent	: FB_EventLog;

	// #80: one-scan flag set by Init() when AcceptInit() refuses; logged once by the body.
	bInitRefused		: BOOL;
	sInitRefusedReason	: STRING(80);
	nInitRefusedLevel	: UDINT;
	InitRefusedEvent	: FB_EventLog;

	// #2: F_AxisTurn found a turn of the target inside the axis limits. No turn: a goto/track is not started (or a
	// running track stops) and AzimuthNoTurnEvent / DerotatorNoTurnEvent warn. Taken before the dispatch below can
	// clear bGoto/bTrack, like bTargetBelowHorizonWarn.
	bAzimuthTurnOK		: BOOL;
	bDerotatorTurnOK	: BOOL;
	bAzimuthNoTurn		: BOOL;
	bDerotatorNoTurn	: BOOL;
	AzimuthNoTurnEvent	: FB_EventLog;
	DerotatorNoTurnEvent: FB_EventLog;
	// #2: a slew target outside the axis limits was refused (one-scan flag, set by _SlewTelescope).
	bSlewOutOfLimits	: BOOL;
	SlewOutOfLimitsEvent: FB_EventLog;
	// #212: a slew target outside the elevation window (stMotionUsed.fGotoMinElevation..fGotoMaxElevation, as goto) was refused (one-scan flag, set by _SlewTelescope).
	bSlewOutsideWindow	: BOOL;
	SlewOutsideWindowEvent: FB_EventLog;

	// #34: home or park position at or below fHorizon + stMotionUsed.fHorizonMargin. The horizon guard
	// would send the telescope home, find it still below the horizon, and home it again forever.
	bHomeBelowHorizon	: BOOL;

	// #24 step 2c: the motion limits used in this scan (_MotionConfig): stMotion with the deprecated aliases applied, or
	// the defaults while the configuration is invalid (bMotionConfigInvalid, software error 16#32)
	stMotionUsed			: BROTLib.ST_MotionConfig;
	bMotionConfigInvalid	: BOOL;
	sMotionAliases			: STRING(120);	// the deprecated aliases in use, '' = none
	sMotionAliasesLogged	: STRING(120);	// the set that was logged last
	MotionAliasEvent		: FB_EventLog;

	// #17: 600 s timeouts of the goto/home/slew state machines. They used to be TONs in the methods' plain VAR,
	// which is re-created on every call, so they never fired. They are fed every scan in the body (the methods are
	// only called while their command is selected) and reset as soon as the command flag drops, whatever ended it.
	tonGotoTimeout		: FB_TimeoutTimer;
	tonHomeTimeout		: FB_TimeoutTimer;
	tonSlewTimeout		: FB_TimeoutTimer;

	// #236: the derotator offset as applied to the setpoint (fDerotatorOffset is the requested one). Follows the request at once
	// while no track is requested; during a track (bTrackActive or fbDerotator.Tracking) it is held until the derotator has locked on
	// the track (bDerotatorOffsetLocked, #246) and then ramps at fDerotatorOffsetRate.
	fDerotatorOffsetApplied	: LREAL;
	bDerotatorOffsetLocked	: BOOL;	// #246: the derotator has locked on the current track once (isTracking); the offset ramp waits for it

	// 2026-11-11 offset ramp (see fOffsetAcceleration): the elevation/azimuth offsets as applied to the target (fElevationOffset,
	// fAzimuthOffset are the requested ones). Follow the request at once while the axis does not track (goto, slew, at rest).
	fbElevationOffsetRamp	: FB_OffsetRamp;
	fbAzimuthOffsetRamp		: FB_OffsetRamp;
	fElevationOffsetApplied	: LREAL;
	fAzimuthOffsetApplied	: LREAL;	// sky frame, like fAzimuthOffset
	// the track-start blend: axis setpoint minus target, set to (axis position - target) in the scan Tracking goes TRUE, then ramped to 0
	fbElevationTrackBlend	: FB_OffsetRamp;
	fbAzimuthTrackBlend		: FB_OffsetRamp;
	fbDerotatorTrackBlend	: FB_OffsetRamp;	// #252
	// #251 retarget detector: values of the last _TrackTelescope call; nTrackScan = nScan - 1 means "tracked in the previous scan"
	// (stale values after a stop, park, suspend, reset or manual are never used, nothing to clear)
	nScan					: UDINT;
	nTrackScan				: UDINT;
	fRaTracked				: LREAL;
	fDecTracked				: LREAL;
	fElSetLast				: LREAL;
	fAzSetLast				: LREAL;
	fDeroSetLast			: LREAL;
	fDeroVelLast			: LREAL;
	fElVelLast				: LREAL;
	fAzVelLast				: LREAL;
	nLastRetarget			: USINT;	// 0 none, 1 blend, 2 move (stop/goto/track); for tests and the scope
	nRetargetCount			: UDINT;
	nElRestarts				: UINT;	// restarts of the move onto the track in this track start
	nAzRestarts				: UINT;
	nDeroRestarts			: UINT;	// #264
	nMoveRestartCount		: UDINT;	// all restarts, for tests and the scope
	bKeepRunning			: BOOL;	// #251 phase B: _AcceptMove does not supersede the running track (only inside Track()/TrackRaDec())

	// #24 step 3a: the stage of each stage machine (until 0.12.0 a bare USINT nStage in the VAR_INST of the method; here so
	// the read-only properties GotoStage, SlewStage, ParkStage and PowerOnStage can return it). The values are the old numbers.
	// _HomeTelescope has no stage.
	eGotoStage			: E_GotoStage := E_GotoStage.idle;
	eSlewStage			: E_SlewStage := E_SlewStage.idle;
	eParkStage			: E_ParkStage := E_ParkStage.prepare;
	ePowerOnStage		: E_PowerOnStage := E_PowerOnStage.open_covers;

	// #26: safety net for a latched bInterrupted (now a one-shot, see the arbitration): auto-clear after 5 s of
	// true idle, logged and counted. The counter should stay at 0.
	bInterruptedIdle			: BOOL;
	tonInterruptedAutoClear		: TON;
	InterruptedAutoClearEvent	: FB_EventLog;

	// #84: a running move was interrupted (gohome/goto/park/track over a slew or goto): stop the axes
	// before the new command may start. Cleared at standstill and on an error. A reset (#56) clears it only
	// if no enabled axis is moving (F_ResetMoveAbort), otherwise the abort stop goes on. Also set by the switch to
	// manual under motion (#118, SuspendAutomatic).
	MoveAbortEvent		: FB_EventLog;
	// plan step 3.1: the axis feedback of this scan (1 azimuth, 2 elevation, 3 derotator), filled by _ReadAxes
	aAxis				: ARRAY[1..3] OF ST_AxisStatus;
	// #24 step 4a: the telemetry record of the last publish (filled in _SendTelemetry) and the block that publishes it
	stTelemetry			: ST_MonetTelemetry;
	fbTelemetry			: FB_MonetTelescopeTelemetry;
	// #96: one MC_Stop per axis and stop transaction; the stop is over when every axis that was sent one has
	// reported StopDone and the telescope has been at rest for 3 scans. Replaces bStopIssuedAz/El/Dr (#84).
	fbStopTx			: BROTLib.FB_StopTransaction;
	// #25 step 5.2: which command runs (BROTLib.FB_CommandArbiter); bRequestIdle: no request is set in this scan
	bStopTxBegun		: BOOL;	// the transaction of the running stop command has been begun
	StopForcedEvent		: FB_EventLog;
	StopStuckEvent		: FB_EventLog;
	// #118: the switch to manual under motion stops the axes once. SuspendAutomatic drives that one stop (the pendant takes
	// over after it); a stop that arrives later during manual is not driven. The body clears the flag, it owns the stop again.
	bSuspendStop		: BOOL;
	bSuspendStopStarted	: BOOL;	// one scan, logged
	SuspendStopEvent	: FB_EventLog;
	// #158: bIsParked means "secured" (covers closed, brake closed, hydraulics off, axes disabled), not "at the park position".
	// bParkedInPlace is TRUE when the park ended where the telescope stood (error, or axes could not move, #86/#87). Not
	// persistent: FALSE after a PLC restart, where the pose is unknown.
	bParkedInPlace		: BOOL;
	ParkedInPlaceEvent	: FB_EventLog;
	bParkedInPlaceLogged: BOOL;	// one scan, logged

	// #83: command acceptance. Methods and the direct-write gate decide at arrival (F_CommandAcceptance);
	// a rejection is logged and counted, never queued.
	bCommandRejected		: BOOL;		// set by _NoteRejected, logged and cleared by the body
	eLastRejectedCommand	: E_TCSCommand;
	eLastRejectReason		: E_CommandRejectReason;
	nCommandRejectCount		: UDINT;	// diagnostics (ADS / scope), optional MQTT field later
	sRejectMessage			: STRING(120);
	RejectEvent				: FB_EventLog;
	tonRejectRepeat			: TON;		// identical rejection within 2 s is logged once (all are counted)
	eLoggedCommand			: E_TCSCommand;
	eLoggedReason			: E_CommandRejectReason;
	// an accepted move replaces the running one (latest wins): drop the other move flags, stop the axes
	// #24 step 5: edge memory of the command inputs (was the #83 direct-write gate). The input of the last scan (snapshot at the
	// end of the body), or TRUE once a method has sent that command since then: a method call and a rising input in the same scan
	// (from one call of the body to the next) are one command, and a held input starts its command once.
	// #83/#87: a Park() received during a stop; the stop branch would clear bPark, so it is set at standstill
	// #87: park aborted a running power-on (one scan, logged)
	PowerAbortEvent			: FB_EventLog;
	// #86: a new axis/focus error on a telescope that is not parked starts the emergency park (#24 step 7 PR 3: also a hydraulics error; PR 7: a power failure)
	bHwError				: BOOL;
	bHwErrorLast			: BOOL;	// edge memory, updated only where the request is made
	bErrorParkStarted		: BOOL;	// one scan, logged
	ErrorParkEvent			: FB_EventLog;
	// #24 step 7 PR 1 (D9): a cause of bCloseRoofRequest is active in this scan, and its value of the last automatic scan. The
	// initial FALSE of bCloseRoofCauseLast means a cause already present at the PLC start (E-stop, no phase) sets the request
	// (conservative, plan 8.7). To arm only after the start instead, initialise it with TRUE.
	bCloseRoofCause			: BOOL;
	bCloseRoofCauseLast		: BOOL := FALSE;
	// #113: no power-on has completed since the PLC start; its axis error is the expected Wake&Shake fault
	bFirstPowerOnPending	: BOOL := TRUE;
	bErrorParkExempt		: BOOL;	// one scan, logged
	ErrorParkExemptEvent	: FB_EventLog;
	// #24 step 7 PR 3 (plan D8, specs/design/monetcommon-safe-states.md row "Hydraulics error"): fbHydraulics.Error is a telescope
	// fault, part of bHwError (bError, READY_STATE -1.0, emergency park in place on the edge, #86). Ramp first: if the drives can
	// still ramp (bHydraulicsCanRamp: brake open, oil pressure there, no E-stop/safety error, no other error) and an enabled axis
	// moves, the error sets bStop (the stop transaction, #96) and the error branch leaves the axes enabled until that stop has
	// settled (bHydraulicsRamp); the park queued behind the stop (bParkAfterStop) then parks in place. With the pressure already
	// gone the brake lock is the stop: no ramp, the axes are disabled in the same scan, as for an axis error.
	bHydraulicsError		: BOOL;	// fbHydraulics.Error in this scan
	bHydraulicsErrorLast	: BOOL;	// its value of the last automatic scan (edge memory of the ramp, updated in every automatic scan)
	bHydraulicsCanRamp		: BOOL;	// the drives can still ramp in this scan
	bHydraulicsRamp			: BOOL;	// the controlled stop of a hydraulics error is running, the error branch does not disable the axes
	bHydraulicsRampStarted	: BOOL;	// one scan, logged
	HydraulicsRampEvent		: FB_EventLog;
	// #24 step 7 PR 5 (plan D8, specs/design/monetcommon-safe-states.md row "Software error: timeout"): a state-machine timeout
	// (16#10 goto, 16#30 home, 16#40 slew) leaves the drives controllable: ramp (bStop, stop transaction #96) if an axis moves, then
	// the park drives to the park position (in place if F_ParkAxesCanMove is FALSE); the error branch does not disable the axes
	// while it runs (bTimeoutPark). No roof close (D9, recoverable).
	bTimeoutError			: BOOL;	// bSoftwareError with one of the three timeout IDs in this scan
	bTimeoutErrorLast		: BOOL;	// its value of the last automatic scan (edge memory)
	bTimeoutCanMove			: BOOL;	// no hardware error, E-stop or safety error: the drives may ramp and drive to the park position
	bTimeoutPark			: BOOL;	// the ramp and park of a timeout is running, the error branch does not disable the axes
	bTimeoutParkStarted		: BOOL;	// one scan, logged
	TimeoutParkEvent		: FB_EventLog;
	// #24 step 7 PR 4 (specs/design/monetcommon-safe-states.md row "Cover error"): fbCovers.Error (HalfBROT FB_CoverControl, latched
	// there until its Reset(), the MAIN reset button; no cover moves while it is set) is no telescope error: not in bError (the drives
	// are controllable), no roof close (D9). Its rising edge on a telescope that is not parked and not in E-stop starts a normal park
	// (Park(), the routing of an external park: a running move is stopped first, then the park drives to the park position if the axes
	// can move, else it parks in place). A park whose covers are in error ends in stage secure without fbCovers.Closed (axes disabled,
	// brake closed, hydraulics off) with bIsParked and software error 16#21. A power-on with the cover error fails before its cover
	// command (bPowerFailure), so the telescope stays parked.
	bCoverErrorLast			: BOOL;	// fbCovers.Error of the last automatic scan (edge memory of the park request; TRUE on the first manual scan, as bHwErrorLast)
	bCoverErrorParkStarted	: BOOL;	// one scan, logged
	CoverErrorParkEvent		: FB_EventLog;
	bParkCoverFault			: BOOL;	// the park left stage secure without fbCovers.Closed (cover error); 16#21 is raised in stage parked
	// #24 step 7 PR 7 (plan D8, specs/design/monetcommon-safe-states.md row "Power failure"): NOT bMainReady (MAIN: PowerMonitoring.
	// phaseOK, warnings included, not debounced) is a telescope fault like the hydraulics error: part of bHwError (bError, READY_STATE
	// -1.0, emergency park in place on the edge, #86), not latched (bError drops when the supply is back). Ramp first while the drives
	// can still ramp (the same test, bHydraulicsCanRamp), else the lock is the stop. Until 0.13.0 it only gated online (-2.0).
	bMainPowerLost			: BOOL;	// NOT bMainReady in this scan
	bMainPowerLostLast		: BOOL;	// its value of the last automatic scan (edge memory of the ramp, updated in every automatic scan)
	bMainPowerRamp			: BOOL;	// the controlled stop of a power failure is running, the error branch does not disable the axes
	bMainPowerRampStarted	: BOOL;	// one scan, logged
	MainPowerRampEvent		: FB_EventLog;
	// #230: a goto target outside the elevation window (software error 16#15/16#16, raised by _GotoTelescope in every scan of the goto, so
	// also when the target drifts over the limit during the travel) while an enabled axis moves: the generic error branch would disable the
	// drives under motion (NC 0x4260 on all three axes) and the hardware-error park would follow. Ramp first, like a timeout but without the
	// park: bStop (stop transaction #96), the error branch leaves the axes enabled until the stop has settled, then it disables them as at
	// standstill. The error stays until the reset.
	bWindowError			: BOOL;	// bSoftwareError with 16#15 or 16#16 in this scan
	bWindowErrorLast		: BOOL;	// its value of the last automatic scan (edge memory)
	bWindowRamp				: BOOL;	// the controlled stop of a window error is running, the error branch does not disable the axes
	bWindowRampStarted		: BOOL;	// one scan, logged
	WindowRampEvent			: FB_EventLog;
	// #24 step 7 PR 8 (plan D8, specs/design/monetcommon-safe-states.md row "Focus error"): only the focus is faulty, the axes are
	// healthy. On the edge of the emergency park (#86), if the axes can drive (F_ParkAxesCanMove, oil pressure there), the park drives
	// to the park position instead of parking in place: an enabled axis that moves gets the controlled stop first (bStop, #96, the
	// park is queued behind it, bParkAfterStop), and the error branch leaves the axes enabled until the park has disabled them itself
	// (bFocusErrorPark). Any other error, an E-stop or a safety error ends it and the park parks in place.
	bFocusErrorOnly			: BOOL;	// the focus error is the only error in this scan (no axis/hydraulics/software error, no power failure, no E-stop/safety error)
	bFocusErrorPark			: BOOL;	// the emergency park of a focus error drives to the park position, the error branch does not disable the axes
	bFocusErrorParkStarted	: BOOL;	// one scan, logged
	FocusErrorParkEvent		: FB_EventLog;
	// #24 step 7 PR 6 (plan D8, specs/design/monetcommon-safe-states.md rows "E-stop" and "Safety error"): an E-stop or a safety
	// error (bSafetyStop) cuts the drives (STO), so the brake lock is the stop. On its rising edge the hydraulics go off at once
	// (the hydraulic brake locks), every move ends (flags dropped, stage machines reset, no MC_Stop: the axes are disabled) and,
	// if the telescope is not parked, a park in place is held (bSafetyParkPending) until both are gone; then it runs like the
	// emergency park (bSafetyPark: past the ready gate, in place because the axes are disabled) and closes the covers.
	// The covers are not on the E-stop circuit (they keep their supply, owner): "E-stop means stop", so on the edge and in every scan
	// while bSafetyStop the covers get Stop() and no stage commands Open()/Close() (the power-on and the park wait in their stage); they
	// close only after the release, by the held park.
	bSafetyStop				: BOOL;	// bEstopTriggered OR bSafetyError in this scan
	bSafetyStopLast			: BOOL;	// its value of the last automatic scan (edge memory)
	bSafetyParkPending		: BOOL;	// the park in place of a safety stop, held until the E-stop and the safety error are gone
	bSafetyPark				: BOOL;	// that park runs (from Park() until bPark falls)
	bSafetyParkStarted		: BOOL;	// one scan, logged
	SafetyParkEvent			: FB_EventLog;
	// #151: the brake may stay open with the elevation disabled for the Wake&Shake (F_WakeShakeWindow)
	bWakeShakeWindow		: BOOL;
	bWakeShakeWindowLast	: BOOL;
	bWakeShakePowerLast		: BOOL;
	tonWakeShakeWindow		: FB_TimeoutTimer;
	sWakeShakeEnd			: STRING(24);
	bWakeShakeOpened		: BOOL;	// one scan, logged
	bWakeShakeClosed		: BOOL;	// one scan, logged
	WakeShakeOpenEvent		: FB_EventLog;
	WakeShakeCloseEvent		: FB_EventLog;
	sWakeShakeCloseMessage	: STRING(80);
	// #155: the elevation error closes the brake once; the operator may open it again in the window
	rtrigElevationError		: R_TRIG;
	// #155: a block (E-stop, hydraulics error, safety error, covers not open) closed an open brake in the window
	bWakeShakeBrakeBlocked	: BOOL;	// logged on its rising edge
	sWakeShakeBlockMessage	: STRING(80);
	WakeShakeBlockEvent		: FB_EventLog;
	// #72: manual mode since the last completed startup. Set on the first manual scan, cleared only by a completed
	// startup (not by reset, stop, park, E-stop or an aborted startup). While set, moves are rejected (init_required).
	bInitRequired			: BOOL;
	bInitRequiredLog		: BOOL;	// logged once, on the first scan back in automatic
	sInitRequiredMessage	: STRING(80);
	nInitRequiredLevel		: UDINT;
	InitRequiredEvent		: FB_EventLog;
END_VAR
VAR CONSTANT
	tWakeShakeWindow	: TIME := T#15M;	// #151: longest time the brake stays open for the Wake&Shake
END_VAR
VAR PERSISTENT
	nInterruptedAutoClearCount	: UDINT;	// how many times auto-clear has fired, ever
	nStopForcedCount			: UDINT;	// #96: stops that settled on the timeout without StopDone from every axis, should stay 0
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// The command model is in FB_BaseTelescopeControl (BROTLib 0.20.0, #25 step 5.4); this block fills in its hook methods.
SUPER^();
]]></ST>
    </Implementation>
    <Folder Name="internal methods" Id="{d1e7fbc6-9662-4c16-bf25-8044ef92da3b}" />
    <Method Name="_ScanBegin" Id="{1429f2cc-764d-4386-84c1-17f071e41115}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). Start of the scan after the startup scan.
METHOD PROTECTED _ScanBegin
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nScan := nScan + 1;		// #251
bSuspendStop := FALSE;	// #118: back in automatic the body owns a running stop again (it continues the same transaction)
// revert fDut1 (set via the Dut1 property, e.g. from an external time bridge over MQTT) to its
// safe 0.0 default if nothing fresh arrives for a while, instead of serving an arbitrarily
// stale UT1-UTC correction forever. FB_AltAzTelescopeControl's own body is never called (this FB
// doesn't call SUPER^() in its main body), so this has to live here rather than up there.
tonDut1Stale(IN := NOT bDut1Received, PT := T#10M);
bDut1Received := FALSE;
IF tonDut1Stale.Q THEN
	fDut1 := 0.0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_AutoStop" Id="{9b06fbfc-c2a6-48e7-a872-0c93d18e95b9}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). An automatic stop (no trustworthy time).
METHOD PROTECTED _AutoStop
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStopActive := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReadInputs" Id="{29d98027-9fcd-485b-a9a5-d3609a3c4ca3}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). Reads the inputs of the axes and the stop transaction.
METHOD PROTECTED _ReadInputs
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #24 step 2c: the motion limits of this scan (stMotion, deprecated aliases, F_MotionConfigValid), before anything uses them
_MotionConfig();

// BROTLib#167: the feed of the el/az setpoint generators, written every scan (an online change of bFeedFromPosition takes effect at once)
fbElevation.SetFeedFromPosition(bFeedFromPosition := bFeedFromPosition, fCycleTime := MAX(TIME_TO_LREAL(tCycle) * 0.001, 1.0E-6));
fbAzimuth.SetFeedFromPosition(bFeedFromPosition := bFeedFromPosition, fCycleTime := MAX(TIME_TO_LREAL(tCycle) * 0.001, 1.0E-6));

_ReadAxes();
// #96: axis state for the stop transaction (the state of the last axis cycle, like bStopped below)
_StopTxInputs();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReadErrors" Id="{47a145a2-2c03-4b3f-a623-9a3b47ce86a1}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). Error ID, slew time and the error flags of this scan.
METHOD PROTECTED _ReadErrors
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #34: refuse a home/park position the horizon guard below would keep re-homing to. Checked every
// scan, so a reset does not clear it until the configuration is fixed.
bHomeBelowHorizon := BROTLib.F_HomeBelowHorizon(fElevationHome := telescopeConfig.elevationHome,
	fElevationPark := telescopeConfig.elevationPark, fHorizon := fHorizon, fMargin := stMotionUsed.fHorizonMargin);
IF bHomeBelowHorizon THEN
	bSoftwareError := TRUE;
	nSoftwareErrorID := 16#31;
END_IF
// #24 step 2c: an invalid stMotion is refused like 16#31: checked every scan, a reset does not clear it until the
// configuration is fixed. _MotionConfig keeps the defaults in use meanwhile.
IF bMotionConfigInvalid THEN
	bSoftwareError := TRUE;
	nSoftwareErrorID := 16#32;
END_IF

// get error ID, reset if bReset command is set
IF fbAzimuth.Error THEN
	nErrorID := fbAzimuth.nErrorID;
	IF bResetActive THEN
		fbAzimuth.Reset();
	END_IF
ELSIF fbElevation.bError THEN
	nErrorID := fbElevation.nErrorID;
	IF bResetActive THEN
		fbElevation.Reset();
	END_IF
ELSIF fbDerotator.bError THEN
	nErrorID := fbDerotator.nErrorID;
	IF bResetActive THEN
		fbDerotator.Reset();
	END_IF	
ELSIF fbFocus.Error THEN
	nErrorID := fbFocus.ErrorID;
	IF bResetActive THEN
		fbFocus.Reset();
	END_IF
ELSIF bSoftwareError THEN
	nErrorID := nSoftwareErrorID;
END_IF

// fSlewTime
fSlewTime :=  MAX(MAX(fbElevation.fSlewTime, fbAzimuth.fSlewTime), fbDerotator.fSlewTime);

// #24 step 7 PR 3 (D8): the hydraulics error is a hardware error of the telescope (until 0.13.0 only the brake rule read it)
bHydraulicsError := fbHydraulics.Error;
// #24 step 7 PR 7 (D8): so is a power failure (NOT bMainReady, the phase monitor; until 0.13.0 it only gated online)
bMainPowerLost := NOT bMainReady;
bHwError := fbElevation.Error OR
		 fbAzimuth.bError OR
		 fbFocus.Error OR
		 fbDerotator.bError OR
		 bHydraulicsError OR
		 bMainPowerLost;
bError := bHwError OR bSoftwareError;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ErrorReaction" Id="{f1177622-2cd6-4819-9010-6c6b4765dd3a}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). The reaction to an error before the move gate: ramps, timeout park, focus park, roof request.
METHOD PROTECTED _ErrorReaction
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #24 step 7 PR 3 (D8): ramp first on a hydraulics error while the drives can still ramp. The brake is hydraulic: once it is
// not open or the oil pressure is gone the lock is the stop. Any other error, E-stop or safety error keeps its own reaction
// (the error branch disables at once). The ramp is the normal stop (bStop, stop transaction #96, the focus stops with it); the
// emergency park below is then queued behind it (Park() during bStop = bParkAfterStop) and parks in place after the stop has
// settled. It ends when the stop has been released (settled), when the drives cannot ramp any more, when the hydraulics error
// is gone (reset) or on the stop timeout (the stop transaction keeps the stop, #96 D1; here the lock takes over).
bHydraulicsCanRamp := fbBrake.BrakeOpen AND fbHydraulics.OilPressureOK AND NOT bEstopTriggered AND NOT bSafetyError AND
	NOT (fbElevation.Error OR fbAzimuth.bError OR fbFocus.Error OR fbDerotator.bError OR bSoftwareError);
IF bHydraulicsRamp AND (NOT bHydraulicsError OR NOT bHydraulicsCanRamp OR NOT bStopActive OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bHydraulicsRamp := FALSE;
END_IF
// on the rising edge only, and only if an enabled axis moves (also homing or tracking); at standstill the disable is the stop
IF bHydraulicsError AND NOT bHydraulicsErrorLast AND bHydraulicsCanRamp AND
		((fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
		 (fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
		 (fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking))) THEN
	bHydraulicsRamp := TRUE;
	bHydraulicsRampStarted := TRUE;
	bStopActive := TRUE;
END_IF
bHydraulicsErrorLast := bHydraulicsError;
// #24 step 7 PR 7 (D8): the same ramp on a power failure. Whether the drives still have their supply on a phase loss is not known
// here [unverified, on site]: they are taken as able to ramp while bHydraulicsCanRamp holds (brake open with oil pressure, no axis
// reports an error, no E-stop/safety error). A drive without supply raises an axis error and a pump without supply loses the
// pressure; either ends the ramp and the lock is the stop. Same end conditions as above; the supply coming back ends it too (then
// bError has dropped and the stop goes on as a normal stop, the queued park drives to the park position if the axes can move).
IF bMainPowerRamp AND (NOT bMainPowerLost OR NOT bHydraulicsCanRamp OR NOT bStopActive OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bMainPowerRamp := FALSE;
END_IF
IF bMainPowerLost AND NOT bMainPowerLostLast AND bHydraulicsCanRamp AND
		((fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
		 (fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
		 (fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking))) THEN
	bMainPowerRamp := TRUE;
	bMainPowerRampStarted := TRUE;
	bStopActive := TRUE;
END_IF
bMainPowerLostLast := bMainPowerLost;

// #24 step 7 PR 5 (D8): a state-machine timeout (raised by the stage method of the last scan, so the axes may still move) ramps
// and parks instead of the disable of the error branch. On its rising edge, unless parked or a hardware error, E-stop or safety
// error is active (those keep their own reaction): bStop if an enabled axis moves (also homing or tracking), and Park(), which is
// queued behind that stop (bParkAfterStop) or runs at once. While bTimeoutPark the error branch leaves the axes enabled and the
// park's prepare stage drives to the park position if the axes can move; its secure stage closes the brake and the covers and
// switches the hydraulics off. It ends when parked, when the timeout error is reset, when the drives cannot move any more, when no
// stop or park is pending (a stop cancels the park) or on the stop timeout; a park that is still driving with the error then
// restarts in its prepare stage, i.e. in place (the error branch disables the axes from this scan on).
bTimeoutError := bSoftwareError AND (nSoftwareErrorID = 16#10 OR nSoftwareErrorID = 16#30 OR nSoftwareErrorID = 16#40);
bTimeoutCanMove := NOT bHwError AND NOT bEstopTriggered AND NOT bSafetyError;
IF bTimeoutPark AND (NOT bTimeoutError OR NOT bTimeoutCanMove OR bIsParked OR NOT (bStopActive OR bParkActive OR bParkAfterStop) OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bTimeoutPark := FALSE;
	IF bError AND (eParkStage = E_ParkStage.untrack OR eParkStage = E_ParkStage.start_move OR
			eParkStage = E_ParkStage.wait_moves) THEN
		eParkStage := E_ParkStage.prepare;
	END_IF
END_IF
IF bTimeoutError AND NOT bTimeoutErrorLast AND bTimeoutCanMove AND NOT bIsParked THEN
	bTimeoutPark := TRUE;
	bTimeoutParkStarted := TRUE;
	IF (fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
			(fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
			(fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking)) THEN
		bStopActive := TRUE;
	END_IF
	Park();	// after bStop: during the stop the park is queued (bParkAfterStop)
END_IF
bTimeoutErrorLast := bTimeoutError;

// #230: the elevation-window errors of a goto (16#15/16#16) ramp the moving axes before the error branch disables them. Same end
// conditions as the other ramps: the stop has been released, a hardware error, E-stop or safety error takes over (the error branch
// disables at once), the error is gone (reset) or the stop timeout. No park: at standstill these errors latch without one (MS-123, MS-153).
bWindowError := bSoftwareError AND (nSoftwareErrorID = 16#15 OR nSoftwareErrorID = 16#16);
IF bWindowRamp AND (NOT bWindowError OR NOT bTimeoutCanMove OR NOT bStopActive OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bWindowRamp := FALSE;
END_IF
IF bWindowError AND NOT bWindowErrorLast AND bTimeoutCanMove AND
		((fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
		 (fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
		 (fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking))) THEN
	bWindowRamp := TRUE;
	bWindowRampStarted := TRUE;
	bStopActive := TRUE;
END_IF
bWindowErrorLast := bWindowError;

// #24 step 7 PR 8 (D8, row focus error): a focus error alone leaves the axes controllable. Ramp first, then the emergency park
// drives to the park position. Decided before the error branch below, which would otherwise disable the axes in this scan.
bFocusErrorOnly := fbFocus.Error AND NOT bEstopTriggered AND NOT bSafetyError AND
	NOT (fbElevation.Error OR fbAzimuth.bError OR fbDerotator.bError OR bHydraulicsError OR bMainPowerLost OR bSoftwareError);
// it ends when the focus error is no longer the only error (another error, also a power failure, E-stop, safety error, or the
// focus error is gone), when the park is over (bIsParked) or not requested any more (a stop dropped it), or on the timeout of its ramp (the lock takes over)
IF bFocusErrorPark AND (NOT bFocusErrorOnly OR bIsParked OR NOT (bParkActive OR bParkAfterStop OR bStopActive) OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bFocusErrorPark := FALSE;
	// with bError still there and the park on its way to the park position: start it again from its first stage, which parks in
	// place now (no new bError edge resets its stage, and the disabled axes would never report Busy in start_move)
	IF bError AND (eParkStage = E_ParkStage.untrack OR eParkStage = E_ParkStage.start_move OR eParkStage = E_ParkStage.wait_moves) THEN
		eParkStage := E_ParkStage.prepare;
	END_IF
END_IF
// on the edge that starts the emergency park below (F_ErrorParkRequest: bHwError edge, not parked, no E-stop; the #113 exemption
// needs an Az/El error, so it cannot apply here), only if the axes can drive (calibrated, enabled, brake open, oil pressure there)
IF bHwError AND NOT bHwErrorLast AND bFocusErrorOnly AND NOT bIsParked AND fbHydraulics.OilPressureOK AND
		F_ParkAxesCanMove(
			bElCalibrated := fbElevation.Calibrated, bAzCalibrated := fbAzimuth.Calibrated, bDrCalibrated := fbDerotator.Calibrated,
			bElEnabled := fbElevation.bEnable AND fbElevation.fbAxis.Ready, bAzEnabled := fbAzimuth.bEnable AND fbAzimuth.fbAxis.Ready, bDrEnabled := fbDerotator.bEnable AND fbDerotator.fbAxis.Ready,
			bBrakeOpen := fbBrake.BrakeOpen) THEN
	bFocusErrorPark := TRUE;
	bFocusErrorParkStarted := TRUE;
	// an enabled axis moves (also homing or tracking): the controlled stop first; at standstill the park drives at once
	IF (fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
			(fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
			(fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking)) THEN
		bStopActive := TRUE;
	END_IF
END_IF

// #24 step 7 PR 1 (D9): the roof close request, from the serious classes only (not bError: the focus error and the software
// errors are recoverable; not bPowerFailure, a power-on failure; power failure is NOT bMainReady, the phase monitor). Latched
// on the rising edge, so a cause that is gone again (a short E-stop, a phase dip) still requests the close; bReset (held while
// bError, so one reset that clears an axis error also clears the request in the next scan) clears it only while no cause is
// active. Here and not later: nothing in the body returns early, so it is evaluated in every automatic scan, also in the
// error branch below and in E-stop. A signal only: nothing in this block reads it.
bCloseRoofCause := fbElevation.Error OR fbAzimuth.bError OR fbDerotator.bError OR
		fbHydraulics.Error OR bEstopTriggered OR bSafetyError OR NOT bMainReady;
IF bResetActive AND NOT bCloseRoofCause THEN
	bCloseRoofRequest := FALSE;
END_IF
IF bCloseRoofCause AND NOT bCloseRoofCauseLast THEN
	bCloseRoofRequest := TRUE;
END_IF
bCloseRoofCauseLast := bCloseRoofCause;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnMoveEdgeAccepted" Id="{6a9ad9a0-5ebc-4164-b7df-dff483c55662}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). A move input edge was accepted.
METHOD PROTECTED _OnMoveEdgeAccepted
VAR_INPUT
	eCommand	: E_TCSCommand;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ClearOffsets();	// #177]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ApplyError" Id="{710d59cb-85b4-455e-9c17-c4a3fa729ef1}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). The axes and the brake on an error.
METHOD PROTECTED _ApplyError
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bError THEN
		// #24 step 7 PR 3 (D8): not during the ramp of a hydraulics error (bHydraulicsRamp is only TRUE while the hydraulics error is
		// the only error); the axes are disabled from the first scan after its stop has settled. #24 step 7 PR 5: nor during the ramp and
		// park of a timeout (bTimeoutPark, only without a hardware error, E-stop or safety error). PR 7: nor during the ramp of a power failure.
		// PR 8: nor during the ramp and the drive of the focus-error park (bFocusErrorPark, only while the focus error is the only error);
		// its park disables them
		IF NOT bHydraulicsRamp AND NOT bTimeoutPark AND NOT bMainPowerRamp AND NOT bFocusErrorPark AND NOT bWindowRamp THEN
			fbElevation.Enable := FALSE;
			fbAzimuth.Enable := FALSE;
			fbDerotator.Enable := FALSE;
		END_IF
END_IF

// #155: the brake is closed once when the elevation error appears, not in every scan: a level close would undo the
// opening from the Visu in the Wake&Shake window (F_BrakeMustClose keeps the brake closed outside the window).
rtrigElevationError(CLK := fbElevation.bError);
IF fbElevation.bError THEN
	fbElevation.Enable := FALSE;
	fbAzimuth.Enable := FALSE;
	fbDerotator.Enable := FALSE;
	IF rtrigElevationError.Q THEN
		fbBrake.CloseBrake();
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Guards" Id="{6c747f06-7173-4eb5-8741-2e25b61cb1b5}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). Horizon guard.
METHOD PROTECTED _Guards
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// If the Telescope dips under the fHorizon (e.g. while tracking, stop and gohome)
IF fbElevation.Calibrated AND fElevationCurrent < (fHorizon + stMotionUsed.fHorizonMargin) THEN
	IF NOT bStopped AND NOT bGoHomeActive THEN
		bStopActive := TRUE;
	ELSIF NOT bHomeBelowHorizon AND NOT bInitRequired THEN	// #72: no automatic motion before the Init that follows manual mode
		bGoHomeActive := TRUE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Timers" Id="{46fd86a9-3e93-4565-ae9d-8dc5e0e41c29}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). Idle park, power-on warning, state-machine timeouts, the safety net of bInterrupted.
METHOD PROTECTED _Timers
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tpPowerOnWarning(IN := bPowerActive OR (NOT fbElevation.bEnable AND fbBrake.BrakeOpen), PT := T#250MS);

tonPowerTimeout(IN := TCS_command = E_TCSCommand.no_command AND NOT bIsParked, PT := stMotionUsed.tIdleParkTimeout, nDivisor := nTimeDivisor);
// #17: state-machine timeouts, checked in _GotoTelescope/_HomeTelescope/_SlewTelescope (which raise the error and
// clear the flag, so the timer resets on the next scan)
tonGotoTimeout(IN := bGotoActive, PT := stMotionUsed.tStateMachineTimeout, nDivisor := nTimeDivisor);
tonHomeTimeout(IN := bGoHomeActive, PT := stMotionUsed.tStateMachineTimeout, nDivisor := nTimeDivisor);
tonSlewTimeout(IN := bSlewActive, PT := stMotionUsed.tStateMachineTimeout, nDivisor := nTimeDivisor);
IF tonPowerTimeout.Q AND NOT bIsParked THEN
	bParkActive := TRUE;
END_IF
		
// #26: safety net only. bInterrupted is now a one-shot (cleared in the arbitration below right after the
// interrupted state machines are called), so it should never stay latched and this should never fire: the
// counter staying at 0 on site confirms that. Before, it could latch (ADR 0001, IAG design doc
// monets-telescopecontrol-command-arbitration.md), and this auto-clear after 5 s of true idle was the fix.
bInterruptedIdle := bInterrupted AND NOT bError AND
	NOT (bPowerActive OR bParkActive OR bGoHomeActive OR bGotoActive OR bSlewActive OR bTrackActive);
tonInterruptedAutoClear(IN := bInterruptedIdle, PT := T#5S);
IF tonInterruptedAutoClear.Q THEN
	bInterrupted := FALSE;
	nInterruptedAutoClearCount := nInterruptedAutoClearCount + 1;
END_IF
InterruptedAutoClearEvent(
	Trigger 		:= tonInterruptedAutoClear.Q,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'bInterrupted auto-cleared after idle timeout (count: %s)',
	OnMessage 		:= UDINT_TO_STRING(nInterruptedAutoClearCount),
	Comm 			:= fbComm);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_RestartMoveTimeout" Id="{afed8771-c9a8-4dfa-bc99-b979f9714bff}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). The replacement gets its own timeout.
METHOD PROTECTED _RestartMoveTimeout
VAR_INPUT
	eKeep	: E_TCSCommand;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eKeep OF
	E_TCSCommand.gohome:	tonHomeTimeout(IN := FALSE);
	E_TCSCommand.goto:		tonGotoTimeout(IN := FALSE);
	E_TCSCommand.slew:		tonSlewTimeout(IN := FALSE);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ParkRequests" Id="{f68b8f53-c66d-4fbf-83e9-1de98c5d79bb}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4, S2: the body of this block is the template text, the differences are in these methods). The automatic parks.
METHOD PROTECTED _ParkRequests
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #86: a new axis/focus error while not parked starts the emergency park by itself (after the supersede block and
// the horizon guard, before the arbitration, so the stop branch cannot clear the request in the same scan). #24 step 7 PR 3: a
// hydraulics error too; during its ramp (bStop set above) Park() queues the park behind the stop (bParkAfterStop).
bErrorParkStarted := BROTLib.F_ErrorParkRequest(bHwError := bHwError, bHwErrorLast := bHwErrorLast,
	bIsParked := bIsParked, bEstop := bEstopTriggered);
bErrorParkExempt := bErrorParkStarted AND F_WakeShakeErrorExempt(bFirstPowerOnPending := bFirstPowerOnPending,
	bPowering := bPowerActive OR fbStartup.Initializing, bAzElError := fbAzimuth.bError OR fbElevation.Error,
	bOtherHwError := fbFocus.Error OR fbDerotator.bError OR bHydraulicsError OR bMainPowerLost);	// #24 step 7 PR 3/PR 7: a hydraulics error or a power failure is never the Wake&Shake fault
bErrorParkStarted := bErrorParkStarted AND NOT bErrorParkExempt;
bHwErrorLast := bHwError;
IF bErrorParkStarted THEN
	Park();	// same routing as an external park: deferred to standstill during a stop (#83/#87)
END_IF
// #24 step 7 PR 4 (row cover error): a new cover error while not parked starts a normal park, not the emergency park: the cover
// error is not bError, so the park branch below stops a running move first (#84) and the park drives to the park position if the
// axes can move (ramp, then drive to park). Same edge and exemptions as #86 (F_ErrorParkRequest: not parked, not in E-stop).
bCoverErrorParkStarted := BROTLib.F_ErrorParkRequest(bHwError := fbCovers.Error, bHwErrorLast := bCoverErrorLast,
	bIsParked := bIsParked, bEstop := bEstopTriggered);
bCoverErrorLast := fbCovers.Error;
IF bCoverErrorParkStarted THEN
	Park();
END_IF

// #24 step 7 PR 6 (D8, rows E-stop / safety error): the E-stop or a safety error cuts the drives (STO), the brake lock is the
// stop (no ramp, no MC_Stop; the axes are disabled at the end of the body). On the rising edge: hydraulics off at once (the
// hydraulic brake locks, D4), every move ends (as the park branch interrupts them, #26 one-shot) and, unless the telescope is
// parked, the park in place is held until the E-stop and the safety error are both gone: the covers close only after the release.
// The covers are not on the E-stop circuit (owner): a cover run (power-on opening, park closing, pendant) would go on, so they get
// Stop() here and in every scan while bSafetyStop (end of the body, after the stages), and no stage commands them meanwhile
// (_PowerOn, _ParkTelescope check bSafetyStop). The #86 park on an axis error stays
// exempt during the E-stop (F_ErrorParkRequest unchanged); this park comes after the release instead. Not for a safety error
// alone in the Wake&Shake window: the window survives it so that the operator can go on (#155); an E-stop ends the window.
// After the #86 block for the same reason (the stop branch cannot clear the park in the scan of the release).
bSafetyStop := bEstopTriggered OR bSafetyError;
IF bSafetyStop AND NOT bSafetyStopLast THEN
	fbHydraulics.Enable := FALSE;
	fbCovers.Stop();	// "E-stop means stop": a running open/close ends where it is (held at the end of the body)
	bGoHomeActive := FALSE;
	bGotoActive := FALSE;
	bSlewActive := FALSE;
	bTrackActive := FALSE;
	bInterrupted := TRUE;
	_HomeTelescope();
	_GotoTelescope();
	_SlewTelescope();
	bInterrupted := FALSE;	// #26: one-shot
	bMoveAbortPending := FALSE;	// #84: the drives are cut, nothing to wait for
	bSupersedeRequest := FALSE;	// #83
	IF NOT bIsParked AND NOT (bWakeShakeWindow AND NOT bEstopTriggered) THEN
		bSafetyParkPending := TRUE;
	END_IF
END_IF
bSafetyStopLast := bSafetyStop;
bSafetyPark := bSafetyPark AND (bParkActive OR bParkAfterStop);	// ends with its park (parked, or cleared by a stop/reset)
IF bSafetyParkPending AND NOT bSafetyStop THEN
	bSafetyParkPending := FALSE;
	IF NOT bIsParked THEN
		bSafetyPark := TRUE;
		bSafetyParkStarted := TRUE;
		Park();
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
