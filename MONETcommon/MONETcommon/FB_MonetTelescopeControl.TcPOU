          <ST><![CDATA[Azimuth := THIS^.fAzimuthCurrent;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CoverAutoOpen" Id="{d750fe74-a7ce-44c0-a77d-2f5e342e939f}">
      <Declaration><![CDATA[PROPERTY CoverAutoOpen : BOOL
]]></Declaration>
      <Get Name="Get" Id="{4134082f-796e-4360-8ca1-5611440c0e09}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CoverAutoOpen := THIS^.bCoverAutoOpen;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{5af5b3f5-890f-4491-8b7f-06921498a3f2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// This property has no effect on MONET: _PowerOn always opens the covers
// unconditionally and never reads bCoverAutoOpen. Forcing it TRUE here keeps
// the property honest, but does not by itself guarantee the invariant, since
// bCoverAutoOpen is a public VAR_INPUT a caller can still write to directly.
THIS^.bCoverAutoOpen := TRUE;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Declination" Id="{b1285964-102f-45b7-af05-6785154ef40d}">
      <Declaration><![CDATA[PROPERTY Declination : LREAL
]]></Declaration>
      <Get Name="Get" Id="{add754b0-d14d-4a0e-b482-234fdfd51176}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Declination := THIS^.fDeclination;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Init" Id="{78ec73c4-02ac-4d83-aefd-694e0077d330}">
      <Declaration><![CDATA[METHOD Init : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #87: park wins in both orders, and a stop is not overridden by a power-on either. This must come before
// AcceptInit: a pending park clears Initialized, so AcceptInit would accept.
IF bStop OR bPark OR bParkAfterStop THEN
    IF NOT bInitRefused THEN
        bInitRefused := TRUE;
        nInitRefusedLevel := ADSLOG_MSGTYPE_WARN;
        IF bStop THEN
            sInitRefusedReason := 'stop in progress';
        ELSE
            sInitRefusedReason := 'park in progress, send stop to cancel it';
        END_IF
    END_IF
// AcceptInit refuses while a startup runs or completed (also across a transient interlock, -2), and while suspended.
ELSIF fbStartup.AcceptInit() THEN
    // #85: nothing stale after power-on (park is kept, it is the safe direction)
    bGoHome := FALSE;
    bGoto := FALSE;
    bSlew := FALSE;
    bTrack := FALSE;
    bPower := TRUE;
    fReadyState := 0.7;
ELSIF NOT bInitRefused THEN
    // #80: do not drop the request silently
    bInitRefused := TRUE;
    IF fbStartup.Initializing THEN
        nInitRefusedLevel := ADSLOG_MSGTYPE_WARN;
        sInitRefusedReason := 'startup already running, send stop or reset to abort';
    ELSIF fbStartup.Initialized THEN
        nInitRefusedLevel := ADSLOG_MSGTYPE_HINT;
        sInitRefusedReason := 'already online';
    ELSE
        nInitRefusedLevel := ADSLOG_MSGTYPE_WARN;
        sInitRefusedReason := 'automatic mode off';
    END_IF
END_IF
Init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveAltAz" Id="{94f5e9d8-f8f7-4c16-ac3f-2e854a5b373b}">
      <Declaration><![CDATA[METHOD MoveAltAz : BOOL
VAR_INPUT
	AltAz	: BROTLib.ST_AltAzCoordinate;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #83: decide first. A rejected move writes nothing, not even the target.
IF NOT _AcceptMove(E_TCSCommand.slew, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
fElevation 	:= AltAz.Altitude;
fAzimuth 	:= AltAz.Azimuth;
bSlew		:= TRUE;
bSlewChecked := TRUE;	// decided here, the direct-write gate in the body must not decide it again
MoveAltAz := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveRaDec" Id="{86c89766-d350-4f6b-9fea-e302f9b4e7d4}">
      <Declaration><![CDATA[METHOD MoveRaDec : BOOL
VAR_INPUT
	RaDec	: BROTLib.ST_RaDecCoordinate;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #83: decide first, see MoveAltAz
IF NOT _AcceptMove(E_TCSCommand.goto, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
fRightAscension	:= RaDec.RightAscension;
fDeclination	:= RaDec.Declination;
bGoto			:= TRUE;
bGotoChecked	:= TRUE;
MoveRaDec		:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Park" Id="{21fb237d-ad50-4f82-97cf-a56a9c25b954}">
      <Declaration><![CDATA[METHOD Park : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #83/#87: park is never rejected. During a stop the stop branch clears bPark every scan, so keep it aside
// and set it at standstill. During a power-on the arbitration lets the park abort the power-on.
IF bStop THEN
	bParkAfterStop := TRUE;
ELSE
	bPark := TRUE;
END_IF
Park := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{efa0c84e-7359-43c3-a635-1faede103859}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReset := TRUE;]]></ST>
      </Implementation>
    </Method>
