        </Implementation>
      </Get>
    </Property>
    <Method Name="Init" Id="{78ec73c4-02ac-4d83-aefd-694e0077d330}">
      <Declaration><![CDATA[METHOD Init : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bPowerChecked := TRUE;	// #24 step 5: a rising bPower in the same scan is this command, not a second one
// #87: park wins in both orders, and a stop is not overridden by a power-on either. This must come before
// AcceptInit: a pending park clears Initialized, so AcceptInit would accept.
IF bStopActive OR bParkActive OR bParkAfterStop THEN
    IF NOT bInitRefused THEN
        bInitRefused := TRUE;
        nInitRefusedLevel := ADSLOG_MSGTYPE_WARN;
        IF bStopActive THEN
            sInitRefusedReason := 'stop in progress';
        ELSE
            sInitRefusedReason := 'park in progress, send stop to cancel it';
        END_IF
    END_IF
// AcceptInit refuses while a startup runs or completed (also across a transient interlock, -2), and while suspended.
ELSIF fbStartup.AcceptInit() THEN
    // #85: nothing stale after power-on (park is kept, it is the safe direction)
    bGoHomeActive := FALSE;
    bGotoActive := FALSE;
    bSlewActive := FALSE;
    bTrackActive := FALSE;
    bPowerActive := TRUE;
    fReadyState := 0.7;
ELSIF NOT bInitRefused THEN
    // #80: do not drop the request silently
    bInitRefused := TRUE;
    IF fbStartup.Initializing THEN
        nInitRefusedLevel := ADSLOG_MSGTYPE_WARN;
        sInitRefusedReason := 'startup already running, send stop or reset to abort';
    ELSIF fbStartup.Initialized THEN
        nInitRefusedLevel := ADSLOG_MSGTYPE_HINT;
        sInitRefusedReason := 'already online';
    ELSE
        nInitRefusedLevel := ADSLOG_MSGTYPE_WARN;
        sInitRefusedReason := 'automatic mode off';
    END_IF
END_IF
Init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveAltAz" Id="{94f5e9d8-f8f7-4c16-ac3f-2e854a5b373b}">
      <Declaration><![CDATA[METHOD MoveAltAz : BOOL
VAR_INPUT
	AltAz	: BROTLib.ST_AltAzCoordinate;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #24 step 5: decided here (accepted or rejected); a rising bSlew input in the same scan is not decided again
bSlewChecked := TRUE;
// #83: decide first. A rejected move writes nothing, not even the target.
IF NOT _AcceptMove(E_TCSCommand.slew, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
IF ABS(fElevation - AltAz.Altitude) > 1.0E-9 OR ABS(fAzimuth - AltAz.Azimuth) > 1.0E-9 THEN
	_ClearOffsets();	// #177: a new target, not the same one sent again
END_IF
fElevation 	:= AltAz.Altitude;
fAzimuth 	:= AltAz.Azimuth;
bSlewActive		:= TRUE;
MoveAltAz := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveRaDec" Id="{86c89766-d350-4f6b-9fea-e302f9b4e7d4}">
      <Declaration><![CDATA[METHOD MoveRaDec : BOOL
VAR_INPUT
	RaDec	: BROTLib.ST_RaDecCoordinate;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bGotoChecked	:= TRUE;	// #24 step 5, see MoveAltAz
// #83: decide first, see MoveAltAz
IF NOT _AcceptMove(E_TCSCommand.goto, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
IF ABS(fRightAscension - RaDec.RightAscension) > 1.0E-9 OR ABS(fDeclination - RaDec.Declination) > 1.0E-9 THEN
	_ClearOffsets();	// #177
END_IF
fRightAscension	:= RaDec.RightAscension;
fDeclination	:= RaDec.Declination;
bGotoActive			:= TRUE;
MoveRaDec		:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Park" Id="{21fb237d-ad50-4f82-97cf-a56a9c25b954}">
      <Declaration><![CDATA[METHOD Park : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bParkChecked := TRUE;	// #24 step 5: a rising bPark in the same scan is this command
// #83/#87: park is never rejected. During a stop the stop branch clears bParkActive every scan, so keep it aside
// and set it at standstill. During a power-on the arbitration lets the park abort the power-on.
IF bStopActive THEN
	bParkAfterStop := TRUE;
ELSE
	bParkActive := TRUE;
END_IF
Park := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{efa0c84e-7359-43c3-a635-1faede103859}">
