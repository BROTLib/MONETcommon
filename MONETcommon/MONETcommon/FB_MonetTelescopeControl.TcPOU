<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetTelescopeControl" Id="{392c90d3-a441-4c8d-a752-42b25b49f5cd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MonetTelescopeControl EXTENDS FB_AltAzTelescopeControl IMPLEMENTS I_AltAzTelescope
VAR_INPUT
	fbFocus				: I_Focus;
	// the concrete block, not I_MirrorCovers: an E-stop / safety error stops the covers (Stop(), which I_MirrorCovers does not carry,
	// as for the pendant). MAIN passes its HalfBROT.FB_CoverControl instance as before (fbCovers := CoverControl).
	fbCovers			: REFERENCE TO HalfBROT.FB_CoverControl;
	fbBrake				: I_Brake;
	fbHydraulics   		: I_Hydraulics;
	fbElevation			: REFERENCE TO FB_ElevationControl;
	fbAzimuth			: REFERENCE TO FB_AzimuthControl;
	fbDerotator			: REFERENCE TO FB_DerotatorControl;

	fbPointing			: REFERENCE TO FB_PointingModelForward;
	fbPointingInverse	: REFERENCE TO FB_PointingModelInversion;

	bBrakeClearing		: BOOL	:= TRUE;

	// BROTLib#33: use the live weather (MQTT, pybrotlib.weather) in the refraction of eq2hor/hor2eq. FALSE (default) keeps
	// the estimate from the site altitude. A value is used only if it is valid (not stale) and plausible for the site
	// (BROTLib.F_RefractionWeather); anything else falls back to the estimate, pressure and temperature independently.
	// Switch on per site after the on-sky check (MONETcommon#30).
	bLiveWeatherRefraction	: BOOL := FALSE;

	// #155: SafetyHandling.error, wired in MAIN. FALSE (default) means the safety block of the brake is not enforced.
	bSafetyError		: BOOL;

	// Test seam (plan decision 4): every long timeout of this telescope (600 s, 2 min, 12 h) is divided by it. Production
	// leaves it at 1. Per instance, because TcUnit runs all suites in the same PLC cycles.
	nTimeDivisor		: UDINT := 1;

	// #24 step 2c: the motion limits of this telescope (move velocities, timeouts, goto/track elevation windows, horizon
	// margin, azimuth/derotator track margin and time cap). The defaults are the literals of 0.11.x, so a MAIN that does
	// not set it behaves as before. Checked every scan with BROTLib.F_MotionConfigValid: an invalid configuration is
	// software error 16#32 (like 16#31), the defaults stay in use until it is fixed.
	stMotion			: BROTLib.ST_MotionConfig;

	// DEPRECATED (#24 D2, removed in the next minor): use stMotion. An alias set to a value other than its old default
	// (below) wins over the stMotion field; that is logged once (WARN). Left at the default, stMotion applies.
	// fElevationMoveVelocity = stMotion.fElevationMoveVelocity: every commanded elevation move (Goto/Home/Park/PowerOn/
	// Slew and the move onto a track target, not the computed tracking rate), M6.
	fElevationMoveVelocity : LREAL := 5.0;
	// #2 (F_AxisTurn) = stMotion.fAzimuthTrackMargin, fDerotatorTrackMargin, fAzimuthTrackTimeCap, fDerotatorTrackTimeCap
	fAzimuthTrackMargin		: LREAL := 1.0;
	fDerotatorTrackMargin	: LREAL := 1.0;
	fAzimuthTrackTimeCap	: LREAL := 14400.0;
	fDerotatorTrackTimeCap	: LREAL := 14400.0;
END_VAR
VAR_OUTPUT
	fDerotatorSign		: LREAL := 1.0;	// derotator
	
	fElevationPointingOffset : LREAL;
	fAzimuthPointingOffset : LREAL;
	fElevationPointingOffset2 : LREAL;
	fAzimuthPointingOffset2 : LREAL;
	
	fRightAscensionCurrentSky: LREAL;
	fDeclinationCurrentSky: LREAL;

	fDerotatorVelocity	: LREAL;	// rotational velocity of the derotator
	fElevationVelocity	: LREAL;	// rotational velocity of the elevation
	fAzimuthVelocity	: LREAL;	// rotational velocity of the elevation

	// weather handed to the refraction of eq2hor and both hor2eq calls (BROTLib#33); published as WEATHER.REFRACTION.*
	fRefractionPressure		: LREAL;	// hPa, 0.0 = estimate from altitude
	fRefractionTemperature	: LREAL;	// deg C, only meaningful if bRefractionTemperatureSet
	bRefractionTemperatureSet	: BOOL;	// FALSE = estimate from altitude

	// #24 step 7 PR 1 (plan D9, specs/design/monetcommon-safe-states.md "Roof"): the roof should be closed. A signal only, nothing
	// in this library acts on it; the site MAIN closes the roof on it (behind its enable switch, only in automatic). Set by the
	// serious error classes only: an Az/El/Der axis error, a hydraulics error, E-stop, safety error, power failure (NOT bMainReady).
	// Not by the focus error or the software errors (bError) and not by bPowerFailure (a power-on failure). Latched on the rising
	// edge of a cause, cleared by bReset once no cause is active. Updated in every automatic scan; in manual (SuspendAutomatic)
	// it keeps the value of the last automatic scan.
	bCloseRoofRequest	: BOOL;

	// #24 step 5 (aim 3): the command requests of this block. Until 0.14.x the inherited inputs bPower, bGoHome, bPark, bTrack,
	// bGoto, bSlew, bStop, bReset were written by this block (set by the methods, cleared when a command ended); now the inputs
	// are read-only and edge-triggered and these latches carry the request. Set by the methods (Init, Home, Park, Track/TrackRaDec/
	// MoveRaDec, Slew/MoveAltAz, Stop, Reset) and by the rising edge of the matching input, cleared by this block when the
	// command ends, is dropped or aborted, exactly where the input used to be cleared. TRUE = requested or running (bGotoActive
	// also while a goto waits for the abort stop of the move it replaces); a status for the Visu and diagnostics, read-only.
	// Comments in this block written before step 5 name the request by its input (bGoto meaning bGotoActive, and so on).
	bPowerActive		: BOOL;	// power-on requested or running (was bPower)
	bGoHomeActive		: BOOL;	// move to the home position (was bGoHome; also set by the horizon guard)
	bParkActive			: BOOL;	// park requested or running (was bPark; kept during manual mode, #118)
	bTrackActive		: BOOL;	// tracking requested or running (was bTrack; set after a goto with bAutoTrack)
	bGotoActive			: BOOL;	// goto requested or running (was bGoto; Track() is a goto followed by tracking)
	bSlewActive			: BOOL;	// slew requested or running (was bSlew)
	bStopActive			: BOOL;	// stop running, until the stop transaction has settled (was bStop)
	bResetActive		: BOOL;	// reset of this scan, held while an error this block resets is active (was bReset)
END_VAR
VAR
    fbStartup : BROTLib.FB_StartupControl;
	bRefractionLive				: BOOL;	// at least one live value is used
	bRefractionPressureRejected	: BOOL;	// live pressure valid but implausible for the site (logged on the rising edge)
	bRefractionTemperatureRejected	: BOOL;
	rtrigPressureRejected	: R_TRIG;
	rtrigTemperatureRejected	: R_TRIG;
	bTargetBelowHorizonWarn	: BOOL;	// #94: goto/track requested with the RA/Dec target below fHorizon, taken before the dispatch can clear bGoto
	// M1: internal (non-axis) errors from the Goto/Home/Slew state machines, latched
	// until bReset since bError/nErrorID are otherwise recomputed from the axes every
	// scan and would silently wipe these within the same cycle they're set in.
	bSoftwareError		: BOOL;
	nSoftwareErrorID	: UINT;
	sSoftwareErrorText	: STRING(80);	// #24 step 3b: what the last _RaiseSoftwareError reported (ADS diagnostics only, not logged), '' after a reset
	SoftwareErrorEvent	: FB_EventLog;

	// #80: one-scan flag set by Init() when AcceptInit() refuses; logged once by the body.
	bInitRefused		: BOOL;
	sInitRefusedReason	: STRING(80);
	nInitRefusedLevel	: UDINT;
	InitRefusedEvent	: FB_EventLog;

	// #2: F_AxisTurn found a turn of the target inside the axis limits. No turn: a goto/track is not started (or a
	// running track stops) and AzimuthNoTurnEvent / DerotatorNoTurnEvent warn. Taken before the dispatch below can
	// clear bGoto/bTrack, like bTargetBelowHorizonWarn.
	bAzimuthTurnOK		: BOOL;
	bDerotatorTurnOK	: BOOL;
	bAzimuthNoTurn		: BOOL;
	bDerotatorNoTurn	: BOOL;
	AzimuthNoTurnEvent	: FB_EventLog;
	DerotatorNoTurnEvent: FB_EventLog;
	// #2: a slew target outside the axis limits was refused (one-scan flag, set by _SlewTelescope).
	bSlewOutOfLimits	: BOOL;
	SlewOutOfLimitsEvent: FB_EventLog;
	// #212: a slew target outside the elevation window (stMotionUsed.fGotoMinElevation..fGotoMaxElevation, as goto) was refused (one-scan flag, set by _SlewTelescope).
	bSlewOutsideWindow	: BOOL;
	SlewOutsideWindowEvent: FB_EventLog;

	// #34: home or park position at or below fHorizon + stMotionUsed.fHorizonMargin. The horizon guard
	// would send the telescope home, find it still below the horizon, and home it again forever.
	bHomeBelowHorizon	: BOOL;

	// #24 step 2c: the motion limits used in this scan (_MotionConfig): stMotion with the deprecated aliases applied, or
	// the defaults while the configuration is invalid (bMotionConfigInvalid, software error 16#32)
	stMotionUsed			: BROTLib.ST_MotionConfig;
	bMotionConfigInvalid	: BOOL;
	sMotionAliases			: STRING(120);	// the deprecated aliases in use, '' = none
	sMotionAliasesLogged	: STRING(120);	// the set that was logged last
	MotionAliasEvent		: FB_EventLog;

	// #17: 600 s timeouts of the goto/home/slew state machines. They used to be TONs in the methods' plain VAR,
	// which is re-created on every call, so they never fired. They are fed every scan in the body (the methods are
	// only called while their command is selected) and reset as soon as the command flag drops, whatever ended it.
	tonGotoTimeout		: FB_TimeoutTimer;
	tonHomeTimeout		: FB_TimeoutTimer;
	tonSlewTimeout		: FB_TimeoutTimer;

	// #24 step 3a: the stage of each stage machine (until 0.12.0 a bare USINT nStage in the VAR_INST of the method; here so
	// the read-only properties GotoStage, SlewStage, ParkStage and PowerOnStage can return it). The values are the old numbers.
	// _HomeTelescope has no stage.
	eGotoStage			: E_GotoStage := E_GotoStage.idle;
	eSlewStage			: E_SlewStage := E_SlewStage.idle;
	eParkStage			: E_ParkStage := E_ParkStage.prepare;
	ePowerOnStage		: E_PowerOnStage := E_PowerOnStage.open_covers;

	// #26: safety net for a latched bInterrupted (now a one-shot, see the arbitration): auto-clear after 5 s of
	// true idle, logged and counted. The counter should stay at 0.
	bInterruptedIdle			: BOOL;
	tonInterruptedAutoClear		: TON;
	InterruptedAutoClearEvent	: FB_EventLog;

	// #84: a running move was interrupted (gohome/goto/park/track over a slew or goto): stop the axes
	// before the new command may start. Cleared at standstill and on an error. A reset (#56) clears it only
	// if no enabled axis is moving (F_ResetMoveAbort), otherwise the abort stop goes on. Also set by the switch to
	// manual under motion (#118, SuspendAutomatic).
	bMoveAbortPending	: BOOL;
	eTimeoutCommand		: E_TCSCommand;	// #56: the command tonCommandTimeout is counting for
	MoveAbortEvent		: FB_EventLog;
	// plan step 3.1: the axis feedback of this scan (1 azimuth, 2 elevation, 3 derotator), filled by _ReadAxes
	aAxis				: ARRAY[1..3] OF ST_AxisStatus;
	// #24 step 4a: the telemetry record of the last publish (filled in _SendTelemetry) and the block that publishes it
	stTelemetry			: ST_MonetTelemetry;
	fbTelemetry			: FB_MonetTelescopeTelemetry;
	// #96: one MC_Stop per axis and stop transaction; the stop is over when every axis that was sent one has
	// reported StopDone and the telescope has been at rest for 3 scans. Replaces bStopIssuedAz/El/Dr (#84).
	fbStopTx			: BROTLib.FB_StopTransaction;
	// #25 step 5.2: which command runs (BROTLib.FB_CommandArbiter); bRequestIdle: no request is set in this scan
	fbArbiter			: BROTLib.FB_CommandArbiter;
	bRequestIdle		: BOOL;
	bStopTxBegun		: BOOL;	// the transaction of the running stop command has been begun
	StopForcedEvent		: FB_EventLog;
	StopStuckEvent		: FB_EventLog;
	// #118: the switch to manual under motion stops the axes once. SuspendAutomatic drives that one stop (the pendant takes
	// over after it); a stop that arrives later during manual is not driven. The body clears the flag, it owns the stop again.
	bSuspendStop		: BOOL;
	bSuspendStopStarted	: BOOL;	// one scan, logged
	SuspendStopEvent	: FB_EventLog;
	// #158: bIsParked means "secured" (covers closed, brake closed, hydraulics off, axes disabled), not "at the park position".
	// bParkedInPlace is TRUE when the park ended where the telescope stood (error, or axes could not move, #86/#87). Not
	// persistent: FALSE after a PLC restart, where the pose is unknown.
	bParkedInPlace		: BOOL;
	ParkedInPlaceEvent	: FB_EventLog;
	bParkedInPlaceLogged: BOOL;	// one scan, logged

	// #83: command acceptance. Methods and the direct-write gate decide at arrival (F_CommandAcceptance);
	// a rejection is logged and counted, never queued.
	bCommandRejected		: BOOL;		// set by _NoteRejected, logged and cleared by the body
	eLastRejectedCommand	: E_TCSCommand;
	eLastRejectReason		: E_CommandRejectReason;
	nCommandRejectCount		: UDINT;	// diagnostics (ADS / scope), optional MQTT field later
	sRejectMessage			: STRING(120);
	RejectEvent				: FB_EventLog;
	tonRejectRepeat			: TON;		// identical rejection within 2 s is logged once (all are counted)
	eLoggedCommand			: E_TCSCommand;
	eLoggedReason			: E_CommandRejectReason;
	// an accepted move replaces the running one (latest wins): drop the other move flags, stop the axes
	bSupersedeRequest		: BOOL;
	eSupersedeKeep			: E_TCSCommand;
	// #24 step 5: edge memory of the command inputs (was the #83 direct-write gate). The input of the last scan (snapshot at the
	// end of the body), or TRUE once a method has sent that command since then: a method call and a rising input in the same scan
	// (from one call of the body to the next) are one command, and a held input starts its command once.
	bGoHomeChecked			: BOOL;
	bGotoChecked			: BOOL;
	bSlewChecked			: BOOL;
	bTrackChecked			: BOOL;
	bPowerChecked			: BOOL;
	bParkChecked			: BOOL;
	bStopChecked			: BOOL;
	bResetChecked			: BOOL;
	// #83/#87: a Park() received during a stop; the stop branch would clear bPark, so it is set at standstill
	bParkAfterStop			: BOOL;
	// #87: park aborted a running power-on (one scan, logged)
	bPowerAbortedByPark		: BOOL;
	PowerAbortEvent			: FB_EventLog;
	// #86: a new axis/focus error on a telescope that is not parked starts the emergency park (#24 step 7 PR 3: also a hydraulics error; PR 7: a power failure)
	bHwError				: BOOL;
	bHwErrorLast			: BOOL;	// edge memory, updated only where the request is made
	bErrorParkStarted		: BOOL;	// one scan, logged
	ErrorParkEvent			: FB_EventLog;
	// #24 step 7 PR 1 (D9): a cause of bCloseRoofRequest is active in this scan, and its value of the last automatic scan. The
	// initial FALSE of bCloseRoofCauseLast means a cause already present at the PLC start (E-stop, no phase) sets the request
	// (conservative, plan 8.7). To arm only after the start instead, initialise it with TRUE.
	bCloseRoofCause			: BOOL;
	bCloseRoofCauseLast		: BOOL := FALSE;
	// #113: no power-on has completed since the PLC start; its axis error is the expected Wake&Shake fault
	bFirstPowerOnPending	: BOOL := TRUE;
	bErrorParkExempt		: BOOL;	// one scan, logged
	ErrorParkExemptEvent	: FB_EventLog;
	// #24 step 7 PR 3 (plan D8, specs/design/monetcommon-safe-states.md row "Hydraulics error"): fbHydraulics.Error is a telescope
	// fault, part of bHwError (bError, READY_STATE -1.0, emergency park in place on the edge, #86). Ramp first: if the drives can
	// still ramp (bHydraulicsCanRamp: brake open, oil pressure there, no E-stop/safety error, no other error) and an enabled axis
	// moves, the error sets bStop (the stop transaction, #96) and the error branch leaves the axes enabled until that stop has
	// settled (bHydraulicsRamp); the park queued behind the stop (bParkAfterStop) then parks in place. With the pressure already
	// gone the brake lock is the stop: no ramp, the axes are disabled in the same scan, as for an axis error.
	bHydraulicsError		: BOOL;	// fbHydraulics.Error in this scan
	bHydraulicsErrorLast	: BOOL;	// its value of the last automatic scan (edge memory of the ramp, updated in every automatic scan)
	bHydraulicsCanRamp		: BOOL;	// the drives can still ramp in this scan
	bHydraulicsRamp			: BOOL;	// the controlled stop of a hydraulics error is running, the error branch does not disable the axes
	bHydraulicsRampStarted	: BOOL;	// one scan, logged
	HydraulicsRampEvent		: FB_EventLog;
	// #24 step 7 PR 5 (plan D8, specs/design/monetcommon-safe-states.md row "Software error: timeout"): a state-machine timeout
	// (16#10 goto, 16#30 home, 16#40 slew) leaves the drives controllable: ramp (bStop, stop transaction #96) if an axis moves, then
	// the park drives to the park position (in place if F_ParkAxesCanMove is FALSE); the error branch does not disable the axes
	// while it runs (bTimeoutPark). No roof close (D9, recoverable).
	bTimeoutError			: BOOL;	// bSoftwareError with one of the three timeout IDs in this scan
	bTimeoutErrorLast		: BOOL;	// its value of the last automatic scan (edge memory)
	bTimeoutCanMove			: BOOL;	// no hardware error, E-stop or safety error: the drives may ramp and drive to the park position
	bTimeoutPark			: BOOL;	// the ramp and park of a timeout is running, the error branch does not disable the axes
	bTimeoutParkStarted		: BOOL;	// one scan, logged
	TimeoutParkEvent		: FB_EventLog;
	// #24 step 7 PR 4 (specs/design/monetcommon-safe-states.md row "Cover error"): fbCovers.Error (HalfBROT FB_CoverControl, latched
	// there until its Reset(), the MAIN reset button; no cover moves while it is set) is no telescope error: not in bError (the drives
	// are controllable), no roof close (D9). Its rising edge on a telescope that is not parked and not in E-stop starts a normal park
	// (Park(), the routing of an external park: a running move is stopped first, then the park drives to the park position if the axes
	// can move, else it parks in place). A park whose covers are in error ends in stage secure without fbCovers.Closed (axes disabled,
	// brake closed, hydraulics off) with bIsParked and software error 16#21. A power-on with the cover error fails before its cover
	// command (bPowerFailure), so the telescope stays parked.
	bCoverErrorLast			: BOOL;	// fbCovers.Error of the last automatic scan (edge memory of the park request; TRUE on the first manual scan, as bHwErrorLast)
	bCoverErrorParkStarted	: BOOL;	// one scan, logged
	CoverErrorParkEvent		: FB_EventLog;
	bParkCoverFault			: BOOL;	// the park left stage secure without fbCovers.Closed (cover error); 16#21 is raised in stage parked
	// #24 step 7 PR 7 (plan D8, specs/design/monetcommon-safe-states.md row "Power failure"): NOT bMainReady (MAIN: PowerMonitoring.
	// phaseOK, warnings included, not debounced) is a telescope fault like the hydraulics error: part of bHwError (bError, READY_STATE
	// -1.0, emergency park in place on the edge, #86), not latched (bError drops when the supply is back). Ramp first while the drives
	// can still ramp (the same test, bHydraulicsCanRamp), else the lock is the stop. Until 0.13.0 it only gated online (-2.0).
	bMainPowerLost			: BOOL;	// NOT bMainReady in this scan
	bMainPowerLostLast		: BOOL;	// its value of the last automatic scan (edge memory of the ramp, updated in every automatic scan)
	bMainPowerRamp			: BOOL;	// the controlled stop of a power failure is running, the error branch does not disable the axes
	bMainPowerRampStarted	: BOOL;	// one scan, logged
	MainPowerRampEvent		: FB_EventLog;
	// #24 step 7 PR 8 (plan D8, specs/design/monetcommon-safe-states.md row "Focus error"): only the focus is faulty, the axes are
	// healthy. On the edge of the emergency park (#86), if the axes can drive (F_ParkAxesCanMove, oil pressure there), the park drives
	// to the park position instead of parking in place: an enabled axis that moves gets the controlled stop first (bStop, #96, the
	// park is queued behind it, bParkAfterStop), and the error branch leaves the axes enabled until the park has disabled them itself
	// (bFocusErrorPark). Any other error, an E-stop or a safety error ends it and the park parks in place.
	bFocusErrorOnly			: BOOL;	// the focus error is the only error in this scan (no axis/hydraulics/software error, no power failure, no E-stop/safety error)
	bFocusErrorPark			: BOOL;	// the emergency park of a focus error drives to the park position, the error branch does not disable the axes
	bFocusErrorParkStarted	: BOOL;	// one scan, logged
	FocusErrorParkEvent		: FB_EventLog;
	// #24 step 7 PR 6 (plan D8, specs/design/monetcommon-safe-states.md rows "E-stop" and "Safety error"): an E-stop or a safety
	// error (bSafetyStop) cuts the drives (STO), so the brake lock is the stop. On its rising edge the hydraulics go off at once
	// (the hydraulic brake locks), every move ends (flags dropped, stage machines reset, no MC_Stop: the axes are disabled) and,
	// if the telescope is not parked, a park in place is held (bSafetyParkPending) until both are gone; then it runs like the
	// emergency park (bSafetyPark: past the ready gate, in place because the axes are disabled) and closes the covers.
	// The covers are not on the E-stop circuit (they keep their supply, owner): "E-stop means stop", so on the edge and in every scan
	// while bSafetyStop the covers get Stop() and no stage commands Open()/Close() (the power-on and the park wait in their stage); they
	// close only after the release, by the held park.
	bSafetyStop				: BOOL;	// bEstopTriggered OR bSafetyError in this scan
	bSafetyStopLast			: BOOL;	// its value of the last automatic scan (edge memory)
	bSafetyParkPending		: BOOL;	// the park in place of a safety stop, held until the E-stop and the safety error are gone
	bSafetyPark				: BOOL;	// that park runs (from Park() until bPark falls)
	bSafetyParkStarted		: BOOL;	// one scan, logged
	SafetyParkEvent			: FB_EventLog;
	// #151: the brake may stay open with the elevation disabled for the Wake&Shake (F_WakeShakeWindow)
	bWakeShakeWindow		: BOOL;
	bWakeShakeWindowLast	: BOOL;
	bWakeShakePowerLast		: BOOL;
	tonWakeShakeWindow		: FB_TimeoutTimer;
	sWakeShakeEnd			: STRING(24);
	bWakeShakeOpened		: BOOL;	// one scan, logged
	bWakeShakeClosed		: BOOL;	// one scan, logged
	WakeShakeOpenEvent		: FB_EventLog;
	WakeShakeCloseEvent		: FB_EventLog;
	sWakeShakeCloseMessage	: STRING(80);
	// #155: the elevation error closes the brake once; the operator may open it again in the window
	rtrigElevationError		: R_TRIG;
	// #155: a block (E-stop, hydraulics error, safety error, covers not open) closed an open brake in the window
	bWakeShakeBrakeBlocked	: BOOL;	// logged on its rising edge
	sWakeShakeBlockMessage	: STRING(80);
	WakeShakeBlockEvent		: FB_EventLog;
	// #72: manual mode since the last completed startup. Set on the first manual scan, cleared only by a completed
	// startup (not by reset, stop, park, E-stop or an aborted startup). While set, moves are rejected (init_required).
	bInitRequired			: BOOL;
	bInitRequiredLog		: BOOL;	// logged once, on the first scan back in automatic
	sInitRequiredMessage	: STRING(80);
	nInitRequiredLevel		: UDINT;
	InitRequiredEvent		: FB_EventLog;
END_VAR
VAR CONSTANT
	tWakeShakeWindow	: TIME := T#15M;	// #151: longest time the brake stays open for the Wake&Shake
END_VAR
VAR PERSISTENT
	nInterruptedAutoClearCount	: UDINT;	// how many times auto-clear has fired, ever
	nStopForcedCount			: UDINT;	// #96: stops that settled on the timeout without StopDone from every axis, should stay 0
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// #24 step 5 (aim 3): the command inputs are read-only here and edge-triggered. The rising edge of bStop, bPark, bReset or
// bPower is the method call (Stop(), Park(), Reset(), Init()), made here at the start of the scan, where a direct write used
// to act; the moves (bGoHome, bGoto, bSlew, bTrack) are decided by the gate after the error computation below. A held input
// starts its command once; the input falling does nothing (it used to stop a track or drop a request only because this block
// also wrote it). A method call of the same command since the last scan already counts (b*Checked), so it is one command.
// Order: stop and park before power, so that Init() refuses a power-on sent together with them (#87).
IF bStop AND NOT bStopChecked THEN
	Stop();
END_IF
IF bPark AND NOT bParkChecked THEN
	Park();
END_IF
IF bReset AND NOT bResetChecked THEN
	Reset();
END_IF
IF bPower AND NOT bPowerChecked THEN
	Init();
END_IF

// Startup events are reset once per scan. Internal bReady still drives mechanical sequencing.
// A repeated request to an already online telescope is dropped, it must not restart calibration.
bPowerActive := fbStartup.BeginScan(Power := bPowerActive, Ready := bReady);
bSuspendStop := FALSE;	// #118: back in automatic the body owns a running stop again (it continues the same transaction)
// revert fDut1 (set via the Dut1 property, e.g. from an external time bridge over MQTT) to its
// safe 0.0 default if nothing fresh arrives for a while, instead of serving an arbitrarily
// stale UT1-UTC correction forever. FB_AltAzTelescopeControl's own body is never called (this FB
// doesn't call SUPER^() in its main body), so this has to live here rather than up there.
tonDut1Stale(IN := NOT bDut1Received, PT := T#10M);
bDut1Received := FALSE;
IF tonDut1Stale.Q THEN
	fDut1 := 0.0;
END_IF

// get the system time; fJd only follows the clock while the clock is valid (synced, see FB_AstroClock)
fbTime();
IF fbTime.bValid THEN
	fJd := DateTime2JD(fbTime.time_RTCEX2);
END_IF
fLst := CT2LST(telescopeConfig.longitude, fJd);

// without a trustworthy time nothing may be pointed or tracked: refuse through the normal stop path
IF NOT fbTime.bValid AND (bGotoActive OR bSlewActive OR bTrackActive) THEN
	bStopActive := TRUE;
END_IF

// #24 step 2c: the motion limits of this scan (stMotion, deprecated aliases, F_MotionConfigValid), before anything uses them
_MotionConfig();

_ReadAxes();
// #96: axis state for the stop transaction (the state of the last axis cycle, like bStopped below)
_StopTxInputs();

_HandleReset();

// #34: refuse a home/park position the horizon guard below would keep re-homing to. Checked every
// scan, so a reset does not clear it until the configuration is fixed.
bHomeBelowHorizon := BROTLib.F_HomeBelowHorizon(fElevationHome := telescopeConfig.elevationHome,
	fElevationPark := telescopeConfig.elevationPark, fHorizon := fHorizon, fMargin := stMotionUsed.fHorizonMargin);
IF bHomeBelowHorizon THEN
	bSoftwareError := TRUE;
	nSoftwareErrorID := 16#31;
END_IF
// #24 step 2c: an invalid stMotion is refused like 16#31: checked every scan, a reset does not clear it until the
// configuration is fixed. _MotionConfig keeps the defaults in use meanwhile.
IF bMotionConfigInvalid THEN
	bSoftwareError := TRUE;
	nSoftwareErrorID := 16#32;
END_IF

// get error ID, reset if bReset command is set
IF fbAzimuth.Error THEN
	nErrorID := fbAzimuth.nErrorID;
	IF bResetActive THEN
		fbAzimuth.Reset();
	END_IF
ELSIF fbElevation.bError THEN
	nErrorID := fbElevation.nErrorID;
	IF bResetActive THEN
		fbElevation.Reset();
	END_IF
ELSIF fbDerotator.bError THEN
	nErrorID := fbDerotator.nErrorID;
	IF bResetActive THEN
		fbDerotator.Reset();
	END_IF	
ELSIF fbFocus.Error THEN
	nErrorID := fbFocus.ErrorID;
	IF bResetActive THEN
		fbFocus.Reset();
	END_IF
ELSIF bSoftwareError THEN
	nErrorID := nSoftwareErrorID;
END_IF

// fSlewTime
fSlewTime :=  MAX(MAX(fbElevation.fSlewTime, fbAzimuth.fSlewTime), fbDerotator.fSlewTime);

// #24 step 7 PR 3 (D8): the hydraulics error is a hardware error of the telescope (until 0.13.0 only the brake rule read it)
bHydraulicsError := fbHydraulics.Error;
// #24 step 7 PR 7 (D8): so is a power failure (NOT bMainReady, the phase monitor; until 0.13.0 it only gated online)
bMainPowerLost := NOT bMainReady;
bHwError := fbElevation.Error OR
		 fbAzimuth.bError OR
		 fbFocus.Error OR
		 fbDerotator.bError OR
		 bHydraulicsError OR
		 bMainPowerLost;
bError := bHwError OR bSoftwareError;

// #24 step 7 PR 3 (D8): ramp first on a hydraulics error while the drives can still ramp. The brake is hydraulic: once it is
// not open or the oil pressure is gone the lock is the stop. Any other error, E-stop or safety error keeps its own reaction
// (the error branch disables at once). The ramp is the normal stop (bStop, stop transaction #96, the focus stops with it); the
// emergency park below is then queued behind it (Park() during bStop = bParkAfterStop) and parks in place after the stop has
// settled. It ends when the stop has been released (settled), when the drives cannot ramp any more, when the hydraulics error
// is gone (reset) or on the stop timeout (the stop transaction keeps the stop, #96 D1; here the lock takes over).
bHydraulicsCanRamp := fbBrake.BrakeOpen AND fbHydraulics.OilPressureOK AND NOT bEstopTriggered AND NOT bSafetyError AND
	NOT (fbElevation.Error OR fbAzimuth.bError OR fbFocus.Error OR fbDerotator.bError OR bSoftwareError);
IF bHydraulicsRamp AND (NOT bHydraulicsError OR NOT bHydraulicsCanRamp OR NOT bStopActive OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bHydraulicsRamp := FALSE;
END_IF
// on the rising edge only, and only if an enabled axis moves (also homing or tracking); at standstill the disable is the stop
IF bHydraulicsError AND NOT bHydraulicsErrorLast AND bHydraulicsCanRamp AND
		((fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
		 (fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
		 (fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking))) THEN
	bHydraulicsRamp := TRUE;
	bHydraulicsRampStarted := TRUE;
	bStopActive := TRUE;
END_IF
bHydraulicsErrorLast := bHydraulicsError;
// #24 step 7 PR 7 (D8): the same ramp on a power failure. Whether the drives still have their supply on a phase loss is not known
// here [unverified, on site]: they are taken as able to ramp while bHydraulicsCanRamp holds (brake open with oil pressure, no axis
// reports an error, no E-stop/safety error). A drive without supply raises an axis error and a pump without supply loses the
// pressure; either ends the ramp and the lock is the stop. Same end conditions as above; the supply coming back ends it too (then
// bError has dropped and the stop goes on as a normal stop, the queued park drives to the park position if the axes can move).
IF bMainPowerRamp AND (NOT bMainPowerLost OR NOT bHydraulicsCanRamp OR NOT bStopActive OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bMainPowerRamp := FALSE;
END_IF
IF bMainPowerLost AND NOT bMainPowerLostLast AND bHydraulicsCanRamp AND
		((fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
		 (fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
		 (fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking))) THEN
	bMainPowerRamp := TRUE;
	bMainPowerRampStarted := TRUE;
	bStopActive := TRUE;
END_IF
bMainPowerLostLast := bMainPowerLost;

// #24 step 7 PR 5 (D8): a state-machine timeout (raised by the stage method of the last scan, so the axes may still move) ramps
// and parks instead of the disable of the error branch. On its rising edge, unless parked or a hardware error, E-stop or safety
// error is active (those keep their own reaction): bStop if an enabled axis moves (also homing or tracking), and Park(), which is
// queued behind that stop (bParkAfterStop) or runs at once. While bTimeoutPark the error branch leaves the axes enabled and the
// park's prepare stage drives to the park position if the axes can move; its secure stage closes the brake and the covers and
// switches the hydraulics off. It ends when parked, when the timeout error is reset, when the drives cannot move any more, when no
// stop or park is pending (a stop cancels the park) or on the stop timeout; a park that is still driving with the error then
// restarts in its prepare stage, i.e. in place (the error branch disables the axes from this scan on).
bTimeoutError := bSoftwareError AND (nSoftwareErrorID = 16#10 OR nSoftwareErrorID = 16#30 OR nSoftwareErrorID = 16#40);
bTimeoutCanMove := NOT bHwError AND NOT bEstopTriggered AND NOT bSafetyError;
IF bTimeoutPark AND (NOT bTimeoutError OR NOT bTimeoutCanMove OR bIsParked OR NOT (bStopActive OR bParkActive OR bParkAfterStop) OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bTimeoutPark := FALSE;
	IF bError AND (eParkStage = E_ParkStage.untrack OR eParkStage = E_ParkStage.start_move OR
			eParkStage = E_ParkStage.wait_moves) THEN
		eParkStage := E_ParkStage.prepare;
	END_IF
END_IF
IF bTimeoutError AND NOT bTimeoutErrorLast AND bTimeoutCanMove AND NOT bIsParked THEN
	bTimeoutPark := TRUE;
	bTimeoutParkStarted := TRUE;
	IF (fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
			(fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
			(fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking)) THEN
		bStopActive := TRUE;
	END_IF
	Park();	// after bStop: during the stop the park is queued (bParkAfterStop)
END_IF
bTimeoutErrorLast := bTimeoutError;

// #24 step 7 PR 8 (D8, row focus error): a focus error alone leaves the axes controllable. Ramp first, then the emergency park
// drives to the park position. Decided before the error branch below, which would otherwise disable the axes in this scan.
bFocusErrorOnly := fbFocus.Error AND NOT bEstopTriggered AND NOT bSafetyError AND
	NOT (fbElevation.Error OR fbAzimuth.bError OR fbDerotator.bError OR bHydraulicsError OR bMainPowerLost OR bSoftwareError);
// it ends when the focus error is no longer the only error (another error, also a power failure, E-stop, safety error, or the
// focus error is gone), when the park is over (bIsParked) or not requested any more (a stop dropped it), or on the timeout of its ramp (the lock takes over)
IF bFocusErrorPark AND (NOT bFocusErrorOnly OR bIsParked OR NOT (bParkActive OR bParkAfterStop OR bStopActive) OR
		(tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop)) THEN
	bFocusErrorPark := FALSE;
	// with bError still there and the park on its way to the park position: start it again from its first stage, which parks in
	// place now (no new bError edge resets its stage, and the disabled axes would never report Busy in start_move)
	IF bError AND (eParkStage = E_ParkStage.untrack OR eParkStage = E_ParkStage.start_move OR eParkStage = E_ParkStage.wait_moves) THEN
		eParkStage := E_ParkStage.prepare;
	END_IF
END_IF
// on the edge that starts the emergency park below (F_ErrorParkRequest: bHwError edge, not parked, no E-stop; the #113 exemption
// needs an Az/El error, so it cannot apply here), only if the axes can drive (calibrated, enabled, brake open, oil pressure there)
IF bHwError AND NOT bHwErrorLast AND bFocusErrorOnly AND NOT bIsParked AND fbHydraulics.OilPressureOK AND
		F_ParkAxesCanMove(
			bElCalibrated := fbElevation.Calibrated, bAzCalibrated := fbAzimuth.Calibrated, bDrCalibrated := fbDerotator.Calibrated,
			bElEnabled := fbElevation.bEnable, bAzEnabled := fbAzimuth.bEnable, bDrEnabled := fbDerotator.bEnable,
			bBrakeOpen := fbBrake.BrakeOpen) THEN
	bFocusErrorPark := TRUE;
	bFocusErrorParkStarted := TRUE;
	// an enabled axis moves (also homing or tracking): the controlled stop first; at standstill the park drives at once
	IF (fbStopTx.abEnabled[1] AND (fbStopTx.abMoving[1] OR aAxis[1].bTracking)) OR
			(fbStopTx.abEnabled[2] AND (fbStopTx.abMoving[2] OR aAxis[2].bTracking)) OR
			(fbStopTx.abEnabled[3] AND (fbStopTx.abMoving[3] OR aAxis[3].bTracking)) THEN
		bStopActive := TRUE;
	END_IF
END_IF

// #24 step 7 PR 1 (D9): the roof close request, from the serious classes only (not bError: the focus error and the software
// errors are recoverable; not bPowerFailure, a power-on failure; power failure is NOT bMainReady, the phase monitor). Latched
// on the rising edge, so a cause that is gone again (a short E-stop, a phase dip) still requests the close; bReset (held while
// bError, so one reset that clears an axis error also clears the request in the next scan) clears it only while no cause is
// active. Here and not later: nothing in the body returns early, so it is evaluated in every automatic scan, also in the
// error branch below and in E-stop. A signal only: nothing in this block reads it.
bCloseRoofCause := fbElevation.Error OR fbAzimuth.bError OR fbDerotator.bError OR
		fbHydraulics.Error OR bEstopTriggered OR bSafetyError OR NOT bMainReady;
IF bResetActive AND NOT bCloseRoofCause THEN
	bCloseRoofRequest := FALSE;
END_IF
IF bCloseRoofCause AND NOT bCloseRoofCauseLast THEN
	bCloseRoofRequest := TRUE;
END_IF
bCloseRoofCauseLast := bCloseRoofCause;

// #83, #24 step 5: the move inputs (ADS write, Visu) are commands on their rising edge, decided like the method calls (the
// target is what the target inputs hold: fRightAscension/fDeclination for goto and track, fAzimuth/fElevation for slew).
// Accepted, the edge sets the request latch; rejected, it is logged and nothing is set. Like a method call, an edge while the
// same command runs is a new command (replace, latest wins). The input is never written; a held input is not a new edge.
// Nested IFs on purpose: ST does not short-circuit AND and _AcceptMove must only run on the edge.
IF bGoHome AND NOT bGoHomeChecked THEN
	IF _AcceptMove(E_TCSCommand.gohome, E_TCSCommand.no_command) THEN
		bGoHomeActive := TRUE;
	END_IF
END_IF
IF bGoto AND NOT bGotoChecked THEN
	IF _AcceptMove(E_TCSCommand.goto, E_TCSCommand.no_command) THEN
		_ClearOffsets();	// #177
		bGotoActive := TRUE;
	END_IF
END_IF
IF bSlew AND NOT bSlewChecked THEN
	IF _AcceptMove(E_TCSCommand.slew, E_TCSCommand.no_command) THEN
		_ClearOffsets();	// #177
		bSlewActive := TRUE;
	END_IF
END_IF
IF bTrack AND NOT bTrackChecked THEN
	IF _AcceptMove(E_TCSCommand.track, E_TCSCommand.no_command) THEN
		_ClearOffsets();	// #177
		bTrackActive := TRUE;
	END_IF
END_IF

IF bError THEN
	bTrackActive := 	FALSE;
	bGotoActive := 	FALSE;
	bSlewActive := 	FALSE;
	bGoHomeActive := 	FALSE;	// #85 (the horizon guard below sets it again if still needed)
	bMoveAbortPending := FALSE;	// #84: the drives are disabled below, nothing to wait for
	bSupersedeRequest := FALSE;	// #83
	// #24 step 7 PR 3 (D8): not during the ramp of a hydraulics error (bHydraulicsRamp is only TRUE while the hydraulics error is
	// the only error); the axes are disabled from the first scan after its stop has settled. #24 step 7 PR 5: nor during the ramp and
	// park of a timeout (bTimeoutPark, only without a hardware error, E-stop or safety error). PR 7: nor during the ramp of a power failure.
	// PR 8: nor during the ramp and the drive of the focus-error park (bFocusErrorPark, only while the focus error is the only error);
	// its park disables them
	IF NOT bHydraulicsRamp AND NOT bTimeoutPark AND NOT bMainPowerRamp AND NOT bFocusErrorPark THEN
		fbElevation.Enable := FALSE;
		fbAzimuth.Enable := FALSE;
		fbDerotator.Enable := FALSE;
	END_IF
ELSE
	nErrorID := 0;
END_IF

// #155: the brake is closed once when the elevation error appears, not in every scan: a level close would undo the
// opening from the Visu in the Wake&Shake window (F_BrakeMustClose keeps the brake closed outside the window).
rtrigElevationError(CLK := fbElevation.bError);
IF fbElevation.bError THEN
	fbElevation.Enable := FALSE;
	fbAzimuth.Enable := FALSE;
	fbDerotator.Enable := FALSE;
	IF rtrigElevationError.Q THEN
		fbBrake.CloseBrake();
	END_IF
END_IF

// #24 step 4b: the target of this scan (refraction weather, eq2hor, pointing model, derotator, velocities, turn inside
// the axis limits) and the reported position (inverse pointing model, both hor2eq); after the error reaction, before the
// horizon guard and the arbitration below (SM plan D3 hook)
_ComputeTargets();
	
// If the Telescope dips under the fHorizon (e.g. while tracking, stop and gohome)
IF fbElevation.Calibrated AND fElevationCurrent < (fHorizon + stMotionUsed.fHorizonMargin) THEN
	IF NOT bStopped AND NOT bGoHomeActive THEN
		bStopActive := TRUE;
	ELSIF NOT bHomeBelowHorizon AND NOT bInitRequired THEN	// #72: no automatic motion before the Init that follows manual mode
		bGoHomeActive := TRUE;
	END_IF
END_IF
		
tpPowerOnWarning(IN := bPowerActive OR (NOT fbElevation.bEnable AND fbBrake.BrakeOpen), PT := T#250MS);

tonPowerTimeout(IN := TCS_command = E_TCSCommand.no_command AND NOT bIsParked, PT := stMotionUsed.tIdleParkTimeout, nDivisor := nTimeDivisor);
tonCommandTimeout();

// #17: state-machine timeouts, checked in _GotoTelescope/_HomeTelescope/_SlewTelescope (which raise the error and
// clear the flag, so the timer resets on the next scan)
tonGotoTimeout(IN := bGotoActive, PT := stMotionUsed.tStateMachineTimeout, nDivisor := nTimeDivisor);
tonHomeTimeout(IN := bGoHomeActive, PT := stMotionUsed.tStateMachineTimeout, nDivisor := nTimeDivisor);
tonSlewTimeout(IN := bSlewActive, PT := stMotionUsed.tStateMachineTimeout, nDivisor := nTimeDivisor);
IF tonPowerTimeout.Q AND NOT bIsParked THEN
	bParkActive := TRUE;
END_IF
		
// #26: safety net only. bInterrupted is now a one-shot (cleared in the arbitration below right after the
// interrupted state machines are called), so it should never stay latched and this should never fire: the
// counter staying at 0 on site confirms that. Before, it could latch (ADR 0001, IAG design doc
// monets-telescopecontrol-command-arbitration.md), and this auto-clear after 5 s of true idle was the fix.
bInterruptedIdle := bInterrupted AND NOT bError AND
	NOT (bPowerActive OR bParkActive OR bGoHomeActive OR bGotoActive OR bSlewActive OR bTrackActive);
tonInterruptedAutoClear(IN := bInterruptedIdle, PT := T#5S);
IF tonInterruptedAutoClear.Q THEN
	bInterrupted := FALSE;
	nInterruptedAutoClearCount := nInterruptedAutoClearCount + 1;
END_IF
InterruptedAutoClearEvent(
	Trigger 		:= tonInterruptedAutoClear.Q,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'bInterrupted auto-cleared after idle timeout (count: %s)',
	OnMessage 		:= UDINT_TO_STRING(nInterruptedAutoClearCount),
	Comm 			:= fbComm);

// #83: the latest move wins. Drop the other move flags, reset their stage machines and stop the axes (#84 path).
// The kept command is already accepted and its target written; it starts once the axes are at standstill.
IF bSupersedeRequest THEN
	IF eSupersedeKeep <> E_TCSCommand.gohome THEN
		bGoHomeActive := FALSE;
	END_IF
	IF eSupersedeKeep <> E_TCSCommand.goto THEN
		bGotoActive := FALSE;
	END_IF
	IF eSupersedeKeep <> E_TCSCommand.slew THEN
		bSlewActive := FALSE;
	END_IF
	IF eSupersedeKeep <> E_TCSCommand.track THEN
		bTrackActive := FALSE;
	END_IF
	bInterrupted := TRUE;
	_HomeTelescope();
	_GotoTelescope();
	_SlewTelescope();
	bInterrupted := FALSE;	// #26: one-shot, the interrupted state machines have reset their stage
	// #56: the replacement gets its own 600 s, the timer must not go on counting from the first request
	CASE eSupersedeKeep OF
		E_TCSCommand.gohome:	tonHomeTimeout(IN := FALSE);
		E_TCSCommand.goto:		tonGotoTimeout(IN := FALSE);
		E_TCSCommand.slew:		tonSlewTimeout(IN := FALSE);
	END_CASE
	IF NOT bError THEN
		bMoveAbortPending := TRUE;
	END_IF
	bSupersedeRequest := FALSE;
END_IF

// #86: a new axis/focus error while not parked starts the emergency park by itself (after the supersede block and
// the horizon guard, before the arbitration, so the stop branch cannot clear the request in the same scan). #24 step 7 PR 3: a
// hydraulics error too; during its ramp (bStop set above) Park() queues the park behind the stop (bParkAfterStop).
bErrorParkStarted := BROTLib.F_ErrorParkRequest(bHwError := bHwError, bHwErrorLast := bHwErrorLast,
	bIsParked := bIsParked, bEstop := bEstopTriggered);
bErrorParkExempt := bErrorParkStarted AND F_WakeShakeErrorExempt(bFirstPowerOnPending := bFirstPowerOnPending,
	bPowering := bPowerActive OR fbStartup.Initializing, bAzElError := fbAzimuth.bError OR fbElevation.Error,
	bOtherHwError := fbFocus.Error OR fbDerotator.bError OR bHydraulicsError OR bMainPowerLost);	// #24 step 7 PR 3/PR 7: a hydraulics error or a power failure is never the Wake&Shake fault
bErrorParkStarted := bErrorParkStarted AND NOT bErrorParkExempt;
bHwErrorLast := bHwError;
IF bErrorParkStarted THEN
	Park();	// same routing as an external park: deferred to standstill during a stop (#83/#87)
END_IF
// #24 step 7 PR 4 (row cover error): a new cover error while not parked starts a normal park, not the emergency park: the cover
// error is not bError, so the park branch below stops a running move first (#84) and the park drives to the park position if the
// axes can move (ramp, then drive to park). Same edge and exemptions as #86 (F_ErrorParkRequest: not parked, not in E-stop).
bCoverErrorParkStarted := BROTLib.F_ErrorParkRequest(bHwError := fbCovers.Error, bHwErrorLast := bCoverErrorLast,
	bIsParked := bIsParked, bEstop := bEstopTriggered);
bCoverErrorLast := fbCovers.Error;
IF bCoverErrorParkStarted THEN
	Park();
END_IF

// #24 step 7 PR 6 (D8, rows E-stop / safety error): the E-stop or a safety error cuts the drives (STO), the brake lock is the
// stop (no ramp, no MC_Stop; the axes are disabled at the end of the body). On the rising edge: hydraulics off at once (the
// hydraulic brake locks, D4), every move ends (as the park branch interrupts them, #26 one-shot) and, unless the telescope is
// parked, the park in place is held until the E-stop and the safety error are both gone: the covers close only after the release.
// The covers are not on the E-stop circuit (owner): a cover run (power-on opening, park closing, pendant) would go on, so they get
// Stop() here and in every scan while bSafetyStop (end of the body, after the stages), and no stage commands them meanwhile
// (_PowerOn, _ParkTelescope check bSafetyStop). The #86 park on an axis error stays
// exempt during the E-stop (F_ErrorParkRequest unchanged); this park comes after the release instead. Not for a safety error
// alone in the Wake&Shake window: the window survives it so that the operator can go on (#155); an E-stop ends the window.
// After the #86 block for the same reason (the stop branch cannot clear the park in the scan of the release).
bSafetyStop := bEstopTriggered OR bSafetyError;
IF bSafetyStop AND NOT bSafetyStopLast THEN
	fbHydraulics.Enable := FALSE;
	fbCovers.Stop();	// "E-stop means stop": a running open/close ends where it is (held at the end of the body)
	bGoHomeActive := FALSE;
	bGotoActive := FALSE;
	bSlewActive := FALSE;
	bTrackActive := FALSE;
	bInterrupted := TRUE;
	_HomeTelescope();
	_GotoTelescope();
	_SlewTelescope();
	bInterrupted := FALSE;	// #26: one-shot
	bMoveAbortPending := FALSE;	// #84: the drives are cut, nothing to wait for
	bSupersedeRequest := FALSE;	// #83
	IF NOT bIsParked AND NOT (bWakeShakeWindow AND NOT bEstopTriggered) THEN
		bSafetyParkPending := TRUE;
	END_IF
END_IF
bSafetyStopLast := bSafetyStop;
bSafetyPark := bSafetyPark AND (bParkActive OR bParkAfterStop);	// ends with its park (parked, or cleared by a stop/reset)
IF bSafetyParkPending AND NOT bSafetyStop THEN
	bSafetyParkPending := FALSE;
	IF NOT bIsParked THEN
		bSafetyPark := TRUE;
		bSafetyParkStarted := TRUE;
		Park();
	END_IF
END_IF

// set TCS_command according to state variables ordered by precedence (#25 step 5.2: BROTLib.FB_CommandArbiter decides, the
// block applies what it asks for). Order: stop (also a running power-on) > park aborts a running power-on (#87) > power-on >
// a running abort stop (#84) > park > gohome > goto > slew > track > idle.
// A command that waits (not ready, busy, behind an abort stop) leaves TCS_command as it was in the last scan; only a scan
// without any request goes idle, as before the arbiter. The arbiter says "no command" in both cases, so the idle case is
// derived here from the same inputs.
fbArbiter.bStop := bStopActive;
fbArbiter.bPower := bPowerActive;
fbArbiter.bInitializing := fbStartup.Initializing;
fbArbiter.bPark := bParkActive;
fbArbiter.bGoHome := bGoHomeActive;
fbArbiter.bGoto := bGotoActive;
fbArbiter.bSlew := bSlewActive;
fbArbiter.bTrack := bTrackActive;
fbArbiter.bError := bError;
fbArbiter.bEmergencyPark := bSafetyPark;
fbArbiter.bReady := bReady;
fbArbiter.bBusy := bBusy;
fbArbiter.bStopped := bStopped;
fbArbiter.bMoveAbortPending := bMoveAbortPending;
fbArbiter.bParkWinsOverPowerOn := TRUE;	// #87
bRequestIdle := NOT (bStopActive OR bPowerActive OR bParkActive OR bGoHomeActive OR bGotoActive OR bSlewActive OR bTrackActive
	OR (bMoveAbortPending AND NOT bError));
fbArbiter();

// #80: a stop always aborts a startup, also when bPower is already FALSE; the park that aborts a power-on does too (#87).
// The flag it looks at is the one of the scan, before the clears below.
IF fbArbiter.bAbortStartup THEN
	fbStartup.MarkAbortedIfStarting(Power := bPowerActive);
END_IF
IF fbArbiter.bClearPower THEN
	bPowerActive := FALSE;
END_IF
IF fbArbiter.bClearTrack THEN
	bTrackActive := FALSE;
END_IF
IF fbArbiter.bClearPark THEN
	bParkActive := FALSE;
END_IF
IF fbArbiter.bClearGoto THEN
	bGotoActive := FALSE;
END_IF
IF fbArbiter.bClearSlew THEN
	bSlewActive := FALSE;
END_IF
IF fbArbiter.bClearGoHome THEN
	bGoHomeActive := FALSE;
END_IF
// #26: the interrupted state machines reset their stage in one call with bInterrupted TRUE; bInterrupted is a one-shot
IF fbArbiter.bInterruptPower OR fbArbiter.bInterruptPark OR fbArbiter.bInterruptGoto OR fbArbiter.bInterruptSlew
		OR fbArbiter.bInterruptGoHome THEN
	bInterrupted := TRUE;
	IF fbArbiter.bInterruptPower THEN
		_PowerOn();		// abort path: bPower FALSE, MarkAborted, stage 0, Move/HomeAxis FALSE
	END_IF
	IF fbArbiter.bInterruptPark THEN
		_ParkTelescope();
	END_IF
	IF fbArbiter.bInterruptGoto THEN
		_GotoTelescope();
	END_IF
	IF fbArbiter.bInterruptSlew THEN
		_SlewTelescope();
	END_IF
	IF fbArbiter.bInterruptGoHome THEN
		_HomeTelescope();
	END_IF
	bInterrupted := FALSE;
END_IF
IF fbArbiter.bSetMoveAbortPending THEN
	bMoveAbortPending := TRUE;	// #84
END_IF
IF fbArbiter.bPowerAbortedByPark THEN
	bPowerAbortedByPark := TRUE;	// #87, logged below
END_IF

IF fbArbiter.eCommand <> E_TCSCommand.no_command THEN
	TCS_command := fbArbiter.eCommand;
ELSIF bRequestIdle THEN
	TCS_command := E_TCSCommand.no_command;
	fbElevation.MoveAxis := FALSE;
	fbAzimuth.MoveAxis := FALSE;
	fbDerotator.MoveAxis := FALSE;
	fbElevation.Tracking := FALSE;
	fbAzimuth.Tracking := FALSE;
	fbDerotator.Tracking := FALSE;
END_IF

// #56: each command counts its timeout from its own dispatch. A preemption never has a scan without command, so
// the timer used to go on from the previous command (a stop after a long track timed out in its first scan).
IF TCS_command <> eTimeoutCommand THEN
	tonCommandTimeout(IN := FALSE);
	eTimeoutCommand := TCS_command;
END_IF

IF TCS_command = E_TCSCommand.poweron THEN
	_PowerOn();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.poweron, PT := stMotionUsed.tPowerOnTimeout, nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'POWER';
ELSIF TCS_command = E_TCSCommand.stop THEN
	_StopTelescope();
	TCSCTOEvent.OnMessage := 'STOP';
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.stop, PT := stMotionUsed.tStopTimeout, nDivisor := nTimeDivisor);	// #84: provisional, measure on site
ELSIF TCS_command = E_TCSCommand.park THEN
	_ParkTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.park, PT := stMotionUsed.tCommandTimeout, nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'PARK';
ELSIF TCS_command = E_TCSCommand.gohome THEN
	_HomeTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.gohome, PT := stMotionUsed.tCommandTimeout, nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'GOHOME';
ELSIF TCS_command = E_TCSCommand.goto THEN
	_GotoTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.goto, PT := stMotionUsed.tCommandTimeout, nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'GOTO';
ELSIF TCS_command = E_TCSCommand.slew THEN
	_SlewTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.slew, PT := stMotionUsed.tCommandTimeout, nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'SLEW';
ELSIF TCS_command = E_TCSCommand.track THEN
	_TrackTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.track, PT := stMotionUsed.tTrackTimeout, nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'TRACK';
ELSE
	// disable command timeout
	tonCommandTimeout(IN := FALSE);
	TCSCTOEvent.OnMessage := 'NOCOMMAND';
END_IF
IF TCS_command <> E_TCSCommand.stop THEN
	// #96: the transaction ends with the stop command (settled, or another command took over); the next stop begins a new one
	fbStopTx.Cancel();
	bStopTxBegun := FALSE;
END_IF

// #121: the shared Az/El brake is closed whenever the elevation is disabled. HalfBROT closes it only on the falling
// edge of the elevation enable and bOpenBrake of the hydraulics is a latch, so a brake that opened later stayed open.
// After the dispatch, so the power-on that enables the axes in this scan is not seen as disabled.
// #151: except in the Wake&Shake window. The exemption of #113 is true for one scan, so the window is latched here.
tonWakeShakeWindow(IN := bWakeShakeWindow, PT := tWakeShakeWindow, nDivisor := nTimeDivisor);
bWakeShakeWindow := F_WakeShakeWindow(bWindow := bWakeShakeWindow, bSet := bErrorParkExempt,
	bTimeout := tonWakeShakeWindow.Q, bParkActive := bParkActive OR bIsParked, bCoversOpen := fbCovers.Opened,
	bPowerOnStart := bPowerActive AND NOT bWakeShakePowerLast, bEstop := bEstopTriggered,
	bOtherHwError := fbFocus.Error OR fbDerotator.bError, sEndReason => sWakeShakeEnd);
bWakeShakePowerLast := bPowerActive;
bWakeShakeOpened := bWakeShakeWindow AND NOT bWakeShakeWindowLast;
bWakeShakeClosed := bWakeShakeWindowLast AND NOT bWakeShakeWindow;
bWakeShakeWindowLast := bWakeShakeWindow;
// #155: in the window the brake still closes while E-stop, a hydraulics error, a safety error or closed covers hold.
IF F_BrakeMustClose(bElevationEnabled := fbElevation.bEnable, bWakeShakeWindow := bWakeShakeWindow,
		bEstop := bEstopTriggered, bHydraulicsError := fbHydraulics.Error, bSafetyError := bSafetyError,
		bCoversOpen := fbCovers.Opened) THEN
	bWakeShakeBrakeBlocked := bWakeShakeWindow AND fbBrake.BrakeOpen;
	IF bWakeShakeBrakeBlocked THEN
		IF bEstopTriggered THEN
			sWakeShakeBlockMessage := 'brake closed in the Wake&Shake window: E-stop';
		ELSIF fbHydraulics.Error THEN
			sWakeShakeBlockMessage := 'brake closed in the Wake&Shake window: hydraulics error';
		ELSIF bSafetyError THEN
			sWakeShakeBlockMessage := 'brake closed in the Wake&Shake window: safety error';
		ELSE
			sWakeShakeBlockMessage := 'brake closed in the Wake&Shake window: covers not open';
		END_IF
	END_IF
	fbBrake.CloseBrake();
ELSE
	bWakeShakeBrakeBlocked := FALSE;
END_IF
 
bSlewing := NOT bTracking AND (aAxis[2].bInMotion OR aAxis[2].bInRamp OR
			aAxis[1].bInMotion OR aAxis[1].bInRamp OR
			aAxis[3].bInMotion OR aAxis[3].bInRamp);

// signal must be stable for 5500MS
tonTrackingDelay(in := aAxis[2].bTracking AND
			aAxis[1].bTracking AND
			aAxis[3].bTracking,PT :=T#5500MS, Q => bTracking);
			
_StopTxMonitor();
			
bHomed := fbElevation.Calibrated AND
			fbAzimuth.Calibrated AND
			fbFocus.Calibrated AND
			fbDerotator.Calibrated;
			
bReady := bHomed AND 
	fbCovers.Opened AND 
	fbElevation.bEnable AND
	fbAzimuth.bEnable AND
	fbDerotator.bEnable AND fbBrake.BrakeOpen AND 
    NOT bError;

bBusy := aAxis[2].bBusy OR
		aAxis[1].bBusy OR
		aAxis[3].bBusy OR
		fbFocus.Busy;

(* STATUS STATES*)
// Public completion is latched only by the final startup stage, never by mechanical bReady alone.
fReadyState := fbStartup.Update(
    Error := bError OR bSoftwareError OR bPowerFailure OR bEstopTriggered,
    Parked := bIsParked,
    Parking := bParkActive AND NOT bPowerActive,
    Operational := bReady AND bMainReady AND NOT bEstopTriggered,
    AbortExtra := bEstopTriggered);
//MotionState
IF bStopped THEN
	nMotionState := 0;
ELSIF bSlewing OR bBusy THEN
	nMotionState := 1;
ELSIF bTracking THEN
	nMotionState := 8;
END_IF

// unset the STOP command if the telescope is stopped (#96: and the stop transaction has settled)
_StopTxRelease();
	
// #24 step 7 PR 3: held only while an error that this block resets is active (axes, focus: Reset() above; software errors:
// _HandleReset), i.e. bError without the hydraulics error, exactly as before 0.14. The hydraulics error is reset by HalfBROT
// (MAIN reset button) and leaves bError by itself; a reset held on it would abort the emergency park in every scan (F_StageAbort).
// PR 7: the same for a power failure (it leaves bError when the supply is back), so it is not in this list either.
// #24 step 7 PR 8: not held during the focus-error park either (a reset of a focus that stays faulty would abort it in every scan,
// with the axes enabled); there a reset is one scan: it resets the focus once and the park starts again from its first stage.
IF NOT (fbElevation.Error OR fbAzimuth.bError OR fbFocus.Error OR fbDerotator.bError OR bSoftwareError) OR bFocusErrorPark THEN
	bResetActive := FALSE;
END_IF

// #24 step 7 PR 6 (D8): also on a safety error without E-stop (was: E-stop only); the drives are cut (STO), the lock is the stop
IF bSafetyStop THEN
	fbElevation.Enable := FALSE;
	fbAzimuth.Enable := FALSE;
	fbDerotator.Enable := FALSE;
	// the covers stay stopped (not on the E-stop circuit): held in every scan, after the stages, so that no command of this scan
	// (a pendant press in the last scan included: MAIN calls the pendant after the cover block) moves them before the release
	fbCovers.Stop();
END_IF

// send telemetry
// The readiness field uses its existing topic and numeric format.
IF fbStartup.PublishDue(CommValid := fbComm <> 0, Heartbeat := FALSE) THEN
    fbComm.PublishLREAL('telescope', 'dome', 'TELESCOPE.READY_STATE', fReadyState);
END_IF
IF bSlewing OR bTrackActive OR bTracking THEN
	tonMQTTTimer.PT := T#500MS; // M13: was "every second", actually twice a second while moving
ELSE
	tonMQTTTimer.PT := T#1000MS; // M13: was "every five seconds", actually every second otherwise
END_IF
tonMQTTTimer(IN:=TRUE);
IF tonMQTTTimer.Q THEN
	tonMQTTTimer(IN:=FALSE);
	_SendTelemetry();
END_IF


_LogEvents();

// #24 step 5: edge memory of the command inputs (the #83 gate snapshot, now of the inputs, not of the requests). A method
// called after this point sets its b*Checked TRUE until the next snapshot, so an input that rises meanwhile is not a second
// command. In manual mode (SuspendAutomatic) the snapshot is not taken: an input that rose during manual acts on the return.
bGoHomeChecked := bGoHome;
bGotoChecked := bGoto;
bSlewChecked := bSlew;
bTrackChecked := bTrack;
bPowerChecked := bPower;
bParkChecked := bPark;
bStopChecked := bStop;
bResetChecked := bReset;]]></ST>
    </Implementation>
    <Folder Name="internal methods" Id="{d1e7fbc6-9662-4c16-bf25-8044ef92da3b}" />
    <Method Name="_GotoTelescope" Id="{8976ce61-8856-40e1-8cfb-7b9454a4edbf}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _GotoTelescope : USINT
VAR_INPUT
END_VAR
VAR
	GoToEvent		: FB_Eventlog;
	nTargetError	: UINT;
END_VAR
VAR_INST
	nLastStage		: USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_GotoTelescope := TO_USINT(eGotoStage);
// #77: a reset/interrupt/stop call only resets the stage; it must never raise an error from a stale target
// #24 step 3c: bReset OR bError OR bInterrupted OR NOT bGoto (F_StageAbort, row goto)
IF F_StageAbort(eMachine := E_StageMachine.goto, bReset := bResetActive, bError := bError, bStop := bStopActive,
		bInterrupted := bInterrupted, bCommand := bGotoActive) THEN
	eGotoStage := E_GotoStage.idle;
	RETURN;
END_IF
IF tonGotoTimeout.Q THEN	// #17: fed every scan in the body, a method-local TON never kept its state
	_RaiseSoftwareError(nId := 16#10, sText := 'goto: state machine timeout');
	bGotoActive := FALSE;
	eGotoStage := E_GotoStage.idle;
	RETURN;
END_IF


// M7: near zenith COS(elevation) -> 0, so any nonzero fAzimuthOffset blows up into a
// huge azimuth (see the offset divisions elsewhere in this FB). The default maximum 89.5 matches the
// default tracking cutoff (_TrackTelescope: stMotionUsed.fTrackMaxElevation).
// #109: the elevation window is F_GotoTargetCheck (tested): below stMotion.fGotoMinElevation (default 2 deg) 16#15,
// above stMotion.fGotoMaxElevation (default 89.5 deg) 16#16 (#24 step 2c)
nTargetError := BROTLib.F_GotoTargetCheck(fElevationCalc, stMotionUsed.fGotoMinElevation, stMotionUsed.fGotoMaxElevation);
IF nTargetError <> 0 THEN
	_RaiseSoftwareError(nId := nTargetError, sText := 'goto: target outside the elevation window');
	bGotoActive := FALSE;
	eGotoStage := E_GotoStage.idle;
	RETURN;
END_IF

// #2: no position inside the axis limits (F_AxisTurn): no move, the body warns. Not an error: nothing is latched.
IF NOT bAzimuthTurnOK OR NOT bDerotatorTurnOK THEN
	bGotoActive := FALSE;
	eGotoStage := E_GotoStage.idle;
	RETURN;
END_IF


CASE eGotoStage OF
	E_GotoStage.idle:	
		IF bReady AND NOT bBusy THEN
			eGotoStage := E_GotoStage.untrack;
		END_IF
	E_GotoStage.untrack:
		IF fbElevation.Tracking = TRUE OR fbAzimuth.Tracking = TRUE OR fbDerotator.Tracking = TRUE THEN
			fbElevation.Tracking := FALSE;
			fbAzimuth.Tracking := FALSE;
			fbDerotator.Tracking := FALSE;
		ELSE
			eGotoStage := E_GotoStage.start_move;
		END_IF				
	E_GotoStage.start_move:	
		fbElevation.Position := fElevationCalc;
		fbAzimuth.Position := fAzimuthCalc;
		fbDerotator.Position := fDerotatorCalc;
		fbDerotator.Velocity := stMotionUsed.fDerotatorMoveVelocity;
		fbElevation.Velocity := stMotionUsed.fElevationMoveVelocity;
		fbAzimuth.Velocity := stMotionUsed.fAzimuthMoveVelocity;
		
		fbElevation.MoveAxis := TRUE;
		fbAzimuth.MoveAxis := TRUE;
		fbDerotator.MoveAxis := TRUE;
		IF fbElevation.Busy AND
			fbAzimuth.Busy AND
			fbDerotator.Busy THEN
				eGotoStage := E_GotoStage.wait_moves;
		END_IF
	E_GotoStage.wait_moves:
		IF NOT fbElevation.Busy AND fbElevation.MoveDone THEN
			fbElevation.MoveAxis := FALSE;
		END_IF
		IF NOT fbAzimuth.Busy AND fbAzimuth.MoveDone THEN
			fbAzimuth.MoveAxis := FALSE;
		END_IF
		IF NOT fbDerotator.Busy AND fbDerotator.MoveDone THEN
			fbDerotator.MoveAxis := FALSE;
		END_IF
		IF NOT fbElevation.MoveAxis AND 
           NOT fbAzimuth.MoveAxis AND 
		   NOT fbDerotator.MoveAxis THEN
		   eGotoStage := E_GotoStage.wait_standstill;
		END_IF
	E_GotoStage.wait_standstill:
		IF NOT bSlewing AND bStopped THEN // all axis standstill
			eGotoStage := E_GotoStage.done;
		END_IF
	E_GotoStage.done:
		fbElevation.MoveAxis := FALSE;
		fbAzimuth.MoveAxis := FALSE;
		fbDerotator.MoveAxis := FALSE;
		fAzimuth := fAzimuthCalc;
		fElevation := fElevationCalc;
		bGotoActive := FALSE;
		// enable automatic tracking
		bTrackActive := bAutoTrack;
		eGotoStage := E_GotoStage.idle;
END_CASE
GoToEvent(Trigger := TO_USINT(eGotoStage) > nLastStage, FormatString := 'GoTo progress: %s', OnMessage := USINT_TO_STRING(TO_USINT(eGotoStage)), comm := fbComm);
nLastStage := TO_USINT(eGotoStage);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HomeTelescope" Id="{7bd4dae5-c49f-4cd9-a0c3-809697b8de19}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _HomeTelescope : BOOL
VAR_INPUT
END_VAR
VAR
    HomeEvent        : FB_Eventlog;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// reset/interrupt aborts the homing without moving anything, like the other stage methods
// #24 step 3c: bReset OR bError OR bInterrupted (F_StageAbort, row gohome: bGoHome is not read, no stage to reset)
IF F_StageAbort(eMachine := E_StageMachine.gohome, bReset := bResetActive, bError := bError, bStop := bStopActive,
		bInterrupted := bInterrupted, bCommand := bGoHomeActive) THEN
    RETURN;
END_IF

IF tonHomeTimeout.Q THEN	// #17: fed every scan in the body
    _RaiseSoftwareError(nId := 16#30, sText := 'gohome: state machine timeout');
    bGoHomeActive := FALSE;	// #17: like goto/slew; otherwise the expired timer would raise the error again right after a reset
    _HomeTelescope :=TRUE;
END_IF

// only move while a home command is active (Stop/Park/Reset call this with bGoHome cleared to abort it)
IF bGoHomeActive AND bReady AND bStopped AND NOT bBusy AND NOT bTracking THEN
    fbElevation.Velocity := stMotionUsed.fElevationMoveVelocity;
    fbElevation.Position := telescopeConfig.elevationHome;
    fbElevation.MoveAxis := TRUE;
    fbAzimuth.Velocity := stMotionUsed.fAzimuthMoveVelocity;
    fbAzimuth.Position := telescopeConfig.azimuthHome;
    fbAzimuth.MoveAxis := TRUE;
    fbDerotator.Velocity := stMotionUsed.fDerotatorMoveVelocity;
    fbDerotator.Position := telescopeConfig.derotatorHome;
    fbDerotator.MoveAxis := TRUE;    
END_IF

IF fbElevation.MoveDone AND 
    fbAzimuth.MoveDone AND 
    fbDerotator.MoveDone THEN
    bGoHomeActive := FALSE;
    fElevation := fElevationCurrent;
    fAzimuth := fAzimuthCurrent;
    _HomeTelescope := TRUE;
ELSE
    _HomeTelescope := FALSE;
END_IF

HomeEvent(Trigger := _HomeTelescope, 
            Level := ADSLOG_MSGTYPE_HINT,
            FormatString := '%s',
            OnMessage := 'Telescope is homed.', comm := fbComm);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ParkTelescope" Id="{999576b1-8aca-41eb-91ab-673a6fc7f4ba}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _ParkTelescope : USINT
VAR_INPUT
END_VAR
VAR
	ParkEvent	: FB_Eventlog;
	bAxesCanMove	: BOOL;
END_VAR
VAR_INST
	rtrigError	: R_TRIG;	// M2: reset the stage only on the rising edge of bError, not every scan; VAR_INST, a plain method VAR is re-created on every call (#17)
END_VAR
VAR_INST
	nLastStage	: USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ParkTelescope := TO_USINT(eParkStage);
// #24 step 3c: bReset OR bStop OR bInterrupted (F_StageAbort, row park: bError does not abort, see M2 below; bPark is not read)
IF F_StageAbort(eMachine := E_StageMachine.park, bReset := bResetActive, bError := bError, bStop := bStopActive,
		bInterrupted := bInterrupted, bCommand := bParkActive) THEN
	eParkStage := E_ParkStage.prepare;
	bParkCoverFault := FALSE;	// #24 step 7 PR 4
	RETURN;
END_IF
// M2: bError does NOT return early here, unlike the other state machines: stage 0's
// "emergency park" branch below is the safe-state response to bError and must run.
// Only force the stage back to 0 on the rising edge, so the emergency branch can still
// progress through its own stages (80 -> 100) on later scans while bError stays TRUE.
rtrigError(CLK := bError);
IF rtrigError.Q THEN
	eParkStage := E_ParkStage.prepare;
END_IF
// parked means: nothing opened since the last park (#113: bIsParked drops with the cover command of a power-on).
// #158: that is "secured", not "at the park position"; see bParkedInPlace.
IF bIsParked THEN
	eParkStage := E_ParkStage.parked;
END_IF
CASE eParkStage OF
	E_ParkStage.prepare: 
		bParkCoverFault := FALSE;	// #24 step 7 PR 4
		bGoHomeActive := 	FALSE;
		bTrackActive := 	FALSE;
		bGotoActive := 	FALSE;
		bSlewActive := 	FALSE;
		// #24 step 7 PR 8: a faulty focus (maybe stuck) is not sent to its park position. No stage waits for the focus, so it
		// cannot hold the park either way.
		IF NOT fbFocus.Error THEN
			fbFocus.Position := telescopeConfig.focusPark;
		END_IF
		// #87: the axes can only drive to the park position when they are calibrated, enabled and the brake is open.
		// Otherwise (aborted power-on, after a reset) park in place, like the emergency park: no axis motion.
		bAxesCanMove := F_ParkAxesCanMove(
			bElCalibrated := fbElevation.Calibrated, bAzCalibrated := fbAzimuth.Calibrated, bDrCalibrated := fbDerotator.Calibrated,
			bElEnabled := fbElevation.bEnable, bAzEnabled := fbAzimuth.bEnable, bDrEnabled := fbDerotator.bEnable,
			bBrakeOpen := fbBrake.BrakeOpen);
		// #24 step 7 PR 5: the park of a timeout (bTimeoutPark, a software error only) drives to the park position like a normal park
		// #24 step 7 PR 8: the emergency park of a focus error alone drives to the park position (bFocusErrorPark, set in the body)
		IF (bError AND NOT bTimeoutPark AND NOT bFocusErrorPark) OR NOT bAxesCanMove THEN // emergency park, or park in place
			fbBrake.CloseBrake();
			fbElevation.Enable := FALSE;
			fbAzimuth.Enable := FALSE;
			fbDerotator.Enable := FALSE;
			// #24 step 7 PR 6 follow-up: not during an E-stop / safety error, the covers stay stopped (stage secure closes them after the release)
			IF NOT bSafetyStop THEN
				fbCovers.Close();
			END_IF
			bParkedInPlace := TRUE;
			bParkedInPlaceLogged := TRUE;
			eParkStage := E_ParkStage.secure;
		ELSE
			bParkedInPlace := FALSE;
			eParkStage := E_ParkStage.untrack;
		END_IF
	E_ParkStage.untrack:
		IF fbElevation.Tracking = TRUE OR fbAzimuth.Tracking = TRUE OR fbDerotator.Tracking = TRUE THEN
			fbElevation.Tracking := FALSE;
			fbAzimuth.Tracking := FALSE;
			fbDerotator.Tracking := FALSE;
		ELSE
			eParkStage := E_ParkStage.start_move;
		END_IF		
	E_ParkStage.start_move:
		fbElevation.Position := telescopeConfig.elevationPark;
		fbElevation.Velocity := stMotionUsed.fElevationMoveVelocity;
		fbElevation.MoveAxis := TRUE;
		fbAzimuth.Position := telescopeConfig.azimuthPark;
		fbAzimuth.Velocity := stMotionUsed.fAzimuthMoveVelocity;
		fbAzimuth.MoveAxis := TRUE;
		fbDerotator.Position := telescopeConfig.derotatorPark;
		fbDerotator.Velocity := stMotionUsed.fDerotatorMoveVelocity;
		fbDerotator.MoveAxis := TRUE;
		IF fbElevation.Busy AND
			fbAzimuth.Busy AND
			fbDerotator.Busy THEN
				eParkStage := E_ParkStage.wait_moves;
		END_IF
	E_ParkStage.wait_moves:
		IF fbElevation.MoveDone THEN
			fbElevation.MoveAxis := FALSE;
		END_IF
		IF fbAzimuth.MoveDone THEN
			fbAzimuth.MoveAxis := FALSE;
		END_IF
		IF fbDerotator.MoveDone THEN
			fbDerotator.MoveAxis := FALSE;
		END_IF
		IF NOT bSlewing THEN // all axis standstill
			eParkStage := E_ParkStage.disable_axes;
		END_IF
	E_ParkStage.disable_axes:
		IF NOT fbElevation.Enable AND NOT fbAzimuth.Enable AND NOT fbDerotator.Enable THEN
			eParkStage := E_ParkStage.secure;
		END_IF

		IF bStopped THEN
			fbElevation.Enable := FALSE;
			fbAzimuth.Enable := FALSE;
			fbDerotator.Enable := FALSE;
		END_IF
		
		fbElevation.MoveAxis := FALSE;
		fbAzimuth.MoveAxis := FALSE;
		fbDerotator.MoveAxis := FALSE;
	E_ParkStage.secure:
		IF fbElevation.Enable OR fbAzimuth.Enable OR fbDerotator.Enable THEN
			eParkStage := E_ParkStage.disable_axes;
		END_IF
		IF NOT fbBrake.BrakeOpen THEN
			// #24 step 7 PR 6 follow-up: during an E-stop / safety error the covers stay stopped and the park waits here (the hydraulics
			// still go off); after the release this line closes them and the park ends as before
			IF NOT bSafetyStop THEN
				fbCovers.Close();
			END_IF
			fbHydraulics.Enable := FALSE;
		END_IF
		IF fbCovers.Closed THEN
			eParkStage := E_ParkStage.parked;
		// #24 step 7 PR 4 (row cover error): covers in error do not move (HalfBROT drops the command), so the park would wait here for
		// ever. It ends without Closed once the axes are disabled (still in secure, not sent back above) and the hydraulics are off
		// (brake not open, switched off above); the open covers are reported as software error 16#21 in stage parked.
		ELSIF fbCovers.Error AND NOT fbBrake.BrakeOpen AND eParkStage = E_ParkStage.secure THEN
			bParkCoverFault := TRUE;
			eParkStage := E_ParkStage.parked;
		END_IF
	E_ParkStage.parked:
			bIsParked := TRUE;
			bParkActive := FALSE;
			_ParkTelescope := 100;
			eParkStage := E_ParkStage.prepare;	
			// #24 step 7 PR 4: raised here, not in secure: bError in the scan after secure would reset the stage to prepare (rtrigError)
			IF bParkCoverFault THEN
				_RaiseSoftwareError(nId := 16#21, sText := 'park: ended without the covers closed (cover error)');
				bParkCoverFault := FALSE;
			END_IF
END_CASE
ParkEvent(Trigger := TO_USINT(eParkStage) > nLastStage, FormatString := 'Parking progress: %s', OnMessage := USINT_TO_STRING(TO_USINT(eParkStage)), comm := fbComm);
nLastStage := TO_USINT(eParkStage);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PowerOn" Id="{4c40649f-56d9-4130-9f80-925439540d98}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _PowerOn : BOOL
VAR_INPUT
END_VAR
VAR_INST
	nLastStage	: USINT := 101;
    elevationDone : BOOL;
    azimuthDone : BOOL;
    derotatorDone : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #66/#80: an explicit stop, reset or interrupt aborts without the failure checks, so the stop path
// (which calls _PowerOn only to reset its stage) cannot raise a false power failure.
IF bResetActive OR bStopActive OR bInterrupted THEN
	bPowerFailure := FALSE;
	bPowerActive := FALSE;
ELSIF NOT bBrakeClearing THEN
	bPowerFailure := TRUE;
	TCSpowerEvent.OnMessage := 'failure: brake clearing not set';
	bPowerActive := FALSE;
ELSIF bError THEN
	bPowerFailure := TRUE;
	TCSpowerEvent.OnMessage := 'Generic error during power on occurred.';
	bPowerActive := FALSE;
// #24 step 7 PR 4 (row cover error): covers in error do not move (HalfBROT), stage 0 would wait for Opened until the 12 h command
// timeout. Checked before the cover command of stage 0, so a power-on with the error already there opens nothing and stays parked.
ELSIF fbCovers.Error THEN
	bPowerFailure := TRUE;
	TCSpowerEvent.OnMessage := 'failure: cover error (reset the covers, then power=1)';
	bPowerActive := FALSE;
ELSE
	bPowerFailure := FALSE;		
END_IF

// #24 step 3c: NOT bPower OR bReset OR bError OR bStop OR bInterrupted (F_StageAbort, row poweron), with bPower as left by
// the checks above
IF F_StageAbort(eMachine := E_StageMachine.poweron, bReset := bResetActive, bError := bError, bStop := bStopActive,
		bInterrupted := bInterrupted, bCommand := bPowerActive) THEN
    fbStartup.MarkAborted();
    bPowerActive := FALSE;
	ePowerOnStage := E_PowerOnStage.open_covers;
	// abort without leaving the last written axis commands set
	fbElevation.MoveAxis := FALSE;
	fbElevation.HomeAxis := FALSE;
	fbAzimuth.MoveAxis := FALSE;
	fbAzimuth.HomeAxis := FALSE;
	fbDerotator.MoveAxis := FALSE;
	fbDerotator.HomeAxis := FALSE;
	fbFocus.HomeAxis := FALSE;
	RETURN;
END_IF

IF ePowerOnStage <> E_PowerOnStage.open_covers THEN	// every stage from home_axes on (was: stage >= 10)
    fbStartup.MarkCalibrating();
END_IF

CASE ePowerOnStage OF
	E_PowerOnStage.open_covers:
		_PowerOn := FALSE;
		// COVER MUST BE OPENED FOR A SUCCESSFUL WAKE & SHAKE COMMAND!
		// unconditional by design: does not consult bCoverAutoOpen (see CoverAutoOpen.Set)
		// #113: from the cover command on, a park must close what the power-on opens (with bIsParked TRUE it would only
		// clear bPark). A power-on that fails before this line (checks above) has opened nothing and stays parked.
		// #24 step 7 PR 6 follow-up: during an E-stop / safety error the covers stay stopped: no cover command, the stage waits (a
		// power-on that had opened before keeps bIsParked FALSE, so the held park closes after the release and aborts it, #87).
		IF NOT bSafetyStop THEN
			bIsParked := FALSE;
			bParkedInPlace := FALSE;
			fbCovers.Open();
		END_IF
		IF bMainReady AND fbCovers.Opened AND NOT bSafetyStop THEN	// waits here during the safety stop (bIsParked cleared above first)
			ePowerOnStage := E_PowerOnStage.home_axes;
		END_IF
		
	E_PowerOnStage.home_axes:
		fbElevation.Enable := TRUE;
		fbAzimuth.Enable := TRUE;
		fbDerotator.Enable := TRUE;
		
		// request homing once: HomeAxis stays TRUE until the homing has finished (HalfBROT), and a new request while a
		// homing runs would restart it. Calibrated can be TRUE for a short moment before the homing is done.
		IF fbElevation.Ready AND NOT fbElevation.Calibrated AND NOT fbElevation.HomeAxis THEN
			fbElevation.HomeAxis := TRUE;
		END_IF
		
		IF fbAzimuth.Ready AND NOT fbAzimuth.Calibrated AND NOT fbAzimuth.HomeAxis THEN
			fbAzimuth.HomeAxis := TRUE;
		END_IF
		
		// enable derotator
		IF fbElevation.Ready THEN
			fbDerotator.HomeAxis := fbDerotator.Ready AND NOT fbDerotator.Calibrated;
		END_IF
		
		// start calibration of focus after elevation has been calibrated
		// this avoids imbalance by the M2 mirror on the elvation during its calibration
		IF fbElevation.Calibrated AND NOT fbFocus.Calibrated THEN
			fbFocus.Enable := TRUE;
			IF NOT fbFocus.HomeAxis THEN
				fbFocus.HomeAxis := TRUE;
			END_IF
		END_IF
	
		IF fbCovers.Opened AND fbElevation.Calibrated AND fbAzimuth.Calibrated AND fbDerotator.Calibrated AND fbFocus.Calibrated AND
			bReady AND bStopped AND NOT bBusy AND NOT bTracking THEN
			ePowerOnStage := E_PowerOnStage.start_move_home;
		END_IF
		
	E_PowerOnStage.start_move_home:
		fbElevation.Velocity := stMotionUsed.fElevationMoveVelocity;
		fbElevation.Position := telescopeConfig.elevationHome;
		fbElevation.MoveAxis := TRUE;
		fbAzimuth.Velocity := stMotionUsed.fAzimuthMoveVelocity;
		fbAzimuth.Position := telescopeConfig.azimuthHome;
		fbAzimuth.MoveAxis := TRUE;
		fbDerotator.Velocity := stMotionUsed.fDerotatorMoveVelocity;
		fbDerotator.Position := telescopeConfig.derotatorHome;
		fbDerotator.MoveAxis := TRUE;	
		
        // Issue once, then consume Done from subsequent axis calls. Each axis can finish in a different scan.
        elevationDone := FALSE;
        azimuthDone := FALSE;
        derotatorDone := FALSE;
        ePowerOnStage := E_PowerOnStage.wait_home;
    E_PowerOnStage.wait_home:
        elevationDone := elevationDone OR fbElevation.MoveDone;
        azimuthDone := azimuthDone OR fbAzimuth.MoveDone;
        derotatorDone := derotatorDone OR fbDerotator.MoveDone;
        IF elevationDone AND azimuthDone AND derotatorDone AND bStopped AND NOT bBusy THEN
            fbElevation.MoveAxis := FALSE;
            fbAzimuth.MoveAxis := FALSE;
            fbDerotator.MoveAxis := FALSE;
            ePowerOnStage := E_PowerOnStage.complete;
        END_IF
    E_PowerOnStage.complete:
        // #80: same Operational test FB_StartupControl.Update applies this scan; otherwise the completion is ignored
        // while bPower is already FALSE and the startup would stay at 0.8. Wait one more scan instead.
        IF bReady AND bMainReady AND bStopped AND NOT bBusy AND NOT bError AND NOT bEstopTriggered THEN
            fbStartup.MarkCompleted();
            bInitRequired := FALSE;			// #72
            bFirstPowerOnPending := FALSE;	// #113
            bPowerActive := FALSE;
            fElevation := fElevationCurrent;
            fAzimuth := fAzimuthCurrent;
            _PowerOn := TRUE;
            bIsParked := FALSE;
            bParkedInPlace := FALSE;
            ePowerOnStage := E_PowerOnStage.open_covers;
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="SuspendAutomatic" Id="{1d8d9ace-21b3-43be-83fa-2fd1c6bdfc0f}">
      <Declaration><![CDATA[// MAIN calls this instead of the cyclic controller while automatic control is disabled.
// #118: the moves of the automatic mode are not driven any more, so a move that is still running is stopped once (one MC_Stop
// per moving axis, BROTLib.FB_StopTransaction, the abort stop of #84/#56) and then the axes are released to the pendant. Queued moves
// are dropped, tracking ends, bPark is kept (it restarts in automatic). Only this one stop is driven here; a stop that arrives
// during manual (Stop()) is processed after the return, it must not brake an axis the operator is jogging.
// #72: the first manual scan also sets bInitRequired: after any manual interval a new Init (power=1) is always required before
// a move is accepted, a startup is never resumed and nothing queued replays. Stop, park, reset and Init stay accepted.
// #168 (small alternative): the three optional inputs carry the live safety state of MAIN into the READY_STATE heartbeat of the
// manual mode. They are telemetry only: they are used in the fbStartup.Suspend(Error := ...) call and nowhere else, never for an
// axis, brake, hydraulics or cover write. The defaults give the heartbeat of before (no E-stop, no safety error, power present).
METHOD SuspendAutomatic
VAR_INPUT
	bEstopIn		: BOOL := FALSE;	// MAIN: SafetyHandling.estop
	bSafetyErrorIn	: BOOL := FALSE;	// MAIN: SafetyHandling.error
	bMainReadyIn	: BOOL := TRUE;		// MAIN: the power monitoring (MONETS ready, MONETN mainReady)
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[// #156: the axis references are assigned only by the telescope body. After a start in manual (key on Local) they are still
// unassigned, so the axis part is skipped until the first automatic scan. The rest (events, READY_STATE) does not use them.
IF __ISVALIDREF(fbAzimuth) AND __ISVALIDREF(fbElevation) AND __ISVALIDREF(fbDerotator) THEN
    _ReadAxes();
    _StopTxInputs();
    IF fbStartup.EnterSuspend() THEN
        bHwErrorLast := TRUE;	// #86: an error already present when switching back to automatic does not park
        bCoverErrorLast := TRUE;	// #24 step 7 PR 4: the same for a cover error
        // #72: after any manual interval only a new Init makes the telescope movable again. Set in the first manual scan, so a
        // move sent during manual is rejected too (bReady is not recomputed in manual) and the horizon guard cannot home before the Init.
        bInitRequired := TRUE;
        bInitRequiredLog := TRUE;
        IF fbStartup.Initializing OR bPowerActive THEN
            bPowerActive := FALSE;
            bInterrupted := TRUE;
            _PowerOn();
            bInterrupted := FALSE;
        END_IF

        // #118: nothing queued may replay on the return, and the manual mode starts from defined axis states
        bGoHomeActive := FALSE;
        bGotoActive := FALSE;
        bSlewActive := FALSE;
        bTrackActive := FALSE;
        bSupersedeRequest := FALSE;
        bInterrupted := TRUE;
        _HomeTelescope();
        _GotoTelescope();
        _SlewTelescope();
        _ParkTelescope();
        bInterrupted := FALSE;
        // #24 step 7 PR 3: during the ramp of a hydraulics error (last automatic scan) the drives are on, so that stop goes on
        // #24 step 7 PR 5: also during the ramp and park of a timeout (bTimeoutPark); bPark is kept as for any park (#118)
        // #24 step 7 PR 7: and during the ramp of a power failure (bMainPowerRamp)
        // #24 step 7 PR 8: also during the ramp or the drive of the focus-error park; after manual mode that park parks in place
        // (the pendant may have moved or disabled the axes), so it is given up here
        bSuspendStop := BROTLib.F_SuspendStop(	// #24 step 6: BROTLib's copy, the three axes OR-ed here
            bError := bError AND NOT bHydraulicsRamp AND NOT bTimeoutPark AND NOT bMainPowerRamp AND NOT bFocusErrorPark,
            bStopRunning := TCS_command = E_TCSCommand.stop AND (bStopActive OR bMoveAbortPending),
            bAnyAxisMoving := (fbStopTx.abEnabled[1] AND fbStopTx.abMoving[1])
                OR (fbStopTx.abEnabled[2] AND fbStopTx.abMoving[2])
                OR (fbStopTx.abEnabled[3] AND fbStopTx.abMoving[3]));
        bFocusErrorPark := FALSE;
        IF bSuspendStop THEN
            IF NOT bStopActive THEN
                bMoveAbortPending := TRUE;
            END_IF
            TCS_command := E_TCSCommand.stop;
            bSuspendStopStarted := TRUE;
        ELSE
            TCS_command := E_TCSCommand.no_command;
            fbAzimuth.Tracking := FALSE;
            fbElevation.Tracking := FALSE;
            fbDerotator.Tracking := FALSE;
            fbAzimuth.MoveAxis := FALSE;
            fbElevation.MoveAxis := FALSE;
            fbDerotator.MoveAxis := FALSE;
        END_IF
    END_IF

    IF bSuspendStop THEN
        // the timeout counts from the first suspended scan, or goes on if the body was already stopping
        IF TCS_command <> eTimeoutCommand THEN
            tonCommandTimeout(IN := FALSE);
            eTimeoutCommand := TCS_command;
        END_IF
        _StopTelescope();
        // the NC rejects a jog while MC_Stop runs, which would raise an axis error: no jog until the stop has settled
        fbAzimuth.MovePos := FALSE;
        fbAzimuth.MoveNeg := FALSE;
        fbElevation.MovePos := FALSE;
        fbElevation.MoveNeg := FALSE;
        fbDerotator.MovePos := FALSE;
        fbDerotator.MoveNeg := FALSE;
        tonCommandTimeout(IN := TRUE, PT := stMotionUsed.tSuspendStopTimeout, nDivisor := nTimeDivisor);
        TCSCTOEvent.OnMessage := 'STOP';
        _StopTxMonitor();
        IF fbStopTx.bSettled THEN
            _StopTxRelease();
            fbStopTx.Cancel();
            bStopTxBegun := FALSE;
            TCS_command := E_TCSCommand.no_command;
            bSuspendStop := FALSE;
        ELSIF fbStopTx.bStuck THEN
            // an axis is still moving after the timeout: hand the axes to the pendant anyway. bMoveAbortPending / bStop stay set,
            // so the body stops again after the return.
            fbAzimuth.StopAxis := FALSE;
            fbElevation.StopAxis := FALSE;
            fbDerotator.StopAxis := FALSE;
            fbStopTx.Cancel();
            bStopTxBegun := FALSE;
            TCS_command := E_TCSCommand.no_command;
            bSuspendStop := FALSE;
        END_IF
    END_IF
END_IF
SuspendStopEvent(	Trigger := bSuspendStopStarted,
					Level := ADSLOG_MSGTYPE_HINT,
					FormatString := '%s',
					OnMessage := 'switch to manual under motion: stopping axes',
					Comm := fbComm);
bSuspendStopStarted := FALSE;
ParkedInPlaceEvent(	Trigger := bParkedInPlaceLogged,
					Level := ADSLOG_MSGTYPE_WARN,
					FormatString := '%s',
					OnMessage := CONCAT(CONCAT(CONCAT('parked in place at el ', LREAL_TO_STRING(fElevationCurrent)), ' az '),
										CONCAT(LREAL_TO_STRING(fAzimuthCurrent), ' (not the park position)')),
					Comm := fbComm);
bParkedInPlaceLogged := FALSE;
_StopEvents();
IF NOT bSuspendStop THEN
    tonCommandTimeout(IN := FALSE);
    eTimeoutCommand := TCS_command;
END_IF
// #168: bError and bPowerFailure are the values of the last automatic scan (bSoftwareError is part of bError); the live safety
// state comes in through the inputs. In manual Error only selects the published value (the startup is aborted anyway).
fReadyState := fbStartup.Suspend(Error := bError OR bPowerFailure OR bEstopIn OR bSafetyErrorIn OR NOT bMainReadyIn, Parked := bIsParked);
// Continue the existing readiness heartbeat without replaying a frozen ONLINE value.
tonMQTTTimer(IN := TRUE, PT := T#1S);
IF fbStartup.PublishDue(CommValid := fbComm <> 0, Heartbeat := tonMQTTTimer.Q) THEN
    fbComm.PublishLREAL('telescope', 'dome', 'TELESCOPE.READY_STATE', fReadyState);
    tonMQTTTimer(IN := FALSE);
END_IF
]]></ST></Implementation>
    </Method>
    <Method Name="_SendTelemetry" Id="{5e3ab35e-5dd6-4108-99df-8d99cebae004}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD _SendTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^._PublishTelemetry();
// #24 step 5: BROTLib's FB_BaseTelescopeControl._PublishTelemetry chooses OBJECT.HORIZONTAL.ALT/AZ and OBJECT.EQUATORIAL.RA/DEC by
// the input bSlew, which is no status any more (this block does not write it; a method slew does not set it, a client may hold it
// after the slew). Where the input and the request (bSlewActive) differ, OBJECT.EQUATORIAL.RA/DEC is sent again right after it
// with the value it published for the request until 0.14.x; the later publish is the one on the wire. OBJECT.HORIZONTAL.ALT/AZ
// needs nothing here: fbTelemetry sends it again below, unconditionally. Remove when BROTLib reads a status there.
IF bSlew <> bSlewActive THEN
	IF bSlewActive THEN
		fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.RA', fRightAscensionCalc);
		fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC', fDeclinationCalc);
	ELSE
		fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.RA', fRightAscension);
		fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC', fDeclination);
	END_IF
END_IF

// #24 step 4a: the MONET fields are published by fbTelemetry (FB_MonetTelescopeTelemetry, the code that was here until
// 0.12.0, unchanged in topics, order, values and conditions). The snapshot is filled once per publish, right before.
stTelemetry.fReadyState					:= fReadyState;
stTelemetry.nMotionState				:= nMotionState;
stTelemetry.nInterruptedAutoClearCount	:= nInterruptedAutoClearCount;

stTelemetry.fRefractionPressure			:= fRefractionPressure;
stTelemetry.fRefractionTemperature		:= fRefractionTemperature;
stTelemetry.bRefractionTemperatureSet	:= bRefractionTemperatureSet;

stTelemetry.fRightAscension				:= fRightAscension;
stTelemetry.fDeclination				:= fDeclination;
stTelemetry.fElevationCalc				:= fElevationCalc;
stTelemetry.fAzimuthCalc				:= fAzimuthCalc;

stTelemetry.fSlewTime					:= fSlewTime;
stTelemetry.fElevationPointingOffset	:= fElevationPointingOffset;
stTelemetry.fAzimuthPointingOffset		:= fAzimuthPointingOffset;

stTelemetry.fLst						:= fLst;
stTelemetry.fJd							:= fJd;
stTelemetry.fLatitude					:= telescopeConfig.latitude;
stTelemetry.fLongitude					:= telescopeConfig.longitude;
stTelemetry.fAltitude					:= telescopeConfig.altitude;

stTelemetry.bElevationEnable			:= fbElevation.Enable;
stTelemetry.bElevationCalibrated		:= fbElevation.Calibrated;
stTelemetry.bElevationError				:= fbElevation.Error;
stTelemetry.nElevationErrorID			:= fbElevation.ErrorID;
stTelemetry.bElevationBusy				:= fbElevation.Busy;
stTelemetry.bElevationTracking			:= fbElevation.isTracking;
stTelemetry.fElevationPosition			:= fbElevation.Position;
stTelemetry.fElevationVelocity			:= fbElevation.Velocity;
stTelemetry.fElevationCurrent			:= fElevationCurrent;
stTelemetry.fElevationOffset			:= fElevationOffset;

stTelemetry.bAzimuthEnable				:= fbAzimuth.Enable;
stTelemetry.bAzimuthCalibrated			:= fbAzimuth.Calibrated;
stTelemetry.bAzimuthError				:= fbAzimuth.Error;
stTelemetry.nAzimuthErrorID				:= fbAzimuth.ErrorID;
stTelemetry.bAzimuthBusy				:= fbAzimuth.Busy;
stTelemetry.bAzimuthTracking			:= fbAzimuth.isTracking;
stTelemetry.fAzimuthPosition			:= fbAzimuth.Position;
stTelemetry.fAzimuthVelocity			:= fbAzimuth.Velocity;
stTelemetry.fAzimuthCurrent				:= fAzimuthCurrent;
stTelemetry.fAzimuthOffset				:= fAzimuthOffset;
stTelemetry.fDerotatorOffset			:= fDerotatorOffset;	// #177

stTelemetry.fElevationCurrentSky		:= fElevationCurrentSky;
stTelemetry.fAzimuthCurrentSky			:= fAzimuthCurrentSky;
stTelemetry.fRightAscensionCurrent		:= fRightAscensionCurrent;
stTelemetry.fHourAngleCurrent			:= fHourAngleCurrent;
stTelemetry.fDeclinationCurrent			:= fDeclinationCurrent;

fbTelemetry(comm := fbComm, stTelemetry := stTelemetry);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SlewTelescope" Id="{d3e1cb80-5564-4d5b-b2d9-2c8dd1b9215a}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _SlewTelescope : USINT
VAR_INPUT
END_VAR
VAR
	SlewEvent:	FB_Eventlog;
	fSlewAzimuth:	LREAL;
	fSlewDerotator:	LREAL;
END_VAR
VAR_INST
	nLastStage:	USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SlewTelescope := TO_USINT(eSlewStage);
// #77: see _GotoTelescope
// #24 step 3c: bReset OR bError OR bInterrupted OR NOT bSlew (F_StageAbort, row slew)
IF F_StageAbort(eMachine := E_StageMachine.slew, bReset := bResetActive, bError := bError, bStop := bStopActive,
		bInterrupted := bInterrupted, bCommand := bSlewActive) THEN
	eSlewStage := E_SlewStage.idle;
	RETURN;
END_IF
IF tonSlewTimeout.Q THEN	// #17: fed every scan in the body
	_RaiseSoftwareError(nId := 16#40, sText := 'slew: state machine timeout');
	bSlewActive := FALSE;
	eSlewStage := E_SlewStage.idle;
	RETURN;
END_IF
CASE eSlewStage OF
	E_SlewStage.idle:	
		IF bReady AND bStopped AND NOT bBusy AND NOT bTracking THEN
			eSlewStage := E_SlewStage.untrack;
		END_IF
	E_SlewStage.untrack:
		IF fbElevation.Tracking = TRUE OR fbAzimuth.Tracking = TRUE OR fbDerotator.Tracking = TRUE THEN
			fbElevation.Tracking := FALSE;
			fbAzimuth.Tracking := FALSE;
			fbDerotator.Tracking := FALSE;
		ELSE
			eSlewStage := E_SlewStage.start_move;
		END_IF				
	E_SlewStage.start_move:
		fbPointing(
			fAzimuth			:= fAzimuth,
			fElevation			:= fElevation,
			fAzimuthOffset		=> fAzimuthPointingOffset,
			fElevationOffset	=> fElevationPointingOffset
		);	
		// #2: the axes would clamp a position outside their limits to another one, so refuse it before any move
		fSlewAzimuth := fAzimuth + fAzimuthPointingOffset + F_AzimuthOffsetOnAxis(fAzimuthOffset, fElevation);
		fSlewDerotator := fElevation + fDerotatorOffset;
		// #212: the same elevation window as goto (F_GotoTargetCheck, #109), on the elevation the axis would get. A warning, nothing latched, no move.
		IF BROTLib.F_GotoTargetCheck(fElevation + fElevationPointingOffset + fElevationOffset, stMotionUsed.fGotoMinElevation, stMotionUsed.fGotoMaxElevation) <> 0 THEN
			bSlewOutsideWindow := TRUE;
			bSlewActive := FALSE;
			eSlewStage := E_SlewStage.idle;
			RETURN;
		END_IF
		IF fSlewAzimuth < fbAzimuth.fMinPosition - 1.0E-6 OR fSlewAzimuth > fbAzimuth.fMaxPosition + 1.0E-6
			OR fSlewDerotator < fbDerotator.fMinPosition - 1.0E-6 OR fSlewDerotator > fbDerotator.fMaxPosition + 1.0E-6 THEN
			bSlewOutOfLimits := TRUE;
			bSlewActive := FALSE;
			eSlewStage := E_SlewStage.idle;
			RETURN;
		END_IF
		fbElevation.Position := fElevation + fElevationPointingOffset + fElevationOffset;
		fbElevation.Velocity := stMotionUsed.fElevationMoveVelocity;
		fbElevation.MoveAxis := TRUE;
		fbAzimuth.Position := fAzimuth + fAzimuthPointingOffset + F_AzimuthOffsetOnAxis(fAzimuthOffset, fElevation);	// M7: was fElevationCalc, mismatched with fAzimuth above
		fbAzimuth.Velocity := stMotionUsed.fAzimuthMoveVelocity;
		fbAzimuth.MoveAxis := TRUE;
		fbDerotator.Position := fElevation + fDerotatorOffset;
		fbDerotator.Velocity := stMotionUsed.fDerotatorMoveVelocity;
		fbDerotator.MoveAxis := TRUE;
		IF fbElevation.Busy AND
			fbAzimuth.Busy AND
			fbDerotator.Busy THEN
				eSlewStage := E_SlewStage.wait_standstill;
		END_IF
	E_SlewStage.wait_standstill:
		// #225: like the goto, MoveAxis is dropped per axis only when its move is really done (NOT Busy AND MoveDone), and the stage ends
		// only when all three are dropped. bSlewing and bStopped are computed later in the body, so in the first scan of this stage they
		// still hold the values from before the move (not slewing, stopped); the stage then went to done at once (MS-140: bSlewActive TRUE
		// for 60 ms, the slew timeout 16#40 never covered the travel).
		IF NOT fbElevation.Busy AND fbElevation.MoveDone THEN
			fbElevation.MoveAxis := FALSE;
		END_IF
		
		IF NOT fbAzimuth.Busy AND fbAzimuth.MoveDone THEN
			fbAzimuth.MoveAxis := FALSE;
		END_IF

		IF NOT fbDerotator.Busy AND fbDerotator.MoveDone THEN
			fbDerotator.MoveAxis := FALSE;
		END_IF
		IF NOT fbElevation.MoveAxis AND NOT fbAzimuth.MoveAxis AND NOT fbDerotator.MoveAxis AND NOT bSlewing AND bStopped THEN // all axis standstill
			eSlewStage := E_SlewStage.done;
		END_IF
	E_SlewStage.done:
		fbElevation.MoveAxis := FALSE;
		fbAzimuth.MoveAxis := FALSE;
		fbDerotator.MoveAxis := FALSE;
		fRightAscension := fRightAscensionCalc;
		fDeclination := fDeclinationCalc;
		bSlewActive := FALSE;
		eSlewStage := E_SlewStage.idle;
END_CASE
SlewEvent(Trigger := TO_USINT(eSlewStage) > nLastStage, FormatString := 'Slew progress: %s', OnMessage := USINT_TO_STRING(TO_USINT(eSlewStage)), Comm := fbComm);
nLastStage := TO_USINT(eSlewStage);		
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_LogEvents" Id="{37adc943-5fc3-45c0-ba6e-4d7a16cee2e8}" FolderPath="internal methods\">
      <Declaration><![CDATA[// plan step 3.3: the event function blocks of the body (ADS log and MQTT log), moved unchanged; called where the block stood, at the end of the body.
METHOD PRIVATE _LogEvents
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Event function blocks start here. *)
TCSpowerEvent(	Trigger := bPowerFailure, 
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := 'power %s',
				//OnMessage := 'Failure',
				OffMessage := 'OK', 
				Comm := fbComm);

TCSgohomeEvent(	Trigger := bGoHomeActive, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'GOHOME %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := fbComm);
TCSparkEvent(	Trigger := bParkActive, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'PARK %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := fbComm);
TCSgotoEvent(	Trigger := bGotoActive, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'GOTO %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := fbComm);
TCStrackEvent(	Trigger := bTrackActive, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'TRACK %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := fbComm);
// #234: the park stage sets bParkedInPlaceLogged in automatic mode; the event was only called in SuspendAutomatic (manual), so the
// WARN was never logged. Same call as in SuspendAutomatic (only one of the two bodies runs per scan).
ParkedInPlaceEvent(	Trigger := bParkedInPlaceLogged,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := CONCAT(CONCAT(CONCAT('parked in place at el ', LREAL_TO_STRING(fElevationCurrent)), ' az '),
									CONCAT(LREAL_TO_STRING(fAzimuthCurrent), ' (not the park position)')),
				Comm := fbComm);
bParkedInPlaceLogged := FALSE;
_StopEvents();
TCStargetHorizonEvent(	Trigger := bTargetBelowHorizonWarn,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Target below safe horizon',
				OffMEssage := '', 
				Comm := fbComm);
AzimuthNoTurnEvent(	Trigger := bAzimuthNoTurn,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'No azimuth position inside the axis limits for the target, goto/track refused',
				OffMEssage := '',
				Comm := fbComm);
DerotatorNoTurnEvent(	Trigger := bDerotatorNoTurn,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'No derotator position inside the axis limits for the target, goto/track refused',
				OffMEssage := '',
				Comm := fbComm);
SlewOutOfLimitsEvent(	Trigger := bSlewOutOfLimits,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Slew target outside the axis limits, slew refused',
				OffMEssage := '',
				Comm := fbComm);
bSlewOutOfLimits := FALSE;
SlewOutsideWindowEvent(	Trigger := bSlewOutsideWindow,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Slew target outside the elevation window, slew refused',
				OffMEssage := '',
				Comm := fbComm);
bSlewOutsideWindow := FALSE;
TCSreadyEvent(	Trigger := bPowerActive AND bReady, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := '%s',
				OnMessage := 'STELLA1 startup finished', 
				Comm := fbComm);
SoftwareErrorEvent(	Trigger := bSoftwareError,
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := 'Internal command error, ID: %s',
				OnMessage := UINT_TO_STRING(nSoftwareErrorID),
				OffMessage := 'cleared',
				OffLevel := ADSLOG_MSGTYPE_HINT,
				Comm := fbComm);
PowerAbortEvent(	Trigger := bPowerAbortedByPark,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'power-on aborted: park requested',
				Comm := fbComm);
bPowerAbortedByPark := FALSE;
ErrorParkEvent(	Trigger := bErrorParkStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'emergency park started: axis error',
				Comm := fbComm);
bErrorParkStarted := FALSE;
ErrorParkExemptEvent(	Trigger := bErrorParkExempt,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'axis error in the first power-on after a PLC restart (Wake&Shake?): no emergency park, covers stay open; reset, Wake&Shake and power=1, or park=1',
				Comm := fbComm);
bErrorParkExempt := FALSE;
HydraulicsRampEvent(	Trigger := bHydraulicsRampStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'hydraulics error: controlled stop of the axes, then emergency park in place',
				Comm := fbComm);
bHydraulicsRampStarted := FALSE;
TimeoutParkEvent(	Trigger := bTimeoutParkStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'state-machine timeout: controlled stop of the axes, then park',
				Comm := fbComm);
bTimeoutParkStarted := FALSE;
CoverErrorParkEvent(	Trigger := bCoverErrorParkStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'cover error: park started (covers as far as possible, the park ends without closed covers)',
				Comm := fbComm);
bCoverErrorParkStarted := FALSE;
MainPowerRampEvent(	Trigger := bMainPowerRampStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'power failure (bMainReady FALSE): controlled stop of the axes, then emergency park in place',
				Comm := fbComm);
bMainPowerRampStarted := FALSE;
FocusErrorParkEvent(	Trigger := bFocusErrorParkStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'focus error: controlled stop of the axes if they move, then emergency park to the park position',
				Comm := fbComm);
bFocusErrorParkStarted := FALSE;
SafetyParkEvent(	Trigger := bSafetyParkStarted,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'E-stop / safety error released: park in place (covers close)',
				Comm := fbComm);
bSafetyParkStarted := FALSE;
WakeShakeBlockEvent(	Trigger := bWakeShakeBrakeBlocked,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := sWakeShakeBlockMessage,
				Comm := fbComm);
WakeShakeOpenEvent(	Trigger := bWakeShakeOpened,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Wake&Shake window open: the brake may stay open for 15 min, then it is closed',
				Comm := fbComm);
bWakeShakeOpened := FALSE;
IF bWakeShakeClosed THEN
	sWakeShakeCloseMessage := CONCAT('Wake&Shake window closed, brake closed: ', sWakeShakeEnd);
END_IF
WakeShakeCloseEvent(	Trigger := bWakeShakeClosed,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := sWakeShakeCloseMessage,
				Comm := fbComm);
bWakeShakeClosed := FALSE;
// #83: every rejection is logged and published (ADS log and MQTT log topic). An identical rejection repeated
// within 2 s is logged once (a level writer would flood the log); all of them are counted. The event is re-armed
// with FALSE first so that rejections in consecutive scans each give a rising edge.
tonRejectRepeat(IN := TRUE, PT := T#2S);
RejectEvent(Trigger := FALSE, Comm := fbComm);
IF bCommandRejected THEN
	IF tonRejectRepeat.Q OR eLastRejectedCommand <> eLoggedCommand OR eLastRejectReason <> eLoggedReason THEN
		sRejectMessage := CONCAT(CONCAT(BROTLib.F_TCSCommandText(eLastRejectedCommand), ' rejected: '),
			F_CommandRejectText(eLastRejectReason));
		RejectEvent(Trigger := TRUE, Level := ADSLOG_MSGTYPE_WARN, FormatString := '%s',
			OnMessage := sRejectMessage, Comm := fbComm);
		eLoggedCommand := eLastRejectedCommand;
		eLoggedReason := eLastRejectReason;
		tonRejectRepeat(IN := FALSE);
	END_IF
	bCommandRejected := FALSE;
END_IF
InitRefusedEvent(	Trigger := bInitRefused,
				Level := nInitRefusedLevel,
				FormatString := 'power-on ignored: %s',
				OnMessage := sInitRefusedReason,
				Comm := fbComm);
bInitRefused := FALSE;
// #72: logged on the first scan back in automatic (the manual scans do not run this method)
IF bInitRequiredLog THEN
	IF bParkActive OR bParkAfterStop THEN
		nInitRequiredLevel := ADSLOG_MSGTYPE_WARN;
		sInitRequiredMessage := 'automatic mode: init required (manual mode), pending park resumes';
	ELSE
		nInitRequiredLevel := ADSLOG_MSGTYPE_HINT;
		sInitRequiredMessage := 'automatic mode: init required (manual mode since last startup)';
	END_IF
END_IF
InitRequiredEvent(	Trigger := bInitRequiredLog,
				Level := nInitRequiredLevel,
				FormatString := '%s',
				OnMessage := sInitRequiredMessage,
				Comm := fbComm);
bInitRequiredLog := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HandleReset" Id="{e7e606af-0b84-4ec5-8f2f-365038356508}" FolderPath="internal methods\">
      <Declaration><![CDATA[// plan step 3.3: the reset handling of the body (stuck-stop recovery, drop of the pending moves, stage reset), moved unchanged; called after
// _ReadAxes/_StopTxInputs at the place where the block stood. rtrigReset is clocked here (nothing before it reads bReset's edge).
METHOD PRIVATE _HandleReset
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set reset state either by hardware (key pressed) or by software (set by e.g. tcs)
rtrigReset(CLK := bResetActive);

// #96 (D3): a reset recovers a stop that is stuck in Stopping without writing over ADS. Only axes that stand still
// are reset (a reset under motion was followed by 0x4260, #84); a moving enabled axis keeps the stop going.
// #56: also for an abort stop (bMoveAbortPending), not only for an operator stop.
IF rtrigReset.Q AND (bStopActive OR bMoveAbortPending)
	AND NOT (fbStopTx.abEnabled[1] AND fbStopTx.abMoving[1])
	AND NOT (fbStopTx.abEnabled[2] AND fbStopTx.abMoving[2])
	AND NOT (fbStopTx.abEnabled[3] AND fbStopTx.abMoving[3]) THEN
	IF fbStopTx.abStopping[1] THEN
		fbAzimuth.Reset();
	END_IF
	IF fbStopTx.abStopping[2] THEN
		fbElevation.Reset();
	END_IF
	IF fbStopTx.abStopping[3] THEN
		fbDerotator.Reset();
	END_IF
	fbStopTx.Cancel();	// bStop then clears at standstill
END_IF

IF bResetActive THEN
    fbStartup.MarkAborted();
	bHorizonError := FALSE; // if reset, the bHorizonError can be switched off
	bSoftwareError := FALSE;
	nSoftwareErrorID := 0;	// #88
	sSoftwareErrorText := '';	// #24 step 3b

	// #85: a reset drops every pending move command; nothing may move later because of a command sent
	// before the reset. bPark is kept on purpose (safe direction, emergency park).
	bGoHomeActive := FALSE;
	bGotoActive := FALSE;
	bSlewActive := FALSE;
	bTrackActive := FALSE;
	// #56: a move that is still running is stopped (the abort stop of #84 goes on), not left to run to its old target.
	// Not during an error (the drives are off) and not during a park (its motion is wanted, bPark is kept).
	bMoveAbortPending := BROTLib.F_ResetMoveAbort(	// #24 step 6: BROTLib's copy, the three axes OR-ed here
		bError := bError,
		bParkRunning := TCS_command = E_TCSCommand.park,
		bAnyAxisMoving := (fbStopTx.abEnabled[1] AND fbStopTx.abMoving[1])
			OR (fbStopTx.abEnabled[2] AND fbStopTx.abMoving[2])
			OR (fbStopTx.abEnabled[3] AND fbStopTx.abMoving[3]));
	bSupersedeRequest := FALSE;	// #83

	// reset the stages of all statemachine methods
	bInterrupted := TRUE; 
	_HomeTelescope();
	_GotoTelescope();
	_SlewTelescope();
	_ParkTelescope();
	bInterrupted := FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="_RaiseSoftwareError" Id="{d7269f1a-1a39-4d9c-9ab8-9d3ec12c3042}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #24 step 3b: the one path of the software errors of the stage machines (goto 16#10, goto target 16#15/16#16, park ended
// without closed covers 16#21 (#24 step 7 PR 4), home 16#30, slew 16#40), until 0.12.0 four copies of the same four
// assignments. bError/nErrorID act in the rest of this scan,
// bSoftwareError/nSoftwareErrorID are latched until bReset (M1, cleared in _HandleReset), so bError and nErrorID follow them
// again from the next scan. The log is unchanged ('Internal command error, ID: %s', _LogEvents); sText is kept for ADS only.
// The configuration errors 16#31/16#32 of the body set only the latch (bError follows from it in the same scan) and do not
// use this method.
METHOD PRIVATE _RaiseSoftwareError
VAR_INPUT
	nId		: UINT;		// software error ID, also nErrorID
	sText	: STRING;	// what failed, stored in sSoftwareErrorText
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bError := TRUE;
nErrorID := nId;
bSoftwareError := TRUE;
nSoftwareErrorID := nId;
sSoftwareErrorText := sText;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_MotionConfig" Id="{8979c776-9097-4885-b923-03159bbd68ae}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #24 step 2c: the motion limits of this scan, called near the start of the body. stMotionUsed := stMotion, then every
// deprecated alias input (D2) that is not at its old default wins over its field; the set of aliases in use is logged
// once (WARN, ADS and MQTT log) whenever it changes. An invalid result (BROTLib.F_MotionConfigValid) sets
// bMotionConfigInvalid (software error 16#32, raised in the body) and the defaults stay in use, so no timer, window or
// velocity runs with an invalid value.
METHOD PRIVATE _MotionConfig
VAR
	stDefault	: BROTLib.ST_MotionConfig;	// the struct defaults (a method VAR is initialised on every call)
	bLog		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stMotionUsed := stMotion;
sMotionAliases := '';
IF fElevationMoveVelocity <> 5.0 THEN
	stMotionUsed.fElevationMoveVelocity := fElevationMoveVelocity;
	sMotionAliases := CONCAT(sMotionAliases, ' fElevationMoveVelocity');
END_IF
IF fAzimuthTrackMargin <> 1.0 THEN
	stMotionUsed.fAzimuthTrackMargin := fAzimuthTrackMargin;
	sMotionAliases := CONCAT(sMotionAliases, ' fAzimuthTrackMargin');
END_IF
IF fDerotatorTrackMargin <> 1.0 THEN
	stMotionUsed.fDerotatorTrackMargin := fDerotatorTrackMargin;
	sMotionAliases := CONCAT(sMotionAliases, ' fDerotatorTrackMargin');
END_IF
IF fAzimuthTrackTimeCap <> 14400.0 THEN
	stMotionUsed.fAzimuthTrackTimeCap := fAzimuthTrackTimeCap;
	sMotionAliases := CONCAT(sMotionAliases, ' fAzimuthTrackTimeCap');
END_IF
IF fDerotatorTrackTimeCap <> 14400.0 THEN
	stMotionUsed.fDerotatorTrackTimeCap := fDerotatorTrackTimeCap;
	sMotionAliases := CONCAT(sMotionAliases, ' fDerotatorTrackTimeCap');
END_IF

bLog := sMotionAliases <> sMotionAliasesLogged AND sMotionAliases <> '';
sMotionAliasesLogged := sMotionAliases;
MotionAliasEvent(	Trigger := bLog,
					Level := ADSLOG_MSGTYPE_WARN,
					FormatString := '%s',
					OnMessage := CONCAT('deprecated inputs override stMotion (set stMotion instead, removed in the next minor):', sMotionAliases),
					Comm := fbComm);

bMotionConfigInvalid := NOT BROTLib.F_MotionConfigValid(stConfig := stMotionUsed);
IF bMotionConfigInvalid THEN
	stMotionUsed := stDefault;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReadAxes" Id="{01fb7eb4-fd45-4d34-9738-945e1968aeee}" FolderPath="internal methods\">
      <Declaration><![CDATA[// plan step 3.1: the feedback of the three axes (the outputs of their FB_Axis) once per scan, at the start of the body and of
// SuspendAutomatic. The axes are called after the telescope, so the outputs are the same wherever the body reads them.
METHOD PRIVATE _ReadAxes
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[aAxis[1].bStandStill := fbAzimuth.fbAxis.StandStill;
aAxis[1].bStopDone := fbAzimuth.fbAxis.StopDone;
aAxis[1].bInMotion := fbAzimuth.fbAxis.InMotion;
aAxis[1].bInRamp := fbAzimuth.fbAxis.InRamp;
aAxis[1].bHoming := fbAzimuth.fbAxis.Homing;
aAxis[1].bStopping := fbAzimuth.fbAxis.Stopping;
aAxis[1].bBusy := fbAzimuth.fbAxis.Busy;
aAxis[1].bTracking := fbAzimuth.fbAxis.isTracking;
aAxis[2].bStandStill := fbElevation.fbAxis.StandStill;
aAxis[2].bStopDone := fbElevation.fbAxis.StopDone;
aAxis[2].bInMotion := fbElevation.fbAxis.InMotion;
aAxis[2].bInRamp := fbElevation.fbAxis.InRamp;
aAxis[2].bHoming := fbElevation.fbAxis.Homing;
aAxis[2].bStopping := fbElevation.fbAxis.Stopping;
aAxis[2].bBusy := fbElevation.fbAxis.Busy;
aAxis[2].bTracking := fbElevation.fbAxis.isTracking;
aAxis[3].bStandStill := fbDerotator.fbAxis.StandStill;
aAxis[3].bStopDone := fbDerotator.fbAxis.StopDone;
aAxis[3].bInMotion := fbDerotator.fbAxis.InMotion;
aAxis[3].bInRamp := fbDerotator.fbAxis.InRamp;
aAxis[3].bHoming := fbDerotator.fbAxis.Homing;
aAxis[3].bStopping := fbDerotator.fbAxis.Stopping;
aAxis[3].bBusy := fbDerotator.fbAxis.Busy;
aAxis[3].bTracking := fbDerotator.fbAxis.isTracking;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ComputeTargets" Id="{28b41640-2b40-49f6-a70c-a35d1a2deacc}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #24 step 4b (D5 option A, SM plan D3 hook): once per scan in the body, after the error reaction and before the horizon
// guard. The weather of the refraction, the commanded target (eq2hor, pointing model, offsets, #94 warning, derotator,
// velocities, #2 turn inside the axis limits) and the reported position (inverse pointing model, both hor2eq). Moved
// unchanged from the body; every variable it reads or writes is in the FB's VAR (the body, the state machines and the
// telemetry use them), so the method has no state of its own.
METHOD PRIVATE _ComputeTargets
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// One weather for the commanded position (eq2hor) and for the reported RA/Dec (both hor2eq below): with different
// weather the reported coordinates would differ from the commanded ones by the refraction difference.
IF bLiveWeatherRefraction THEN
	bRefractionLive := BROTLib.F_RefractionWeather(
		stWeather := Weather,
		fSiteAltitude := telescopeConfig.altitude,
		fPressure => fRefractionPressure,
		fTemperature => fRefractionTemperature,
		bTemperatureSet => bRefractionTemperatureSet,
		bPressureRejected => bRefractionPressureRejected,
		bTemperatureRejected => bRefractionTemperatureRejected);
ELSE
	bRefractionLive := FALSE;
	fRefractionPressure := 0.0;
	fRefractionTemperature := 0.0;
	bRefractionTemperatureSet := FALSE;
	bRefractionPressureRejected := FALSE;
	bRefractionTemperatureRejected := FALSE;
END_IF
rtrigPressureRejected(CLK := bRefractionPressureRejected);
IF rtrigPressureRejected.Q THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'Live weather: %s does not fit the site, the estimate is used', 'pressure');
END_IF
rtrigTemperatureRejected(CLK := bRefractionTemperatureRejected);
IF rtrigTemperatureRejected.Q THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'Live weather: %s does not fit the site, the estimate is used', 'temperature');
END_IF

eq2hor(
	ra := fRightAscension,
	dec := fDeclination,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	pressure := fRefractionPressure,
	temperature := fRefractionTemperature,
	temperature_set := bRefractionTemperatureSet,
	JD := fJd + fTimeOffset,
	dut1 := fDut1,
	refract_to_observed := TRUE,
	// refract := FALSE,
	alt => fElevationCalc,
	az => fAzimuthCalc,
	ha => fHourAngleCalc);

// apply pointing model
fbPointing(
	fAzimuth			:= fAzimuthCalc,
	fElevation			:= fElevationCalc,
	fAzimuthOffset		=> fAzimuthPointingOffset,
	fElevationOffset	=> fElevationPointingOffset
);
fElevationCalc := fElevationCalc + fElevationPointingOffset + fElevationOffset;
// F_AzimuthOffsetOnAxis: fAzimuthOffset / COS(elevation), bounded near the zenith (BROTLib#27)
fAzimuthCalc := fAzimuthCalc + fAzimuthPointingOffset + F_AzimuthOffsetOnAxis(fAzimuthOffset, fElevationCalc);

// #94: evaluated here, before the arbitration and the Goto/Track dispatch below can clear bGoto/bTrack (error 0x15)
// in the same scan. Only a requested goto/track makes the RA/Dec target relevant.
bTargetBelowHorizonWarn := BROTLib.F_TargetBelowHorizonWarning(bGoto := bGotoActive, bTrack := bTrackActive, fElevationCalc := fElevationCalc, fHorizon := fHorizon);

// calculate derotator position 
fDerotatorCalc := F_DerotatorPosition2(fAzimuthCalc, fElevationCalc, telescopeConfig.latitude, fDerotatorSign)  + fDerotatorOffset;

// calculate velocities
fDerotatorVelocity := F_Derotatorvelocity(fAzimuthCalc, fElevationCalc, telescopeConfig.latitude, fDerotatorSign);
fElevationVelocity := F_Elevationvelocity(fAzimuthCalc, telescopeConfig.latitude);
fAzimuthVelocity := F_Azimuthvelocity(fElevationCalc, fAzimuthCalc, telescopeConfig.latitude);

// #2: the turn of the target inside the axis limits (the measured endpoints, never a literal of one site). A target
// is not clamped to another position: without a turn inside the limits the goto/track is refused. While an axis
// tracks it keeps the turn it is on, except for a new goto, which chooses freely (the axis may be anywhere).
bAzimuthTurnOK := F_AxisTurn(
	fTarget := fAzimuthCalc, fVelocity := fAzimuthVelocity, fCurrent := fbAzimuth.fActualPosition,
	bHold := fbAzimuth.Tracking AND NOT bGotoActive, fMin := fbAzimuth.fMinPosition, fMax := fbAzimuth.fMaxPosition,
	fMargin := stMotionUsed.fAzimuthTrackMargin, fTrackTimeCap := stMotionUsed.fAzimuthTrackTimeCap, fPosition => fAzimuthCalc);
bDerotatorTurnOK := F_AxisTurn(
	fTarget := fDerotatorCalc, fVelocity := fDerotatorVelocity, fCurrent := fbDerotator.fActualPosition,
	bHold := fbDerotator.Tracking AND NOT bGotoActive, fMin := fbDerotator.fMinPosition, fMax := fbDerotator.fMaxPosition,
	fMargin := stMotionUsed.fDerotatorTrackMargin, fTrackTimeCap := stMotionUsed.fDerotatorTrackTimeCap, fPosition => fDerotatorCalc);
// only a requested goto/track makes the target relevant (see #94)
bAzimuthNoTurn := (bGotoActive OR bTrackActive) AND NOT bAzimuthTurnOK;
bDerotatorNoTurn := (bGotoActive OR bTrackActive) AND NOT bDerotatorTurnOK;

// get current coordinates	
fAzimuthCurrent := fbAzimuth.fActualPosition;
fElevationCurrent := fbElevation.fActualPosition;
fDerotatorCurrent := fbDerotator.fActualPosition;

// apply inverse pointing model
fbPointingInverse(
	fAzimuth			:= fAzimuthCurrent,
	fElevation			:= fElevationCurrent,
	fAzimuthOffset  	=> fAzimuthPointingOffset2,
	fElevationOffset	=> fElevationPointingOffset2
);
fAzimuthCurrentSky := fAzimuthCurrent - fAzimuthPointingOffset2;
fElevationCurrentSky := fElevationCurrent - fElevationPointingOffset2;

// add offsets
//fElevationCurrent := fElevationCurrentSky - fElevationOffset;
//fAzimuthCurrent := fAzimuthCurrentSky - fAzimuthOffset / COS(fElevationCalc * d2r);

// calculate equatorial coordinates
hor2eq(alt := fElevationCurrentSky - fElevationOffset,
		az := fAzimuthCurrentSky - F_AzimuthOffsetOnAxis(fAzimuthOffset, fElevationCurrent),	// M7: was fElevationCalc
		jd := fJd,
		dut1 := fDut1,
		lat := telescopeConfig.latitude,
		lon := telescopeConfig.longitude,
		altitude := telescopeConfig.altitude,
		pressure := fRefractionPressure,
		temperature := fRefractionTemperature,
		temperature_set := bRefractionTemperatureSet,
		alt_is_observed := TRUE,
		// refract := FALSE,
		ra => fRightAscensionCurrent,
		dec => fDeclinationCurrent,
		ha => fHourAngleCurrent);	// M13: was never assigned, HA_ICRS telemetry was stuck at 0.0
hor2eq(alt := fElevationCurrentSky,
		az := fAzimuthCurrentSky,
		jd := fJd,
		dut1 := fDut1,
		lat := telescopeConfig.latitude,
		lon := telescopeConfig.longitude,
		altitude := telescopeConfig.altitude,
		pressure := fRefractionPressure,
		temperature := fRefractionTemperature,
		temperature_set := bRefractionTemperatureSet,
		alt_is_observed := TRUE,
		ra => fRightAscensionCurrentSky,
		dec => fDeclinationCurrentSky);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopTxInputs" Id="{b7e41c92-3d58-4f06-a1c9-0e8d52b6f301}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #96/#118: axis state for the stop transaction (the state of the last axis cycle), set by the body and SuspendAutomatic
METHOD PRIVATE _StopTxInputs
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #232: enabled = requested AND powered. The request (bEnable) stays TRUE when the drive power is cut by an interlock (HalfBROT:
// the azimuth and derotator power needs the brake open, fbAxis.Enable := bEnable AND bAtRest AND bBrakeOpen); the NC axis is then
// Disabled, StandStill is FALSE by definition and a request-based bStopped never became TRUE again (park and stop held for ever).
fbStopTx.abEnabled[1] := fbAzimuth.bEnable AND fbAzimuth.fbAxis.Ready;
fbStopTx.abEnabled[2] := fbElevation.bEnable AND fbElevation.fbAxis.Ready;
fbStopTx.abEnabled[3] := fbDerotator.bEnable AND fbDerotator.fbAxis.Ready;
fbStopTx.abStandStill[1] := aAxis[1].bStandStill;
fbStopTx.abStandStill[2] := aAxis[2].bStandStill;
fbStopTx.abStandStill[3] := aAxis[3].bStandStill;
fbStopTx.abStopAxis[1] := fbAzimuth.StopAxis;
fbStopTx.abStopAxis[2] := fbElevation.StopAxis;
fbStopTx.abStopAxis[3] := fbDerotator.StopAxis;
fbStopTx.abStopDone[1] := aAxis[1].bStopDone;
fbStopTx.abStopDone[2] := aAxis[2].bStopDone;
fbStopTx.abStopDone[3] := aAxis[3].bStopDone;
fbStopTx.abMoving[1] := aAxis[1].bInMotion OR aAxis[1].bInRamp OR aAxis[1].bHoming;
fbStopTx.abMoving[2] := aAxis[2].bInMotion OR aAxis[2].bInRamp OR aAxis[2].bHoming;
fbStopTx.abMoving[3] := aAxis[3].bInMotion OR aAxis[3].bInRamp OR aAxis[3].bHoming;
fbStopTx.abStopping[1] := aAxis[1].bStopping;
fbStopTx.abStopping[2] := aAxis[2].bStopping;
fbStopTx.abStopping[3] := aAxis[3].bStopping;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopTxMonitor" Id="{b7e41c92-3d58-4f06-a1c9-0e8d52b6f302}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #96/#118: bStopped, then the settle / timeout monitoring of the stop transaction (body and SuspendAutomatic)
METHOD PRIVATE _StopTxMonitor
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #232: an axis that is requested but not powered (fbAxis.Ready FALSE, NC state Disabled) cannot move and has no StandStill
bStopped :=  (NOT (fbElevation.bEnable AND fbElevation.fbAxis.Ready) OR aAxis[2].bStandStill) AND
			(NOT (fbAzimuth.bEnable AND fbAzimuth.fbAxis.Ready) OR aAxis[1].bStandStill) AND
			(NOT (fbDerotator.bEnable AND fbDerotator.fbAxis.Ready) OR aAxis[3].bStandStill);

// #96: settles the stop (every issued axis reported StopDone, at rest for 3 scans) or raises the timeout cases
fbStopTx.bStopped := bStopped;
fbStopTx.bTimeout := tonCommandTimeout.Q AND TCS_command = E_TCSCommand.stop;
fbStopTx.Monitor();
IF fbStopTx.bForced THEN
	nStopForcedCount := nStopForcedCount + 1;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopTxRelease" Id="{b7e41c92-3d58-4f06-a1c9-0e8d52b6f303}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #96/#118: once the stop transaction has settled, release bStop, the abort stop and StopAxis (body and SuspendAutomatic)
METHOD PRIVATE _StopTxRelease
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fbStopTx.bSettled THEN
	bStopActive := FALSE;
	IF TCS_command = E_TCSCommand.stop THEN
		bMoveAbortPending := FALSE;	// #84: only after STOP was dispatched in this scan
		fbAzimuth.StopAxis := FALSE;
		fbElevation.StopAxis := FALSE;
		fbDerotator.StopAxis := FALSE;
	END_IF
	IF bParkAfterStop AND NOT bStopActive THEN
		// #83: a park sent during the stop runs now (from the next scan)
		bParkActive := TRUE;
		bParkAfterStop := FALSE;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopEvents" Id="{b7e41c92-3d58-4f06-a1c9-0e8d52b6f304}" FolderPath="internal methods\">
      <Declaration><![CDATA[// Log events of the stop (body and SuspendAutomatic, once per scan)
METHOD PRIVATE _StopEvents
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TCSstopEvent(	Trigger := bStopActive, 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := 'STOP %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed',
				OffLevel := ADSLOG_MSGTYPE_HINT, 
				Comm := fbComm);
TCSCTOEvent(	Trigger := tonCommandTimeout.Q,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := 'A timeout occurred during %s command!',
				Comm := fbComm);
MoveAbortEvent(	Trigger := bMoveAbortPending AND NOT bStopActive,
					Level := ADSLOG_MSGTYPE_HINT,
					FormatString := '%s',
					OnMessage := 'move interrupted, stopping axes',
					OffMessage := 'axes stopped',
					Comm := fbComm);
StopForcedEvent(	Trigger := fbStopTx.bForced,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'STOP completed without StopDone from every axis',
				Comm := fbComm);
StopStuckEvent(	Trigger := fbStopTx.bStuck,
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := '%s',
				OnMessage := 'STOP timeout: an axis is not at standstill',
				Comm := fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopTelescope" Id="{cb5cd062-03c6-4c9b-bbde-9c71b10960c3}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _StopTelescope : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #84: one scan does it all. fbAxis.Stop() cancels a pending MoveTo itself; clearing MoveAxis
// alone (CancelMove) does not stop a running move.
// BROTLib#101: while an axis tracks, dropping Tracking sends MC_ExtSetPointGenDisable, and an MC_Stop in the same cycle meets the
// still active setpoint generator (NC error 0x4257 on every tracking axis). The stop therefore starts one scan after the drop.
IF fbAzimuth.Tracking OR fbElevation.Tracking OR fbDerotator.Tracking THEN
	fbAzimuth.Tracking := FALSE;
	fbElevation.Tracking := FALSE;
	fbDerotator.Tracking := FALSE;
	fbAzimuth.MoveAxis := FALSE;
	fbElevation.MoveAxis := FALSE;
	fbDerotator.MoveAxis := FALSE;
	_StopTelescope := FALSE;
	RETURN;
END_IF
fbAzimuth.Tracking := FALSE;
fbElevation.Tracking := FALSE;
fbDerotator.Tracking := FALSE;
fbAzimuth.MoveAxis := FALSE;
fbElevation.MoveAxis := FALSE;
fbDerotator.MoveAxis := FALSE;

// #96: one MC_Stop per axis and stop transaction. The release (StopAxis := FALSE, bStop) happens in the body when
// the transaction has settled, not here: StopDone clears StopAxis by itself, and writing it again while the axis is
// still Stopping was the restart loop.
IF NOT bStopTxBegun THEN
	fbStopTx.Begin();
	// MONETcommon#122: the focus has no StopAxis level and is not part of the transaction (it settles on its own
	// StopDone): one Stop() per stop command stops a running focus move and holds the position reached
	fbFocus.Stop();
	bStopTxBegun := TRUE;
END_IF
fbStopTx();

// a StopAxis level still latched from an earlier stop is dropped for one scan (abWriteLow), so that the next TRUE
// is a fresh FALSE->TRUE edge and the setter really calls fbAxis.Stop()
IF fbStopTx.abWriteLow[1] THEN
	fbAzimuth.StopAxis := FALSE;
ELSIF fbStopTx.abWriteHigh[1] THEN
	fbAzimuth.StopAxis := TRUE;
END_IF
IF fbStopTx.abWriteLow[2] THEN
	fbElevation.StopAxis := FALSE;
ELSIF fbStopTx.abWriteHigh[2] THEN
	fbElevation.StopAxis := TRUE;
END_IF
IF fbStopTx.abWriteLow[3] THEN
	fbDerotator.StopAxis := FALSE;
ELSIF fbStopTx.abWriteHigh[3] THEN
	fbDerotator.StopAxis := TRUE;
END_IF
_StopTelescope := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_TrackTelescope" Id="{6e849cc7-222d-486c-8d3d-ea253bc6d574}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _TrackTelescope : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Elevation
fDerotatorVelocity := F_Derotatorvelocity(fAzimuthCalc, fElevationCalc, telescopeConfig.latitude, fDerotatorSign);
fElevationVelocity := F_Elevationvelocity(fAzimuthCalc, telescopeConfig.latitude);
fAzimuthVelocity := F_Azimuthvelocity(fElevationCalc, fAzimuthCalc, telescopeConfig.latitude);
IF fElevationCurrent < stMotionUsed.fTrackMinElevation OR fElevationCurrent > stMotionUsed.fTrackMaxElevation THEN
	bTrackActive := FALSE;
END_IF
// #2: replaces the literal cutoffs (azimuth 440, derotator -69/379) of MONETN: tracking stops stMotionUsed.fAzimuthTrackMargin /
// fDerotatorTrackMargin before the limit the target moves towards, or when no turn exists
IF NOT bAzimuthTurnOK OR NOT bDerotatorTurnOK THEN
	bTrackActive := FALSE;
END_IF

fbElevation.Position := fElevationCalc;
IF NOT fbElevation.Tracking THEN
	fbElevation.Velocity := stMotionUsed.fElevationMoveVelocity;
	fbElevation.MoveAxis := TRUE;
	IF NOT fbElevation.Busy AND fbElevation.MoveDone THEN
		fbElevation.MoveAxis := FALSE;
		IF fbElevation.isTracking THEN
			fbElevation.Velocity := fElevationVelocity;
		ELSE
			fbElevation.Velocity := 3.0*fElevationVelocity;
		END_IF
		fbElevation.Velocity := fElevationVelocity;
		fbElevation.Tracking := TRUE;
	END_IF
ELSE
	fbElevation.Velocity := fElevationVelocity;
END_IF

// Azimuth
fbAzimuth.Position := fAzimuthCalc;
IF NOT fbAzimuth.Tracking THEN
	fbAzimuth.Velocity := stMotionUsed.fAzimuthMoveVelocity;
	fbAzimuth.MoveAxis := TRUE;
	IF NOT fbAzimuth.Busy AND fbAzimuth.MoveDone THEN
		fbAzimuth.MoveAxis := FALSE;
		IF fbAzimuth.isTracking THEN
			fbAzimuth.Velocity := fAzimuthVelocity;
		ELSE
			fbAzimuth.Velocity := 3.0*fAzimuthVelocity;
		END_IF
		fbAzimuth.Velocity := fAzimuthVelocity;
		fbAzimuth.Tracking := TRUE;
	END_IF
ELSE
	fbAzimuth.Velocity := fAzimuthVelocity;
END_IF

// Derotator
fbDerotator.Position := fDerotatorCalc;
IF NOT fbDerotator.Tracking THEN
	fbDerotator.Velocity := stMotionUsed.fDerotatorMoveVelocity;
	fbDerotator.MoveAxis := TRUE;
	IF NOT fbDerotator.Busy AND fbDerotator.MoveDone THEN
		fbDerotator.MoveAxis := FALSE;
		IF fbDerotator.isTracking THEN
			fbDerotator.Velocity := fDerotatorVelocity;
		ELSE
			fbDerotator.Velocity := 3.0*fDerotatorVelocity;
		END_IF
		fbDerotator.Velocity := fDerotatorVelocity;
		fbDerotator.Tracking := TRUE;
	END_IF
ELSE
	fbDerotator.Velocity := fDerotatorVelocity;
END_IF
]]></ST>
      </Implementation>
    </Method>
