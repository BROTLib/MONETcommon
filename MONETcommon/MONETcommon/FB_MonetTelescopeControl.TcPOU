      <Declaration><![CDATA[PROPERTY Azimuth : LREAL
]]></Declaration>
      <Get Name="Get" Id="{fd6f0d71-0c53-4de5-af62-a6f082f3b2fe}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
