END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bSlewChecked	:= TRUE;	// #24 step 5: decided here (accepted or rejected); a rising bSlew input in the same scan is not decided again
// #83: decide first. A rejected slew writes nothing, not even the target, and never stays pending.
IF NOT _AcceptMove(E_TCSCommand.slew, E_TCSCommand.no_command) THEN
	RETURN;			// Slew = FALSE: rejected, logged by the body
END_IF
IF ABS(THIS^.fElevation - fAltitude) > 1.0E-9 OR ABS(THIS^.fAzimuth - fAzimuth) > 1.0E-9 THEN
	_ClearOffsets();	// #177
END_IF
THIS^.fElevation 	:= fAltitude;
THIS^.fAzimuth 	:= fAzimuth;
THIS^.bSlewActive		:= TRUE;
Slew := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{d33b3161-dc8a-45e5-ae2f-544550162c16}">
      <Declaration><![CDATA[METHOD Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStopChecked := TRUE;	// #24 step 5: a rising bStop in the same scan is this stop, not a second (repeated) one
// #213: a stop ends a park that is queued behind a running stop (timeout or error park, park=1 during a stop). Only the stop
// release started it; without this it started once the ramp stop settled and the stop was ignored (MS-137, 3 of 8 runs).
// A Park() later in the same scan queues again.
bParkAfterStop := FALSE;
// #96 (D2): a repeated stop while a stop is running re-sends a stop only to axes that are moving again
IF bStopActive THEN
	fbStopTx.Restart();
	// #156: fbFocus is unassigned until the body has run (start in manual)
	IF fbFocus <> 0 THEN
		fbFocus.Stop();	// MONETcommon#122: a focus that was sent to a new target meanwhile is stopped again
	END_IF
END_IF
bStopActive := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Track" Id="{36f6a798-1a7b-442f-88f7-fc8d7dfa3dc0}">
      <Declaration><![CDATA[METHOD Track : BOOL
VAR_INPUT
	fRightAscension	: LREAL;
	fDeclination	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #24 step 5: decided here (accepted or rejected); a rising bGoto or bTrack input in the same scan is this command (a goto
// that ends in tracking), not a second one
bGotoChecked			:= TRUE;
bTrackChecked			:= TRUE;
// #83: decide first, see Slew
IF NOT _AcceptMove(E_TCSCommand.goto, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
IF ABS(THIS^.fRightAscension - fRightAscension) > 1.0E-9 OR ABS(THIS^.fDeclination - fDeclination) > 1.0E-9 THEN
	_ClearOffsets();	// #177
END_IF
THIS^.fRightAscension	:= fRightAscension;
THIS^.fDeclination		:= fDeclination;
//THIS^.bTrack			:= TRUE;
THIS^.bGotoActive				:= TRUE;
Track := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TrackRaDec" Id="{f497d99f-36a3-42c8-ae9b-738903f3158c}">
      <Declaration><![CDATA[METHOD TrackRaDec : BOOL
VAR_INPUT
	RaDec	: BROTLib.ST_RaDecCoordinate;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #24 step 5: decided here (accepted or rejected); a rising bGoto or bTrack input in the same scan is this command (a goto
// that ends in tracking), not a second one
bGotoChecked			:= TRUE;
bTrackChecked			:= TRUE;
// #83: decide first, see Slew
IF NOT _AcceptMove(E_TCSCommand.goto, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
IF ABS(fRightAscension - RaDec.RightAscension) > 1.0E-9 OR ABS(fDeclination - RaDec.Declination) > 1.0E-9 THEN
	_ClearOffsets();	// #177
END_IF
fRightAscension	:= RaDec.RightAscension;
fDeclination		:= RaDec.Declination;
//bTrack			:= TRUE;
THIS^.bGotoActive				:= TRUE;
TrackRaDec := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{5b1d2a10-7c3e-4d52-9a61-0e4f8c2b7a11}">
      <Declaration><![CDATA[// #83: BROTLib's base Home sets bGoHome unconditionally; decide first like the other moves (#24 step 5: sets bGoHomeActive).
METHOD Home : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bGoHomeChecked := TRUE;	// #24 step 5: a rising bGoHome in the same scan is this command
IF NOT _AcceptMove(E_TCSCommand.gohome, E_TCSCommand.no_command) THEN
	RETURN;
END_IF
bGoHomeActive := TRUE;
Home := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_CommandState" Id="{5b1d2a10-7c3e-4d52-9a61-0e4f8c2b7a12}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #83: the state F_CommandAcceptance decides on. eExcludeOwn leaves the own request out of bMoveActive (until 0.14.x the
// direct-write gate checked a flag that was already set); since #24 step 5 every caller passes no_command, because an input
// edge no longer sets the request before it is decided.
METHOD PRIVATE _CommandState : ST_CommandState
VAR_INPUT
	eExcludeOwn	: E_TCSCommand;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CommandState.bEstop		:= bEstopTriggered;
_CommandState.bError		:= bError;
_CommandState.bClockValid	:= fbTime.bValid;
_CommandState.bStop			:= bStopActive;
_CommandState.bPowering		:= bPowerActive OR fbStartup.Initializing;
_CommandState.bParkPending	:= bParkActive OR bParkAfterStop;
_CommandState.bIsParked		:= bIsParked;
_CommandState.bReady		:= bReady;
_CommandState.bInitRequired	:= bInitRequired;
_CommandState.bGoHomeActive	:= (bGoHomeActive AND eExcludeOwn <> E_TCSCommand.gohome) OR TCS_command = E_TCSCommand.gohome;
_CommandState.bMoveActive	:= (bGotoActive AND eExcludeOwn <> E_TCSCommand.goto) OR
	(bSlewActive AND eExcludeOwn <> E_TCSCommand.slew) OR
	(bTrackActive AND eExcludeOwn <> E_TCSCommand.track) OR
	(bGoHomeActive AND eExcludeOwn <> E_TCSCommand.gohome) OR
	TCS_command = E_TCSCommand.goto OR TCS_command = E_TCSCommand.slew OR TCS_command = E_TCSCommand.track OR
	bTracking OR bMoveAbortPending;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_AcceptMove" Id="{5b1d2a10-7c3e-4d52-9a61-0e4f8c2b7a13}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #83: TRUE if the move may run (accepted, or it replaces the running one), FALSE if it was rejected
// (logged by the body, nothing written).
METHOD PRIVATE _AcceptMove : BOOL
VAR_INPUT
	eCommand	: E_TCSCommand;
	eExcludeOwn	: E_TCSCommand;
END_VAR
VAR
	eReason		: E_CommandRejectReason;
	eDecision	: E_CommandDecision;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eDecision := F_CommandAcceptance(eCommand := eCommand, stState := _CommandState(eExcludeOwn := eExcludeOwn), eReason => eReason);
CASE eDecision OF
	E_CommandDecision.reject:
		_NoteRejected(eCommand := eCommand, eReason := eReason);
		_AcceptMove := FALSE;
	E_CommandDecision.replace:
		bSupersedeRequest := TRUE;
		eSupersedeKeep := eCommand;
		_AcceptMove := TRUE;
ELSE
	_AcceptMove := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ClearOffsets" Id="{7d2e9b40-1c6a-4f83-b5d7-3a9e0c8f1a62}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #177: a new target starts without the pointing offsets of the previous one (the pendant nudges them in automatic mode).
// Called only after an accepted move to a target that differs from the last one (and on the rising bGoto/bSlew/bTrack
// edges), so the same target sent again keeps its offsets. Not for Home/Park/Init.
METHOD PRIVATE _ClearOffsets
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fElevationOffset := 0.0;
fAzimuthOffset := 0.0;
fDerotatorOffset := 0.0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_NoteRejected" Id="{5b1d2a10-7c3e-4d52-9a61-0e4f8c2b7a14}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _NoteRejected
VAR_INPUT
	eCommand	: E_TCSCommand;
	eReason		: E_CommandRejectReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nCommandRejectCount := nCommandRejectCount + 1;
eLastRejectedCommand := eCommand;
eLastRejectReason := eReason;
bCommandRejected := TRUE;]]></ST>
      </Implementation>
    </Method>
