      <Declaration><![CDATA[// #24 step 3a: stage of the goto state machine (_GotoTelescope), read-only (diagnostics, rig tests)
PROPERTY GotoStage : E_GotoStage
]]></Declaration>
      <Get Name="Get" Id="{a0c6ebf9-67a0-45f2-b933-7fe31b9d3dcb}">
