<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetSafetyHandling" Id="{f40cbfea-880d-4f1c-9345-5f8b55063f2d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MonetSafetyHandling
VAR
	// power on delay

	// AT%I*/AT%Q* below are mapped directly on this FB: only one instance per PLC is
	// supported, a second instance would collide on the same physical hardware.
	inError					AT%I*:	BOOL;		// Safety Error Condition
	outRun					AT%Q*:	BOOL;		// Run/Stop Safety
	outRestart				AT%Q*:	BOOL;		// Restart Safety
	outErrAck				AT%Q*:	BOOL;		// Error Acknowledgement 
	
	outResetAzimuthSTO		AT%Q*: BOOL;
	outResetElevationSTO	AT%Q*: BOOL;
	outResetDerotatorSTO	AT%Q*: BOOL;
	
	// Safety group
	fbInfoGroup1			: FB_InfoGroup;
	stInfoGroup1	AT%I*	: ST_InfoDataGroup;
	sStateGroup1			: STRING;
	
	// Estop
	fbInfoEStop1			:FB_InfoEStop;
	stInfoEStop1 	AT%I*	:ST_InfoDataFB;
	sStateEStop1			:STRING;
	sDiagEStop1				:STRING;	
	
	// Info EL1904
	fbInfoSafetyIn			: FB_InfoConnection;
	stInfoSafetyIn 	AT%I*	: ST_InfoDataConnection;
	sStateSafetyIn			: STRING;
	sDiagSafetyIn			: STRING;
	bSafetyInCh1			: BOOL;
	bSafetyInCh2			: BOOL;
	bSafetyInCh3			: BOOL;
	bSafetyInCh4			: BOOL;
	
	// Info EL2904
	fbInfoSafetyOut			: FB_InfoConnection;
	stInfoSafetyOut AT%I*	: ST_InfoDataConnection;
	sStateSafetyOut			: STRING;
	sDiagSafetyOut			: STRING;
	bSafetyOutCh1			: BOOL;
	bSafetyOutCh2			: BOOL;
	bSafetyOutCh3			: BOOL;
	bSafetyOutCh4			: BOOL;
	
	// #6: one reset sequence (ErrAck -> Restart -> STO reset -> check) for the start-up and for resetRequest
	initialStartUpStep		: INT := 0;		// 0 waiting for the safety connections, 10 sequence running, 100 done
	tonWaitConnections		: TON := (PT := T#30S);	// start the sequence anyway if the connections never report data
	bConnectionsUp			: BOOL;			// EL1904 and EL2904 FSoE connections exchange data
	nSeqStep				: INT := 0;		// 0 idle, 10 ErrAck, 20 Restart, 30 STO reset, 40 check
	tonSeqPulse				: TON := (PT := T#1S);	// length of each pulse
	tonSeqCheck				: TON := (PT := T#5S);	// time for the group to reach RUN after the pulses
	bSeqFailed				: BOOL;			// last sequence ended without the group in RUN
	sSeqResult				: STRING(255);

	// external reset request (cabinet/pendant reset button; a remote reset can be OR-ed in by the caller)
	rtrigReset				: R_TRIG;

	ErrAckLog				: FB_EventLog;		// Errack logging
	RestartLog				: FB_EventLog;		// restart logging
	SafetyLog				: FB_EventLog;		// safety logging
	SeqFailedLog			: FB_EventLog;		// #6: start-up/reset sequence did not bring the group to RUN

	fbComm					: I_Comm;
END_VAR
VAR_OUTPUT
	error					: BOOL;		// error condition
	state          			: BOOL;		// safety is okay
	estop					: BOOL;		// Emergency_stop engaged
	bStartupDone			: BOOL;		// #6: the start-up sequence has run once
	bSafetyReady			: BOOL;		// #6: group and E-stop both in RUN
END_VAR
VAR_INPUT
	// issue a remute run/stop
	remote_run		: BOOL := TRUE;
	// rising edge: run the reset sequence ErrAck -> Restart -> STO reset (ignored while one is running).
	// Today the cabinet/pendant reset button; a remote (MQTT) reset would be OR-ed in here (#6, to be decided).
	resetRequest	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Safety is running on start
outRun := remote_run;

// error?
error := inError;

// get safety status
fbInfoGroup1(
	stInfoData	:= stInfoGroup1,
	sState		=> sStateGroup1);
// #6: reported as it is, also during the start-up (was forced TRUE until the start-up sequence had run)
state := sStateGroup1 = 'RUN';

// estop triggered?
fbInfoEStop1(
	stInfoData	:= stInfoEStop1, 
	sState		=> sStateEStop1, 
	sDiag		=> sDiagEStop1);
// #6: reported as it is, also during the start-up (was forced FALSE until then); only the log waits, see SafetyLog
estop := sStateEStop1 <> 'RUN';
bSafetyReady := state AND NOT estop;

//Info SafetyIn EL1904
fbInfoSafetyIn(
	stInfoData		:=stInfoSafetyIn, 
	sState			=>sStateSafetyIn, 
	sDiag			=>sDiagSafetyIn, 
	bChannel1		=>bSafetyInCh1, 
	bChannel2		=>bSafetyInCh2, 
	bChannel3		=>bSafetyInCh3, 
	bChannel4		=>bSafetyInCh4);	
	
//Info SafetyOut EL2904
fbInfoSafetyOut(
	stInfoData		:=stInfoSafetyOut, 
	sState			=>sStateSafetyOut, 
	sDiag			=>sDiagSafetyOut, 
	bChannel1		=>bSafetyOutCh1, 
	bChannel2		=>bSafetyOutCh2, 
	bChannel3		=>bSafetyOutCh3, 
	bChannel4		=>bSafetyOutCh4);
	
// #6: start-up. Wait until the FSoE connections of the EL1904/EL2904 exchange data (they can come up after the PLC,
// e.g. after a power failure) instead of a fixed 2 s, then run the reset sequence once. After 30 s it runs anyway,
// and the check at its end logs if the group did not reach RUN.
bConnectionsUp := sStateSafetyIn = 'State Data' AND sStateSafetyOut = 'State Data';
CASE initialStartUpStep OF
	0:
		tonWaitConnections(IN := TRUE);
		IF bConnectionsUp OR tonWaitConnections.Q THEN
			tonWaitConnections(IN := FALSE);
			nSeqStep := 10;
			bSeqFailed := FALSE;
			initialStartUpStep := 10;
		END_IF
	10:
		IF nSeqStep = 0 THEN
			initialStartUpStep := 100;
		END_IF
END_CASE
bStartupDone := initialStartUpStep = 100;

// external reset request (cabinet/pendant button): same sequence, ignored while one is running
rtrigReset(CLK := resetRequest);
IF rtrigReset.Q AND nSeqStep = 0 AND bStartupDone THEN
	nSeqStep := 10;
	bSeqFailed := FALSE;	// so a repeated failure is logged again
END_IF

// #6: the one reset sequence, the only writer of outErrAck/outRestart/outReset*STO. ErrAck first: while the group is
// in error a Restart has no effect.
CASE nSeqStep OF
	10:	// acknowledge group errors
		outErrAck := TRUE;
		tonSeqPulse(IN := TRUE);
		IF tonSeqPulse.Q THEN
			tonSeqPulse(IN := FALSE);
			outErrAck := FALSE;
			nSeqStep := 20;
		END_IF
	20:	// restart the E-stop function block (FBEstop1.Restart)
		outRestart := TRUE;
		tonSeqPulse(IN := TRUE);
		IF tonSeqPulse.Q THEN
			tonSeqPulse(IN := FALSE);
			outRestart := FALSE;
			nSeqStep := 30;
		END_IF
	30:	// reset STO of the three drives
		outResetAzimuthSTO := TRUE;
		outResetElevationSTO := TRUE;
		outResetDerotatorSTO := TRUE;
		tonSeqPulse(IN := TRUE);
		IF tonSeqPulse.Q THEN
			tonSeqPulse(IN := FALSE);
			outResetAzimuthSTO := FALSE;
			outResetElevationSTO := FALSE;
			outResetDerotatorSTO := FALSE;
			nSeqStep := 40;
		END_IF
	40:	// check: the group should reach RUN shortly after the pulses
		tonSeqCheck(IN := TRUE);
		IF bSafetyReady OR tonSeqCheck.Q THEN
			tonSeqCheck(IN := FALSE);
			bSeqFailed := NOT bSafetyReady;
			sSeqResult := CONCAT(CONCAT(CONCAT('group ', sStateGroup1), ', E-stop '), sStateEStop1);
			sSeqResult := CONCAT(CONCAT(sSeqResult, ', connections '), SEL(bConnectionsUp, 'not exchanging data', 'up'));
			nSeqStep := 0;
		END_IF
END_CASE


ErrAckLog(
	Trigger 	:= outErrAck,
	OnMessage 	:= 'Safety error was acknowledged.',
	Comm		:= fbComm
);
			
RestartLog(	
	Trigger 	:= outRestart,
	Level 		:= ADSLOG_MSGTYPE_WARN,
	OnMessage 	:= 'Safety was restarted.',
	Comm		:= fbComm
);

SafetyLog(	
	Trigger 	:= estop AND bStartupDone,	// #6: no alarm while the safety is still starting up
	Level 		:= ADSLOG_MSGTYPE_ERROR,
	OnMessage 	:= 'Safety Error! Emergency stop engaged!',
	OffMessage 	:= 'Safety is OK.',
	OffLevel 	:= ADSLOG_MSGTYPE_HINT,
	Comm		:= fbComm);
SeqFailedLog(
	Trigger 	:= bSeqFailed,
	Level 		:= ADSLOG_MSGTYPE_ERROR,
	FormatString := 'Safety start/reset did not reach RUN: %s',
	OnMessage 	:= sSeqResult,
	Comm		:= fbComm);
]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{78880c56-5a68-4979-b4f3-852d102d76af}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains	: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode		: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;	      
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbComm := comm;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_MonetSafetyHandling">
      <LineId Id="1" Count="79" />
      <LineId Id="130" Count="21" />
      <LineId Id="189" Count="0" />
    </LineIds>
    <LineIds Name="FB_MonetSafetyHandling.FB_Init">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>