<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_SuspendStop" Id="{4c9a2e71-d6b3-4a58-8f10-72e5b0a3c9d4}" SpecialFunc="None">
    <Declaration><![CDATA[// Does the switch to manual stop the axes (MONETcommon#118)? SuspendAutomatic takes the moves of the automatic mode out of the
// cycle, so a move that is still running is stopped once (one MC_Stop per moving axis, FB_MonetStopTransaction) and then the
// axes go to the pendant. TRUE if an enabled axis is moving (also homing), or if a stop was already running (it is braking:
// the axes report Stopping, not motion). Not during an error (the drives are off).
// Differs from F_ResetMoveAbort: a running park is stopped too, because nothing drives it in manual (bPark is kept).
FUNCTION F_SuspendStop : BOOL
VAR_INPUT
	bError			: BOOL;
	bStopRunning	: BOOL;		// a stop or abort stop was running in the last automatic scan
	bAzMoving		: BOOL;		// enabled AND (InMotion OR InRamp OR Homing), per axis
	bElMoving		: BOOL;
	bDrMoving		: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_SuspendStop := NOT bError AND (bStopRunning OR bAzMoving OR bElMoving OR bDrMoving);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
