<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_GotoStage" Id="{e5264e45-ec8d-4620-aff4-2a92dfa34e94}">
    <Declaration><![CDATA[// #24 step 3a: stage of FB_MonetTelescopeControl._GotoTelescope (property GotoStage). The values are the stage numbers of
// 0.12.0 and earlier, so the log ('GoTo progress: %s') and ADS watch values read as before.
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_GotoStage :
(
	idle := 0,				// waits for bReady AND NOT bBusy
	untrack := 10,			// tracking of the three axes switched off
	start_move := 25,		// targets and velocities written, MoveAxis until all three axes are busy
	wait_moves := 50,		// MoveAxis dropped per axis when its move is done
	wait_standstill := 75,	// all axes at standstill
	done := 100				// goto finished (one call), then idle; bTrack := bAutoTrack
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
