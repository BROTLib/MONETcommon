<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetStopTransaction" Id="{3d6f2b54-8a1e-4c77-9b0d-5e2a17c4f891}" SpecialFunc="None">
    <Declaration><![CDATA[// One MC_Stop per axis and stop transaction (#96), and the transaction only settles when it is really over.
// Before, FB_MonetTelescopeControl._StopTelescope wrote StopAxis on every scan in which an axis was not StandStill. The
// axis block clears bStopAxis on StopDone, but MC_Stop keeps the axis in Stopping for one more call (FB_AxisCommand
// releases Execute only after it has seen Done), so the next scan wrote a fresh FALSE->TRUE edge and restarted MC_Stop on an
// axis that was already at rest. bStop was cleared only when all axes were at standstill in the same scan.
// Here each axis is sent one stop per transaction; the transaction settles when every axis that was sent a stop has
// reported StopDone (a disabled axis counts as done), bStopped has held for nSettleScans scans, and nothing waits for
// anything else. Ported from IAG50cm FB_StopTransaction (#108, #98) to the three axes of the MONETs.
// Pure logic (no axis access), tested offline in MONETcommonTests.
//
// Use: FB_MonetTelescopeControl sets the inputs every scan, calls the body (request logic) while it stops the axes,
// calls Monitor() every scan after bStopped is computed, and writes the outputs to StopAxis. Index 1 = azimuth,
// 2 = elevation, 3 = derotator. A disabled axis is never sent a stop (#150).
FUNCTION_BLOCK FB_MonetStopTransaction
VAR_INPUT
	abEnabled		: ARRAY[1..3] OF BOOL;	// axis is enabled (a disabled axis counts as done)
	abStandStill	: ARRAY[1..3] OF BOOL;	// fbAxis.StandStill (a running MC_Stop reports FALSE)
	abStopAxis		: ARRAY[1..3] OF BOOL;	// the current StopAxis level of the axis block
	abStopDone		: ARRAY[1..3] OF BOOL;	// fbAxis.StopDone
	abMoving		: ARRAY[1..3] OF BOOL;	// fbAxis.InMotion OR fbAxis.InRamp
	abStopping		: ARRAY[1..3] OF BOOL;	// fbAxis.Stopping
	bStopped		: BOOL;					// the whole telescope is at rest
	bTimeout		: BOOL;					// the stop command timeout of the telescope has elapsed
END_VAR
VAR_OUTPUT
	abWriteLow		: ARRAY[1..3] OF BOOL;	// write StopAxis := FALSE in this scan (a level latched from an earlier stop)
	abWriteHigh		: ARRAY[1..3] OF BOOL;	// write StopAxis := TRUE in this scan (the one stop of this transaction)
	bSettled		: BOOL;					// the stop is over: release StopAxis and bStop
	bActive			: BOOL;					// a transaction was begun and has not settled yet
	bForced			: BOOL;					// one scan: settled on the timeout without StopDone from every issued axis
	bStuck			: BOOL;					// one scan: timeout while an axis is still not at standstill
END_VAR
VAR
	abIssued		: ARRAY[1..3] OF BOOL;	// the axis was sent its stop in this transaction, never again
	abDone			: ARRAY[1..3] OF BOOL;	// the axis reported StopDone after it was sent its stop
	abJustIssued	: ARRAY[1..3] OF BOOL;	// issued in this scan: a StopDone seen in the same scan is a leftover
	nStoppedScans	: UINT;					// consecutive scans with bStopped
	bStuckReported	: BOOL;
	i				: UINT;
END_VAR
VAR CONSTANT
	nSettleScans	: UINT := 3;			// 30 ms at the 10 ms task
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[FOR i := 1 TO 3 DO
	abWriteLow[i] := FALSE;
	abWriteHigh[i] := FALSE;
	// #150: a disabled axis is not at StandStill either, but FB_Axis cannot run MC_Stop on it (StopAllowed is FALSE): the
	// request would stay latched and start with the next power-on, which the NC refuses with 0x42EF
	IF NOT abIssued[i] AND NOT abStandStill[i] AND abEnabled[i] THEN
		IF abStopAxis[i] THEN
			// latched from an earlier stop: one scan low, so that the next TRUE is a fresh edge
			abWriteLow[i] := TRUE;
		ELSE
			abWriteHigh[i] := TRUE;
			abIssued[i] := TRUE;
			abJustIssued[i] := TRUE;
		END_IF
	END_IF
END_FOR
]]></ST>
    </Implementation>
    <Method Name="Begin" Id="{a14c8e07-62d3-45b9-8f1a-0c7d93e5b246}">
      <Declaration><![CDATA[// Start a new stop transaction: each axis may be sent one stop again.
METHOD Begin
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	abIssued[i] := FALSE;
	abDone[i] := FALSE;
	abJustIssued[i] := FALSE;
END_FOR
nStoppedScans := 0;
bStuckReported := FALSE;
bActive := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cancel" Id="{e5b97d31-1c48-4a62-b3f0-7d82a6c19e54}">
      <Declaration><![CDATA[// Forget a running transaction (another command took over, reset): nothing waits for it any more.
METHOD Cancel
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bActive := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restart" Id="{7c20f6a9-b385-4d1e-a947-3e16d5b8c072}">
      <Declaration><![CDATA[// A repeated stop while a stop is running (D2): send a new stop only to the axes that are moving again and are not
// already stopping. A client that repeats stop cannot recreate the restart loop of #96.
METHOD Restart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	IF abMoving[i] AND NOT abStopping[i] THEN
		abIssued[i] := FALSE;
		abDone[i] := FALSE;
		abJustIssued[i] := FALSE;
	END_IF
END_FOR
nStoppedScans := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Monitor" Id="{b9d3e482-5a07-4f6c-8e21-c4a0791d3f85}">
      <Declaration><![CDATA[// Call every scan after bStopped is computed. A transaction settles when every axis that was sent a stop has reported
// StopDone (a disabled axis counts as done), the telescope is at rest and has been for nSettleScans scans (the first
// StandStill sample can come before the stop takes hold, IAG50cm#98). On the stop timeout (D1): if the telescope is at
// rest but an issued axis never reported StopDone, it settles anyway (bForced, to be logged and counted); if an axis is
// still not at standstill, bStuck is raised once and the stop is kept (the drives stay enabled).
METHOD Monitor
VAR
	bDoneOk	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bForced := FALSE;
bStuck := FALSE;

bDoneOk := TRUE;
FOR i := 1 TO 3 DO
	IF abStopDone[i] AND abIssued[i] AND NOT abJustIssued[i] THEN
		abDone[i] := TRUE;
	END_IF
	abJustIssued[i] := FALSE;
	IF abIssued[i] AND NOT abDone[i] AND abEnabled[i] THEN
		bDoneOk := FALSE;
	END_IF
END_FOR

IF bStopped THEN
	IF nStoppedScans < nSettleScans THEN
		nStoppedScans := nStoppedScans + 1;
	END_IF
ELSE
	nStoppedScans := 0;
END_IF

IF bActive THEN
	IF bStopped AND nStoppedScans >= nSettleScans AND bDoneOk THEN
		bActive := FALSE;
	ELSIF bTimeout THEN
		IF bStopped AND nStoppedScans >= nSettleScans THEN
			bForced := TRUE;
			bActive := FALSE;
		ELSIF NOT bStopped AND NOT bStuckReported THEN
			bStuck := TRUE;
			bStuckReported := TRUE;
		END_IF
	END_IF
END_IF

// no transaction running: finished as soon as the telescope is at rest
bSettled := NOT bActive AND bStopped;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
