<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MonetSuspendUnderMotion_Tests" Id="{53186e07-66e6-48ea-9e47-a7225a329a42}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of FB_MonetTelescopeControl.SuspendAutomatic (the cabinet selector on manual, #118) on mock axes (plan step 1,
// MONETcommonTests README). These tests pin what the code does today, with the line of the behaviour in a comment; they are not a
// specification. Every test owns a rig and runs over many PLC cycles (VAR_INST of the method, one Scan() per cycle). Failed checks
// are also noted in GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK MonetSuspendUnderMotion_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Suspend_While_Slewing_Stops_Each_Moving_Axis_Once();
Suspend_At_Rest_Sends_No_Stop();
Suspend_During_Park_Stops_The_Park_And_Keeps_bPark();
Suspend_Blocks_The_Jog_While_The_Stop_Runs();
Back_To_Automatic_With_An_Error_Does_Not_Park();
Back_To_Automatic_Requires_Init_Before_Any_Move();
Manual_From_Cold_Start_Does_Not_Fault();
Stop_Twice_In_Manual_From_Cold_Start_Does_Not_Fault();
Manual_From_Cold_Start_Then_Automatic_Requires_Init();
Manual_Estop_And_Safety_Error_Show_Error_In_ReadyState();
Manual_Safety_Input_Does_Not_Command_The_Axes();
]]></ST>
    </Implementation>
    <Method Name="Manual_Estop_And_Safety_Error_Show_Error_In_ReadyState" Id="{6f2d8a41-3b9e-4c57-8d10-a1e5c7b94f31}">
      <Declaration><![CDATA[// #168 (small alternative): the live E-stop, safety error and power failure of MAIN reach the READY_STATE heartbeat in manual (-1.0).
// Before: the heartbeat used the values of the last automatic scan and stayed -2.0 / 0.0. Telemetry only.
METHOD PRIVATE Manual_Estop_And_Safety_Error_Show_Error_In_ReadyState
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nElevStop	: UINT;
	nElevReset	: UINT;
	nAzimStop	: UINT;
	nAzimReset	: UINT;
	nDeroStop	: UINT;
	nDeroReset	: UINT;
	nHydDisable	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Manual_Estop_And_Safety_Error_Show_Error_In_ReadyState');
sTest := 'Manual_Estop_And_Safety_Error_Show_Error_In_ReadyState: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: switch to manual
	IF rig.Online THEN
		rig.SetManual(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// manual, at rest: -2.0, then the E-stop is pressed
	IF nCycles >= 30 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 in manual at rest');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 in manual at rest'));
		rig.SetEstop(TRUE);
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// the E-stop pressed in manual reaches the heartbeat
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'E-stop in manual: READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'E-stop in manual: READY_STATE -1.0'));
		rig.SetEstop(FALSE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// released in manual: back to -2.0 at once (not stuck until the return)
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'E-stop released in manual: READY_STATE -2.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'E-stop released in manual: READY_STATE -2.0'));
		rig.SetSafetyError(TRUE);
		nStep := 50;
		nCycles := 0;
	END_IF
50:	// safety error alone (decision D1: -1.0 in manual)
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'safety error in manual: READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'safety error in manual: READY_STATE -1.0'));
		rig.SetSafetyError(FALSE);
		nStep := 60;
		nCycles := 0;
	END_IF
60:	// safety error cleared
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'safety error cleared in manual: READY_STATE -2.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'safety error cleared in manual: READY_STATE -2.0'));
		rig.SetMainReady(FALSE);
		nStep := 70;
		nCycles := 0;
	END_IF
70:	// power failure starting in manual
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'power failure in manual: READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'power failure in manual: READY_STATE -1.0'));
		rig.SetMainReady(TRUE);
		nStep := 80;
		nCycles := 0;
	END_IF
80:
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'power restored in manual: READY_STATE -2.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'power restored in manual: READY_STATE -2.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Manual_Safety_Input_Does_Not_Command_The_Axes" Id="{9b4e1c73-5a2d-4f86-b3e9-2d7a0c618e54}">
      <Declaration><![CDATA[// #168: the inputs of SuspendAutomatic are telemetry. With the elevation jogged by the operator in manual, an E-stop, a safety error
// and a power failure make no stop, reset or disable request and do not force the jog off.
METHOD PRIVATE Manual_Safety_Input_Does_Not_Command_The_Axes
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nElevStop	: UINT;
	nElevReset	: UINT;
	nAzimStop	: UINT;
	nAzimReset	: UINT;
	nDeroStop	: UINT;
	nDeroReset	: UINT;
	nHydDisable	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Manual_Safety_Input_Does_Not_Command_The_Axes');
sTest := 'Manual_Safety_Input_Does_Not_Command_The_Axes: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: switch to manual
	IF rig.Online THEN
		rig.SetManual(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// manual: the operator holds the jog button
	IF nCycles >= 30 THEN
		rig.JogElevation(TRUE);
		nStep := 25;
		nCycles := 0;
	END_IF
25:	// record the command counters, then raise the safety inputs
	IF nCycles >= 10 THEN
		nElevStop := rig.fbElev.nStopEdges;
		nElevReset := rig.fbElev.nResetEdges;
		nAzimStop := rig.fbAzim.nStopEdges;
		nAzimReset := rig.fbAzim.nResetEdges;
		nDeroStop := rig.fbDero.nStopEdges;
		nDeroReset := rig.fbDero.nResetEdges;
		nHydDisable := rig.fbBrakeHyd.nDisableCalls;
		rig.SetEstop(TRUE);
		rig.SetSafetyError(TRUE);
		rig.SetMainReady(FALSE);
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// E-stop, safety error and power failure in manual write nothing from the telescope control
	IF nCycles >= 50 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'the heartbeat shows the error');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the heartbeat shows the error'));
		AssertTrue(Condition := rig.fbElev.MovePos, Message := 'the operator's jog request is not forced off');
		F_Note(bFailed := NOT (rig.fbElev.MovePos), sText := CONCAT(sTest, 'the operator's jog request is not forced off'));
		AssertTrue(Condition := rig.fbElev.nStopEdges = nElevStop AND rig.fbAzim.nStopEdges = nAzimStop AND rig.fbDero.nStopEdges = nDeroStop, Message := 'no stop request to an axis');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = nElevStop AND rig.fbAzim.nStopEdges = nAzimStop AND rig.fbDero.nStopEdges = nDeroStop), sText := CONCAT(sTest, 'no stop request to an axis'));
		AssertTrue(Condition := rig.fbElev.nResetEdges = nElevReset AND rig.fbAzim.nResetEdges = nAzimReset AND rig.fbDero.nResetEdges = nDeroReset, Message := 'no reset to an axis');
		F_Note(bFailed := NOT (rig.fbElev.nResetEdges = nElevReset AND rig.fbAzim.nResetEdges = nAzimReset AND rig.fbDero.nResetEdges = nDeroReset), sText := CONCAT(sTest, 'no reset to an axis'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls = nHydDisable, Message := 'hydraulics are not switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls = nHydDisable), sText := CONCAT(sTest, 'hydraulics are not switched off'));
		AssertTrue(Condition := NOT rig.fbTel.bSuspendStop AND NOT rig.fbTel.bResetActive, Message := 'no suspend stop and no reset latch');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSuspendStop AND NOT rig.fbTel.bResetActive), sText := CONCAT(sTest, 'no suspend stop and no reset latch'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspend_While_Slewing_Stops_Each_Moving_Axis_Once" Id="{88ce4633-9cab-43b1-ad84-da63f2946a81}">
      <Declaration><![CDATA[// M:1324 SuspendAutomatic (#118): the switch to manual while the axes move stops each moving axis once (the abort stop), drops the
// slew and then releases the axes. In manual the telescope is never online (FB_StartupControl.Suspend: READY_STATE -2.0).
METHOD PRIVATE Suspend_While_Slewing_Stops_Each_Moving_Axis_Once
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Suspend_While_Slewing_Stops_Each_Moving_Axis_Once');
sTest := 'Suspend_While_Slewing_Stops_Each_Moving_Axis_Once: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slew
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the slew moves all three axes
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// let the moves run for a few scans, then switch to manual
	IF nCycles >= 5 THEN
		rig.SetManual(TRUE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// wait until the stop has settled
	IF NOT rig.fbTel.bMoveAbortPending AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbElev.nStopEdges = 1 AND rig.fbAzim.nStopEdges = 1 AND rig.fbDero.nStopEdges = 1, Message := 'each moving axis was stopped once');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 1 AND rig.fbAzim.nStopEdges = 1 AND rig.fbDero.nStopEdges = 1), sText := CONCAT(sTest, 'each moving axis was stopped once'));
		AssertFalse(Condition := rig.fbTel.bSlewActive, Message := 'the slew is dropped');
		F_Note(bFailed := (rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the slew is dropped'));
		AssertFalse(Condition := rig.fbTel.bSuspendStop, Message := 'the suspend stop is over');
		F_Note(bFailed := (rig.fbTel.bSuspendStop), sText := CONCAT(sTest, 'the suspend stop is over'));
		AssertTrue(Condition := rig.fbTel.ReadyState <> 1.0, Message := 'never online in manual');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState <> 1.0), sText := CONCAT(sTest, 'never online in manual'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspend_At_Rest_Sends_No_Stop" Id="{7e4fa74e-28e0-401a-baa8-dffdce308633}">
      <Declaration><![CDATA[// M:1324: nothing moves (F_SuspendStop is FALSE), so the switch to manual stops nothing; the telescope just goes to READY_STATE -2.0.
METHOD PRIVATE Suspend_At_Rest_Sends_No_Stop
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Suspend_At_Rest_Sends_No_Stop');
sTest := 'Suspend_At_Rest_Sends_No_Stop: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online, at rest: switch to manual
	IF rig.Online THEN
		rig.SetManual(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF nCycles >= 30 THEN
		AssertTrue(Condition := rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0, Message := 'no axis was stopped');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0), sText := CONCAT(sTest, 'no axis was stopped'));
		AssertFalse(Condition := rig.fbTel.bSuspendStop OR rig.fbTel.bMoveAbortPending, Message := 'no stop is running');
		F_Note(bFailed := (rig.fbTel.bSuspendStop OR rig.fbTel.bMoveAbortPending), sText := CONCAT(sTest, 'no stop is running'));
		AssertTrue(Condition := rig.fbTel.ReadyState <> 1.0, Message := 'never online in manual');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState <> 1.0), sText := CONCAT(sTest, 'never online in manual'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspend_During_Park_Stops_The_Park_And_Keeps_bPark" Id="{6ba2379c-cc4b-4d51-8ed6-e99b8fd09b11}">
      <Declaration><![CDATA[// M:1324, F_SuspendStop: a running park is stopped too, because nothing drives it in manual; bPark is kept, the park restarts
// in automatic.
METHOD PRIVATE Suspend_During_Park_Stops_The_Park_And_Keeps_bPark
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Suspend_During_Park_Stops_The_Park_And_Keeps_bPark');
sTest := 'Suspend_During_Park_Stops_The_Park_And_Keeps_bPark: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: park
	IF rig.Online THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park drives the three axes
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// let the park run for a few scans, then switch to manual
	IF nCycles >= 5 THEN
		rig.SetManual(TRUE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF NOT rig.fbTel.bMoveAbortPending AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbElev.nStopEdges = 1 AND rig.fbAzim.nStopEdges = 1 AND rig.fbDero.nStopEdges = 1, Message := 'the park motion was stopped, once per axis');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 1 AND rig.fbAzim.nStopEdges = 1 AND rig.fbDero.nStopEdges = 1), sText := CONCAT(sTest, 'the park motion was stopped, once per axis'));
		AssertTrue(Condition := rig.fbTel.bParkActive, Message := 'bPark is kept');
		F_Note(bFailed := NOT (rig.fbTel.bParkActive), sText := CONCAT(sTest, 'bPark is kept'));
		AssertFalse(Condition := rig.fbTel.bIsParked, Message := 'the telescope is not parked');
		F_Note(bFailed := (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the telescope is not parked'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspend_Blocks_The_Jog_While_The_Stop_Runs" Id="{0dfa9476-d187-405c-bfcc-edc74f3b564d}">
      <Declaration><![CDATA[// M:1385-1390: the NC rejects a jog while MC_Stop runs, which would raise an axis error: while the suspend stop runs the jog
// requests of the pendant are forced off.
METHOD PRIVATE Suspend_Blocks_The_Jog_While_The_Stop_Runs
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Suspend_Blocks_The_Jog_While_The_Stop_Runs');
sTest := 'Suspend_Blocks_The_Jog_While_The_Stop_Runs: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slew
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the operator holds the up button, then switches to manual
	IF nCycles >= 5 THEN
		rig.JogElevation(TRUE);
		rig.SetManual(TRUE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// the first manual scan has run
	IF nCycles = 1 THEN
		AssertTrue(Condition := rig.fbTel.bSuspendStop, Message := 'a suspend stop is running');
		F_Note(bFailed := NOT (rig.fbTel.bSuspendStop), sText := CONCAT(sTest, 'a suspend stop is running'));
		AssertFalse(Condition := rig.fbElev.MovePos, Message := 'the jog request is forced off while the stop runs');
		F_Note(bFailed := (rig.fbElev.MovePos), sText := CONCAT(sTest, 'the jog request is forced off while the stop runs'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Back_To_Automatic_With_An_Error_Does_Not_Park" Id="{09ef304f-7e22-4201-96a2-85ef54ae4814}">
      <Declaration><![CDATA[// M:1334 (#86): an axis error that appears while the selector is on manual must not start the emergency park when automatic comes
// back (bHwErrorLast is set on entering the suspension, so there is no rising edge).
METHOD PRIVATE Back_To_Automatic_With_An_Error_Does_Not_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Back_To_Automatic_With_An_Error_Does_Not_Park');
sTest := 'Back_To_Automatic_With_An_Error_Does_Not_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: switch to manual
	IF rig.Online THEN
		rig.SetManual(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// in manual, an axis error appears
	IF nCycles >= 10 THEN
		rig.InjectElevationError(16#4550);
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// back to automatic
	IF nCycles >= 10 THEN
		rig.SetManual(FALSE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF nCycles >= 60 THEN
		AssertTrue(Condition := rig.fbTel.bError, Message := 'the error is still there');
		F_Note(bFailed := NOT (rig.fbTel.bError), sText := CONCAT(sTest, 'the error is still there'));
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'no emergency park');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no emergency park'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers were not closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers were not closed'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Back_To_Automatic_Requires_Init_Before_Any_Move" Id="{72b3d6f1-8a4c-4e17-b5d9-3c0a91e7f272}">
      <Declaration><![CDATA[// #72: a completed startup that only visited manual mode needs a new Init: back in automatic moves are rejected (init_required),
// nothing moves, READY_STATE stays -2.0; after the Init the latch is cleared and a slew is accepted again.
METHOD PRIVATE Back_To_Automatic_Requires_Init_Before_Any_Move
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Back_To_Automatic_Requires_Init_Before_Any_Move');
sTest := 'Back_To_Automatic_Requires_Init_Before_Any_Move: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: switch to manual
	IF rig.Online THEN
		AssertFalse(Condition := rig.fbTel.InitRequired, Message := 'no init required after a completed startup');
		F_Note(bFailed := (rig.fbTel.InitRequired), sText := CONCAT(sTest, 'no init required after a completed startup'));
		rig.SetManual(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// in manual: the latch is set at once, back to automatic
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.fbTel.InitRequired, Message := 'init required in manual');
		F_Note(bFailed := NOT (rig.fbTel.InitRequired), sText := CONCAT(sTest, 'init required in manual'));
		rig.SetManual(FALSE);
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// back in automatic: moves are rejected
	IF nCycles >= 5 THEN
		AssertTrue(Condition := rig.fbTel.InitRequired, Message := 'init still required in automatic');
		F_Note(bFailed := NOT (rig.fbTel.InitRequired), sText := CONCAT(sTest, 'init still required in automatic'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 before the Init');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 before the Init'));
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		AssertFalse(Condition := rig.fbTel.bSlewActive, Message := 'the slew method is rejected');
		F_Note(bFailed := (rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the slew method is rejected'));
		AssertTrue(Condition := rig.fbTel.eLastRejectReason = MONETcommon.E_CommandRejectReason.init_required, Message := 'reason init_required');
		F_Note(bFailed := NOT (rig.fbTel.eLastRejectReason = MONETcommon.E_CommandRejectReason.init_required), sText := CONCAT(sTest, 'reason init_required'));
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// nothing moves
	IF nCycles >= 30 THEN
		AssertFalse(Condition := rig.fbTel.bGotoActive OR rig.fbTel.bSlewActive, Message := 'no move flag survives');
		F_Note(bFailed := (rig.fbTel.bGotoActive OR rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'no move flag survives'));
		AssertFalse(Condition := rig.fbElev.MoveAxis OR rig.fbAzim.MoveAxis OR rig.fbDero.MoveAxis, Message := 'no axis moves');
		F_Note(bFailed := (rig.fbElev.MoveAxis OR rig.fbAzim.MoveAxis OR rig.fbDero.MoveAxis), sText := CONCAT(sTest, 'no axis moves'));
		rig.fbTel.Init();
		nStep := 50;
		nCycles := 0;
	END_IF
50:	// the new Init completes: the latch is cleared and a slew is accepted again
	IF rig.Online THEN
		AssertFalse(Condition := rig.fbTel.InitRequired, Message := 'init no longer required after the new startup');
		F_Note(bFailed := (rig.fbTel.InitRequired), sText := CONCAT(sTest, 'init no longer required after the new startup'));
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 60;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the new startup did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the new startup did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
60:
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew after the new Init was not accepted');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew after the new Init was not accepted'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Manual_From_Cold_Start_Does_Not_Fault" Id="{c4a1f0e2-6b7d-4e35-9a18-5d2f7b903e56}">
      <Declaration><![CDATA[// #156: the PLC starts with the cabinet selector on manual, so the telescope body never ran and fbAzimuth/fbElevation/fbDerotator
// are unassigned references. SuspendAutomatic must not touch them (before the fix: page fault, the run crashes). The telescope
// is never online (READY_STATE 1.0) and no axis is driven.
METHOD PRIVATE Manual_From_Cold_Start_Does_Not_Fault
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Manual_From_Cold_Start_Does_Not_Fault');
sTest := 'Manual_From_Cold_Start_Does_Not_Fault: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// the first scan after the reset is already a manual scan
	IF nCycles = 1 THEN
		rig.SetManual(TRUE);
	END_IF
	IF nCycles >= 20 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState <> 1.0, Message := 'never online in manual');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState <> 1.0), sText := CONCAT(sTest, 'never online in manual'));
		AssertFalse(Condition := rig.fbElev.MoveAxis OR rig.fbAzim.MoveAxis OR rig.fbDero.MoveAxis, Message := 'no axis moves');
		F_Note(bFailed := (rig.fbElev.MoveAxis OR rig.fbAzim.MoveAxis OR rig.fbDero.MoveAxis), sText := CONCAT(sTest, 'no axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Twice_In_Manual_From_Cold_Start_Does_Not_Fault" Id="{d7b2e913-0c4a-4f68-8e21-6a3c9d0f1b47}">
      <Declaration><![CDATA[// #156: Stop() calls fbFocus.Stop() when a stop is already running (#122). After a cold start in manual fbFocus is unassigned and
// bStop stays set (only the body releases it), so the second Stop() used to call a method on a null interface.
METHOD PRIVATE Stop_Twice_In_Manual_From_Cold_Start_Does_Not_Fault
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Twice_In_Manual_From_Cold_Start_Does_Not_Fault');
sTest := 'Stop_Twice_In_Manual_From_Cold_Start_Does_Not_Fault: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:
	IF nCycles = 1 THEN
		rig.SetManual(TRUE);
	END_IF
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 10;
		nCycles := 0;
	END_IF
10:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	END_IF
20:
	IF nCycles >= 5 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState <> 1.0, Message := 'never online after two stops in manual');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState <> 1.0), sText := CONCAT(sTest, 'never online after two stops in manual'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Manual_From_Cold_Start_Then_Automatic_Requires_Init" Id="{e9c3f024-1d5b-4a79-9f32-7b4d0e1a2c58}">
      <Declaration><![CDATA[// #156: after a cold start in manual, the first automatic scan assigns the references and the guard is lifted. The telescope is
// not initialized: a slew is rejected until a new Init, which then completes as after any start.
METHOD PRIVATE Manual_From_Cold_Start_Then_Automatic_Requires_Init
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Manual_From_Cold_Start_Then_Automatic_Requires_Init');
sTest := 'Manual_From_Cold_Start_Then_Automatic_Requires_Init: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// cold start in manual
	IF nCycles = 1 THEN
		rig.SetManual(TRUE);
	END_IF
	IF nCycles >= 10 THEN
		rig.SetManual(FALSE);
		nStep := 10;
		nCycles := 0;
	END_IF
10:	// automatic: wait for the clock, a slew is rejected before the Init
	IF rig.ClockValid AND nCycles >= 5 THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		AssertFalse(Condition := rig.fbTel.bSlewActive, Message := 'the slew is rejected before the Init');
		F_Note(bFailed := (rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the slew is rejected before the Init'));
		rig.fbTel.Init();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the Init completes
	IF rig.Online THEN
		AssertFalse(Condition := rig.fbTel.InitRequired, Message := 'init no longer required after the Init');
		F_Note(bFailed := (rig.fbTel.InitRequired), sText := CONCAT(sTest, 'init no longer required after the Init'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the Init did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the Init did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
