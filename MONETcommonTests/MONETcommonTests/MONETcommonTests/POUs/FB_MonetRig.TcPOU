<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetRig" Id="{60e92a7a-02cd-4e48-8d20-abdb7dc0369f}" SpecialFunc="None">
    <Declaration><![CDATA[// The MONET telescope (FB_MonetTelescopeControl) on mock axes, scanned in the MONETS MAIN order (telescope first, then
// the axes). One Scan() is one PLC scan. The scenario tests own one rig each (VAR_INST of the test method) and call Scan()
// once per PLC cycle: the astronomical clock needs a real NT_GetTime round trip (up to about 5 s) before the telescope
// accepts a goto/slew/track, so a rig is not usable before ClockValid. Everything else counts scans, not time.
// Plan: BROTLib specs/plans/2026-10-21-telescope-state-machine-unification.md (D1, step 1).
FUNCTION_BLOCK FB_MonetRig
VAR
	fbComm			: FB_NullComm;
	fbElev			: FB_ElevationMock(comm := fbComm);
	fbAzim			: FB_AzimuthMock(comm := fbComm);
	fbDero			: FB_DerotatorMock(comm := fbComm);
	fbFocus			: FB_FocusMock(comm := fbComm);
	fbCovers		: FB_CoversMock(comm := fbComm);	// a HalfBROT.FB_CoverControl subclass, its FB_Init takes comm
	fbBrakeHyd		: FB_BrakeHydraulicsMock;
	fbPointing		: FB_PointingModelForward(AOFF := 0.0, BNP := 0.0, AN_A := 0.0, AE_A := 0.0, NPAE := 0.0, EOFF := 0.0, AN_E := 0.0, AE_E := 0.0, TF := 0.0);	// zero coefficients
	fbPointingInv	: FB_PointingModelInversion(fbPointing := fbPointing);
	fbTel			: FB_MonetTelescopeControl(comm := fbComm);
	fbWatchdog		: FB_MonetMqttWatchdog(comm := fbComm);	// for MonetSafeState_Tests (a method VAR_INST cannot refer to a sibling in its init list)
	nScans			: UDINT;
	bManual			: BOOL;	// MAIN calls SuspendAutomatic instead of the body while the cabinet selector is on manual
	nTimeDivisor	: UDINT := 1;	// the time seam of the telescope under test (SetTimeDivisor)
	bEstopIn		: BOOL;	// SafetyHandling.estop
	bSafetyIn		: BOOL;	// SafetyHandling.error
	bMainReadyIn	: BOOL := TRUE;	// PowerMonitoring.phaseOK (MAIN: bMainReady := ready)
	stMotion		: BROTLib.ST_MotionConfig;	// stMotion of the telescope under test (SetMotion), default = the struct defaults (#24 step 2c)
	fElevationMoveVelocityIn	: LREAL := 5.0;	// the deprecated alias input (SetElevationMoveVelocity), default = its old default; MONETS MAIN passes 3.0
END_VAR
VAR CONSTANT
	telescopeConfig	: ST_TelescopeConfig := (longitude := 20.810808, latitude := -32.375823, altitude := 1798.0,
											 azimuthPark := 175, elevationPark := 60, derotatorPark := 0, focusPark := 36.0,
											 azimuthHome := 175, elevationHome := 40, derotatorHome := 0,
											 name := 'MONET/S', diameter := 1.2, cabinet := 'Beckhoff', manufacturer := 'test',
											 mountOptions := 'ALT-AZ', mount := 'ALT_AZ');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Method Name="SetHomeScans" Id="{8a18ef85-bb7c-4844-b14a-04199381c5b4}">
      <Declaration><![CDATA[// scans a homing takes on the three mock axes (default 3): a test that wants to act while the axes are homing makes it longer
METHOD SetHomeScans
VAR_INPUT
	nScans	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbElev.nMockHomeScans := nScans;
fbAzim.nMockHomeScans := nScans;
fbDero.nMockHomeScans := nScans;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMoveScans" Id="{65c9910e-1c65-4968-95a1-8c415702ba7d}">
      <Declaration><![CDATA[// scans a move takes on the three mock axes (default 60)
METHOD SetMoveScans
VAR_INPUT
	nScans	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbElev.nMockMoveScans := nScans;
fbAzim.nMockMoveScans := nScans;
fbDero.nMockMoveScans := nScans;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetStopScans" Id="{d676b49d-f214-4b42-a004-df2964ff2f3e}">
      <Declaration><![CDATA[// scans an MC_Stop takes on the three mock axes (default 3); a very large value is an axis that never reports standstill
METHOD SetStopScans
VAR_INPUT
	nScans	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbElev.nMockStopScans := nScans;
fbAzim.nMockStopScans := nScans;
fbDero.nMockStopScans := nScans;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetTimeDivisor" Id="{ebf41625-64f0-473d-96e0-0430a16c873f}">
      <Declaration><![CDATA[// divides every long timeout of the telescope (600 s, 2 min, 12 h) by nValue, for this rig only (1 = real times)
METHOD SetTimeDivisor
VAR_INPUT
	nValue	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nTimeDivisor := nValue;
fbTel.nTimeDivisor := nValue;	// also in manual, where the body (and its input list) is not called
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Scan" Id="{121ba66a-36ff-4009-9705-7efd4e908f1b}">
      <Declaration><![CDATA[METHOD Scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bManual THEN
	fbTel.SuspendAutomatic();
ELSE
	fbTel(
		telescopeConfig := telescopeConfig,
		fbCovers := fbCovers,
		fbBrake := fbBrakeHyd,
		fbHydraulics := fbBrakeHyd,
		fbFocus := fbFocus,
		fbElevation := fbElev,
		fbAzimuth := fbAzim,
		fbDerotator := fbDero,
		fbPointing := fbPointing,
		fbPointingInverse := fbPointingInv,
		bEstopTriggered := bEstopIn,
		bSafetyError := bSafetyIn,
		bMainReady := bMainReadyIn,
		stMotion := stMotion,
		fElevationMoveVelocity := fElevationMoveVelocityIn,
		nTimeDivisor := nTimeDivisor);
END_IF
fbCovers();	// after the telescope, as MAIN calls CoverControl(); only the travel model (SetCoverTravelScans) runs in it
fbElev(fbCovers := fbCovers, fbBrake := fbBrakeHyd);
fbAzim();
fbDero();
fbFocus();
nScans := nScans + 1;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClockValid" Id="{3076ff3c-98ad-4dc0-97fb-ed4821c83c33}">
      <Declaration><![CDATA[PROPERTY ClockValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{bc2a52f7-905d-4428-b9c8-29b6c1c1c00d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClockValid := fbTel.fbTime.bValid;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Online" Id="{d88bbb8d-d30d-4985-b3f0-0b0b689944f1}">
      <Declaration><![CDATA[PROPERTY Online : BOOL]]></Declaration>
      <Get Name="Get" Id="{fa836018-c28d-4e5d-becc-884b5bb557c9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Online := fbTel.ReadyState = 1.0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetMotion" Id="{a8848ecf-4ba6-4d7f-95e4-4a32a59465d5}">
      <Declaration><![CDATA[// stMotion of the telescope under test (#24 step 2c), handed to it from the next Scan() on; the default is the struct defaults
METHOD SetMotion
VAR_INPUT
	stValue	: BROTLib.ST_MotionConfig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stMotion := stValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetElevationMoveVelocity" Id="{62399cab-459e-47e6-bff3-27d83498d3ec}">
      <Declaration><![CDATA[// the deprecated alias input fElevationMoveVelocity of the telescope (#24 D2); 5.0 (default) = not used, MONETS MAIN passes 3.0
METHOD SetElevationMoveVelocity
VAR_INPUT
	fValue	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fElevationMoveVelocityIn := fValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetManual" Id="{7367e2f8-5967-47be-afd4-0d6ea17370fa}">
      <Declaration><![CDATA[// the cabinet selector: TRUE = manual (the telescope body is not called, SuspendAutomatic is)
METHOD SetManual
VAR_INPUT
	bValue	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bManual := bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetCoverTravelScans" Id="{44131a3b-7ab9-4087-a9e2-27fc7d8d14c2}">
      <Declaration><![CDATA[// scans a full open or close of the mock covers takes (default 0: at once); > 0 lets a test press the E-stop during a cover run
METHOD SetCoverTravelScans
VAR_INPUT
	nScans	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbCovers.nMockTravelScans := nScans;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEstop" Id="{f76d3ba5-df1c-4f8b-afcc-6f56a0d9547e}">
      <Declaration><![CDATA[// the E-stop input of the telescope
METHOD SetEstop
VAR_INPUT
	bValue	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bEstopIn := bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSafetyError" Id="{a8622214-e2e0-447a-aac1-516f64995742}">
      <Declaration><![CDATA[// the safety error input of the telescope (SafetyHandling.error, #155)
METHOD SetSafetyError
VAR_INPUT
	bValue	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bSafetyIn := bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSlewFlag" Id="{acff02fe-462d-4119-ba0f-3270ddb40627}">
      <Declaration><![CDATA[// writes the slew flag of the telescope directly (an ADS write); the methods reject a move before it is set while the clock is invalid
METHOD SetSlewFlag
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTel.bSlew := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSlewInput" Id="{7befd08b-db5e-4357-97aa-6eb3458cdf4a}">
      <Declaration><![CDATA[// #24 step 5: the slew input of the telescope as a level (an ADS write or a Visu button held or released); the telescope never
// writes it, its rising edge is the command
METHOD SetSlewInput
VAR_INPUT
	bValue	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTel.bSlew := bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSlewTargetInput" Id="{26be7ad4-8976-4b6a-86eb-973975e56a4f}">
      <Declaration><![CDATA[// #24 step 5: the target inputs a slew input uses (what the Visu writes before the button: fAzimuth, fElevation)
METHOD SetSlewTargetInput
VAR_INPUT
	fAzimuth	: LREAL;
	fAltitude	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTel.fAzimuth := fAzimuth;
fbTel.fElevation := fAltitude;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMainReady" Id="{83eaab32-d382-48b6-babc-99dec72544d2}">
      <Declaration><![CDATA[// the power input of the telescope (bMainReady, MAIN: PowerMonitoring.phaseOK); FALSE = power failure. Default TRUE.
METHOD SetMainReady
VAR_INPUT
	bValue	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bMainReadyIn := bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="JogElevation" Id="{99a17950-974a-44cd-b2a3-f86293f3314d}">
      <Declaration><![CDATA[// the pendant jog button for the elevation (up)
METHOD JogElevation
VAR_INPUT
	bValue	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbElev.MovePos := bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="InjectElevationError" Id="{4c2738fe-bd1d-4e40-8884-048309dc8e4b}">
      <Declaration><![CDATA[METHOD InjectElevationError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbElev.InjectError(nId);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="InjectAzimuthError" Id="{5857afe2-6b7e-47e4-849f-b3e7bfb14aca}">
      <Declaration><![CDATA[METHOD InjectAzimuthError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAzim.InjectError(nId);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="InjectFocusError" Id="{f0de967d-0d68-41a5-ad3e-328e6c9af1d2}">
      <Declaration><![CDATA[METHOD InjectFocusError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbFocus.InjectError(nId);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="InjectDerotatorError" Id="{b1bf17dc-df53-46f0-a8d3-000210700a06}">
      <Declaration><![CDATA[METHOD InjectDerotatorError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbDero.InjectError(nId);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
