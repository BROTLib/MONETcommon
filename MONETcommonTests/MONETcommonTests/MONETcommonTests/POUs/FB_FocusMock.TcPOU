<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusMock" Id="{d60c6dd3-7d7e-4718-8066-31cf2190e8dd}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of FB_FocusControl (an I_Focus) for the telescope state machine tests (MONETcommon#36). Status only: the real focus
// block positions itself in automatic mode, the mock follows fPosition when the telescope asks for a move.
FUNCTION_BLOCK FB_FocusMock EXTENDS HalfBROT.FB_FocusControl
VAR
	fbCore	: FB_AxisMockCore;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// No SUPER^(): the real body (MC_* blocks, AXIS_REF) does not run. The real property setters (MoveAxis -> fbAxis.MoveTo(),
// StopAxis -> fbAxis.Stop(), HomeAxis -> _StartHoming) stay, so the telescope sees the real command interface. The model
// is driven by the levels the telescope writes and writes what the telescope reads: the base outputs and the nested
// fbAxis outputs.
fbCore(bEnable := bEnable, bHome := bHomeAxis, bMove := bMoveAxis, fTarget := fPosition);

fbAxis.Ready := fbCore.bReady;
fbAxis.Calibrated := fbCore.bCalibrated;
fbAxis.HomeDone := fbCore.bCalibrated;
fbAxis.HomeActive := fbCore.bHoming;
fbAxis.Homing := fbCore.bHoming;
fbAxis.InMotion := fbCore.bInMotion;
fbAxis.StandStill := fbCore.bStandStill;
fbAxis.MoveDone := fbCore.bMoveDone;
fbAxis.Busy := fbCore.bInMotion OR fbCore.bHoming;
fbAxis.ActualPosition := fbCore.fPosition;

bReady := fbCore.bReady AND fbCore.bStandStill;
bCalibrated := fbCore.bCalibrated;
fActualPosition := fbCore.fPosition;

// the real control body clears the level on MoveDone
IF fbCore.bMoveDone THEN
	bMoveAxis := FALSE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
