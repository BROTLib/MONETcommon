<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusMock" Id="{a35603b3-030a-4de3-a67d-dbbefdf04315}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of FB_FocusControl (an I_Focus) for the telescope state machine tests (MONETcommon#36). Status only: the real focus
// block positions itself in automatic mode, the mock follows fPosition when the telescope asks for a move.
FUNCTION_BLOCK FB_FocusMock EXTENDS HalfBROT.FB_FocusControl
VAR
	fbCore	: FB_AxisMockCore;
	pBool	: POINTER TO BOOL;
	pLreal	: POINTER TO LREAL;
	bInjected	: BOOL;
	nInjectedId	: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// No SUPER^(): the real body (MC_* blocks, AXIS_REF) does not run. The real property setters (MoveAxis -> fbAxis.MoveTo(),
// StopAxis -> fbAxis.Stop(), HomeAxis -> _StartHoming) stay, so the telescope sees the real command interface. The model
// is driven by the levels the telescope writes and writes what the telescope reads: the base outputs and the nested
// fbAxis outputs.
// HalfBROT 0.6.0: the real focus starts its moves with FB_MoveFollower, there is no bMoveAxis level any more. The body
// that does that does not run here, and nothing in the rig wrote the old level, so the mock never moved: unchanged.
fbCore(bEnable := bEnable, bHome := bHomeAxis, bMove := FALSE, fTarget := fPosition);

// outputs of FB_Axis cannot be written from outside (C: 'is no input of'), a pointer sidesteps that (as FB_Axis_Tests.SetActPos)
pBool := ADR(fbAxis.Ready);			pBool^ := fbCore.bReady;
pBool := ADR(fbAxis.Calibrated);	pBool^ := fbCore.bCalibrated;
pBool := ADR(fbAxis.HomeDone);		pBool^ := fbCore.bCalibrated;
pBool := ADR(fbAxis.HomeActive);	pBool^ := fbCore.bHoming;
pBool := ADR(fbAxis.Homing);		pBool^ := fbCore.bHoming;
pBool := ADR(fbAxis.InMotion);		pBool^ := fbCore.bInMotion;
pBool := ADR(fbAxis.StandStill);	pBool^ := fbCore.bStandStill;
pBool := ADR(fbAxis.MoveDone);		pBool^ := fbCore.bMoveDone;
pBool := ADR(fbAxis.Busy);			pBool^ := fbCore.bInMotion OR fbCore.bHoming;
pLreal := ADR(fbAxis.ActualPosition);	pLreal^ := fbCore.fPosition;

bReady := fbCore.bReady AND fbCore.bStandStill;
bCalibrated := fbCore.bCalibrated;
fActualPosition := fbCore.fPosition;

IF bReset THEN
	bReset := FALSE;	// ResetDone at once
	bInjected := FALSE;
END_IF
bError := bInjected;
nErrorID := nInjectedId;
]]></ST>
    </Implementation>
    <Method Name="InjectError" Id="{5d1887e1-3dbd-44f6-ba4b-460d34da292d}">
      <Declaration><![CDATA[// the axis reports an error with this id until the telescope resets it (bError/nErrorID are what the telescope reads)
METHOD InjectError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bInjected := TRUE;
nInjectedId := nId;
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_FocusMock">
      <LineId Id="3" Count="29" />
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_FocusMock.InjectError">
      <LineId Id="3" Count="1" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>