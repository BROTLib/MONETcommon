<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{0799da45-8949-418f-b539-2af88eaf4ab8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// TcUnit finds every FB_TestSuite instance by itself; it is enough to declare them here.
	fbCommandAcceptanceTests	: F_CommandAcceptance_Tests;
	fbAxisTurnTests	: F_AxisTurn_Tests;
	fbBrakeMustCloseTests	: F_BrakeMustClose_Tests;
	fbWakeShakeErrorExemptTests	: F_WakeShakeErrorExempt_Tests;
	fbWakeShakeWindowTests	: F_WakeShakeWindow_Tests;
	fbFocusManualHomeTests	: FB_FocusManualHome_Tests;
	fbFocusTargetFollowsActualTests	: F_FocusTargetFollowsActual_Tests;
	fbFocusModeSwitchSimTests	: FocusModeSwitch_Sim_Tests;
	fbFocusTargetInitTests	: FB_FocusTargetInit_Tests;
	fbFocusTargetInitSimTests	: FocusTargetInit_Sim_Tests;
	fbOilLevelValidTests	: F_OilLevelValid_Tests;
	fbOilSuctionLatchTests	: F_OilSuctionLatch_Tests;
	fbTempSensorTests	: FB_MonetTempSensor_Tests;
	fbMethodVarProbeTests	: FB_MethodVarProbe_Tests;
	fbPendantControlTests	: FB_MonetPendantControl_Tests;
	fbMonetRigTests	: FB_MonetRig_Tests;
	fbMonetStopDuringSlewTests	: MonetStopDuringSlew_Tests;
	fbMonetStopWhileTrackingTests	: MonetStopWhileTracking_Tests;
	fbMonetParkDuringPowerOnTests	: MonetParkDuringPowerOn_Tests;
	fbMonetResetUnderMotionTests	: MonetResetUnderMotion_Tests;
	fbMonetSuspendUnderMotionTests	: MonetSuspendUnderMotion_Tests;
	fbMonetErrorParkTests	: MonetErrorPark_Tests;
	fbMonetBrakeReleaseTests	: MonetBrakeRelease_Tests;
	fbMonetTimeoutsTests : MonetTimeouts_Tests;
	fbMonetParkLogTests	: FB_MonetParkLog_Tests;	// #279
	fbMonetSafeStateTests	: MonetSafeState_Tests;
	fbStageAbortTests	: F_StageAbort_Tests;	// suite 34 of 41
	fbJogRequestTests	: FB_JogRequest_Tests;	// suite 36 of 41 (#148)
	fbHomeRequestTests	: FB_HomeRequest_Tests;	// suite 35 of 41 (MAXNUMBEROFTESTSUITES); #24 step 6 freed 6 slots (the BROTLib duplicates)
	fbHalfBROTHelpersTests	: FB_HalfBROTHelpers_Tests;	// suite 35: the HalfBROT helpers that had no test, in one suite (HalfBROT#32); see "Things to know" in the README for why not more suites
	fbFocusParkHelpersTests	: FB_FocusParkHelpers_Tests;	// six small function suites in one (26 tests): 30 suites, five slots of headroom below MAXNUMBEROFTESTSUITES
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TcUnit.RUN();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
