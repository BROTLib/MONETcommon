<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CoversMock" Id="{f17dfb05-8c2f-48a0-9523-e0aa4e3eb81e}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of the mirror covers (I_MirrorCovers): Open/Close take effect at once.
FUNCTION_BLOCK FB_CoversMock IMPLEMENTS BROTLib.I_MirrorCovers
VAR
	bOpened		: BOOL;
	bClosed		: BOOL := TRUE;
	bFailed		: BOOL;
	nOpenCalls	: UINT;
	nCloseCalls	: UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Method Name="Open" Id="{878b5598-7bb7-4d16-819f-f7ff964312ca}">
      <Declaration><![CDATA[METHOD Open : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bOpened := TRUE;
bClosed := FALSE;
nOpenCalls := nOpenCalls + 1;
Open := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Close" Id="{dc54c13f-ffe1-4494-9ce6-0a5905cb5ccc}">
      <Declaration><![CDATA[METHOD Close : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bOpened := FALSE;
bClosed := TRUE;
nCloseCalls := nCloseCalls + 1;
Close := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{0b918468-8437-4bae-bedb-9b7a9531322e}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bFailed := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Opened" Id="{9f0d87fc-b2be-4fac-a4ec-8deb394287bf}">
      <Declaration><![CDATA[PROPERTY Opened : BOOL]]></Declaration>
      <Get Name="Get" Id="{53e0617a-fd86-42b6-a811-84d49e77466b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Opened := bOpened;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Closed" Id="{ffcda306-0a5f-43bd-936b-bffbde33e1c0}">
      <Declaration><![CDATA[PROPERTY Closed : BOOL]]></Declaration>
      <Get Name="Get" Id="{0aef944c-4a5c-471f-9558-f7beefc93bc4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Closed := bClosed;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{ccafefc7-a111-4388-91b0-2dd3fd487173}">
      <Declaration><![CDATA[PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{23c63bde-cc9b-40e4-b598-8aa868f352a3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := bFailed;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
