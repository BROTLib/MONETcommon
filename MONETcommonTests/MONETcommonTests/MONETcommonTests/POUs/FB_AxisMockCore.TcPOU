<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AxisMockCore" Id="{7268b1bc-a85f-46c9-bcb5-8b5f63d401a5}" SpecialFunc="None">
    <Declaration><![CDATA[// Motion model of one mocked axis (telescope state machine mock rig, BROTLib plan 2026-10-21-telescope-state-machine-unification).
// One call = one PLC scan of the axis part. Enable -> Ready after nReadyScans, homing -> calibrated after nHomeScans, a rising
// bMove -> InMotion for nMoveScans, then MoveDone for one scan and the position is the target. Only the levels the telescope
// writes are inputs; nothing here touches an MC_* block. Same model as IAG50cmTests.
// External setpoint generator (BROTLib#101): while bTracking the generator is on (bTrackActive, the axis is in motion and
// tracking). It takes nDisableScans scans to be off after bTracking falls. A stop or a move request that arrives while it
// is still on is rejected by the NC with 0x4257 (bExtError for one scan, counted in nExtErrors), like the real axis.
// Once the generator is off the axis keeps moving (bCoast) until a stop or a move request, so the telescope still has to stop it.
FUNCTION_BLOCK FB_AxisMockCore
VAR_INPUT
	bEnable			: BOOL;
	bHome			: BOOL;
	bMove			: BOOL;
	bStop			: BOOL;		// the StopAxis level: a rising edge is a stop request (MC_Stop)
	bTracking		: BOOL;		// the Tracking level (MC_ExtSetPointGenEnable wanted)
	fTarget			: LREAL;
	fHomePosition	: LREAL;		// the position a homing ends at (the calibration cam, fCalibPosition of the axis block)
	nReadyScans		: UINT := 2;
	nHomeScans		: UINT := 3;
	nMoveScans		: UINT := 4;
	nStopScans		: UINT := 3;
	nDisableScans	: UINT := 1;	// scans MC_ExtSetPointGenDisable takes after bTracking fell
END_VAR
VAR_OUTPUT
	bReady			: BOOL;
	bCalibrated		: BOOL;
	bHoming			: BOOL;
	bInMotion		: BOOL;
	bStandStill		: BOOL := TRUE;
	bMoveDone		: BOOL;		// one scan
	bStopping		: BOOL;
	bStopDone		: BOOL;		// one scan
	nStopEdges		: UINT;		// rising edges of bStop, i.e. MC_Stop requests
	bTrackActive	: BOOL;		// the external setpoint generator is on and the axis tracks
	bCoast			: BOOL;		// the generator is off, the axis has not been stopped yet
	bExtError		: BOOL;		// one scan: a stop or move request met the generator (NC error 0x4257)
	nExtErrors		: UINT;
	fPosition		: LREAL;
END_VAR
VAR
	nReadyCount		: UINT;
	nHomeCount		: UINT;
	nMoveCount		: UINT;
	nStopCount		: UINT;
	rtMove			: R_TRIG;
	rtStop			: R_TRIG;
	bExtActive		: BOOL;		// the generator is on or still being disabled
	nDisableCount	: UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bMoveDone := FALSE;
bStopDone := FALSE;

// a stop request aborts a running move where it is (the model has no interpolation: the position stays) and takes
// nStopScans scans, then reports Done for one scan
bExtError := FALSE;
rtStop(CLK := bStop);
IF rtStop.Q AND bExtActive THEN
	bExtError := TRUE;
END_IF
IF rtStop.Q THEN
	bCoast := FALSE;
	nStopEdges := nStopEdges + 1;
	bStopping := TRUE;
	nStopCount := 0;
	bInMotion := FALSE;
END_IF
IF bStopping THEN
	nStopCount := nStopCount + 1;
	IF nStopCount >= nStopScans THEN
		bStopping := FALSE;
		bStopDone := TRUE;
	END_IF
END_IF

IF bEnable THEN
	IF nReadyCount >= nReadyScans THEN
		bReady := TRUE;
	ELSE
		nReadyCount := nReadyCount + 1;
	END_IF
ELSE
	nReadyCount := 0;
	bReady := FALSE;
END_IF

IF bHome AND bReady AND NOT bCalibrated AND NOT bStopping THEN
	bHoming := TRUE;
	nHomeCount := nHomeCount + 1;
	IF nHomeCount >= nHomeScans THEN
		bCalibrated := TRUE;
		fPosition := fHomePosition;
		bHoming := FALSE;
		nHomeCount := 0;
	END_IF
ELSE
	bHoming := FALSE;
	nHomeCount := 0;		// a homing that is stopped or no longer requested starts from zero
END_IF

rtMove(CLK := bMove);
IF rtMove.Q AND bExtActive THEN
	bExtError := TRUE;
END_IF
IF rtMove.Q AND bReady AND bCalibrated AND NOT bStopping THEN
	bCoast := FALSE;
	bInMotion := TRUE;
	nMoveCount := 0;
END_IF
IF bInMotion THEN
	nMoveCount := nMoveCount + 1;
	IF nMoveCount >= nMoveScans THEN
		fPosition := fTarget;
		bInMotion := FALSE;
		bMoveDone := TRUE;
	END_IF
END_IF

// the generator: on while tracking on a ready, calibrated axis; off nDisableScans scans after bTracking fell. The request
// edges above were checked against the state of the previous call, i.e. a disable and a stop in the same scan collide.
IF bTracking AND bReady AND bCalibrated AND NOT bStopping THEN
	bExtActive := TRUE;
	bCoast := FALSE;
	nDisableCount := 0;
ELSIF bExtActive THEN
	nDisableCount := nDisableCount + 1;
	IF nDisableCount >= nDisableScans THEN
		bExtActive := FALSE;
		bCoast := NOT bStopping;
	END_IF
END_IF
IF bExtError THEN
	nExtErrors := nExtErrors + 1;
END_IF
bTrackActive := bExtActive AND bTracking;

bStandStill := NOT bInMotion AND NOT bHoming AND NOT bStopping;	// a tracking axis is not at standstill for the status (the mocks use bTrackActive), but it stays ready
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
