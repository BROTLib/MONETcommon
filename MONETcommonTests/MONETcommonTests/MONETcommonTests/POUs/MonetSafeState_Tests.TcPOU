<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MonetSafeState_Tests" Id="{d1a4e0f8-8062-4b9e-9210-d42d0064fb81}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of the safe state per error class that had no test (#24 aim 6, step 1 of specs/plans/2026-11-02-reference-
// implementation-issue-24.md; the table is specs/design/monetcommon-safe-states.md). These tests pin what FB_MonetTelescopeControl
// does today on mock axes, with the line of the behaviour in a comment; they are not a specification. A test whose name ends in
// _Current pins a behaviour that differs from the target of the table (decision D4) and is flipped by the fix (step 7). The
// Roof_Request_* tests and No_Roof_Request_On_Focus_Error specify bCloseRoofRequest (step 7 PR 1, D9; no clock, no power-on). Every test
// owns a rig and runs over many PLC cycles (VAR_INST of the method, one Scan() per cycle). Failed checks are also noted in
// GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK MonetSafeState_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Hydraulics_Error_While_Tracking_Keeps_Tracking_Current();
Cover_Error_At_PowerOn_Waits_In_Stage_0_Current();
Cover_Error_Holds_The_Park_Before_Parked_Current();
Estop_During_Slew_Disables_The_Axes_Without_Park_Current();
Power_Failure_During_Goto_Keeps_Moving_Current();
Goto_Times_Out_Without_Park_Current();
Home_Times_Out_Without_Park_Current();
Clock_Invalid_Slew_Takes_The_Stop_Path();
Watchdog_Parks_And_Closes_The_Roof_In_One_Scan();
Invalid_Motion_Config_Is_Software_Error_32();
Roof_Request_On_Axis_Errors();
Roof_Request_On_Hydraulics_Error();
Roof_Request_On_Estop();
Roof_Request_On_Safety_Error();
Roof_Request_On_Power_Failure();
No_Roof_Request_On_Focus_Error();
]]></ST>
    </Implementation>
    <Method Name="Hydraulics_Error_While_Tracking_Keeps_Tracking_Current" Id="{f533c953-e643-4316-8d3d-4e35919c0034}">
      <Declaration><![CDATA[// M:283-287, 751-753: a hydraulics error is not a telescope error (bHwError has no hydraulics), and the brake rule only acts with the
// elevation disabled. With the pressure still there nothing changes; when the pressure goes the brake locks by itself (mock), the
// axes stay enabled and commanded to track (TCS_command keeps track, M:676-679), nothing parks, the hydraulics are not switched off,
// and only bReady drops (brake not open, M:791): READY_STATE -2.0. Target (D4): stop, park in place, hydraulics off.
METHOD PRIVATE Hydraulics_Error_While_Tracking_Keeps_Tracking_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	nTracking	: UINT;
	sTest		: STRING(80);
	nCloses		: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hydraulics_Error_While_Tracking_Keeps_Tracking_Current');
sTest := 'Hydraulics_Error_While_Tracking_Keeps_Tracking_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target (always above the horizon, any RA)
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until all three axes have tracked for a few scans, then the hydraulics report an error (pressure still there)
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 5 THEN
		rig.fbBrakeHyd.InjectError();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the error alone changes nothing; then the pressure goes and the brake locks
	IF nCycles >= 30 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'a hydraulics error is not a telescope error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'a hydraulics error is not a telescope error'));
		AssertTrue(Condition := rig.Online, Message := 'still online while the pressure is there');
		F_Note(bFailed := NOT (rig.Online), sText := CONCAT(sTest, 'still online while the pressure is there'));
		AssertTrue(Condition := rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking, Message := 'the axes still track');
		F_Note(bFailed := NOT (rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking), sText := CONCAT(sTest, 'the axes still track'));
		nCloses := rig.fbBrakeHyd.nCloseCalls;
		rig.fbBrakeHyd.InjectPressureLoss();
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is locked (no pressure)');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is locked (no pressure)'));
		AssertTrue(Condition := rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable, Message := 'the three axes stay enabled');
		F_Note(bFailed := NOT (rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable), sText := CONCAT(sTest, 'the three axes stay enabled'));
		AssertTrue(Condition := rig.fbTel.bTrack AND rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking, Message := 'the axes are still commanded to track');
		F_Note(bFailed := NOT (rig.fbTel.bTrack AND rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking), sText := CONCAT(sTest, 'the axes are still commanded to track'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'no telescope error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'no telescope error'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'no park');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls = 0, Message := 'the telescope does not switch the hydraulics off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls = 0), sText := CONCAT(sTest, 'the telescope does not switch the hydraulics off'));
		AssertTrue(Condition := rig.fbBrakeHyd.nCloseCalls = nCloses, Message := 'the telescope does not close the brake itself');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nCloseCalls = nCloses), sText := CONCAT(sTest, 'the telescope does not close the brake itself'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 (not operational, the brake is not open)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 (not operational, the brake is not open)'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cover_Error_At_PowerOn_Waits_In_Stage_0_Current" Id="{916ea77f-2a49-49f8-8fa7-8ffe4aff53f2}">
      <Declaration><![CDATA[// M:1212-1217: the telescope never reads fbCovers.Error. A power-on with covers that report an error (and do not move) waits in
// stage 0 for fbCovers.Opened, enables no axis and stays at READY_STATE 0.7; only the 12 h command timeout would end it, and that
// only logs (M:700, 2016). bIsParked is already FALSE (M:1212) although nothing has opened. Target (D4): the power-on is refused
// or aborted, the telescope stays secured.
METHOD PRIVATE Cover_Error_At_PowerOn_Waits_In_Stage_0_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cover_Error_At_PowerOn_Waits_In_Stage_0_Current');
sTest := 'Cover_Error_At_PowerOn_Waits_In_Stage_0_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock; the covers report an error, then power on
	IF rig.ClockValid THEN
		rig.fbCovers.InjectError();
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// a power-on without the cover error is online after far fewer scans (FB_MonetRig_Tests)
	IF nCycles >= 300 THEN
		AssertTrue(Condition := rig.fbCovers.nOpenCalls >= 1, Message := 'the power-on commanded the covers');
		F_Note(bFailed := NOT (rig.fbCovers.nOpenCalls >= 1), sText := CONCAT(sTest, 'the power-on commanded the covers'));
		AssertFalse(Condition := rig.fbCovers.bOpened, Message := 'the covers did not open');
		F_Note(bFailed := (rig.fbCovers.bOpened), sText := CONCAT(sTest, 'the covers did not open'));
		AssertTrue(Condition := rig.fbTel.fbStartup.Initializing, Message := 'the power-on is still running');
		F_Note(bFailed := NOT (rig.fbTel.fbStartup.Initializing), sText := CONCAT(sTest, 'the power-on is still running'));
		AssertTrue(Condition := rig.fbTel.ReadyState = 0.7, Message := 'READY_STATE stays 0.7 (preparation)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 0.7), sText := CONCAT(sTest, 'READY_STATE stays 0.7 (preparation)'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'no axis was enabled (stage 0)');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'no axis was enabled (stage 0)'));
		AssertFalse(Condition := rig.fbTel.bIsParked, Message := 'bIsParked has dropped although nothing opened');
		F_Note(bFailed := (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'bIsParked has dropped although nothing opened'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'a cover error is not a telescope error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'a cover error is not a telescope error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cover_Error_Holds_The_Park_Before_Parked_Current" Id="{edc4f922-82f3-4352-b522-fd07dc3ed470}">
      <Declaration><![CDATA[// The telescope never reads fbCovers.Error: online it stays online. A park then drives to the park position, disables the axes, closes
// the brake and switches the hydraulics off (M:1139-1142), but waits in stage 80 for fbCovers.Closed (M:1143) for ever: bPark stays,
// bIsParked never comes, READY_STATE 0.3 (parking). The 2 min park timeout only logs. Target (D4): the park ends secured with the
// covers as far as possible.
METHOD PRIVATE Cover_Error_Holds_The_Park_Before_Parked_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cover_Error_Holds_The_Park_Before_Parked_Current');
sTest := 'Cover_Error_Holds_The_Park_Before_Parked_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the covers report an error
	IF rig.Online THEN
		rig.fbCovers.InjectError();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// nothing changes online; then park
	IF nCycles >= 30 THEN
		AssertTrue(Condition := rig.Online, Message := 'still online with a cover error');
		F_Note(bFailed := NOT (rig.Online), sText := CONCAT(sTest, 'still online with a cover error'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'a cover error is not a telescope error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'a cover error is not a telescope error'));
		rig.fbTel.Park();
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// the park drives to the park position and disables the axes
	IF NOT (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable) AND nCycles > 5 THEN
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not disable the axes');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not disable the axes'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:
	IF nCycles >= 100 THEN
		AssertTrue(Condition := rig.fbTel.bPark, Message := 'the park is still running (it waits for the covers)');
		F_Note(bFailed := NOT (rig.fbTel.bPark), sText := CONCAT(sTest, 'the park is still running (it waits for the covers)'));
		AssertFalse(Condition := rig.fbTel.bIsParked, Message := 'the telescope never reports parked');
		F_Note(bFailed := (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the telescope never reports parked'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls >= 1, Message := 'the hydraulics are switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls >= 1), sText := CONCAT(sTest, 'the hydraulics are switched off'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls >= 1 AND NOT rig.fbCovers.bClosed, Message := 'the covers were commanded closed and did not move');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls >= 1 AND NOT rig.fbCovers.bClosed), sText := CONCAT(sTest, 'the covers were commanded closed and did not move'));
		AssertTrue(Condition := rig.fbTel.ReadyState = 0.3, Message := 'READY_STATE stays 0.3 (parking)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 0.3), sText := CONCAT(sTest, 'READY_STATE stays 0.3 (parking)'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'no telescope error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'no telescope error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Estop_During_Slew_Disables_The_Axes_Without_Park_Current" Id="{8e60e5a2-3593-49f3-bb7c-2bde946b1ab4}">
      <Declaration><![CDATA[// M:823-827, 545-546 (#86): the E-stop under a slew disables the three axes in every scan, the brake is closed by the #121 rule
// (M:751-766), nothing parks, the covers are not closed, the hydraulics stay on; READY_STATE -1.0 (M:802). The E-stop is not
// bError. How a slew ends on real axes under STO is not modelled (the mock axis keeps its move). Target (D4): park in place,
// covers as possible after the release, hydraulics off.
METHOD PRIVATE Estop_During_Slew_Disables_The_Axes_Without_Park_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Estop_During_Slew_Disables_The_Axes_Without_Park_Current');
sTest := 'Estop_During_Slew_Disables_The_Axes_Without_Park_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, slew
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 3000);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the axes move: the E-stop is pressed
	IF nCycles >= 5 THEN
		rig.SetEstop(TRUE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'the three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'the three axes are disabled'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'no park');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers are not closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers are not closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls = 0, Message := 'the hydraulics stay on');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls = 0), sText := CONCAT(sTest, 'the hydraulics stay on'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'the E-stop is not bError');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'the E-stop is not bError'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'READY_STATE is -1.0');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'READY_STATE is -1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Power_Failure_During_Goto_Keeps_Moving_Current" Id="{df52c504-416b-4fbe-ad2d-969ae710a1d6}">
      <Declaration><![CDATA[// M:805: bMainReady FALSE (MAIN: PowerMonitoring.phaseOK) during a goto only gates online: READY_STATE -2.0, the goto goes on, the
// axes stay enabled, nothing stops or parks. When the supply is back READY_STATE is 1.0 again without a new Init (transient interlock
// of FB_StartupReadiness). What the drives do on a real phase loss is not modelled. Target (D4): stop if the drives are powered,
// park if possible, hydraulics off.
METHOD PRIVATE Power_Failure_During_Goto_Keeps_Moving_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Power_Failure_During_Goto_Keeps_Moving_Current');
sTest := 'Power_Failure_During_Goto_Keeps_Moving_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, goto a circumpolar target
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 3000);
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the goto did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the goto did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the axes move: the main power fails
	IF nCycles >= 5 THEN
		rig.SetMainReady(FALSE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF nCycles >= 30 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 while bMainReady is FALSE');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 while bMainReady is FALSE'));
		AssertTrue(Condition := rig.fbTel.bGoto, Message := 'the goto goes on');
		F_Note(bFailed := NOT (rig.fbTel.bGoto), sText := CONCAT(sTest, 'the goto goes on'));
		AssertTrue(Condition := rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis, Message := 'the axes are still commanded to move');
		F_Note(bFailed := NOT (rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis), sText := CONCAT(sTest, 'the axes are still commanded to move'));
		AssertTrue(Condition := rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable, Message := 'the three axes stay enabled');
		F_Note(bFailed := NOT (rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable), sText := CONCAT(sTest, 'the three axes stay enabled'));
		AssertFalse(Condition := rig.fbTel.bStop OR rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'no stop, no park');
		F_Note(bFailed := (rig.fbTel.bStop OR rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no stop, no park'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'no telescope error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'no telescope error'));
		rig.SetMainReady(TRUE);
		nStep := 50;
		nCycles := 0;
	END_IF
50:	// the supply is back
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.Online, Message := 'online again without a new Init');
		F_Note(bFailed := NOT (rig.Online), sText := CONCAT(sTest, 'online again without a new Init'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Goto_Times_Out_Without_Park_Current" Id="{575b45e8-d28e-4e1e-bc05-3296ec33c970}">
      <Declaration><![CDATA[// M:875-883 (#17): a goto still running after 600 s is software error 16#10 (time seam: 1000, so 0.6 s). From the next scan the error
// branch disables the three axes under motion, without a ramp (M:312-324), and the #121 rule closes the brake (M:751-766). A software
// error starts no park (bHwError only, M:545): the covers stay open, the hydraulics stay on; READY_STATE -1.0, latched until reset.
// Target (D4): ramp, park, covers closed, hydraulics off.
METHOD PRIVATE Goto_Times_Out_Without_Park_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Goto_Times_Out_Without_Park_Current');
sTest := 'Goto_Times_Out_Without_Park_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, short timeouts, goto a circumpolar target
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bError THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := rig.fbTel.nErrorID = 16#10, Message := 'the goto timeout is error 16#10');
		F_Note(bFailed := NOT (rig.fbTel.nErrorID = 16#10), sText := CONCAT(sTest, 'the goto timeout is error 16#10'));
		AssertFalse(Condition := rig.fbTel.bGoto, Message := 'the goto is dropped');
		F_Note(bFailed := (rig.fbTel.bGoto), sText := CONCAT(sTest, 'the goto is dropped'));
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the goto never timed out');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the goto never timed out'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'the three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'the three axes are disabled'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'no park');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers stay open');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers stay open'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls = 0, Message := 'the hydraulics stay on');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls = 0), sText := CONCAT(sTest, 'the hydraulics stay on'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0, Message := 'the error is latched, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the error is latched, READY_STATE -1.0'));
		// step 7 PR 1 (D9): a software error is recoverable, no roof close request (stays so after the flip of this test)
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no roof close request for 16#10');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no roof close request for 16#10'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home_Times_Out_Without_Park_Current" Id="{452fcee1-58fd-44c6-bd2a-16a6b9438e2e}">
      <Declaration><![CDATA[// M:986-993 (#17): a home still running after 600 s is software error 16#30 (time seam: 1000, so 0.6 s); bGoHome is dropped. The
// same safe state as the goto timeout: axes disabled, brake closed, no park, covers open, hydraulics on. Target (D4): as the goto.
METHOD PRIVATE Home_Times_Out_Without_Park_Current
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Home_Times_Out_Without_Park_Current');
sTest := 'Home_Times_Out_Without_Park_Current: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, short timeouts, home
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Home();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bError THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := rig.fbTel.nErrorID = 16#30, Message := 'the home timeout is error 16#30');
		F_Note(bFailed := NOT (rig.fbTel.nErrorID = 16#30), sText := CONCAT(sTest, 'the home timeout is error 16#30'));
		AssertFalse(Condition := rig.fbTel.bGoHome, Message := 'the home is dropped');
		F_Note(bFailed := (rig.fbTel.bGoHome), sText := CONCAT(sTest, 'the home is dropped'));
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the home never timed out');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the home never timed out'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'the three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'the three axes are disabled'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'no park');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers stay open');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers stay open'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls = 0, Message := 'the hydraulics stay on');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls = 0), sText := CONCAT(sTest, 'the hydraulics stay on'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0, Message := 'the error is latched, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the error is latched, READY_STATE -1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clock_Invalid_Slew_Takes_The_Stop_Path" Id="{3ae55bea-8d37-4402-9d1c-a6193ab6ddcb}">
      <Declaration><![CDATA[// M:236-238: a move flag while the clock is not valid sets bStop (the normal stop path), and the direct-write gate rejects the move
// with clock_invalid (_CommandState M:2487, F_CommandAcceptance); nothing parks. This is only reachable before the first clock sync:
// FB_AstroClockSync latches bValid, so "the clock becomes invalid during a track" cannot happen today. The flag is written directly
// (an ADS write), since the methods reject the move before it is set.
METHOD PRIVATE Clock_Invalid_Slew_Takes_The_Stop_Path
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Clock_Invalid_Slew_Takes_The_Stop_Path');
sTest := 'Clock_Invalid_Slew_Takes_The_Stop_Path: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// first cycle: the clock needs a NT_GetTime round trip (about 5 s), so it is not valid yet
	IF NOT rig.ClockValid THEN
		rig.SetSlewFlag();
		nStep := 10;
		nCycles := 0;
	ELSE
		AssertTrue(Condition := FALSE, Message := 'the clock was already valid in the first cycle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the clock was already valid in the first cycle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
	bSawStop := bSawStop OR rig.fbTel.bStop;
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.ClockValid, Message := 'the clock is still not valid');
		F_Note(bFailed := (rig.ClockValid), sText := CONCAT(sTest, 'the clock is still not valid'));
		AssertTrue(Condition := bSawStop, Message := 'the slew flag took the stop path (bStop)');
		F_Note(bFailed := NOT (bSawStop), sText := CONCAT(sTest, 'the slew flag took the stop path (bStop)'));
		AssertFalse(Condition := rig.fbTel.bSlew, Message := 'the slew is dropped');
		F_Note(bFailed := (rig.fbTel.bSlew), sText := CONCAT(sTest, 'the slew is dropped'));
		AssertTrue(Condition := rig.fbTel.eLastRejectReason = MONETcommon.E_CommandRejectReason.clock_invalid, Message := 'the slew is rejected with clock_invalid');
		F_Note(bFailed := NOT (rig.fbTel.eLastRejectReason = MONETcommon.E_CommandRejectReason.clock_invalid), sText := CONCAT(sTest, 'the slew is rejected with clock_invalid'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bError, Message := 'no park, no error');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bError), sText := CONCAT(sTest, 'no park, no error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Watchdog_Parks_And_Closes_The_Roof_In_One_Scan" Id="{2ceca4cd-cb17-43a5-85a3-6b30784a4e38}">
      <Declaration><![CDATA[// FB_MonetMqttWatchdog:29-35 (D4): armed only after the first connect; tGrace after the connection is lost it calls Park() on the
// telescope and Close() on the roof in the same scan, and again in every scan until the connection is back. The telescope is the
// real FB_MonetTelescopeControl of a rig whose body is not scanned here, so bPark stays as Park() set it; the roof is FB_RoofMock.
METHOD PRIVATE Watchdog_Parks_And_Closes_The_Roof_In_One_Scan
VAR_INST
	rig			: FB_MonetRig;
	fbRoof		: FB_RoofMock;
	bConnected	: BOOL;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nCloses		: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Watchdog_Parks_And_Closes_The_Roof_In_One_Scan');
sTest := 'Watchdog_Parks_And_Closes_The_Roof_In_One_Scan: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.fbWatchdog(bConnected := bConnected, iTelescope := rig.fbTel, iRoof := fbRoof, tGrace := T#100MS);
nCycles := nCycles + 1;
CASE nStep OF
0:	// never connected: not armed, also after more than tGrace; then the broker connects
	IF nCycles >= 30 THEN
		AssertFalse(Condition := rig.fbWatchdog.bTriggered OR rig.fbTel.bPark OR fbRoof.nCloseCalls > 0, Message := 'not armed before the first connect');
		F_Note(bFailed := (rig.fbWatchdog.bTriggered OR rig.fbTel.bPark OR fbRoof.nCloseCalls > 0), sText := CONCAT(sTest, 'not armed before the first connect'));
		bConnected := TRUE;
		nStep := 10;
		nCycles := 0;
	END_IF
10:	// connected for one scan, then the connection is lost
	bConnected := FALSE;
	nStep := 20;
	nCycles := 0;
20:
	IF rig.fbWatchdog.bTriggered THEN
		AssertTrue(Condition := rig.fbTel.bPark AND fbRoof.nCloseCalls = 1, Message := 'park and roof close in the trigger scan');
		F_Note(bFailed := NOT (rig.fbTel.bPark AND fbRoof.nCloseCalls = 1), sText := CONCAT(sTest, 'park and roof close in the trigger scan'));
		nStep := 30;
		nCycles := 0;
	ELSIF rig.fbTel.bPark OR fbRoof.nCloseCalls > 0 THEN
		AssertTrue(Condition := FALSE, Message := 'park or roof close before the watchdog triggered');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'park or roof close before the watchdog triggered'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the watchdog never triggered');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the watchdog never triggered'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// still disconnected: repeated in every scan; then the broker is back
	AssertTrue(Condition := fbRoof.nCloseCalls = 2, Message := 'the roof close is repeated in the next scan');
	F_Note(bFailed := NOT (fbRoof.nCloseCalls = 2), sText := CONCAT(sTest, 'the roof close is repeated in the next scan'));
	bConnected := TRUE;
	nStep := 40;
	nCycles := 0;
40:	// connected again: the watchdog lets go
	AssertFalse(Condition := rig.fbWatchdog.bTriggered, Message := 'not triggered once the connection is back');
	F_Note(bFailed := (rig.fbWatchdog.bTriggered), sText := CONCAT(sTest, 'not triggered once the connection is back'));
	nCloses := fbRoof.nCloseCalls;
	nStep := 50;
	nCycles := 0;
50:
	IF nCycles >= 10 THEN
		AssertTrue(Condition := fbRoof.nCloseCalls = nCloses, Message := 'no roof close while connected');
		F_Note(bFailed := NOT (fbRoof.nCloseCalls = nCloses), sText := CONCAT(sTest, 'no roof close while connected'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Invalid_Motion_Config_Is_Software_Error_32" Id="{1c5940e5-8f4f-45b6-867d-441dba951f47}">
      <Declaration><![CDATA[// #24 step 2c, row "software error: config": an invalid stMotion (BROTLib.F_MotionConfigValid FALSE, here the goto window reversed,
// min 50 > max 40) is software error 16#32, raised in every scan like 16#31 (M: after F_HomeBelowHorizon). The defaults stay in use
// (stMotionUsed), a reset does not clear the error while the configuration is wrong, and it clears once the configuration is valid.
// No clock and no power-on needed.
METHOD PRIVATE Invalid_Motion_Config_Is_Software_Error_32
VAR_INST
	rig			: FB_MonetRig;
	stCfg		: BROTLib.ST_MotionConfig;
	stValid		: BROTLib.ST_MotionConfig;	// the defaults
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Invalid_Motion_Config_Is_Software_Error_32');
sTest := 'Invalid_Motion_Config_Is_Software_Error_32: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
IF nStep = 0 THEN	// before the first scan
	stCfg.fGotoMinElevation := 50.0;
	stCfg.fGotoMaxElevation := 40.0;
	rig.SetMotion(stValue := stCfg);
	nStep := 10;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
10:
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#32, Message := 'the invalid configuration is error 16#32');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#32), sText := CONCAT(sTest, 'the invalid configuration is error 16#32'));
		AssertTrue(Condition := rig.fbTel.stMotionUsed.fGotoMinElevation = 2.0 AND rig.fbTel.stMotionUsed.fGotoMaxElevation = 89.5,
			Message := 'the defaults stay in use');
		F_Note(bFailed := NOT (rig.fbTel.stMotionUsed.fGotoMinElevation = 2.0 AND rig.fbTel.stMotionUsed.fGotoMaxElevation = 89.5),
			sText := CONCAT(sTest, 'the defaults stay in use'));
		// step 7 PR 1 (D9): a configuration error is recoverable, no roof close request
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no roof close request for 16#32');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no roof close request for 16#32'));
		rig.fbTel.Reset();
		nStep := 20;
		nCycles := 0;
	END_IF
20:
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#32, Message := 'a reset does not clear it while the configuration is wrong');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#32), sText := CONCAT(sTest, 'a reset does not clear it while the configuration is wrong'));
		rig.SetMotion(stValue := stValid);
		rig.fbTel.Reset();
		nStep := 30;
		nCycles := 0;
	END_IF
30:
	IF nCycles >= 3 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'a valid configuration and a reset clear the error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'a valid configuration and a reset clear the error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Roof_Request_On_Axis_Errors" Id="{7dd8bf42-fdcb-48ef-8970-6f1739a986dc}">
      <Declaration><![CDATA[// #24 step 7 PR 1 (D9, row axis error): an elevation, azimuth and derotator error each set bCloseRoofRequest (M: next to bError).
// The axis error goes only with a reset: the telescope resets the axis in the reset scan (the cause is still active, the
// request stays), bReset is held while bError, so in the next scan the request is cleared without a second reset.
// No clock, no power-on (the telescope is parked at the start, so no emergency park).
METHOD PRIVATE Roof_Request_On_Axis_Errors
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Roof_Request_On_Axis_Errors');
sTest := 'Roof_Request_On_Axis_Errors: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// one step every 3 scans: the cause or the reset of the step before has been scanned
IF nCycles >= 3 THEN
	nCycles := 0;
	CASE nStep OF
	0:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no request without a cause');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no request without a cause'));
		rig.InjectElevationError(16#4550);
		nStep := 10;
	10:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the elevation error sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the elevation error sets the request'));
		rig.fbTel.Reset();
		nStep := 20;
	20:
		AssertTrue(Condition := NOT rig.fbTel.bCloseRoofRequest AND NOT rig.fbTel.bError, Message := 'one reset clears the elevation error and the request');
		F_Note(bFailed := NOT (NOT rig.fbTel.bCloseRoofRequest AND NOT rig.fbTel.bError), sText := CONCAT(sTest, 'one reset clears the elevation error and the request'));
		rig.InjectAzimuthError(16#4550);
		nStep := 30;
	30:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the azimuth error sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the azimuth error sets the request'));
		rig.fbTel.Reset();
		nStep := 40;
	40:
		AssertTrue(Condition := NOT rig.fbTel.bCloseRoofRequest AND NOT rig.fbTel.bError, Message := 'one reset clears the azimuth error and the request');
		F_Note(bFailed := NOT (NOT rig.fbTel.bCloseRoofRequest AND NOT rig.fbTel.bError), sText := CONCAT(sTest, 'one reset clears the azimuth error and the request'));
		rig.InjectDerotatorError(16#4550);
		nStep := 50;
	50:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the derotator error sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the derotator error sets the request'));
		rig.fbTel.Reset();
		nStep := 60;
	60:
		AssertTrue(Condition := NOT rig.fbTel.bCloseRoofRequest AND NOT rig.fbTel.bError, Message := 'one reset clears the derotator error and the request');
		F_Note(bFailed := NOT (NOT rig.fbTel.bCloseRoofRequest AND NOT rig.fbTel.bError), sText := CONCAT(sTest, 'one reset clears the derotator error and the request'));
		nStep := 99;
		TEST_FINISHED();
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Roof_Request_On_Hydraulics_Error" Id="{020b97fd-3bb6-4c6c-912e-b4e6b5eef17d}">
      <Declaration><![CDATA[// #24 step 7 PR 1 (D9, row hydraulics error): fbHydraulics.Error sets bCloseRoofRequest although it is no telescope error. The
// telescope reset does not reset the hydraulics (HalfBROT Reset(), the MAIN reset button), so a reset with the error still
// there keeps the request; after the hydraulics reset it stays latched until the next telescope reset.
METHOD PRIVATE Roof_Request_On_Hydraulics_Error
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Roof_Request_On_Hydraulics_Error');
sTest := 'Roof_Request_On_Hydraulics_Error: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// one step every 3 scans: the cause or the reset of the step before has been scanned
IF nCycles >= 3 THEN
	nCycles := 0;
	CASE nStep OF
	0:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no request without a cause');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no request without a cause'));
		rig.fbBrakeHyd.InjectError();
		nStep := 10;
	10:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the hydraulics error sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the hydraulics error sets the request'));
		rig.fbTel.Reset();
		nStep := 20;
	20:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset with the hydraulics error keeps it');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset with the hydraulics error keeps it'));
		rig.fbBrakeHyd.Reset();
		nStep := 30;
	30:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'latched after the hydraulics reset');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'latched after the hydraulics reset'));
		rig.fbTel.Reset();
		nStep := 40;
	40:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset without a cause clears it');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset without a cause clears it'));
		nStep := 99;
		TEST_FINISHED();
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Roof_Request_On_Estop" Id="{880f3c99-15e7-4f8e-8783-ead830e388fc}">
      <Declaration><![CDATA[// #24 step 7 PR 1 (D9, row E-stop): the E-stop sets bCloseRoofRequest. The E-stop circuit also cuts the roof drives, so the request
// must outlive it: a reset during the E-stop keeps it, it stays latched after the release, and only a reset without a cause
// clears it.
METHOD PRIVATE Roof_Request_On_Estop
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Roof_Request_On_Estop');
sTest := 'Roof_Request_On_Estop: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// one step every 3 scans: the cause or the reset of the step before has been scanned
IF nCycles >= 3 THEN
	nCycles := 0;
	CASE nStep OF
	0:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no request without a cause');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no request without a cause'));
		rig.SetEstop(TRUE);
		nStep := 10;
	10:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the E-stop sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the E-stop sets the request'));
		rig.fbTel.Reset();
		nStep := 20;
	20:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset during the E-stop keeps it');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset during the E-stop keeps it'));
		rig.SetEstop(FALSE);
		nStep := 30;
	30:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'latched after the release');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'latched after the release'));
		rig.fbTel.Reset();
		nStep := 40;
	40:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset without a cause clears it');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset without a cause clears it'));
		nStep := 99;
		TEST_FINISHED();
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Roof_Request_On_Safety_Error" Id="{81dfce06-d633-456d-ae15-e1171c532a06}">
      <Declaration><![CDATA[// #24 step 7 PR 1 (D9, row safety error): bSafetyError (SafetyHandling.error, no E-stop) sets bCloseRoofRequest; latched and reset
// as for the E-stop.
METHOD PRIVATE Roof_Request_On_Safety_Error
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Roof_Request_On_Safety_Error');
sTest := 'Roof_Request_On_Safety_Error: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// one step every 3 scans: the cause or the reset of the step before has been scanned
IF nCycles >= 3 THEN
	nCycles := 0;
	CASE nStep OF
	0:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no request without a cause');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no request without a cause'));
		rig.SetSafetyError(TRUE);
		nStep := 10;
	10:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the safety error sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the safety error sets the request'));
		rig.fbTel.Reset();
		nStep := 20;
	20:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset with the safety error keeps it');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset with the safety error keeps it'));
		rig.SetSafetyError(FALSE);
		nStep := 30;
	30:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'latched after the safety error is gone');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'latched after the safety error is gone'));
		rig.fbTel.Reset();
		nStep := 40;
	40:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset without a cause clears it');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset without a cause clears it'));
		nStep := 99;
		TEST_FINISHED();
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Roof_Request_On_Power_Failure" Id="{00264b16-ba15-4b5e-b428-f8b71d6b9d53}">
      <Declaration><![CDATA[// #24 step 7 PR 1 (D9, row power failure): bMainReady FALSE (PowerMonitoring.phaseOK) sets bCloseRoofRequest, so a phase dip that is
// gone again still requests the close; latched and reset as for the E-stop. Not M's bPowerFailure (a power-on failure).
METHOD PRIVATE Roof_Request_On_Power_Failure
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Roof_Request_On_Power_Failure');
sTest := 'Roof_Request_On_Power_Failure: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// one step every 3 scans: the cause or the reset of the step before has been scanned
IF nCycles >= 3 THEN
	nCycles := 0;
	CASE nStep OF
	0:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no request without a cause');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no request without a cause'));
		rig.SetMainReady(FALSE);
		nStep := 10;
	10:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the power failure sets the request');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the power failure sets the request'));
		rig.fbTel.Reset();
		nStep := 20;
	20:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset during the power failure keeps it');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset during the power failure keeps it'));
		rig.SetMainReady(TRUE);
		nStep := 30;
	30:
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'latched when the supply is back');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'latched when the supply is back'));
		rig.fbTel.Reset();
		nStep := 40;
	40:
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'a reset without a cause clears it');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'a reset without a cause clears it'));
		nStep := 99;
		TEST_FINISHED();
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="No_Roof_Request_On_Focus_Error" Id="{750cde95-081b-44f0-9886-388f38ea3f96}">
      <Declaration><![CDATA[// #24 step 7 PR 1 (D9, row focus error): a focus error is a telescope error (bHwError, bError) but recoverable: no
// bCloseRoofRequest (open: plan 8.4). The software errors are checked in Goto_Times_Out_Without_Park_Current (16#10) and
// Invalid_Motion_Config_Is_Software_Error_32 (16#32).
METHOD PRIVATE No_Roof_Request_On_Focus_Error
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('No_Roof_Request_On_Focus_Error');
sTest := 'No_Roof_Request_On_Focus_Error: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// one step every 3 scans: the cause or the reset of the step before has been scanned
IF nCycles >= 3 THEN
	nCycles := 0;
	CASE nStep OF
	0:
		rig.InjectFocusError(16#4550);
		nStep := 10;
	10:
		AssertTrue(Condition := rig.fbTel.bError, Message := 'the focus error is a telescope error');
		F_Note(bFailed := NOT (rig.fbTel.bError), sText := CONCAT(sTest, 'the focus error is a telescope error'));
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no request for a focus error');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no request for a focus error'));
		nStep := 99;
		TEST_FINISHED();
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
