<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetPendantControl_Tests" Id="{08fefe33-64b1-416b-b29d-2fb550602936}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for MONETcommon.FB_MonetPendantControl.
//
// Unlinked_Pendant_Lights_Error_Lamp: with no linked hardware the selector, key and button inputs (AT%I*) are all FALSE:
// selector 0 (pendant disconnected) and the enable key off. The error lamp lights and nothing else happens.
//
// The other cases (#3) drive the inputs through FB_MonetPendantProbe and check that the pendant lets go of a function it
// drives: Move* is FALSE once the key goes off, the selector changes or reads 0, and Enable follows after tEnableRelease.
// They assert the command levels (MovePos, MoveNeg, Enable), not motion: the axis mocks are not scanned. The limit inputs
// the pendant reads are set with SetDigitalInputs (0 would keep MovePos FALSE and the cases would pass for nothing), and
// every case asserts the precondition (the jog is on) before the event.
FUNCTION_BLOCK FB_MonetPendantControl_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Unlinked_Pendant_Lights_Error_Lamp();
Elevation_Key_Off_Releases_Jog();
Azimuth_Selector_Change_Releases_Jog();
Derotator_Selector_Zero_Releases_Jog();
Focus_Key_Off_Releases_Jog();
Key_Off_Without_Ownership_Writes_Nothing();
Release_Is_Once();
Reselect_Cancels_Enable_Drop();
Selector_Bounce_Does_Not_Drive_Intermediate_Function();
Unassigned_References_Do_Not_Fault();
Auto_Does_Not_Write_Enable_Or_Move();
Auto_Elevation_Tap_Adds_One_Step();
Auto_Azimuth_Right_Is_Positive_Sky_Offset();
Auto_Direction_Held_Before_Enable_Needs_Release();
Auto_Needs_Enable_Button();
Auto_Needs_Online_Telescope();
Auto_Offset_Beyond_Limit_Can_Only_Be_Reduced();
Auto_Elevation_Nudge_Refused_Outside_Goto_Window();
Auto_Nudge_Adds_To_Offset_Set_Elsewhere();
Auto_Derotator_Nudge_Adds_To_Derotator_Offset();
Auto_Held_Direction_Ramps();
Auto_Unwired_Telescope_Does_Not_Fault();
Off_Mode_Writes_Nothing();
Manual_To_Auto_Releases_Move_And_Keeps_Enable();
New_Target_Clears_Offsets_Same_Target_Keeps_Them();
]]></ST>
    </Implementation>
    <Method Name="Auto_Does_Not_Write_Enable_Or_Move" Id="{b1c2d3e4-0001-4a5b-8c6d-7e8f90a1b201}">
      <Declaration><![CDATA[// #177: automatic mode, selector 7, enable button released: the pendant must not write Enable/Move* (the bug of the issue)
METHOD PRIVATE Auto_Does_Not_Write_Enable_Or_Move
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Does_Not_Write_Enable_Or_Move');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbEl.Enable := TRUE;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertTrue(Condition := fbEl.Enable, Message := 'automatic: Enable stays as the telescope set it');
AssertFalse(Condition := fbEl.MovePos, Message := 'automatic: no jog');
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'no enable button: no nudge');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Elevation_Tap_Adds_One_Step" Id="{b1c2d3e4-0002-4a5b-8c6d-7e8f90a1b202}">
      <Declaration><![CDATA[// #177: automatic, selector 7, enable held, up pressed after a release: one tap = fElAzStep on the elevation offset, Enable untouched
METHOD PRIVATE Auto_Elevation_Tap_Adds_One_Step
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Elevation_Tap_Adds_One_Step');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbEl.Enable := TRUE;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'one tap, one step');
AssertTrue(Condition := fbEl.Enable, Message := 'Enable untouched');
AssertFalse(Condition := fbEl.MovePos, Message := 'no Move*');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := TRUE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'down is the opposite step');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Azimuth_Right_Is_Positive_Sky_Offset" Id="{b1c2d3e4-0003-4a5b-8c6d-7e8f90a1b203}">
      <Declaration><![CDATA[// #177: selector 8, right = + on the sky-frame azimuth offset (the cos(el) division stays in FB_MonetTelescopeControl)
METHOD PRIVATE Auto_Azimuth_Right_Is_Positive_Sky_Offset
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Azimuth_Right_Is_Positive_Sky_Offset');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 8, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 8, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#2S);
AssertEquals(Expected := 5.0/3600.0, Actual := fbTel.AzimuthOffset, Delta := 1.0E-9, Message := 'right: +step');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Direction_Held_Before_Enable_Needs_Release" Id="{b1c2d3e4-0004-4a5b-8c6d-7e8f90a1b204}">
      <Declaration><![CDATA[// #177: a direction held while the enable button goes down does nothing until it is released once (arming)
METHOD PRIVATE Auto_Direction_Held_Before_Enable_Needs_Release
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Direction_Held_Before_Enable_Needs_Release');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'held through the press: no nudge');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'after a release: nudges');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Needs_Enable_Button" Id="{b1c2d3e4-0005-4a5b-8c6d-7e8f90a1b205}">
      <Declaration><![CDATA[// #177: no nudge without the enable button held (decision 1)
METHOD PRIVATE Auto_Needs_Enable_Button
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Needs_Enable_Button');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'button released: no nudge');
