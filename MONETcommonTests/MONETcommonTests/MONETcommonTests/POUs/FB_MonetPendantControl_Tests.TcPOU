]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Needs_Online_Telescope" Id="{b1c2d3e4-0006-4a5b-8c6d-7e8f90a1b206}">
      <Declaration><![CDATA[// #177: nudges only at READY_STATE 1 (D4): 0.7 (initializing) and -1 (error) do nothing
METHOD PRIVATE Auto_Needs_Online_Telescope
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Needs_Online_Telescope');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbTel.SetReady(0.7);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'not online: no nudge');
fbTel.SetReady(-1.0);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'error: no nudge');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Offset_Beyond_Limit_Can_Only_Be_Reduced" Id="{b1c2d3e4-0007-4a5b-8c6d-7e8f90a1b207}">
      <Declaration><![CDATA[// #177: an offset at the pendant maximum (600 arcsec) cannot grow, but can be reduced; one set beyond it by MQTT can be reduced
METHOD PRIVATE Auto_Offset_Beyond_Limit_Can_Only_Be_Reduced
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Offset_Beyond_Limit_Can_Only_Be_Reduced');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbTel.AltitudeOffset := 600.0/3600.0;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 600.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'at the limit: up refused');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := TRUE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 600.0/3600.0 - 5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'down reduces');
fbTel.AltitudeOffset := 2.0;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 2.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'beyond the limit: up refused');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := TRUE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 2.0 - 5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'beyond the limit: down reduces');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Elevation_Nudge_Refused_Outside_Goto_Window" Id="{b1c2d3e4-0008-4a5b-8c6d-7e8f90a1b208}">
      <Declaration><![CDATA[// #177: the elevation nudge may not take the axis target above the goto window (default max 89.5 deg)
METHOD PRIVATE Auto_Elevation_Nudge_Refused_Outside_Goto_Window
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Elevation_Nudge_Refused_Outside_Goto_Window');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbEl.Position := 89.5;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'at the window edge: up refused');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := TRUE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := -5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'down is inside the window');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Nudge_Adds_To_Offset_Set_Elsewhere" Id="{b1c2d3e4-0009-4a5b-8c6d-7e8f90a1b209}">
      <Declaration><![CDATA[// #177: the nudge is read-modify-write: it adds to an offset set by MQTT (SetAltitudeOffset), it does not overwrite it
METHOD PRIVATE Auto_Nudge_Adds_To_Offset_Set_Elsewhere
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Nudge_Adds_To_Offset_Set_Elsewhere');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbTel.SetAltitudeOffset(0.05);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertEquals(Expected := 0.05 + 5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'added to the MQTT value');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Derotator_Nudge_Adds_To_Derotator_Offset" Id="{b1c2d3e4-0010-4a5b-8c6d-7e8f90a1b210}">
      <Declaration><![CDATA[// #177: selector 6: left/right nudge the derotator offset (fDerotStep), not the derotator Move*
METHOD PRIVATE Auto_Derotator_Nudge_Adds_To_Derotator_Offset
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Derotator_Nudge_Adds_To_Derotator_Offset');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbDr.fMinPosition := -90.0;
fbDr.fMaxPosition := 360.0;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 6, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 6, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#2S);
AssertEquals(Expected := 0.02, Actual := fbTel.DerotatorOffset, Delta := 1.0E-9, Message := 'right: +0.02 deg');
AssertFalse(Condition := fbDr.MovePos, Message := 'no Move*');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Held_Direction_Ramps" Id="{b1c2d3e4-0011-4a5b-8c6d-7e8f90a1b211}">
      <Declaration><![CDATA[// #177: a held direction: tap, nothing until 0.5 s, then 10 arcsec/s (10 ms scans: 3 s are 300 scans)
METHOD PRIVATE Auto_Held_Direction_Ramps
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
	nI		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Held_Direction_Ramps');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
FOR nI := 1 TO 98 DO
	Scan(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
END_FOR
AssertEquals(Expected := 5.0/3600.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-9, Message := 'before 0.5 s only the tap');
FOR nI := 1 TO 100 DO
	Scan(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
END_FOR
AssertTrue(Condition := fbTel.AltitudeOffset > 5.0/3600.0 + 4.0/3600.0, Message := 'after 0.5 s: slow rate about 10 arcsec/s');
AssertTrue(Condition := fbTel.AltitudeOffset < 5.0/3600.0 + 8.0/3600.0, Message := 'slow rate, not fast');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Auto_Unwired_Telescope_Does_Not_Fault" Id="{b1c2d3e4-0012-4a5b-8c6d-7e8f90a1b212}">
      <Declaration><![CDATA[// #177: automatic mode with iTelescope not assigned: no nudge, no write, no page fault
METHOD PRIVATE Auto_Unwired_Telescope_Does_Not_Fault
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Auto_Unwired_Telescope_Does_Not_Fault');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertTrue(Condition := TRUE, Message := 'reached the end without a page fault');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Off_Mode_Writes_Nothing" Id="{b1c2d3e4-0013-4a5b-8c6d-7e8f90a1b213}">
      <Declaration><![CDATA[// #177: off mode (key Local, hydraulics off): selector 5-8 write neither Enable/Move* nor offsets; the covers keep working
METHOD PRIVATE Off_Mode_Writes_Nothing
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Off_Mode_Writes_Nothing');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbP.eMode := E_TelescopeMode.off;
fbEl.Enable := FALSE;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertFalse(Condition := fbEl.Enable, Message := 'off: Enable not written');
AssertFalse(Condition := fbEl.MovePos, Message := 'off: no jog');
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'off: no nudge');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Manual_To_Auto_Releases_Move_And_Keeps_Enable" Id="{b1c2d3e4-0014-4a5b-8c6d-7e8f90a1b214}">
      <Declaration><![CDATA[// #177: manual jog, then the mode goes to automatic: Move* FALSE once, and the Enable is not dropped after tEnableRelease (the telescope owns it)
METHOD PRIVATE Manual_To_Auto_Releases_Move_And_Keeps_Enable
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Manual_To_Auto_Releases_Move_And_Keeps_Enable');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
fbEl.Position := 45.0;
fbDr.Position := 0.0;
fbTel.SetReady(1.0);
fbP.iTelescope := fbTel;
fbP.eMode := E_TelescopeMode.automatic;
fbP.tCycle := T#10MS;
fbP.eMode := E_TelescopeMode.manual;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertTrue(Condition := fbEl.MovePos, Message := 'precondition: manual jog on');
AssertTrue(Condition := fbEl.Enable, Message := 'precondition: manual Enable on');
fbP.eMode := E_TelescopeMode.automatic;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := FALSE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#2S);
AssertFalse(Condition := fbEl.MovePos, Message := 'automatic: Move* released');
AssertTrue(Condition := fbEl.Enable, Message := 'automatic: Enable not dropped by the pendant');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="New_Target_Clears_Offsets_Same_Target_Keeps_Them" Id="{b1c2d3e4-0015-4a5b-8c6d-7e8f90a1b215}">
      <Declaration><![CDATA[// #177: a new target clears the three offsets, the same target sent again keeps them
METHOD PRIVATE New_Target_Clears_Offsets_Same_Target_Keeps_Them
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
	fbTel	: FB_MonetTelescopeProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('New_Target_Clears_Offsets_Same_Target_Keeps_Them');
fbTel.SetAltitudeOffset(0.01);
fbTel.SetAzimuthOffset(0.02);
fbTel.SetDerotatorOffset(0.5);
fbTel.Track(fRightAscension := 10.0, fDeclination := 20.0);
AssertEquals(Expected := 0.0, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'new target: elevation offset cleared');
AssertEquals(Expected := 0.0, Actual := fbTel.AzimuthOffset, Delta := 1.0E-12, Message := 'new target: azimuth offset cleared');
AssertEquals(Expected := 0.0, Actual := fbTel.DerotatorOffset, Delta := 1.0E-12, Message := 'new target: derotator offset cleared');
fbTel.SetAltitudeOffset(0.01);
fbTel.Track(fRightAscension := 10.0, fDeclination := 20.0);
AssertEquals(Expected := 0.01, Actual := fbTel.AltitudeOffset, Delta := 1.0E-12, Message := 'same target again: offset kept');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Scan" Id="{71d29b26-686b-4cd9-9173-dad44653aedb}">
      <Declaration><![CDATA[// one pendant scan with the given inputs. The selector debounce is off (T#0S) but needs a second scan to see the selector stable,
// so a change of the selector is applied with Hold (two scans).
METHOD PRIVATE Scan
VAR_IN_OUT
	fbP		: FB_MonetPendantProbe;
	fbEl	: FB_ElevationMock;
	fbAz	: FB_AzimuthMock;
	fbDr	: FB_DerotatorMock;
	fbFo	: FB_FocusMock;
END_VAR
VAR_INPUT
	bKey		: BOOL;
	bButton		: BOOL;
	nSel		: UINT;
	bUp			: BOOL;
	bDown		: BOOL;
	bLeft		: BOOL;
	bRight		: BOOL;
	tRelease	: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbP(bKey := bKey, bButton := bButton, nSel := nSel, bUp := bUp, bDown := bDown, bLeft := bLeft, bRight := bRight,
	tEnableRelease := tRelease, tSelectionDebounce := T#0S,
	fbElevation := fbEl, fbAzimuth := fbAz, fbDerotator := fbDr, fbFocus := fbFo);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hold" Id="{e6f1982d-6228-44af-a18d-f171701b335e}">
      <Declaration><![CDATA[// two scans with the same inputs: the selector is stable from the second one
METHOD PRIVATE Hold
VAR_IN_OUT
	fbP		: FB_MonetPendantProbe;
	fbEl	: FB_ElevationMock;
	fbAz	: FB_AzimuthMock;
	fbDr	: FB_DerotatorMock;
	fbFo	: FB_FocusMock;
END_VAR
VAR_INPUT
	bKey		: BOOL;
	bButton		: BOOL;
	nSel		: UINT;
	bUp			: BOOL;
	bDown		: BOOL;
	bLeft		: BOOL;
	bRight		: BOOL;
	tRelease	: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Scan(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := bKey, bButton := bButton, nSel := nSel, bUp := bUp, bDown := bDown, bLeft := bLeft, bRight := bRight, tRelease := tRelease);
Scan(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := bKey, bButton := bButton, nSel := nSel, bUp := bUp, bDown := bDown, bLeft := bLeft, bRight := bRight, tRelease := tRelease);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Elevation_Key_Off_Releases_Jog" Id="{b9186aad-ab0c-4ada-b175-cf794ec10aee}">
      <Declaration><![CDATA[// Key off while the elevation is jogged: MovePos/MoveNeg are FALSE, Enable follows after tEnableRelease (#3)
METHOD PRIVATE Elevation_Key_Off_Releases_Jog
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Elevation_Key_Off_Releases_Jog');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbEl.MovePos, Message := 'precondition: the elevation jogs up');
AssertTrue(Condition := fbEl.Enable, Message := 'precondition: the elevation is enabled');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertFalse(Condition := fbEl.MovePos, Message := 'key off: MovePos released');
AssertFalse(Condition := fbEl.MoveNeg, Message := 'key off: MoveNeg released');
AssertTrue(Condition := fbEl.Enable, Message := 'Enable stays until tEnableRelease has expired');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#0S);
AssertFalse(Condition := fbEl.Enable, Message := 'Enable dropped after tEnableRelease');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Azimuth_Selector_Change_Releases_Jog" Id="{01628a95-7812-4cef-ac18-c660277812b1}">
      <Declaration><![CDATA[// Selector 8 to 7 while a direction is held: the azimuth jog is released, the elevation takes over (#3)
METHOD PRIVATE Azimuth_Selector_Change_Releases_Jog
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Azimuth_Selector_Change_Releases_Jog');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 8, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#1H);
AssertTrue(Condition := fbAz.MovePos, Message := 'precondition: the azimuth jogs right');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#1H);
AssertFalse(Condition := fbAz.MovePos, Message := 'selector change: azimuth MovePos released');
AssertFalse(Condition := fbAz.MoveNeg, Message := 'selector change: azimuth MoveNeg released');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Derotator_Selector_Zero_Releases_Jog" Id="{aa52798f-4291-4c55-a159-07d540b7ab6b}">
      <Declaration><![CDATA[// Selector reads 0 (pendant cable pulled): the derotator jog is released and the error lamp is on (#3)
METHOD PRIVATE Derotator_Selector_Zero_Releases_Jog
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Derotator_Selector_Zero_Releases_Jog');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 6, bUp := FALSE, bDown := FALSE, bLeft := TRUE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbDr.MoveNeg, Message := 'precondition: the derotator jogs left');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 0, bUp := FALSE, bDown := FALSE, bLeft := TRUE, bRight := FALSE, tRelease := T#1H);
AssertFalse(Condition := fbDr.MoveNeg, Message := 'selector 0: derotator MoveNeg released');
AssertFalse(Condition := fbDr.MovePos, Message := 'selector 0: derotator MovePos released');
AssertTrue(Condition := fbP.ObLampError, Message := 'selector 0: error lamp on');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Key_Off_Releases_Jog" Id="{213fc2e8-fadb-4b15-b740-c8ec0894d5e7}">
      <Declaration><![CDATA[// Key off while the focus is jogged: MovePos is FALSE (#3)
METHOD PRIVATE Focus_Key_Off_Releases_Jog
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Key_Off_Releases_Jog');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 5, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbFo.MovePos, Message := 'precondition: the focus jogs up');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 5, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertFalse(Condition := fbFo.MovePos, Message := 'key off: focus MovePos released');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Key_Off_Without_Ownership_Writes_Nothing" Id="{c3a7ca3d-edd7-4ee1-8f5e-a5a0643aca97}">
      <Declaration><![CDATA[// With the key off the pendant owns nothing and writes nothing: a jog started elsewhere (Visu, telescope) stays (#3)
METHOD PRIVATE Key_Off_Without_Ownership_Writes_Nothing
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Key_Off_Without_Ownership_Writes_Nothing');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
fbEl.MovePos := TRUE;
fbEl.Enable := TRUE;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbEl.MovePos, Message := 'a jog set elsewhere is not touched with the key off');
AssertTrue(Condition := fbEl.Enable, Message := 'an Enable set elsewhere is not touched with the key off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Release_Is_Once" Id="{74b2c60a-9483-4952-9e8d-98953882536c}">
      <Declaration><![CDATA[// The release is one write: a jog set after it (Visu) is not released again (#3)
METHOD PRIVATE Release_Is_Once
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Release_Is_Once');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbEl.MovePos, Message := 'precondition: the elevation jogs up');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertFalse(Condition := fbEl.MovePos, Message := 'released');
fbEl.MovePos := TRUE;
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbEl.MovePos, Message := 'not released a second time');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reselect_Cancels_Enable_Drop" Id="{669cbc01-79b9-4440-9ee0-46c92e36d01d}">
      <Declaration><![CDATA[// The same function selected again before tEnableRelease expires: the pending Enable drop is cancelled (#3)
METHOD PRIVATE Reselect_Cancels_Enable_Drop
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reselect_Cancels_Enable_Drop');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertTrue(Condition := fbEl.Enable, Message := 'precondition: the elevation is enabled');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := FALSE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertEquals_UINT(Expected := 7, Actual := fbP.nEnablePending, Message := 'precondition: the Enable drop of the elevation is pending');
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tRelease := T#1H);
AssertEquals_UINT(Expected := 0, Actual := fbP.nEnablePending, Message := 'selected again: the pending Enable drop is cancelled');
AssertTrue(Condition := fbEl.Enable, Message := 'selected again with the button held: Enable stays');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Selector_Bounce_Does_Not_Drive_Intermediate_Function" Id="{a8160511-039f-45c2-9b05-506bba8d9141}">
      <Declaration><![CDATA[// The first scan after a selector change drives nothing: turning 7 to 8 with a direction held does not jog the new function at once (#3)
METHOD PRIVATE Selector_Bounce_Does_Not_Drive_Intermediate_Function
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
	fbEl	: FB_ElevationMock(comm := fbComm);
	fbAz	: FB_AzimuthMock(comm := fbComm);
	fbDr	: FB_DerotatorMock(comm := fbComm);
	fbFo	: FB_FocusMock(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Selector_Bounce_Does_Not_Drive_Intermediate_Function');
fbEl.SetDigitalInputs(16#3);
fbAz.SetDigitalInputs(16#3);
Hold(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 7, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#1H);
Scan(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 8, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#1H);
AssertFalse(Condition := fbAz.MovePos, Message := 'first scan at the new selector: nothing driven');
AssertFalse(Condition := fbEl.MovePos, Message := 'the old function is released');
Scan(fbP := fbP, fbEl := fbEl, fbAz := fbAz, fbDr := fbDr, fbFo := fbFo, bKey := TRUE, bButton := TRUE, nSel := 8, bUp := FALSE, bDown := FALSE, bLeft := FALSE, bRight := TRUE, tRelease := T#1H);
AssertTrue(Condition := fbAz.MovePos, Message := 'stable selector: the azimuth jogs');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unassigned_References_Do_Not_Fault" Id="{f87dbd70-dda5-42b8-9d6d-92a611256842}">
      <Declaration><![CDATA[// No references assigned: every function can be selected for a scan without a null dereference (a failure here is a page fault, CI shows a crashed run)
METHOD PRIVATE Unassigned_References_Do_Not_Fault
VAR
	fbComm	: FB_NullComm;
	fbP		: FB_MonetPendantProbe(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Unassigned_References_Do_Not_Fault');
fbP(bKey := TRUE, bButton := TRUE, nSel := 1, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 1, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 5, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 5, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 6, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 6, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 7, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 8, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := TRUE, bButton := TRUE, nSel := 8, bUp := TRUE, bDown := FALSE, bLeft := FALSE, bRight := FALSE, tSelectionDebounce := T#0S);
fbP(bKey := FALSE, nSel := 7, tSelectionDebounce := T#0S);
AssertTrue(Condition := TRUE, Message := 'no fault with unassigned references');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unlinked_Pendant_Lights_Error_Lamp" Id="{160231b1-de38-493f-9d6b-339d6320396b}">
      <Declaration><![CDATA[// Selector 0 and key off: ObLampError is TRUE (it used to keep its last value, FALSE after start-up),
// bEnable stays FALSE and no direction lamp is lit (HalfBROT #12).
METHOD PRIVATE Unlinked_Pendant_Lights_Error_Lamp
VAR
	fbComm		: FB_NullComm;
	fbPendant	: MONETcommon.FB_MonetPendantControl(comm := fbComm);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Unlinked_Pendant_Lights_Error_Lamp');
fbPendant();
AssertTrue(Condition := fbPendant.ObLampError, Message := 'error lamp is on with selector 0');
AssertFalse(Condition := fbPendant.bEnable, Message := 'bEnable is FALSE with the key off');
AssertFalse(Condition := fbPendant.ObLampUp, Message := 'up lamp is off');
AssertFalse(Condition := fbPendant.ObLampDown, Message := 'down lamp is off');
AssertFalse(Condition := fbPendant.ObLampLeft, Message := 'left lamp is off');
AssertFalse(Condition := fbPendant.ObLampRight, Message := 'right lamp is off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>