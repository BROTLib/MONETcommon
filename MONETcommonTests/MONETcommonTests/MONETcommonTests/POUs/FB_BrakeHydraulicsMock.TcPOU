<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_BrakeHydraulicsMock" Id="{d6fd3765-198f-4172-b62a-9673b69f0003}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of the hydraulics unit, which is both the brake (I_Brake) and the hydraulics (I_Hydraulics) on MONETS/MONETN.
FUNCTION_BLOCK FB_BrakeHydraulicsMock IMPLEMENTS BROTLib.I_Brake, BROTLib.I_Hydraulics
VAR
	bBrakeIsOpen	: BOOL;
	bEnabled		: BOOL;
	bFailed			: BOOL;
	bStartSuction	: BOOL;
	bStopPump		: BOOL;
	nOpenCalls		: UINT;
	nCloseCalls		: UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Method Name="OpenBrake" Id="{bc28f56f-a6a2-4f79-8d67-99432a4b3986}">
      <Declaration><![CDATA[METHOD OpenBrake : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bBrakeIsOpen := TRUE;
nOpenCalls := nOpenCalls + 1;
OpenBrake := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CloseBrake" Id="{7f9962d8-9c80-4060-8248-ea1733687993}">
      <Declaration><![CDATA[METHOD CloseBrake : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bBrakeIsOpen := FALSE;
nCloseCalls := nCloseCalls + 1;
CloseBrake := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{3eb8020a-1b75-4938-a3a0-da58381b5d1f}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bFailed := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="BrakeOpen" Id="{30b73c5a-ffa0-456f-a6e7-3d70b3404ecf}">
