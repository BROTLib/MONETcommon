END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bStartSuction := ManualStartSuction;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ManualStopPump" Id="{2ddff069-acbf-4690-822f-72a1fdad65df}">
