END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bEnabled := Enable;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Error" Id="{a4145293-424c-4b1a-8329-23ac7162fa1c}">
