        </Implementation>
      </Get>
      <Set Name="Set" Id="{12230013-e2ae-40c1-8c20-7bb664e59b9b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bStopPump := ManualStopPump;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="OilPressureOK" Id="{4e5d1a2f-5061-45bd-afc0-42d65abbac19}">
      <Declaration><![CDATA[PROPERTY OilPressureOK : BOOL]]></Declaration>
      <Get Name="Get" Id="{2331e5ef-f7fe-4e8f-bf87-51be9fd5dd72}">
