      <Get Name="Get" Id="{c7aec1d0-65fb-45ae-b093-9c4129b6f4f0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BrakeOpen := bBrakeIsOpen;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Enable" Id="{a0345438-323d-4998-98a8-aaa46c6eaf40}">
