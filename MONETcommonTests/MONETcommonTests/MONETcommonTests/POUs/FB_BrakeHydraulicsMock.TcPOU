<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_BrakeHydraulicsMock" Id="{b710b6cd-5a7f-4296-96e0-69b08cd2bf4f}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of the hydraulics unit, which is both the brake (I_Brake) and the hydraulics (I_Hydraulics) on MONETS/MONETN.
FUNCTION_BLOCK FB_BrakeHydraulicsMock IMPLEMENTS BROTLib.I_Brake, BROTLib.I_Hydraulics
VAR
	bBrakeIsOpen	: BOOL;
	bEnabled		: BOOL;
	bFailed			: BOOL;
	bStartSuction	: BOOL;
	bStopPump		: BOOL;
	nOpenCalls		: UINT;
	nCloseCalls		: UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Method Name="OpenBrake" Id="{1860ca1d-fc0d-4dcf-9300-461841a019a3}">
      <Declaration><![CDATA[METHOD OpenBrake : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bBrakeIsOpen := TRUE;
nOpenCalls := nOpenCalls + 1;
OpenBrake := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CloseBrake" Id="{c2fadfac-89f8-4739-a96e-c54aa1375935}">
      <Declaration><![CDATA[METHOD CloseBrake : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bBrakeIsOpen := FALSE;
nCloseCalls := nCloseCalls + 1;
CloseBrake := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="InjectError" Id="{026406ac-d201-44d8-81fe-06f99e026f89}">
      <Declaration><![CDATA[// the hydraulics report an error until Reset() (fbHydraulics.Error, #155)
METHOD InjectError
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bFailed := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{16f43ef0-757d-4384-8dfd-12f9d925c432}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bFailed := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="BrakeOpen" Id="{204a74e7-dd69-4286-ba4a-f6d8af491b0e}">
      <Declaration><![CDATA[PROPERTY BrakeOpen : BOOL]]></Declaration>
      <Get Name="Get" Id="{7906c1ca-cfc4-4697-85f7-4747f39743d8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BrakeOpen := bBrakeIsOpen;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Enable" Id="{a7fabbdc-1914-4ba3-b880-a9a9efdf711e}">
      <Declaration><![CDATA[PROPERTY Enable : BOOL]]></Declaration>
      <Get Name="Get" Id="{364b7fff-89a5-4852-b599-5d22c51cb154}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
