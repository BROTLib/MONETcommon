        </Implementation>
      </Get>
      <Set Name="Set" Id="{8c793db1-1c28-4866-a715-01adc659a592}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bEnabled := Enable;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Error" Id="{279f0a44-7656-4396-a7be-cb44b7e5318c}">
      <Declaration><![CDATA[PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{4f35eefc-e137-4abb-8542-d2d4aaa06e16}">
