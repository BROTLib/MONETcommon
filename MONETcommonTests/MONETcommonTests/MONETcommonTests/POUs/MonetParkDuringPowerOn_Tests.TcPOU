<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MonetParkDuringPowerOn_Tests" Id="{ef273f8d-20bc-4a45-b4f7-010fd9017fa8}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of FB_MonetTelescopeControl for a park or a stop that arrives during the power-on, and for an Init() during a
// park, on mock axes (plan step 1, MONETcommonTests README). These tests pin what the code does today, with the line of the
// behaviour in a comment; they are not a specification. Every test owns a rig and runs over many PLC cycles (VAR_INST of the
// method, one Scan() per cycle). Failed checks are also noted in GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK MonetParkDuringPowerOn_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Park_During_PowerOn_Parks_In_Place_And_Closes_The_Covers();
Park_During_Homing_Stops_The_Homing_Axes_First();
Stop_During_PowerOn_Aborts_The_Startup();
Init_During_Park_Is_Refused();
]]></ST>
    </Implementation>
    <Method Name="Park_During_PowerOn_Parks_In_Place_And_Closes_The_Covers" Id="{27f535d0-bbf6-4f9b-b4ca-266f7b7d2542}">
      <Declaration><![CDATA[// M:533-545 (#87), M:1245 (#113): a park that arrives while the power-on has only commanded the covers aborts the power-on and
// parks in place (no axis is calibrated, so none is sent to the park position): the axes are disabled, the covers that the
// power-on opened are closed again, READY_STATE is parked (0.0).
METHOD PRIVATE Park_During_PowerOn_Parks_In_Place_And_Closes_The_Covers
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_During_PowerOn_Parks_In_Place_And_Closes_The_Covers');
sTest := 'Park_During_PowerOn_Parks_In_Place_And_Closes_The_Covers: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: park now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the park has finished
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bPark, Message := 'the park is over');
		F_Note(bFailed := (rig.fbTel.bPark), sText := CONCAT(sTest, 'the park is over'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1, Message := 'the covers the power-on opened are closed again');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers the power-on opened are closed again'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'all three axes are disabled (parked in place)');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'all three axes are disabled (parked in place)'));
		AssertTrue(Condition := rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0, Message := 'nothing was moving, so no axis was stopped');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0), sText := CONCAT(sTest, 'nothing was moving, so no axis was stopped'));
		AssertFalse(Condition := rig.fbTel.fbStartup.Initializing, Message := 'the startup is aborted');
		F_Note(bFailed := (rig.fbTel.fbStartup.Initializing), sText := CONCAT(sTest, 'the startup is aborted'));
		AssertTrue(Condition := rig.fbTel.ReadyState = 0.0, Message := 'READY_STATE is parked (0.0)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 0.0), sText := CONCAT(sTest, 'READY_STATE is parked (0.0)'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Park_During_Homing_Stops_The_Homing_Axes_First" Id="{71651cc9-a542-4aa6-9cd5-b52ae8699fee}">
      <Declaration><![CDATA[// M:533-545 (#87) with the abort stop (#84): a park that arrives while the axes are homing aborts the power-on, sends one stop to
// each axis that was homing, waits for the stop to settle and then parks in place; the aborted homing does not calibrate.
METHOD PRIVATE Park_During_Homing_Stops_The_Homing_Axes_First
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_During_Homing_Stops_The_Homing_Axes_First');
sTest := 'Park_During_Homing_Stops_The_Homing_Axes_First: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.SetHomeScans(40);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// both axes are homing: park now
	IF rig.fbElev.fbAxis.Homing AND rig.fbAzim.fbAxis.Homing THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the axes never started homing');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the axes never started homing'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the park has finished
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbElev.nStopEdges = 1 AND rig.fbAzim.nStopEdges = 1, Message := 'the elevation and the azimuth that were homing got one stop each');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 1 AND rig.fbAzim.nStopEdges = 1), sText := CONCAT(sTest, 'the elevation and the azimuth that were homing got one stop each'));
		AssertFalse(Condition := rig.fbElev.Calibrated OR rig.fbAzim.Calibrated, Message := 'the aborted homing did not calibrate');
		F_Note(bFailed := (rig.fbElev.Calibrated OR rig.fbAzim.Calibrated), sText := CONCAT(sTest, 'the aborted homing did not calibrate'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'all three axes are disabled (parked in place)');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'all three axes are disabled (parked in place)'));
		AssertTrue(Condition := rig.fbCovers.bClosed, Message := 'the covers are closed');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed), sText := CONCAT(sTest, 'the covers are closed'));
		AssertTrue(Condition := rig.fbTel.ReadyState = 0.0, Message := 'READY_STATE is parked (0.0)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 0.0), sText := CONCAT(sTest, 'READY_STATE is parked (0.0)'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_During_PowerOn_Aborts_The_Startup" Id="{25600afc-21e9-4323-b67d-f3e061c4061a}">
      <Declaration><![CDATA[// M:508-518 (#80): a stop outranks a running power-on. The startup is aborted (READY_STATE -2.0), nothing is parked, and the
// covers the power-on opened stay open: a stop does not close them.
METHOD PRIVATE Stop_During_PowerOn_Aborts_The_Startup
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_During_PowerOn_Aborts_The_Startup');
sTest := 'Stop_During_PowerOn_Aborts_The_Startup: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: stop now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the stop has settled
	IF NOT rig.fbTel.bStop AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bPower, Message := 'the power-on request is dropped');
		F_Note(bFailed := (rig.fbTel.bPower), sText := CONCAT(sTest, 'the power-on request is dropped'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'the stop does not park');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the stop does not park'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 (startup aborted)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 (startup aborted)'));
		AssertTrue(Condition := rig.fbCovers.bOpened, Message := 'the covers stay open');
		F_Note(bFailed := NOT (rig.fbCovers.bOpened), sText := CONCAT(sTest, 'the covers stay open'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init_During_Park_Is_Refused" Id="{106ad422-b016-4cc5-b9f2-4d1c7175e978}">
      <Declaration><![CDATA[// M:1969 (#87, #80): park wins in both orders. An Init() while a park runs is refused with a reason and starts no power-on; the
// park goes on and ends parked.
METHOD PRIVATE Init_During_Park_Is_Refused
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Init_During_Park_Is_Refused');
sTest := 'Init_During_Park_Is_Refused: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: start a park
	IF rig.Online THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park is running: an Init() now is refused
	rig.fbTel.Init();
		AssertTrue(Condition := rig.fbTel.bInitRefused, Message := 'the Init() is refused');
		F_Note(bFailed := NOT (rig.fbTel.bInitRefused), sText := CONCAT(sTest, 'the Init() is refused'));
		AssertTrue(Condition := rig.fbTel.sInitRefusedReason = 'park in progress, send stop to cancel it', Message := 'the reason names the park');
		F_Note(bFailed := NOT (rig.fbTel.sInitRefusedReason = 'park in progress, send stop to cancel it'), sText := CONCAT(sTest, 'the reason names the park'));
		AssertFalse(Condition := rig.fbTel.bPower, Message := 'no power-on is started');
		F_Note(bFailed := (rig.fbTel.bPower), sText := CONCAT(sTest, 'no power-on is started'));
	nStep := 30;
	nCycles := 0;
30:	// wait until the park has finished
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bPower, Message := 'the power-on request is still dropped');
		F_Note(bFailed := (rig.fbTel.bPower), sText := CONCAT(sTest, 'the power-on request is still dropped'));
		AssertTrue(Condition := rig.fbTel.ReadyState = 0.0, Message := 'the park ended parked (0.0)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 0.0), sText := CONCAT(sTest, 'the park ended parked (0.0)'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
