<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HomeFailPosition_Tests" Id="{ea4851d9-64db-43a6-b580-d0ac38b5177a}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for HalfBROT.FB_HomeFailPosition, the position restore after a failed cam homing (HalfBROT#147). Pure logic, no NC: the NC's
// virtual homing position is simulated as -1E10 / +1E10 (MC_SetPosition is not run, the block only asks for it).
FUNCTION_BLOCK FB_HomeFailPosition_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Restores_Start_Plus_Travel();
Waits_Until_Axis_Can_Set();
Clamped_Into_Window();
Latest_Idle_Position_Is_The_Start();
Jump_Is_Not_Travel();
Done_Ends_The_Restore();
Set_Error_No_Retry();
Uncalibrated_Start_Not_Restored();
Failure_At_Real_Position_Not_Restored();
]]></ST>
    </Implementation>
    <Method Name="Restores_Start_Plus_Travel" Id="{159aa082-bec8-4e30-af1f-c5cd9a4fc128}">
      <Declaration><![CDATA[// Homing started at 40.0, moved 0.5 at the virtual position, failed: restore to 40.5, not clamped.
METHOD PRIVATE Restores_Start_Plus_Travel
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Restores_Start_Plus_Travel');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertTrue(Condition := fb.bRestore, Message := 'restore wanted');
AssertEquals_LREAL(Expected := 40.5, Actual := fb.fRestorePosition, Delta := 1.0E-9, Message := 'start + travel');
AssertEquals_LREAL(Expected := 40.5, Actual := fb.fEstimate, Delta := 1.0E-9, Message := 'estimate');
AssertFalse(Condition := fb.bClamped, Message := 'not clamped');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Waits_Until_Axis_Can_Set" Id="{33578a24-bbba-4d60-b05c-a729270ec1fd}">
      <Declaration><![CDATA[// The restore is asked for only while MC_SetPosition can run (no error, axis at rest).
METHOD PRIVATE Waits_Until_Axis_Can_Set
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Waits_Until_Axis_Can_Set');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := FALSE, bSetDone := FALSE, bSetError := FALSE);
AssertFalse(Condition := fb.bRestore, Message := 'waiting');
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertTrue(Condition := fb.bRestore, Message := 'restore wanted');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clamped_Into_Window" Id="{8b8fd745-9a1a-48e4-b7f5-7f6f87d353c4}">
      <Declaration><![CDATA[// Start close to the upper end: the restored value is held fMargin inside the window.
METHOD PRIVATE Clamped_Into_Window
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Clamped_Into_Window');
Step(fb := fb, fActual := 89.9, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.0, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.0, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertTrue(Condition := fb.bRestore, Message := 'restore wanted');
AssertEquals_LREAL(Expected := 89.5, Actual := fb.fRestorePosition, Delta := 1.0E-9, Message := 'clamped to max - margin');
AssertEquals_LREAL(Expected := 89.9, Actual := fb.fEstimate, Delta := 1.0E-9, Message := 'estimate unclamped');
AssertTrue(Condition := fb.bClamped, Message := 'clamped');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Latest_Idle_Position_Is_The_Start" Id="{40fd638f-a88b-4da7-ac9f-201740473389}">
      <Declaration><![CDATA[// The start is the last real position before the homing, not the first one.
METHOD PRIVATE Latest_Idle_Position_Is_The_Start
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Latest_Idle_Position_Is_The_Start');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := 50.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertTrue(Condition := fb.bRestore, Message := 'restore wanted');
AssertEquals_LREAL(Expected := 50.0, Actual := fb.fRestorePosition, Delta := 1.0E-9, Message := 'restore to the latest position');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Jump_Is_Not_Travel" Id="{a95a8813-f5aa-4984-91a7-a52c35b09266}">
      <Declaration><![CDATA[// The NC jump from -1E10 to +1E10 at the cam is not counted as travel, only the real travel after it.
METHOD PRIVATE Jump_Is_Not_Travel
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Jump_Is_Not_Travel');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := 1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := 1.0E10 + 0.25, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := 1.0E10 + 0.25, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertTrue(Condition := fb.bRestore, Message := 'restore wanted');
AssertEquals_LREAL(Expected := 40.25, Actual := fb.fRestorePosition, Delta := 1.0E-9, Message := 'start + 0.25, without the jump');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Done_Ends_The_Restore" Id="{15ce7edc-9b07-4fac-8915-ee9cc5fc44a0}">
      <Declaration><![CDATA[// MC_SetPosition done: reported for one cycle, the request ends.
METHOD PRIVATE Done_Ends_The_Restore
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Done_Ends_The_Restore');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := TRUE, bSetError := FALSE);
AssertTrue(Condition := fb.bRestored, Message := 'restored');
AssertFalse(Condition := fb.bRestore, Message := 'request ends');
Step(fb := fb, fActual := 40.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertFalse(Condition := fb.bRestored, Message := 'one cycle only');
AssertFalse(Condition := fb.bRestore, Message := 'no new request');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Set_Error_No_Retry" Id="{ea5eabd5-94e2-4a6c-a19f-8fae577dcf2c}">
      <Declaration><![CDATA[// MC_SetPosition failed: reported for one cycle, no retry.
METHOD PRIVATE Set_Error_No_Retry
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Set_Error_No_Retry');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := TRUE);
AssertTrue(Condition := fb.bRestoreFailed, Message := 'failed');
AssertFalse(Condition := fb.bRestore, Message := 'request ends');
Step(fb := fb, fActual := -1.0E10 + 0.5, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertFalse(Condition := fb.bRestoreFailed, Message := 'one cycle only');
AssertFalse(Condition := fb.bRestore, Message := 'no retry');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Uncalibrated_Start_Not_Restored" Id="{356af908-02d6-40cc-ae0e-1a0715d7c5ed}">
      <Declaration><![CDATA[// A homing that started on an uncalibrated axis has no meaningful start: no restore.
METHOD PRIVATE Uncalibrated_Start_Not_Restored
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Uncalibrated_Start_Not_Restored');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := -1.0E10, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertFalse(Condition := fb.bRestore, Message := 'no restore');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Failure_At_Real_Position_Not_Restored" Id="{c9bc9e45-164c-4b05-8010-4eeaa5f089fa}">
      <Declaration><![CDATA[// A failure report while the position is real (not the NC's virtual one): nothing to restore.
METHOD PRIVATE Failure_At_Real_Position_Not_Restored
VAR
	fb	: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Failure_At_Real_Position_Not_Restored');
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := TRUE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := 40.0, bHomeActive := TRUE, bCalibrated := FALSE, bFailed := FALSE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
Step(fb := fb, fActual := 40.0, bHomeActive := FALSE, bCalibrated := FALSE, bFailed := TRUE, bCanSet := TRUE, bSetDone := FALSE, bSetError := FALSE);
AssertFalse(Condition := fb.bRestore, Message := 'no restore');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Step" Id="{93abfea1-ddcf-41f4-bd69-b236a302fe92}">
      <Declaration><![CDATA[// One cycle of the block with a window of 0 to 90 (margin 0.5, largest step 1.0: the block defaults).
METHOD PRIVATE Step
VAR_INPUT
	fActual		: LREAL;
	bHomeActive	: BOOL;
	bCalibrated	: BOOL;
	bFailed		: BOOL;
	bCanSet		: BOOL := TRUE;
	bSetDone	: BOOL;
	bSetError	: BOOL;
END_VAR
VAR_IN_OUT
	fb			: HalfBROT.FB_HomeFailPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fb(fActualPosition := fActual, bHomeActive := bHomeActive, bHomePending := FALSE, bCalibrated := bCalibrated, bFailed := bFailed,
	bCanSet := bCanSet, fMin := 0.0, fMax := 90.0, bSetDone := bSetDone, bSetError := bSetError);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
