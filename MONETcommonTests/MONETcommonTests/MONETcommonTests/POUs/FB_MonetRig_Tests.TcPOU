<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetRig_Tests" Id="{3ed949b3-7d66-48e5-bdad-edf8be04d763}" SpecialFunc="None">
    <Declaration><![CDATA[// Smoke test of the mock rig (spike S0 of the telescope state machine plan (BROTLib specs/plans/2026-10-21-telescope-state-machine-unification.md, step 0.2):
// can the real FB_MonetTelescopeControl run on axis mocks that subclass the HalfBROT axis blocks? Answers D1 (a) writing the
// nested fbAxis outputs from the derived block, (b) a body override without SUPER^(), (c) AT%I* of FB_AxisControl on the target.
// Also the telemetry record of the telescope (#24 step 4a, MONETcommon.FB_MonetTelescopeTelemetry) for a fixed snapshot, recorded
// by FB_RecordingComm: here because all 40 suite slots are used and this suite is about the parts of FB_MonetTelescopeControl.
// And the command inputs of #24 step 5 (read-only, edge-triggered; the requests are the b*Active outputs), here for the same reason.
// And the goto window from stMotion (#24 step 2c), moved here in #24 step 6 when F_GotoTargetCheck_Tests went to BROTLib.
FUNCTION_BLOCK FB_MonetRig_Tests EXTENDS TcUnit.FB_TestSuite
VAR
	fbComm			: FB_NullComm;
	fbElev			: FB_ElevationMock(comm := fbComm);
	fbAzim			: FB_AzimuthMock(comm := fbComm);
	fbDero			: FB_DerotatorMock(comm := fbComm);
	fbFocus			: FB_FocusMock(comm := fbComm);
	fbCovers		: FB_CoversMock(comm := fbComm);
	stFocusOut		: HalfBROT.ST_FocusOut;
	fbBrakeHyd		: FB_BrakeHydraulicsMock;
	fbPointing		: FB_PointingModelForward(AOFF := 0.0, BNP := 0.0, AN_A := 0.0, AE_A := 0.0, NPAE := 0.0, EOFF := 0.0, AN_E := 0.0, AE_E := 0.0, TF := 0.0);	// zero coefficients
	fbPointingInv	: FB_PointingModelInversion(fbPointing := fbPointing);
	fbTel			: FB_MonetTelescopeControl(comm := fbComm);
END_VAR
VAR CONSTANT
	telescopeConfig	: ST_TelescopeConfig := (longitude := 20.810808, latitude := -32.375823, altitude := 1798.0,
											 azimuthPark := 175, elevationPark := 60, derotatorPark := 0, focusPark := 36.0,
											 azimuthHome := 175, elevationHome := 40, derotatorHome := 0,
											 name := 'MONET/S', diameter := 1.2, cabinet := 'Beckhoff', manufacturer := 'test',
											 mountOptions := 'ALT-AZ', mount := 'ALT_AZ');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Mock_Axis_Move_Reports_MoveDone();
Rig_Instantiates_Telescope_With_Mock_Axes();
Monets_Elevation_Velocity_Alias_Is_Used();
Telemetry_Publishes_The_Snapshot();
Telemetry_Axis_State_Branches();
Held_Slew_Input_Starts_The_Slew_Once();
Slew_Input_Falling_Does_Not_Abort_The_Slew();
Slew_Method_And_Input_Edge_In_One_Scan_Count_Once();
Repeated_Track_Retargets_And_Second_Stop_Works();
Derotator_Offset_Set_At_The_Start_Of_A_Track_Is_Ramped();
AltAz_Offsets_Set_During_A_Track_Are_Ramped();
Track_Start_Setpoint_Begins_At_The_Axis_Position();
Retarget_By_Direct_RaDec_Write_Is_Blended();
Retarget_During_The_Move_Onto_The_Track();
Feed_From_Position_Is_Passed_To_Elevation_And_Azimuth();
Derotator_Track_Start_Setpoint_Begins_At_The_Axis_Position();
Small_Track_Retarget_Stays_Tracking();
Large_Retarget_By_Direct_Write_Goes_Through_The_Move();
Retarget_Mid_Blend_Keeps_The_Velocity();
Stop_During_A_Retarget_Blend_Settles();
Goto_Window_From_stMotion_Refuses_The_Pole();
Slew_Window_Refuses_Low_And_High_Elevation();
]]></ST>
    </Implementation>
    <Method Name="Mock_Axis_Move_Reports_MoveDone" Id="{4aeb9af3-2d82-44f2-87fd-050f1d95d90d}">
      <Declaration><![CDATA[METHOD PRIVATE Mock_Axis_Move_Reports_MoveDone
VAR
	i			: INT;
	bSeenDone	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Mock_Axis_Move_Reports_MoveDone');
fbElev.bEnable := TRUE;
FOR i := 1 TO 10 DO
	fbElev();
END_FOR
AssertTrue(Condition := fbElev.Ready, Message := 'enabled mock axis is ready');

fbElev.HomeAxis := TRUE;
FOR i := 1 TO 10 DO
	fbElev();
END_FOR
AssertTrue(Condition := fbElev.Calibrated, Message := 'homing calibrates the mock axis');

fbElev.nMockMoveScans := 4;	// the default move takes 60 scans (long enough to interrupt it in the scenario suites)
fbElev.Position := 30.0;
fbElev.MoveAxis := TRUE;
FOR i := 1 TO 20 DO
	fbElev();
	IF fbElev.MoveDone THEN
		bSeenDone := TRUE;
	END_IF
END_FOR
AssertTrue(Condition := bSeenDone, Message := 'MoveDone was reported');
AssertFalse(Condition := fbElev.MoveAxis, Message := 'the move level is cleared on MoveDone');
AssertEquals_LREAL(Expected := 30.0, Actual := fbElev.ActualPosition, Delta := 0.001, Message := 'position is the target');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Rig_Instantiates_Telescope_With_Mock_Axes" Id="{d179b82d-b465-4c72-9f8b-293425632a43}">
      <Declaration><![CDATA[METHOD PRIVATE Rig_Instantiates_Telescope_With_Mock_Axes
VAR
	i	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Rig_Instantiates_Telescope_With_Mock_Axes');
FOR i := 1 TO 10 DO
	fbTel(
		telescopeConfig := telescopeConfig,
		fbCovers := fbCovers,
		fbBrake := fbBrakeHyd,
		fbHydraulics := fbBrakeHyd,
		fbFocus := fbFocus,
		fbElevation := fbElev,
		fbAzimuth := fbAzim,
		fbDerotator := fbDero,
		fbPointing := fbPointing,
		fbPointingInverse := fbPointingInv);
	fbElev();
	fbAzim();
	fbDero();
	fbFocus(stOut := stFocusOut);
END_FOR
AssertFalse(Condition := fbTel.bError, Message := 'telescope on mock axes reports no error');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Monets_Elevation_Velocity_Alias_Is_Used" Id="{98a6998a-c9d6-428d-834c-a7683598224c}">
      <Declaration><![CDATA[// #24 step 2c, D2, on the mock rig (FB_MonetRig): MONETS MAIN passes the deprecated input fElevationMoveVelocity := 3.0 and leaves
// stMotion at its defaults. The alias is not at its old default (5.0), so it wins: a slew moves the elevation at 3.0 deg/s, azimuth
// and derotator keep stMotion's 10.0, and the alias is the one listed as in use (logged once). Back at 5.0 the alias is not used and
// stMotion.fElevationMoveVelocity applies. Multi-cycle (VAR_INST rig, one Scan() per PLC cycle, the first cycles wait for the
// astronomical clock). Failed checks are also noted in GVL_Diag.sFailures.
METHOD PRIVATE Monets_Elevation_Velocity_Alias_Is_Used
VAR_INST
	rig			: FB_MonetRig;
	stCfg		: BROTLib.ST_MotionConfig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Monets_Elevation_Velocity_Alias_Is_Used');
sTest := 'Monets_Elevation_Velocity_Alias_Is_Used: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// MONETS MAIN: fElevationMoveVelocity := 3.0; wait for the clock, then power on
	rig.SetElevationMoveVelocity(fValue := 3.0);
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		AssertTrue(Condition := rig.fbElev.Velocity = 3.0, Message := 'the slew moves the elevation at the alias 3.0 deg/s');
		F_Note(bFailed := NOT (rig.fbElev.Velocity = 3.0), sText := CONCAT(sTest, 'the slew moves the elevation at the alias 3.0 deg/s'));
		AssertTrue(Condition := rig.fbAzim.Velocity = 10.0 AND rig.fbDero.Velocity = 10.0, Message := 'azimuth and derotator move at stMotion 10.0 deg/s');
		F_Note(bFailed := NOT (rig.fbAzim.Velocity = 10.0 AND rig.fbDero.Velocity = 10.0), sText := CONCAT(sTest, 'azimuth and derotator move at stMotion 10.0 deg/s'));
		AssertTrue(Condition := rig.fbTel.sMotionAliases = ' fElevationMoveVelocity', Message := 'only fElevationMoveVelocity is listed as a deprecated input in use');
		F_Note(bFailed := NOT (rig.fbTel.sMotionAliases = ' fElevationMoveVelocity'), sText := CONCAT(sTest, 'only fElevationMoveVelocity is listed as a deprecated input in use'));
		// the alias back at its old default: stMotion applies
		rig.SetElevationMoveVelocity(fValue := 5.0);
		stCfg.fElevationMoveVelocity := 4.0;
		rig.SetMotion(stValue := stCfg);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.stMotionUsed.fElevationMoveVelocity = 4.0, Message := 'with the alias at 5.0, stMotion.fElevationMoveVelocity is used');
		F_Note(bFailed := NOT (rig.fbTel.stMotionUsed.fElevationMoveVelocity = 4.0), sText := CONCAT(sTest, 'with the alias at 5.0, stMotion.fElevationMoveVelocity is used'));
		AssertTrue(Condition := rig.fbTel.sMotionAliases = '', Message := 'no deprecated input in use');
		F_Note(bFailed := NOT (rig.fbTel.sMotionAliases = ''), sText := CONCAT(sTest, 'no deprecated input in use'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Telemetry_Publishes_The_Snapshot" Id="{d918d0a8-6c18-4fc8-b420-b6fe4e8e1434}">
      <Declaration><![CDATA[// #24 step 4a: FB_MonetTelescopeTelemetry with a fixed snapshot publishes the 44 fields of _SendTelemetry (0.12.0) in the old order,
// with the old publish method, topic and value, all to 'telescope'/'dome'. Pins topic names and formats that pyobs/pybrotlib and
// Telegraf/InfluxDB read. Elevation: enabled, referenced, error 16#4550, busy and tracking (8). Azimuth: disabled, not referenced,
// no error (its ErrorID 123 is not published), busy not tracking (1); REALPOS uses F_AzimuthOffsetOnAxis(0.5, current elevation 60):
// 175 - 1.0. Single cycle, guarded. Failed checks are also noted in GVL_Diag.sFailures.
METHOD PRIVATE Telemetry_Publishes_The_Snapshot
VAR_INST
	rec			: FB_RecordingComm;
	fbTelemetry	: MONETcommon.FB_MonetTelescopeTelemetry;
	stSnap			: MONETcommon.ST_MonetTelemetry;
	sMismatch	: STRING(255);
	bDone		: BOOL;
END_VAR
VAR
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Telemetry_Publishes_The_Snapshot');
IF bDone THEN
	RETURN;
END_IF
sTest := 'Telemetry_Publishes_The_Snapshot: ';
stSnap.fReadyState := 1.0;
stSnap.nMotionState := 8;
stSnap.nInterruptedAutoClearCount := 3;
stSnap.fRefractionPressure := 1000.5;
stSnap.fRefractionTemperature := -12.25;
stSnap.bRefractionTemperatureSet := TRUE;
stSnap.fRightAscension := 150.25;
stSnap.fDeclination := -20.5;
stSnap.fElevationCalc := 45.5;
stSnap.fAzimuthCalc := 181.25;
stSnap.fSlewTime := 12.5;
stSnap.fElevationPointingOffset := 0.125;
stSnap.fAzimuthPointingOffset := -0.25;
stSnap.fLst := 7.75;
stSnap.fJd := 2461346.5;
stSnap.fLatitude := -32.375823;
stSnap.fLongitude := 20.810808;
stSnap.fAltitude := 1798.0;
stSnap.bElevationEnable := TRUE;
stSnap.bElevationCalibrated := TRUE;
stSnap.bElevationError := TRUE;
stSnap.nElevationErrorID := 16#4550;
stSnap.bElevationBusy := TRUE;
stSnap.bElevationTracking := TRUE;
stSnap.fElevationPosition := 61.0;
stSnap.fElevationVelocity := 0.004;
stSnap.fElevationCurrent := 60.0;
stSnap.fElevationOffset := 0.5;
stSnap.bAzimuthEnable := FALSE;
stSnap.bAzimuthCalibrated := FALSE;
stSnap.bAzimuthError := FALSE;
stSnap.nAzimuthErrorID := 123;
stSnap.bAzimuthBusy := TRUE;
stSnap.bAzimuthTracking := FALSE;
stSnap.fAzimuthPosition := 170.0;
stSnap.fAzimuthVelocity := 10.0;
stSnap.fAzimuthCurrent := 175.0;
stSnap.fAzimuthOffset := 0.5;
stSnap.fDerotatorOffset := 0.25;
stSnap.fElevationCurrentSky := 59.875;
stSnap.fAzimuthCurrentSky := 175.25;
stSnap.fRightAscensionCurrent := 150.5;
stSnap.fHourAngleCurrent := 30.25;
stSnap.fDeclinationCurrent := -20.75;

rec.Clear();
sMismatch := '';
fbTelemetry(comm := rec, stTelemetry := stSnap);

_Expect(rec := rec, sMismatch := sMismatch, nIndex := 1, sMethod := 'PublishLREAL', sTopic := 'TELESCOPE.READY_STATE', fValue := 1.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 2, sMethod := 'PublishLREAL', sTopic := 'TELESCOPE.MOTION_STATE', fValue := 8.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 3, sMethod := 'PublishINT', sTopic := 'TELESCOPE.INTERRUPTED_AUTO_CLEAR_COUNT', nValue := 3, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 4, sMethod := 'Publish', sTopic := 'WEATHER.REFRACTION.PRESSURE', sValue := '1000.5', fValue := 0.0, nValue := 0);
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 5, sMethod := 'Publish', sTopic := 'WEATHER.REFRACTION.TEMPERATURE', sValue := '-12.25', fValue := 0.0, nValue := 0);
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 6, sMethod := 'Publish', sTopic := 'WEATHER.REFRACTION.PRESSURE_LIVE', sValue := 'TRUE', fValue := 0.0, nValue := 0);
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 7, sMethod := 'Publish', sTopic := 'WEATHER.REFRACTION.TEMPERATURE_LIVE', sValue := 'TRUE', fValue := 0.0, nValue := 0);
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 8, sMethod := 'PublishLREAL', sTopic := 'OBJECT.EQUATORIAL.RA_ICRS', fValue := 150.25, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 9, sMethod := 'PublishLREAL', sTopic := 'OBJECT.EQUATORIAL.DEC_ICRS', fValue := -20.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 10, sMethod := 'PublishLREAL', sTopic := 'OBJECT.HORIZONTAL.ALT', fValue := 45.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 11, sMethod := 'PublishLREAL', sTopic := 'OBJECT.HORIZONTAL.AZ', fValue := 181.25, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 12, sMethod := 'PublishLREAL', sTopic := 'POINTING.SLEWTIME', fValue := 12.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 13, sMethod := 'PublishLREAL', sTopic := 'POINTING.OFFSETS.ALT', fValue := 0.125, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 14, sMethod := 'PublishLREAL', sTopic := 'POINTING.OFFSETS.AZ', fValue := -0.25, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 15, sMethod := 'PublishLREAL', sTopic := 'POSITION.LOCAL.SIDEREAL_TIME', fValue := 7.75, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 16, sMethod := 'PublishLREAL', sTopic := 'POSITION.LOCAL.JD', fValue := 2461346.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 17, sMethod := 'PublishLREAL', sTopic := 'POSITION.LOCAL.LATITUDE', fValue := -32.375823, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 18, sMethod := 'PublishLREAL', sTopic := 'POSITION.LOCAL.LONGITUDE', fValue := 20.810808, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 19, sMethod := 'PublishLREAL', sTopic := 'POSITION.LOCAL.HEIGHT', fValue := 1798.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 20, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.POWER_STATE', fValue := 1.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 21, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.REFERENCED', fValue := 1.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 22, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.ALT.ERROR_STATE', nValue := 16#4550, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 23, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.ALT.MOTION_STATE', nValue := 8, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 24, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.REALPOS', fValue := 59.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 25, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.CURRPOS', fValue := 60.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 26, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.TARGETPOS', fValue := 61.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 27, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.CURRSPEED', fValue := 0.004, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 28, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.TARGETDISTANCE', fValue := 1.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 29, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.OFFSET', fValue := 0.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 30, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.POWER_STATE', fValue := 0.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 31, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.REFERENCED', fValue := 0.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 32, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.AZ.ERROR_STATE', nValue := 0, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 33, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.AZ.MOTION_STATE', nValue := 1, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 34, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.CURRPOS', fValue := 175.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 35, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.REALPOS', fValue := 174.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 36, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.TARGETPOS', fValue := 170.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 37, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.CURRSPEED', fValue := 10.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 38, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.TARGETDISTANCE', fValue := 5.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 39, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.OFFSET', fValue := 0.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 40, sMethod := 'PublishLREAL', sTopic := 'POSITION.HORIZONTAL.ALT', fValue := 59.875, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 41, sMethod := 'PublishLREAL', sTopic := 'POSITION.HORIZONTAL.AZ', fValue := 175.25, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 42, sMethod := 'PublishLREAL', sTopic := 'POSITION.EQUATORIAL.RA_ICRS', fValue := 150.5, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 43, sMethod := 'PublishLREAL', sTopic := 'POSITION.EQUATORIAL.HA_ICRS', fValue := 30.25, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 44, sMethod := 'PublishLREAL', sTopic := 'POSITION.EQUATORIAL.DEC_ICRS', fValue := -20.75, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 45, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.DEROT.OFFSET', fValue := 0.25, nValue := 0, sValue := '');

AssertEquals_INT(Expected := 45, Actual := rec.nCount, Message := 'one record is 44 publishes + the derotator offset (#177)');
F_Note(bFailed := rec.nCount <> 45, sText := CONCAT(sTest, CONCAT('publishes: ', INT_TO_STRING(rec.nCount))));
AssertEquals_INT(Expected := 0, Actual := rec.nOtherAddress, Message := 'every publish goes to telescope/dome');
F_Note(bFailed := rec.nOtherAddress <> 0, sText := CONCAT(sTest, 'a publish not to telescope/dome'));
AssertEquals_STRING(Expected := '', Actual := sMismatch, Message := 'method, topic and value of every publish as in 0.12.0 (first mismatch)');
F_Note(bFailed := sMismatch <> '', sText := CONCAT(sTest, CONCAT('first mismatch: ', sMismatch)));
bDone := TRUE;
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Telemetry_Axis_State_Branches" Id="{65159265-dc2f-4426-b3fb-d5b71f667040}">
      <Declaration><![CDATA[// #24 step 4a: the other side of every condition of the telemetry record. Elevation: disabled, not referenced, no error (ErrorID 99
// not published), not busy (0, tracking ignored). Azimuth: enabled, referenced, error 16#4FFF, busy and tracking (8). No live
// pressure (0.0) and no live temperature: both *_LIVE are FALSE. Same order and count as Telemetry_Publishes_The_Snapshot.
METHOD PRIVATE Telemetry_Axis_State_Branches
VAR_INST
	rec			: FB_RecordingComm;
	fbTelemetry	: MONETcommon.FB_MonetTelescopeTelemetry;
	stSnap			: MONETcommon.ST_MonetTelemetry;
	sMismatch	: STRING(255);
	bDone		: BOOL;
END_VAR
VAR
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Telemetry_Axis_State_Branches');
IF bDone THEN
	RETURN;
END_IF
sTest := 'Telemetry_Axis_State_Branches: ';
stSnap.fRefractionPressure := 0.0;
stSnap.bRefractionTemperatureSet := FALSE;
stSnap.bElevationEnable := FALSE;
stSnap.bElevationCalibrated := FALSE;
stSnap.bElevationError := FALSE;
stSnap.nElevationErrorID := 99;
stSnap.bElevationBusy := FALSE;
stSnap.bElevationTracking := TRUE;
stSnap.bAzimuthEnable := TRUE;
stSnap.bAzimuthCalibrated := TRUE;
stSnap.bAzimuthError := TRUE;
stSnap.nAzimuthErrorID := 16#4FFF;
stSnap.bAzimuthBusy := TRUE;
stSnap.bAzimuthTracking := TRUE;

rec.Clear();
sMismatch := '';
fbTelemetry(comm := rec, stTelemetry := stSnap);

_Expect(rec := rec, sMismatch := sMismatch, nIndex := 6, sMethod := 'Publish', sTopic := 'WEATHER.REFRACTION.PRESSURE_LIVE', sValue := 'FALSE', fValue := 0.0, nValue := 0);
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 7, sMethod := 'Publish', sTopic := 'WEATHER.REFRACTION.TEMPERATURE_LIVE', sValue := 'FALSE', fValue := 0.0, nValue := 0);
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 20, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.POWER_STATE', fValue := 0.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 21, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.ALT.REFERENCED', fValue := 0.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 22, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.ALT.ERROR_STATE', nValue := 0, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 23, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.ALT.MOTION_STATE', nValue := 0, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 30, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.POWER_STATE', fValue := 1.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 31, sMethod := 'PublishLREAL', sTopic := 'POSITION.INSTRUMENTAL.AZ.REFERENCED', fValue := 1.0, nValue := 0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 32, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.AZ.ERROR_STATE', nValue := 16#4FFF, fValue := 0.0, sValue := '');
_Expect(rec := rec, sMismatch := sMismatch, nIndex := 33, sMethod := 'PublishINT', sTopic := 'POSITION.INSTRUMENTAL.AZ.MOTION_STATE', nValue := 8, fValue := 0.0, sValue := '');

AssertEquals_INT(Expected := 45, Actual := rec.nCount, Message := 'every branch publishes, the count stays 45');
F_Note(bFailed := rec.nCount <> 45, sText := CONCAT(sTest, CONCAT('publishes: ', INT_TO_STRING(rec.nCount))));
AssertEquals_STRING(Expected := '', Actual := sMismatch, Message := 'the other branch of every condition (first mismatch)');
F_Note(bFailed := sMismatch <> '', sText := CONCAT(sTest, CONCAT('first mismatch: ', sMismatch)));
bDone := TRUE;
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Expect" Id="{40f596b7-904a-4c35-b012-c2cfdcd0fd7a}">
      <Declaration><![CDATA[// #24 step 4a: record nIndex of rec is a call of sMethod for sTopic with the value (fValue for PublishLREAL, within 1E-9;
// nValue for PublishINT; sValue for Publish/PublishString). The first mismatch is written to sMismatch ('index topic').
METHOD PRIVATE _Expect
VAR_IN_OUT
	rec			: FB_RecordingComm;
	sMismatch	: STRING(255);
END_VAR
VAR_INPUT
	nIndex		: INT;
	sMethod		: STRING(16);
	sTopic		: STRING(80);
	fValue		: LREAL;
	nValue		: LINT;
	sValue		: STRING(80);
END_VAR
VAR
	bOk			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nIndex < 1 OR nIndex > 64 THEN
	bOk := FALSE;
ELSIF rec.aMethod[nIndex] <> sMethod OR rec.aTopic[nIndex] <> sTopic THEN
	bOk := FALSE;
ELSIF sMethod = 'PublishLREAL' THEN
	bOk := ABS(rec.aLREAL[nIndex] - fValue) <= 1.0E-9;
ELSIF sMethod = 'PublishINT' THEN
	bOk := rec.aINT[nIndex] = nValue;
ELSE
	bOk := rec.aString[nIndex] = sValue;
END_IF
IF NOT bOk AND sMismatch = '' THEN
	sMismatch := CONCAT(INT_TO_STRING(nIndex), CONCAT(' ', sTopic));
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Held_Slew_Input_Starts_The_Slew_Once" Id="{2cbbc467-9318-48ab-a81f-afbc9c1b11f3}">
      <Declaration><![CDATA[// #24 step 5: the slew input is held TRUE (a client or Visu that never releases it). Its rising edge starts the slew once; the
// telescope does not clear the input any more, and the held level is no new command: after the slew has ended (bSlewActive FALSE)
// nothing starts again while the input stays TRUE. Until 0.14.x the block cleared the flag at the end, so a held flag was not
// possible; a writer had to write TRUE again (and that was a new command).
METHOD PRIVATE Held_Slew_Input_Starts_The_Slew_Once
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nStarts		: UINT;
	bActiveLast	: BOOL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Held_Slew_Input_Starts_The_Slew_Once');
sTest := 'Held_Slew_Input_Starts_The_Slew_Once: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.SetSlewTargetInput(fAzimuth := 180.0, fAltitude := 45.0);
		rig.SetSlewInput(bValue := TRUE);	// held from now on
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the slew runs and ends with the input still held
	IF rig.fbTel.bSlewActive AND NOT bActiveLast THEN
		nStarts := nStarts + 1;
	END_IF
	bActiveLast := rig.fbTel.bSlewActive;
	IF nStarts > 0 AND NOT rig.fbTel.bSlewActive AND rig.fbTel.bStopped THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the held slew input did not start and end a slew');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the held slew input did not start and end a slew'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// keep the input held for 100 more scans: no second slew
	IF rig.fbTel.bSlewActive AND NOT bActiveLast THEN
		nStarts := nStarts + 1;
	END_IF
	bActiveLast := rig.fbTel.bSlewActive;
	IF nCycles >= 100 THEN
		AssertTrue(Condition := nStarts = 1 AND NOT rig.fbTel.bSlewActive, Message := 'the held input started the slew once, no second slew');
		F_Note(bFailed := NOT (nStarts = 1 AND NOT rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the held input started the slew once, no second slew'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 45.0) < 0.01, Message := 'the slew reached the target of the target inputs');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 45.0) < 0.01), sText := CONCAT(sTest, 'the slew reached the target of the target inputs'));
		AssertTrue(Condition := rig.fbTel.nCommandRejectCount = nRejects0, Message := 'the held level is no command (nothing rejected)');
		F_Note(bFailed := NOT (rig.fbTel.nCommandRejectCount = nRejects0), sText := CONCAT(sTest, 'the held level is no command (nothing rejected)'));
		AssertTrue(Condition := rig.fbTel.bSlew, Message := 'the telescope did not write the input');
		F_Note(bFailed := NOT (rig.fbTel.bSlew), sText := CONCAT(sTest, 'the telescope did not write the input'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Input_Falling_Does_Not_Abort_The_Slew" Id="{9bf36a98-0f45-4f12-b5d7-9652a70f249d}">
      <Declaration><![CDATA[// #24 step 5: the input falling while its command runs aborts nothing (a Visu button released, a client writing FALSE). The slew
// that the rising edge started runs to its target: no stop, no abort stop, no MC_Stop on any axis.
METHOD PRIVATE Slew_Input_Falling_Does_Not_Abort_The_Slew
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Input_Falling_Does_Not_Abort_The_Slew');
sTest := 'Slew_Input_Falling_Does_Not_Abort_The_Slew: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.SetSlewTargetInput(fAzimuth := 180.0, fAltitude := 45.0);
		rig.SetSlewInput(bValue := TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the slew moves the axes, then release the input
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		rig.SetSlewInput(bValue := FALSE);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew input did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew input did not start the axis moves'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the slew goes on to its target
	bSawStop := bSawStop OR rig.fbTel.bStopActive OR rig.fbTel.bMoveAbortPending;
	IF NOT rig.fbTel.bSlewActive AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertTrue(Condition := NOT bSawStop, Message := 'the falling input stopped nothing');
		F_Note(bFailed := NOT (NOT bSawStop), sText := CONCAT(sTest, 'the falling input stopped nothing'));
		AssertTrue(Condition := rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0, Message := 'no MC_Stop on any axis');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0), sText := CONCAT(sTest, 'no MC_Stop on any axis'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 45.0) < 0.01, Message := 'the slew reached its target');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 45.0) < 0.01), sText := CONCAT(sTest, 'the slew reached its target'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not end after the input fell');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not end after the input fell'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Method_And_Input_Edge_In_One_Scan_Count_Once" Id="{c3a0b8fa-340f-4d5c-91b3-7be5964445a1}">
      <Declaration><![CDATA[// #24 step 5: Slew() and a rising slew input before the same scan are one command (b*Checked): the edge is not decided again. Counted
// twice, the second one would replace the first (latest wins, #83) with an abort stop (bMoveAbortPending) before the slew. One slew,
// no abort stop, no MC_Stop, nothing rejected.
METHOD PRIVATE Slew_Method_And_Input_Edge_In_One_Scan_Count_Once
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nStarts		: UINT;
	bActiveLast	: BOOL;
	bSawAbort	: BOOL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Method_And_Input_Edge_In_One_Scan_Count_Once');
sTest := 'Slew_Method_And_Input_Edge_In_One_Scan_Count_Once: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		rig.SetSlewTargetInput(fAzimuth := 180.0, fAltitude := 45.0);
		rig.SetSlewInput(bValue := TRUE);	// rises before the same scan as the method call
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// one slew to the end
	IF rig.fbTel.bSlewActive AND NOT bActiveLast THEN
		nStarts := nStarts + 1;
	END_IF
	bActiveLast := rig.fbTel.bSlewActive;
	bSawAbort := bSawAbort OR rig.fbTel.bMoveAbortPending OR rig.fbTel.bStopActive;
	IF nStarts > 0 AND NOT rig.fbTel.bSlewActive AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertTrue(Condition := nStarts = 1 AND NOT bSawAbort, Message := 'one slew, the edge did not replace the method call (no abort stop)');
		F_Note(bFailed := NOT (nStarts = 1 AND NOT bSawAbort), sText := CONCAT(sTest, 'one slew, the edge did not replace the method call (no abort stop)'));
		AssertTrue(Condition := rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0, Message := 'no MC_Stop on any axis');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges = 0 AND rig.fbAzim.nStopEdges = 0 AND rig.fbDero.nStopEdges = 0), sText := CONCAT(sTest, 'no MC_Stop on any axis'));
		AssertTrue(Condition := rig.fbTel.nCommandRejectCount = nRejects0, Message := 'nothing rejected');
		F_Note(bFailed := NOT (rig.fbTel.nCommandRejectCount = nRejects0), sText := CONCAT(sTest, 'nothing rejected'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 45.0) < 0.01, Message := 'the slew reached its target');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 45.0) < 0.01), sText := CONCAT(sTest, 'the slew reached its target'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not end');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not end'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Repeated_Track_Retargets_And_Second_Stop_Works" Id="{bbe1e744-21ca-48ba-ba8b-b08f3f5aa9ed}">
      <Declaration><![CDATA[// #24 step 5 (plan step 4c: pyobs sends the next target while tracking, brotgui a Stellarium goto, and a second stop): a method call
// while the same command is active is still a command. Track() while tracking is accepted (replace, #83), the new RA/Dec is taken and
// tracked after the abort stop; a second Stop() while the first stop runs is accepted too and the stop settles (#96).
METHOD PRIVATE Repeated_Track_Retargets_And_Second_Stop_Works
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nTracking	: UINT;
	bAccepted	: BOOL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Repeated_Track_Retargets_And_Second_Stop_Works');
sTest := 'Repeated_Track_Retargets_And_Second_Stop_Works: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);	// circumpolar, always above the horizon
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until all three axes have tracked for a few scans, then send the next target
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 5 THEN
		rig.fbTel.SetAltitudeOffset(0.01);
		rig.fbTel.SetAzimuthOffset(0.02);
		rig.fbTel.SetDerotatorOffset(0.5);
		nRejects0 := rig.fbTel.nCommandRejectCount;
		bAccepted := rig.fbTel.Track(fRightAscension := 180.0, fDeclination := -80.0);
		AssertTrue(Condition := rig.fbTel.AltitudeOffset = 0.0 AND rig.fbTel.AzimuthOffset = 0.0 AND rig.fbTel.DerotatorOffset = 0.0, Message := 'a new target clears the three offsets (#177)');
		F_Note(bFailed := NOT (rig.fbTel.AltitudeOffset = 0.0 AND rig.fbTel.AzimuthOffset = 0.0 AND rig.fbTel.DerotatorOffset = 0.0), sText := CONCAT(sTest, 'a new target did not clear the offsets'));
		AssertTrue(Condition := bAccepted AND rig.fbTel.bGotoActive AND rig.fbTel.fRightAscension = 180.0 AND rig.fbTel.fDeclination = -80.0, Message := 'Track() while tracking is accepted and takes the new target');
		F_Note(bFailed := NOT (bAccepted AND rig.fbTel.bGotoActive AND rig.fbTel.fRightAscension = 180.0 AND rig.fbTel.fDeclination = -80.0), sText := CONCAT(sTest, 'Track() while tracking is accepted and takes the new target'));
		nStep := 30;
		nCycles := 0;
		nTracking := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the new target is tracked after the abort stop
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking AND NOT rig.fbTel.bMoveAbortPending THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 5 THEN
		AssertTrue(Condition := rig.fbTel.bTrackActive AND NOT rig.fbTel.bGotoActive AND rig.fbTel.fRightAscension = 180.0 AND rig.fbTel.nCommandRejectCount = nRejects0, Message := 'the new target is tracked, nothing rejected');
		F_Note(bFailed := NOT (rig.fbTel.bTrackActive AND NOT rig.fbTel.bGotoActive AND rig.fbTel.fRightAscension = 180.0 AND rig.fbTel.nCommandRejectCount = nRejects0), sText := CONCAT(sTest, 'the new target is tracked, nothing rejected'));
		rig.fbTel.Stop();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not track the new target');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not track the new target'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:	// a second stop while the first one runs
	IF nCycles = 2 THEN
		AssertTrue(Condition := rig.fbTel.bStopActive, Message := 'the first stop is still running');
		F_Note(bFailed := NOT (rig.fbTel.bStopActive), sText := CONCAT(sTest, 'the first stop is still running'));
		rig.fbTel.Stop();
	ELSIF nCycles > 5 AND NOT rig.fbTel.bStopActive AND rig.fbTel.bStopped THEN
		AssertTrue(Condition := NOT rig.fbTel.bTrackActive AND NOT rig.fbAzim.Tracking AND NOT rig.fbElev.Tracking AND NOT rig.fbDero.Tracking, Message := 'the stop settled, nothing tracks');
		F_Note(bFailed := NOT (NOT rig.fbTel.bTrackActive AND NOT rig.fbAzim.Tracking AND NOT rig.fbElev.Tracking AND NOT rig.fbDero.Tracking), sText := CONCAT(sTest, 'the stop settled, nothing tracks'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Derotator_Offset_Set_At_The_Start_Of_A_Track_Is_Ramped" Id="{8b039839-1a3d-4258-97d0-17d9fcc1fdad}">
      <Declaration><![CDATA[// #246 (MONETS MS-172): a derotator offset written in the first scan after the track became active used to be applied as a
// step (the #236 ramp only ran while fbDerotator.Tracking), and the AX5206 raised F324. The offset now ramps from the scan in which
// bTrackActive is TRUE: the setpoint of the derotator moves by at most fDerotatorOffsetRate * tCycle per scan (the sky drift of a
// circumpolar target is far below it) and reaches the new offset.
METHOD PRIVATE Derotator_Offset_Set_At_The_Start_Of_A_Track_Is_Ramped
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	fPrev		: LREAL;
	fStart		: LREAL;
	fStep		: LREAL;
	fMaxStep	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Derotator_Offset_Set_At_The_Start_Of_A_Track_Is_Ramped');
sTest := 'Derotator_Offset_Set_At_The_Start_Of_A_Track_Is_Ramped: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the first scan in which the track is active: the offset request arrives now, between two scans (an ADS write or a client)
	IF rig.fbTel.bTrackActive THEN
		fStart := rig.fbDero.fPosition;
		fPrev := fStart;
		fMaxStep := 0.0;
		rig.fbTel.SetDerotatorOffset(2.0);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the track did not become active');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the track did not become active'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the setpoint moves in ramp steps only
	fStep := ABS(rig.fbDero.fPosition - fPrev);
	fPrev := rig.fbDero.fPosition;
	IF fStep > fMaxStep THEN
		fMaxStep := fStep;
	END_IF
	IF nCycles >= 150 THEN
		AssertTrue(Condition := fMaxStep < 0.01, Message := 'the derotator setpoint never moves by more than a ramp step per scan (no step)');
		F_Note(bFailed := NOT (fMaxStep < 0.01), sText := CONCAT(sTest, 'the derotator setpoint moved by more than a ramp step in one scan'));
		AssertTrue(Condition := ABS(fPrev - fStart) > 0.3, Message := 'the offset is on its way (ramping)');
		F_Note(bFailed := NOT (ABS(fPrev - fStart) > 0.3), sText := CONCAT(sTest, 'the offset did not start to ramp'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Goto_Window_From_stMotion_Refuses_The_Pole" Id="{1d00472a-4fb7-42c4-80dc-1de68a57ad43}">
      <Declaration><![CDATA[// #24 step 2c, on the mock rig (FB_MonetRig, MONET/S, latitude -32.4; moved here from F_GotoTargetCheck_Tests in #24 step 6): the goto window of FB_MonetTelescopeControl is
// stMotion.fGotoMinElevation/fGotoMaxElevation, no longer the literals 2.0/89.5. A target 1 deg from the south celestial pole
// (dec -89) stands at 31.4..33.4 deg at any time; with the default window it is accepted (MonetSafeState_Tests tracks dec -85),
// with fGotoMaxElevation 30 it is refused as above the window: software error 16#16 and the goto is dropped. Multi-cycle (VAR_INST
// rig, one Scan() per PLC cycle, the first cycles wait for the astronomical clock). Failed checks are also noted in GVL_Diag.sFailures.
METHOD PRIVATE Goto_Window_From_stMotion_Refuses_The_Pole
VAR_INST
	rig			: FB_MonetRig;
	stCfg		: BROTLib.ST_MotionConfig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Goto_Window_From_stMotion_Refuses_The_Pole');
sTest := 'Goto_Window_From_stMotion_Refuses_The_Pole: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// the configuration of the test, then wait for the clock and power on
	stCfg.fGotoMaxElevation := 30.0;
	rig.SetMotion(stValue := stCfg);
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -89.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bError THEN
		AssertTrue(Condition := rig.fbTel.nErrorID = 16#16, Message := 'the target above stMotion.fGotoMaxElevation is error 16#16');
		F_Note(bFailed := NOT (rig.fbTel.nErrorID = 16#16), sText := CONCAT(sTest, 'the target above stMotion.fGotoMaxElevation is error 16#16'));
		AssertFalse(Condition := rig.fbTel.bGotoActive, Message := 'the goto is dropped');
		F_Note(bFailed := (rig.fbTel.bGotoActive), sText := CONCAT(sTest, 'the goto is dropped'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the goto was not refused');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the goto was not refused'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Window_Refuses_Low_And_High_Elevation" Id="{6f1c0a52-3b8e-4d7a-9c21-5e0d8a4b7f13}">
      <Declaration><![CDATA[// #212, on the mock rig: a slew is held to the goto window (F_GotoTargetCheck, defaults 2.0..89.5 deg). elevation -5 and 95 are refused:
// the elevation axis is never started, no software error is latched and bSlewActive drops. elevation 2.5 is still carried out.
// Multi-cycle (VAR_INST rig, one Scan() per PLC cycle). Failed checks are also noted in GVL_Diag.sFailures.
METHOD PRIVATE Slew_Window_Refuses_Low_And_High_Elevation
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	bMoved		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Window_Refuses_Low_And_High_Elevation');
sTest := 'Slew_Window_Refuses_Low_And_High_Elevation: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
IF rig.fbElev.MoveAxis THEN
	bMoved := TRUE;
END_IF
CASE nStep OF
0:
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
	IF rig.Online AND rig.fbTel.bStopped AND NOT rig.fbTel.bBusy THEN	// idle, so a MoveAxis from here on is the slew's
		bMoved := FALSE;
		rig.fbTel.Slew(fAzimuth := 175.0, fAltitude := -5.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// elevation -5: dropped, no move, no error
	IF NOT rig.fbTel.bSlewActive THEN
		AssertFalse(Condition := bMoved OR rig.fbTel.bError, Message := 'elevation -5: no move and no error');
		F_Note(bFailed := bMoved OR rig.fbTel.bError, sText := CONCAT(sTest, 'elevation -5: no move and no error'));
		bMoved := FALSE;
		rig.fbTel.Slew(fAzimuth := 175.0, fAltitude := 95.0);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'elevation -5: the slew was not dropped');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'elevation -5: the slew was not dropped'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// elevation 95: dropped, no move, no error
	IF NOT rig.fbTel.bSlewActive THEN
		AssertFalse(Condition := bMoved OR rig.fbTel.bError, Message := 'elevation 95: no move and no error');
		F_Note(bFailed := bMoved OR rig.fbTel.bError, sText := CONCAT(sTest, 'elevation 95: no move and no error'));
		bMoved := FALSE;
		rig.fbTel.Slew(fAzimuth := 175.0, fAltitude := 2.5);
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'elevation 95: the slew was not dropped');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'elevation 95: the slew was not dropped'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:	// elevation 2.5: carried out
	IF bMoved THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'elevation 2.5: the slew is carried out');
		F_Note(bFailed := rig.fbTel.bError, sText := CONCAT(sTest, 'elevation 2.5: the slew is carried out'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'elevation 2.5: the slew did not start');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'elevation 2.5: the slew did not start'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AltAz_Offsets_Set_During_A_Track_Are_Ramped" Id="{2126fd0f-ee3b-4b3e-8edd-a5514ecf48e8}">
      <Declaration><![CDATA[// MONETN 2026-11-11 (plan 2026-11-11-altaz-offset-ramp): a 0.01 deg elevation/azimuth offset step during a track made the
// elevation ring with 64-70 % overshoot (AX5125, mode 11). The offsets now reach the setpoint through FB_OffsetRamp: the setpoint
// of each axis moves by far less than the offset per scan (the old code: the whole 0.01 deg in one scan) and has the whole
// offset (azimuth: 0.01 / COS(elevation), F_AzimuthOffsetOnAxis) after 1.5 s; the telescope keeps tracking without an error.
METHOD PRIVATE AltAz_Offsets_Set_During_A_Track_Are_Ramped
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	fElStart	: LREAL;
	fAzStart	: LREAL;
	fElPrev		: LREAL;
	fAzPrev		: LREAL;
	fElMax		: LREAL;
	fAzMax		: LREAL;
	fAzExpected	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AltAz_Offsets_Set_During_A_Track_Are_Ramped');
sTest := 'AltAz_Offsets_Set_During_A_Track_Are_Ramped: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// elevation and azimuth track
	IF rig.fbElev.Tracking AND rig.fbAzim.Tracking THEN
		nStep := 25;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'elevation and azimuth did not start to track');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'elevation and azimuth did not start to track'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
25:	// 1 s into the track (the track-start blend is over), then the offsets arrive (MQTT elevationoffset/azimuthoffset)
	IF nCycles >= 100 THEN
		fElStart := rig.fbElev.fPosition;
		fAzStart := rig.fbAzim.fPosition;
		fElPrev := fElStart;
		fAzPrev := fAzStart;
		fAzExpected := 0.01 / COS(fElStart * 0.017453292519943295);
		rig.fbTel.SetAltitudeOffset(0.01);
		rig.fbTel.SetAzimuthOffset(0.01);
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// the setpoints move in ramp steps only
	fElMax := MAX(fElMax, ABS(rig.fbElev.fPosition - fElPrev));
	fAzMax := MAX(fAzMax, ABS(rig.fbAzim.fPosition - fAzPrev));
	fElPrev := rig.fbElev.fPosition;
	fAzPrev := rig.fbAzim.fPosition;
	IF nCycles >= 150 THEN
		AssertTrue(Condition := fElMax < 0.001, Message := 'the elevation setpoint moves by less than 0.001 deg per scan (no 0.01 deg step)');
		F_Note(bFailed := NOT (fElMax < 0.001), sText := CONCAT(sTest, 'the elevation setpoint stepped'));
		AssertTrue(Condition := fAzMax < 0.002, Message := 'the azimuth setpoint moves by less than 0.002 deg per scan (no step)');
		F_Note(bFailed := NOT (fAzMax < 0.002), sText := CONCAT(sTest, 'the azimuth setpoint stepped'));
		AssertTrue(Condition := ABS(fElPrev - fElStart - 0.01) < 0.002, Message := 'the elevation setpoint has the whole offset after 1.5 s');
		F_Note(bFailed := NOT (ABS(fElPrev - fElStart - 0.01) < 0.002), sText := CONCAT(sTest, 'the elevation offset did not arrive'));
		AssertTrue(Condition := ABS(fAzPrev - fAzStart - fAzExpected) < 0.002, Message := 'the azimuth setpoint has the whole offset (1/COS(el)) after 1.5 s');
		F_Note(bFailed := NOT (ABS(fAzPrev - fAzStart - fAzExpected) < 0.002), sText := CONCAT(sTest, 'the azimuth offset did not arrive'));
		AssertTrue(Condition := rig.fbTel.bTrackActive AND rig.fbElev.Tracking AND rig.fbAzim.Tracking, Message := 'still tracking');
		F_Note(bFailed := NOT (rig.fbTel.bTrackActive AND rig.fbElev.Tracking AND rig.fbAzim.Tracking), sText := CONCAT(sTest, 'the track ended'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := rig.fbTel.bError, sText := CONCAT(sTest, 'error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Track_Start_Setpoint_Begins_At_The_Axis_Position" Id="{c5d9493b-8a3e-428c-a834-2f041544bf15}">
      <Declaration><![CDATA[// MONETN 2026-11-11 (plan 2026-11-11-altaz-offset-ramp): the move onto the track target ends where the target was when the move
// started (MC_MoveAbsolute; the mock models it with SetMoveLatchesTarget), so the first tracking setpoint jumped by the drift of
// the target since then (about 0.008 deg on the MONETN azimuth after a slew). Here the gap is made by offsets written while the
// axes move onto the track (0.005 deg, azimuth 0.005 / COS(el)). The first tracking setpoint is now the axis position, the gap
// is blended out in ramp steps (FB_OffsetRamp) and closed after 1.5 s.
METHOD PRIVATE Track_Start_Setpoint_Begins_At_The_Axis_Position
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bElSeen		: BOOL;
	bAzSeen		: BOOL;
	fElGap		: LREAL;
	fAzGap		: LREAL;
	fElStart	: LREAL;
	fAzStart	: LREAL;
	fElPrev		: LREAL;
	fAzPrev		: LREAL;
	fElMax		: LREAL;
	fAzMax		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Track_Start_Setpoint_Begins_At_The_Axis_Position');
sTest := 'Track_Start_Setpoint_Begins_At_The_Axis_Position: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on; the elevation/azimuth mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// the axes move onto the track target: the offsets arrive now, the moves keep the target of their start
	IF rig.fbTel.bTrackActive AND rig.fbElev.Busy AND rig.fbAzim.Busy AND NOT rig.fbElev.Tracking AND NOT rig.fbAzim.Tracking THEN
		rig.fbTel.SetAltitudeOffset(0.005);
		rig.fbTel.SetAzimuthOffset(0.005);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the axes did not move onto the track target');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the axes did not move onto the track target'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the first tracking scan of each axis: the setpoint is the axis position
	IF rig.fbElev.Tracking AND NOT bElSeen THEN
		bElSeen := TRUE;
		fElGap := rig.fbElev.fPosition - rig.fbElev.fActualPosition;
		fElStart := rig.fbElev.fPosition;
		fElPrev := fElStart;
	END_IF
	IF rig.fbAzim.Tracking AND NOT bAzSeen THEN
		bAzSeen := TRUE;
		fAzGap := rig.fbAzim.fPosition - rig.fbAzim.fActualPosition;
		fAzStart := rig.fbAzim.fPosition;
		fAzPrev := fAzStart;
	END_IF
	IF bElSeen THEN
		fElMax := MAX(fElMax, ABS(rig.fbElev.fPosition - fElPrev));
		fElPrev := rig.fbElev.fPosition;
	END_IF
	IF bAzSeen THEN
		fAzMax := MAX(fAzMax, ABS(rig.fbAzim.fPosition - fAzPrev));
		fAzPrev := rig.fbAzim.fPosition;
	END_IF
	IF bElSeen AND bAzSeen AND nCycles >= 250 THEN
		AssertTrue(Condition := ABS(fElGap) < 1.0E-9, Message := 'elevation: the first tracking setpoint is the axis position');
		F_Note(bFailed := NOT (ABS(fElGap) < 1.0E-9), sText := CONCAT(sTest, 'elevation: the first tracking setpoint jumped'));
		AssertTrue(Condition := ABS(fAzGap) < 1.0E-9, Message := 'azimuth: the first tracking setpoint is the axis position');
		F_Note(bFailed := NOT (ABS(fAzGap) < 1.0E-9), sText := CONCAT(sTest, 'azimuth: the first tracking setpoint jumped'));
		AssertTrue(Condition := fElMax < 0.001 AND fAzMax < 0.001, Message := 'the gap is blended out in ramp steps (less than 0.001 deg per scan)');
		F_Note(bFailed := NOT (fElMax < 0.001 AND fAzMax < 0.001), sText := CONCAT(sTest, 'the setpoint stepped after the track start'));
		AssertTrue(Condition := ABS(fElPrev - fElStart) > 0.003 AND ABS(fAzPrev - fAzStart) > 0.003, Message := 'the gap (offsets of 0.005 deg) is closed');
		F_Note(bFailed := NOT (ABS(fElPrev - fElStart) > 0.003 AND ABS(fAzPrev - fAzStart) > 0.003), sText := CONCAT(sTest, 'the gap was not closed (the offsets did not arrive during the move?)'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := rig.fbTel.bError, sText := CONCAT(sTest, 'error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1000 THEN
		AssertTrue(Condition := FALSE, Message := 'elevation and azimuth did not start to track');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'elevation and azimuth did not start to track'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retarget_By_Direct_RaDec_Write_Is_Blended" Id="{29318149-86a1-4e73-91f3-c6a45c895f84}">
      <Declaration><![CDATA[// #251: RA/Dec written directly while tracking (Visu binding, ADS client) reached the axes as a one-scan step (a velocity kick on the
// AX5125 in mode 11). A 0.02 deg retarget is now blended: the el/az setpoints stay continuous (step below fOffsetVelocity * dt,
// velocity change below 0.01 deg/s per scan), the axes keep tracking, the blend is closed after a few seconds. The derotator is blended
// too (#252) with the default fRetargetDerotatorMax.
METHOD PRIVATE Retarget_By_Direct_RaDec_Write_Is_Blended
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nTracking	: UINT;
	nHist		: UINT;
	bObserve	: BOOL;
	bDropped	: BOOL;
	elP1		: LREAL;
	elP2		: LREAL;
	azP1		: LREAL;
	azP2		: LREAL;
	fMaxD1		: LREAL;
	fMaxD2		: LREAL;
	deroP1		: LREAL;
	fMaxDeroD1	: LREAL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Retarget_By_Direct_RaDec_Write_Is_Blended');
sTest := 'Retarget_By_Direct_RaDec_Write_Is_Blended: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// the setpoints of the el/az axes (mock fPosition) per scan: step d1 and change of the step d2 while both track
IF rig.fbElev.Tracking AND rig.fbAzim.Tracking THEN
	nHist := nHist + 1;
	IF bObserve AND nHist >= 3 THEN
		fMaxD1 := MAX(fMaxD1, MAX(ABS(rig.fbElev.fPosition - elP1), ABS(rig.fbAzim.fPosition - azP1)));
		fMaxDeroD1 := MAX(fMaxDeroD1, ABS(rig.fbDero.fPosition - deroP1));
		fMaxD2 := MAX(fMaxD2, MAX(ABS(rig.fbElev.fPosition - 2.0 * elP1 + elP2), ABS(rig.fbAzim.fPosition - 2.0 * azP1 + azP2)));
	END_IF
ELSE
	nHist := 0;
	IF bObserve THEN
		bDropped := TRUE;
	END_IF
END_IF
elP2 := elP1;
elP1 := rig.fbElev.fPosition;
azP2 := azP1;
azP1 := rig.fbAzim.fPosition;
deroP1 := rig.fbDero.fPosition;
CASE nStep OF
0:	// wait for the clock, then power on; the el/az mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// tracking for 1 s, then the direct write of the target (Visu binding, ADS client)
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 100 THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.SetTargetDirect(0.0, -85.02);
		bObserve := TRUE;
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	IF nCycles >= 300 THEN
		AssertTrue(Condition := NOT bDropped, Message := 'the axes kept tracking');
		F_Note(bFailed := NOT (NOT bDropped), sText := CONCAT(sTest, 'the axes kept tracking'));
		AssertTrue(Condition := fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001, Message := 'the el/az setpoints stayed continuous');
		F_Note(bFailed := NOT (fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001), sText := CONCAT(sTest, 'the el/az setpoints stayed continuous'));
		AssertTrue(Condition := rig.fbTel.nLastRetarget = 1 AND rig.fbTel.nRetargetCount = 1, Message := 'the retarget was blended once');
		F_Note(bFailed := NOT (rig.fbTel.nLastRetarget = 1 AND rig.fbTel.nRetargetCount = 1), sText := CONCAT(sTest, 'the retarget was blended once'));
		AssertTrue(Condition := fMaxDeroD1 < 0.0055, Message := 'the derotator setpoint stayed continuous (blended too, #252)');
		F_Note(bFailed := NOT (fMaxDeroD1 < 0.0055), sText := CONCAT(sTest, 'the derotator setpoint stepped'));
		AssertTrue(Condition := rig.fbElev.Tracking AND rig.fbAzim.Tracking AND ABS(rig.fbTel.fbElevationTrackBlend.fValue) < 0.0001 AND ABS(rig.fbTel.fbAzimuthTrackBlend.fValue) < 0.0001, Message := 'the blend is closed');
		F_Note(bFailed := NOT (rig.fbElev.Tracking AND rig.fbAzim.Tracking AND ABS(rig.fbTel.fbElevationTrackBlend.fValue) < 0.0001 AND ABS(rig.fbTel.fbAzimuthTrackBlend.fValue) < 0.0001), sText := CONCAT(sTest, 'the blend is closed'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Large_Retarget_By_Direct_Write_Goes_Through_The_Move" Id="{b6e089e6-31ab-445a-af01-195ef51e91f8}">
      <Declaration><![CDATA[// #251: a direct RA/Dec write far from the track (here 5 deg) is not blended: the scan writes no setpoint, the telescope stops, goes
// to the new target and tracks it. Every scan in which both axes track is smooth (no step), nothing is rejected.
METHOD PRIVATE Large_Retarget_By_Direct_Write_Goes_Through_The_Move
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nTracking	: UINT;
	nHist		: UINT;
	bObserve	: BOOL;
	bDropped	: BOOL;
	elP1		: LREAL;
	elP2		: LREAL;
	azP1		: LREAL;
	azP2		: LREAL;
	fMaxD1		: LREAL;
	fMaxD2		: LREAL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Large_Retarget_By_Direct_Write_Goes_Through_The_Move');
sTest := 'Large_Retarget_By_Direct_Write_Goes_Through_The_Move: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// the setpoints of the el/az axes (mock fPosition) per scan: step d1 and change of the step d2 while both track
IF rig.fbElev.Tracking AND rig.fbAzim.Tracking THEN
	nHist := nHist + 1;
	IF bObserve AND nHist >= 3 THEN
		fMaxD1 := MAX(fMaxD1, MAX(ABS(rig.fbElev.fPosition - elP1), ABS(rig.fbAzim.fPosition - azP1)));
		fMaxD2 := MAX(fMaxD2, MAX(ABS(rig.fbElev.fPosition - 2.0 * elP1 + elP2), ABS(rig.fbAzim.fPosition - 2.0 * azP1 + azP2)));
	END_IF
ELSE
	nHist := 0;
	IF bObserve THEN
		bDropped := TRUE;
	END_IF
END_IF
elP2 := elP1;
elP1 := rig.fbElev.fPosition;
azP2 := azP1;
azP1 := rig.fbAzim.fPosition;
CASE nStep OF
0:	// wait for the clock, then power on; the el/az mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// tracking for 1 s, then the direct write of the target (Visu binding, ADS client)
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 100 THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.SetTargetDirect(180.0, -80.0);
		bObserve := TRUE;
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	IF bDropped AND nHist >= 200 THEN
		AssertTrue(Condition := rig.fbTel.nLastRetarget = 2 AND rig.fbTel.nRetargetCount = 1, Message := 'the retarget took the stop/goto/track path');
		F_Note(bFailed := NOT (rig.fbTel.nLastRetarget = 2 AND rig.fbTel.nRetargetCount = 1), sText := CONCAT(sTest, 'the retarget took the stop/goto/track path'));
		AssertTrue(Condition := fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001, Message := 'every tracking scan is smooth');
		F_Note(bFailed := NOT (fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001), sText := CONCAT(sTest, 'every tracking scan is smooth'));
		AssertTrue(Condition := rig.fbTel.nCommandRejectCount = nRejects0, Message := 'nothing rejected');
		F_Note(bFailed := NOT (rig.fbTel.nCommandRejectCount = nRejects0), sText := CONCAT(sTest, 'nothing rejected'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the new target was not tracked');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the new target was not tracked'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retarget_Mid_Blend_Keeps_The_Velocity" Id="{d6910426-803b-4040-a0b4-9b82aa32b3bc}">
      <Declaration><![CDATA[// #251: a second retarget while the first blend runs adds to the running blend (FB_OffsetRamp.Shift keeps the velocity): no
// velocity step across the second retarget, the blend ends at the new target.
METHOD PRIVATE Retarget_Mid_Blend_Keeps_The_Velocity
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nTracking	: UINT;
	nHist		: UINT;
	bObserve	: BOOL;
	bDropped	: BOOL;
	elP1		: LREAL;
	elP2		: LREAL;
	azP1		: LREAL;
	azP2		: LREAL;
	fMaxD1		: LREAL;
	fMaxD2		: LREAL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Retarget_Mid_Blend_Keeps_The_Velocity');
sTest := 'Retarget_Mid_Blend_Keeps_The_Velocity: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// the setpoints of the el/az axes (mock fPosition) per scan: step d1 and change of the step d2 while both track
IF rig.fbElev.Tracking AND rig.fbAzim.Tracking THEN
	nHist := nHist + 1;
	IF bObserve AND nHist >= 3 THEN
		fMaxD1 := MAX(fMaxD1, MAX(ABS(rig.fbElev.fPosition - elP1), ABS(rig.fbAzim.fPosition - azP1)));
		fMaxD2 := MAX(fMaxD2, MAX(ABS(rig.fbElev.fPosition - 2.0 * elP1 + elP2), ABS(rig.fbAzim.fPosition - 2.0 * azP1 + azP2)));
	END_IF
ELSE
	nHist := 0;
	IF bObserve THEN
		bDropped := TRUE;
	END_IF
END_IF
elP2 := elP1;
elP1 := rig.fbElev.fPosition;
azP2 := azP1;
azP1 := rig.fbAzim.fPosition;
CASE nStep OF
0:	// wait for the clock, then power on; the el/az mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// tracking for 1 s, then the direct write of the target (Visu binding, ADS client)
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 100 THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.SetRetargetDerotatorMax(1.0);
		rig.SetTargetDirect(0.0, -85.02);
		bObserve := TRUE;
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	IF nCycles >= 30 THEN
		rig.SetTargetDirect(0.0, -85.0);
		nStep := 21;
		nCycles := 0;
	END_IF
21:	IF nCycles >= 400 THEN
		AssertTrue(Condition := NOT bDropped, Message := 'the axes kept tracking');
		F_Note(bFailed := NOT (NOT bDropped), sText := CONCAT(sTest, 'the axes kept tracking'));
		AssertTrue(Condition := fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001, Message := 'the setpoints stayed continuous across both retargets');
		F_Note(bFailed := NOT (fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001), sText := CONCAT(sTest, 'the setpoints stayed continuous across both retargets'));
		AssertTrue(Condition := rig.fbTel.nRetargetCount = 2 AND rig.fbTel.nLastRetarget = 1, Message := 'both retargets were blended');
		F_Note(bFailed := NOT (rig.fbTel.nRetargetCount = 2 AND rig.fbTel.nLastRetarget = 1), sText := CONCAT(sTest, 'both retargets were blended'));
		AssertTrue(Condition := ABS(rig.fbTel.fbElevationTrackBlend.fValue) < 0.0001 AND ABS(rig.fbTel.fbAzimuthTrackBlend.fValue) < 0.0001, Message := 'the blend is closed');
		F_Note(bFailed := NOT (ABS(rig.fbTel.fbElevationTrackBlend.fValue) < 0.0001 AND ABS(rig.fbTel.fbAzimuthTrackBlend.fValue) < 0.0001), sText := CONCAT(sTest, 'the blend is closed'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_During_A_Retarget_Blend_Settles" Id="{e78ee59c-2b31-4c99-9b51-59d899ebaf1c}">
      <Declaration><![CDATA[// #251: Stop() 0.2 s into a retarget blend is a normal stop from tracking: it settles, nothing tracks, no error.
METHOD PRIVATE Stop_During_A_Retarget_Blend_Settles
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nTracking	: UINT;
	nHist		: UINT;
	bObserve	: BOOL;
	bDropped	: BOOL;
	elP1		: LREAL;
	elP2		: LREAL;
	azP1		: LREAL;
	azP2		: LREAL;
	fMaxD1		: LREAL;
	fMaxD2		: LREAL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_During_A_Retarget_Blend_Settles');
sTest := 'Stop_During_A_Retarget_Blend_Settles: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// the setpoints of the el/az axes (mock fPosition) per scan: step d1 and change of the step d2 while both track
IF rig.fbElev.Tracking AND rig.fbAzim.Tracking THEN
	nHist := nHist + 1;
	IF bObserve AND nHist >= 3 THEN
		fMaxD1 := MAX(fMaxD1, MAX(ABS(rig.fbElev.fPosition - elP1), ABS(rig.fbAzim.fPosition - azP1)));
		fMaxD2 := MAX(fMaxD2, MAX(ABS(rig.fbElev.fPosition - 2.0 * elP1 + elP2), ABS(rig.fbAzim.fPosition - 2.0 * azP1 + azP2)));
	END_IF
ELSE
	nHist := 0;
	IF bObserve THEN
		bDropped := TRUE;
	END_IF
END_IF
elP2 := elP1;
elP1 := rig.fbElev.fPosition;
azP2 := azP1;
azP1 := rig.fbAzim.fPosition;
CASE nStep OF
0:	// wait for the clock, then power on; the el/az mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// tracking for 1 s, then the direct write of the target (Visu binding, ADS client)
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 100 THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.SetRetargetDerotatorMax(1.0);
		rig.SetTargetDirect(0.0, -85.02);
		bObserve := TRUE;
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	IF nCycles >= 20 THEN
		rig.fbTel.Stop();
		nStep := 21;
		nCycles := 0;
	END_IF
21:	IF nCycles > 5 AND NOT rig.fbTel.bStopActive AND rig.fbTel.bStopped THEN
		AssertTrue(Condition := NOT rig.fbTel.bTrackActive AND NOT rig.fbAzim.Tracking AND NOT rig.fbElev.Tracking AND NOT rig.fbDero.Tracking, Message := 'the stop settled, nothing tracks');
		F_Note(bFailed := NOT (NOT rig.fbTel.bTrackActive AND NOT rig.fbAzim.Tracking AND NOT rig.fbElev.Tracking AND NOT rig.fbDero.Tracking), sText := CONCAT(sTest, 'the stop settled, nothing tracks'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Small_Track_Retarget_Stays_Tracking" Id="{f5f018d6-37fb-4cae-9f6d-29bef322b425}">
      <Declaration><![CDATA[// #251 phase B: Track() with a target 0.02 deg away while tracking does not stop the axes: no abort, no goto, nothing rejected,
// the retarget is blended (the el/az setpoints stay continuous). The derotator guard is opened (it has no blend until #252).
METHOD PRIVATE Small_Track_Retarget_Stays_Tracking
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nTracking	: UINT;
	nHist		: UINT;
	bObserve	: BOOL;
	bDropped	: BOOL;
	elP1		: LREAL;
	elP2		: LREAL;
	azP1		: LREAL;
	azP2		: LREAL;
	fMaxD1		: LREAL;
	fMaxD2		: LREAL;
	nRejects0	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Small_Track_Retarget_Stays_Tracking');
sTest := 'Small_Track_Retarget_Stays_Tracking: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
// the setpoints of the el/az axes (mock fPosition) per scan: step d1 and change of the step d2 while both track
IF rig.fbElev.Tracking AND rig.fbAzim.Tracking THEN
	nHist := nHist + 1;
	IF bObserve AND nHist >= 3 THEN
		fMaxD1 := MAX(fMaxD1, MAX(ABS(rig.fbElev.fPosition - elP1), ABS(rig.fbAzim.fPosition - azP1)));
		fMaxD2 := MAX(fMaxD2, MAX(ABS(rig.fbElev.fPosition - 2.0 * elP1 + elP2), ABS(rig.fbAzim.fPosition - 2.0 * azP1 + azP2)));
	END_IF
ELSE
	nHist := 0;
	IF bObserve THEN
		bDropped := TRUE;
	END_IF
END_IF
elP2 := elP1;
elP1 := rig.fbElev.fPosition;
azP2 := azP1;
azP1 := rig.fbAzim.fPosition;
CASE nStep OF
0:	// wait for the clock, then power on; the el/az mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// tracking for 1 s, then the direct write of the target (Visu binding, ADS client)
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 100 THEN
		nRejects0 := rig.fbTel.nCommandRejectCount;
		rig.SetRetargetDerotatorMax(1.0);
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.02);
		bObserve := TRUE;
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	IF nCycles >= 300 THEN
		AssertTrue(Condition := NOT bDropped, Message := 'the axes kept tracking');
		F_Note(bFailed := NOT (NOT bDropped), sText := CONCAT(sTest, 'the axes kept tracking'));
		AssertTrue(Condition := fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001, Message := 'the el/az setpoints stayed continuous');
		F_Note(bFailed := NOT (fMaxD1 < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005 AND fMaxD2 < 0.0001), sText := CONCAT(sTest, 'the el/az setpoints stayed continuous'));
		AssertTrue(Condition := rig.fbTel.nLastRetarget = 1 AND rig.fbTel.nRetargetCount = 1, Message := 'the retarget was blended once');
		F_Note(bFailed := NOT (rig.fbTel.nLastRetarget = 1 AND rig.fbTel.nRetargetCount = 1), sText := CONCAT(sTest, 'the retarget was blended once'));
		AssertTrue(Condition := rig.fbElev.Tracking AND rig.fbAzim.Tracking AND ABS(rig.fbTel.fbElevationTrackBlend.fValue) < 0.0001 AND ABS(rig.fbTel.fbAzimuthTrackBlend.fValue) < 0.0001, Message := 'the blend is closed');
		F_Note(bFailed := NOT (rig.fbElev.Tracking AND rig.fbAzim.Tracking AND ABS(rig.fbTel.fbElevationTrackBlend.fValue) < 0.0001 AND ABS(rig.fbTel.fbAzimuthTrackBlend.fValue) < 0.0001), sText := CONCAT(sTest, 'the blend is closed'));
		AssertTrue(Condition := NOT rig.fbTel.bMoveAbortPending AND NOT rig.fbTel.bGotoActive AND rig.fbTel.TCS_command = BROTLib.E_TCSCommand.track AND rig.fbTel.nCommandRejectCount = nRejects0, Message := 'Track() stayed in the track: no abort, no goto, nothing rejected');
		F_Note(bFailed := NOT (NOT rig.fbTel.bMoveAbortPending AND NOT rig.fbTel.bGotoActive AND rig.fbTel.TCS_command = BROTLib.E_TCSCommand.track AND rig.fbTel.nCommandRejectCount = nRejects0), sText := CONCAT(sTest, 'Track() did not stay in the track'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retarget_During_The_Move_Onto_The_Track" Id="{a81c593e-2385-4b72-ad31-cf121c6110af}">
      <Declaration><![CDATA[// #251: the target is written directly (Visu binding, ADS client) while the axes still move onto the track. The move keeps the target
// of its start, so the gap at MoveDone is up to 2 deg (Dec -85 to -83). The clock is real: how the 2 deg split between elevation and azimuth
// depends on the time of day, so at least one axis (not both) has a gap over fTrackStartBlendMax and restarts. The moves are started again and the first tracking
// setpoint is the axis position (no step), as in Track_Start_Setpoint_Begins_At_The_Axis_Position.
METHOD PRIVATE Retarget_During_The_Move_Onto_The_Track
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bElSeen		: BOOL;
	bAzSeen		: BOOL;
	fElGap		: LREAL;
	fAzGap		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Retarget_During_The_Move_Onto_The_Track');
sTest := 'Retarget_During_The_Move_Onto_The_Track: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on; the el/az mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// the axes move onto the track target: the target changes now, the moves keep the target of their start
	IF rig.fbTel.bTrackActive AND rig.fbElev.Busy AND rig.fbAzim.Busy AND NOT rig.fbElev.Tracking AND NOT rig.fbAzim.Tracking THEN
		rig.SetTargetDirect(0.0, -83.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the axes did not move onto the track target');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the axes did not move onto the track target'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the first tracking scan of each axis: the setpoint is the axis position
	IF rig.fbElev.Tracking AND NOT bElSeen THEN
		bElSeen := TRUE;
		fElGap := rig.fbElev.fPosition - rig.fbElev.fActualPosition;
	END_IF
	IF rig.fbAzim.Tracking AND NOT bAzSeen THEN
		bAzSeen := TRUE;
		fAzGap := rig.fbAzim.fPosition - rig.fbAzim.fActualPosition;
	END_IF
	IF bElSeen AND bAzSeen AND nCycles >= 250 THEN
		AssertTrue(Condition := ABS(fElGap) < 1.0E-9, Message := 'elevation: the first tracking setpoint is the axis position');
		F_Note(bFailed := NOT (ABS(fElGap) < 1.0E-9), sText := CONCAT(sTest, 'elevation: the first tracking setpoint jumped'));
		AssertTrue(Condition := ABS(fAzGap) < 1.0E-9, Message := 'azimuth: the first tracking setpoint is the axis position');
		F_Note(bFailed := NOT (ABS(fAzGap) < 1.0E-9), sText := CONCAT(sTest, 'azimuth: the first tracking setpoint jumped'));
		AssertTrue(Condition := rig.fbTel.nMoveRestartCount >= 1, Message := 'the move of at least one axis was started again');
		F_Note(bFailed := NOT (rig.fbTel.nMoveRestartCount >= 1), sText := CONCAT(sTest, 'no move was started again'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := rig.fbTel.bError, sText := CONCAT(sTest, 'error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'elevation and azimuth did not start to track');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'elevation and azimuth did not start to track'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Derotator_Track_Start_Setpoint_Begins_At_The_Axis_Position" Id="{ac0827d8-dbf2-4a10-a0bb-e575e2ecfcff}">
      <Declaration><![CDATA[// #252: the move onto the track ends where the target was when the move started (the mocks model it with SetMoveLatchesTarget). The
// derotator target moved since (here: RA written during the move, 0.3 deg), so its first tracking setpoint used to step by that
// gap. Now the first tracking setpoint is the axis position and the gap is blended out in ramp steps (like elevation and azimuth).
METHOD PRIVATE Derotator_Track_Start_Setpoint_Begins_At_The_Axis_Position
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSeen		: BOOL;
	fGap		: LREAL;
	fSource		: LREAL;
	fStart		: LREAL;
	fPrev		: LREAL;
	fMaxStep	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Derotator_Track_Start_Setpoint_Begins_At_The_Axis_Position');
sTest := 'Derotator_Track_Start_Setpoint_Begins_At_The_Axis_Position: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on; the mocks end a move at the target of its start, like the NC
	IF rig.ClockValid THEN
		rig.SetMoveLatchesTarget(TRUE);
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// the axes move onto the track target: the target moves a little now, the moves keep the target of their start
	IF rig.fbTel.bTrackActive AND rig.fbDero.Busy AND NOT rig.fbDero.Tracking THEN
		rig.SetTargetDirect(0.3, -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the derotator did not move onto the track target');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the derotator did not move onto the track target'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the first tracking scan of the derotator: the setpoint is the axis position
	IF rig.fbDero.Tracking AND NOT bSeen THEN
		bSeen := TRUE;
		fGap := rig.fbDero.fPosition - rig.fbDero.fActualPosition;
		fSource := rig.fbTel.fDerotatorCalc - rig.fbDero.fActualPosition;
		fStart := rig.fbDero.fPosition;
		fPrev := fStart;
	ELSIF bSeen THEN
		fMaxStep := MAX(fMaxStep, ABS(rig.fbDero.fPosition - fPrev));
		fPrev := rig.fbDero.fPosition;
	END_IF
	IF bSeen AND nCycles >= 250 THEN
		AssertTrue(Condition := ABS(fGap) < 1.0E-9, Message := 'derotator: the first tracking setpoint is the axis position');
		F_Note(bFailed := NOT (ABS(fGap) < 1.0E-9), sText := CONCAT(sTest, 'derotator: the first tracking setpoint jumped'));
		AssertTrue(Condition := ABS(fSource) > 0.001, Message := 'the target had moved away from the axis during the move (the test sees a gap)');
		F_Note(bFailed := NOT (ABS(fSource) > 0.001), sText := CONCAT(sTest, 'no gap between the target and the derotator at the track start'));
		AssertTrue(Condition := fMaxStep < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005, Message := 'the gap is blended out in ramp steps');
		F_Note(bFailed := NOT (fMaxStep < rig.fbTel.fOffsetVelocity * 0.01 + 0.0005), sText := CONCAT(sTest, 'the derotator setpoint stepped after the track start'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := rig.fbTel.bError, sText := CONCAT(sTest, 'error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the derotator did not start to track');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the derotator did not start to track'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Feed_From_Position_Is_Passed_To_Elevation_And_Azimuth" Id="{fb6a6370-df2a-4e5f-ad16-e462ca87cbba}">
      <Declaration><![CDATA[// BROTLib#167: bFeedFromPosition (default FALSE) reaches FB_Axis.FeedFromPosition of elevation and azimuth, CycleTime is tCycle in s.
METHOD PRIVATE Feed_From_Position_Is_Passed_To_Elevation_And_Azimuth
VAR_INST
	rig		: FB_MonetRig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Feed_From_Position_Is_Passed_To_Elevation_And_Azimuth');
rig.Scan();
AssertFalse(Condition := rig.fbElev.fbAxis.FeedFromPosition OR rig.fbAzim.fbAxis.FeedFromPosition, Message := 'default: the old feed');
AssertTrue(Condition := ABS(rig.fbElev.fbAxis.CycleTime - 0.01) < 1.0E-9 AND ABS(rig.fbAzim.fbAxis.CycleTime - 0.01) < 1.0E-9, Message := 'CycleTime is tCycle (10 ms)');
rig.SetFeedFromPosition(TRUE);
rig.Scan();
AssertTrue(Condition := rig.fbElev.fbAxis.FeedFromPosition AND rig.fbAzim.fbAxis.FeedFromPosition, Message := 'elevation and azimuth take the feed from the position');
rig.SetFeedFromPosition(FALSE);
rig.Scan();
AssertFalse(Condition := rig.fbElev.fbAxis.FeedFromPosition OR rig.fbAzim.fbAxis.FeedFromPosition, Message := 'switched off again');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
