<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PumpResetPulse_Tests" Id="{e34e0d3f-84fa-4aec-b9a2-b397f543c5b1}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for HalfBROT.FB_PumpResetPulse, the reset pulse for the pump starters (HalfBROT#120). Pure logic. A pulse of T#1H stays active for the
// whole test, so the end of a pulse (the hold for one more cycle) is not covered here; tPulse = T#0S is the "off" mode.
FUNCTION_BLOCK FB_PumpResetPulse_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Pulse_Off_Follows_Request();
Pulse_Before_First_Start();
No_Pulse_Without_Request();
Running_Pump_Needs_No_Pulse();
Request_Resets_Stopped_Starters_Only();
Pulse_After_Pump_Failure();
]]></ST>
    </Implementation>
    <Method Name="Pulse_Off_Follows_Request" Id="{ea107c41-90c8-4166-9983-110e8461892f}">
      <Declaration><![CDATA[// tPulse = T#0S: the reset outputs follow bResetRequest, no hold, no automatic pulse.
METHOD PRIVATE Pulse_Off_Follows_Request
VAR
	fb	: HalfBROT.FB_PumpResetPulse;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Pulse_Off_Follows_Request');
fb(bResetRequest := TRUE, bPumpRequest := TRUE, bPumpFailure := FALSE, bPumpRunning := FALSE, bSuctionRunning := FALSE, tPulse := T#0S);
AssertTrue(Condition := fb.bResetPump, Message := 'pump reset');
AssertTrue(Condition := fb.bResetSuction, Message := 'suction reset');
AssertFalse(Condition := fb.bHoldPump, Message := 'no hold');
AssertFalse(Condition := fb.bActive, Message := 'no pulse');
fb(bResetRequest := FALSE, bPumpRequest := TRUE, bPumpFailure := FALSE, bPumpRunning := FALSE, bSuctionRunning := FALSE, tPulse := T#0S);
AssertFalse(Condition := fb.bResetPump, Message := 'released');
AssertFalse(Condition := fb.bResetSuction, Message := 'released');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Pulse_Before_First_Start" Id="{8372ffbf-7137-424a-adbc-d3cc555381a5}">
      <Declaration><![CDATA[// After a PLC start the first pump request is preceded by a pulse, and the pump enable is held off during it.
METHOD PRIVATE Pulse_Before_First_Start
VAR
	fb	: HalfBROT.FB_PumpResetPulse;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Pulse_Before_First_Start');
fb(bResetRequest := FALSE, bPumpRequest := TRUE, bPumpFailure := FALSE, bPumpRunning := FALSE, bSuctionRunning := FALSE, tPulse := T#1H);
AssertTrue(Condition := fb.bActive, Message := 'pulse');
AssertTrue(Condition := fb.bResetPump, Message := 'pump reset');
AssertTrue(Condition := fb.bResetSuction, Message := 'suction reset');
AssertTrue(Condition := fb.bHoldPump, Message := 'pump enable held');
AssertEquals_STRING(Expected := 'before first start', Actual := fb.sReason, Message := 'reason');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="No_Pulse_Without_Request" Id="{8bd8b8fa-d319-407a-9cd6-8ae79dae91ab}">
      <Declaration><![CDATA[// No pump request and no reset request: nothing happens.
METHOD PRIVATE No_Pulse_Without_Request
VAR
	fb	: HalfBROT.FB_PumpResetPulse;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('No_Pulse_Without_Request');
fb(bResetRequest := FALSE, bPumpRequest := FALSE, bPumpFailure := FALSE, bPumpRunning := FALSE, bSuctionRunning := FALSE, tPulse := T#1H);
AssertFalse(Condition := fb.bActive, Message := 'no pulse');
AssertFalse(Condition := fb.bResetPump, Message := 'no reset');
AssertFalse(Condition := fb.bResetSuction, Message := 'no reset');
AssertFalse(Condition := fb.bHoldPump, Message := 'no hold');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Running_Pump_Needs_No_Pulse" Id="{fc9285a3-3129-4bd2-aa86-e8cecc949f6a}">
      <Declaration><![CDATA[// A pump with run feedback is never reset or held, the due pulse is dropped.
METHOD PRIVATE Running_Pump_Needs_No_Pulse
VAR
	fb	: HalfBROT.FB_PumpResetPulse;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Running_Pump_Needs_No_Pulse');
fb(bResetRequest := FALSE, bPumpRequest := TRUE, bPumpFailure := FALSE, bPumpRunning := TRUE, bSuctionRunning := FALSE, tPulse := T#1H);
AssertFalse(Condition := fb.bActive, Message := 'no pulse');
AssertFalse(Condition := fb.bResetPump, Message := 'no reset');
AssertFalse(Condition := fb.bHoldPump, Message := 'no hold');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Request_Resets_Stopped_Starters_Only" Id="{f377a7b0-5763-4f53-9067-bfc1b59fe853}">
      <Declaration><![CDATA[// A reset request pulses only the starters without run feedback.
METHOD PRIVATE Request_Resets_Stopped_Starters_Only
VAR
	fb	: HalfBROT.FB_PumpResetPulse;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Request_Resets_Stopped_Starters_Only');
fb(bResetRequest := TRUE, bPumpRequest := FALSE, bPumpFailure := FALSE, bPumpRunning := TRUE, bSuctionRunning := FALSE, tPulse := T#1H);
AssertTrue(Condition := fb.bActive, Message := 'pulse');
AssertFalse(Condition := fb.bResetPump, Message := 'running pump not reset');
AssertTrue(Condition := fb.bResetSuction, Message := 'stopped suction reset');
AssertFalse(Condition := fb.bHoldPump, Message := 'running pump not held');
AssertEquals_STRING(Expected := 'requested', Actual := fb.sReason, Message := 'reason');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Pulse_After_Pump_Failure" Id="{d35a4e15-f506-4614-99d6-c2f120ebb7fc}">
      <Declaration><![CDATA[// A main pump failure after it ran makes the next start pulse again.
METHOD PRIVATE Pulse_After_Pump_Failure
VAR
	fb	: HalfBROT.FB_PumpResetPulse;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Pulse_After_Pump_Failure');
fb(bResetRequest := FALSE, bPumpRequest := TRUE, bPumpFailure := FALSE, bPumpRunning := TRUE, bSuctionRunning := FALSE, tPulse := T#1H);
AssertFalse(Condition := fb.bActive, Message := 'running, no pulse');
fb(bResetRequest := FALSE, bPumpRequest := TRUE, bPumpFailure := TRUE, bPumpRunning := FALSE, bSuctionRunning := FALSE, tPulse := T#1H);
AssertTrue(Condition := fb.bActive, Message := 'pulse after the failure');
AssertEquals_STRING(Expected := 'after pump failure', Actual := fb.sReason, Message := 'reason');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
