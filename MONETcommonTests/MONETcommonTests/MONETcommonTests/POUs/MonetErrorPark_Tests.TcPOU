<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MonetErrorPark_Tests" Id="{589804fc-1ef2-48cc-9923-fb6abcd872c3}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of the emergency park that FB_MonetTelescopeControl starts on a new axis, focus or (since #24 step 7 PR 3)
// hydraulics error (#86, #113) or (since step 7 PR 7) power failure on mock axes, and (since #24 step 7 PR 4) of the normal park a
// new cover error starts; since #24 step 7 PR 8 the park of a focus error alone drives to the park position
// (plan step 1, MONETcommonTests README). These tests pin what the code does today, with the line of the behaviour in a comment;
// they are not a specification. Every test owns a rig and runs over many PLC cycles (VAR_INST of the method, one Scan() per
// cycle). Failed checks are also noted in GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK MonetErrorPark_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Elevation_Error_Starts_The_Emergency_Park();
Focus_Error_At_Standstill_Parks_At_The_Park_Position();
Error_On_A_Parked_Telescope_Does_Not_Park_Again();
Error_During_Estop_Does_Not_Park();
First_PowerOn_AzEl_Error_Is_Exempt_From_The_Park();
Persisting_Error_Does_Not_Start_A_Second_Park();
Power_Failure_At_Standstill_Parks_In_Place_And_Recovers();
Power_Failure_On_A_Parked_Telescope_Does_Not_Park();
Hydraulics_Error_On_A_Parked_Telescope_Does_Not_Park();
Hydraulics_Error_During_Estop_Does_Not_Park();
Hydraulics_Error_Park_Recovers_With_Hydraulics_Reset_And_Reset();
Cover_Error_Park_Recovers_With_Cover_Reset_And_Reset();
Cover_Error_During_Estop_Does_Not_Park();
Focus_Error_While_Tracking_Ramps_Then_Parks_At_The_Park_Position();
Focus_Error_With_An_Axis_Error_Parks_In_Place();
Axis_Error_During_The_Focus_Error_Park_Parks_In_Place();
Stuck_Focus_Does_Not_Hold_The_Focus_Error_Park();
Focus_Error_Park_Recovers_With_Reset_And_Power_On();
]]></ST>
    </Implementation>
    <Method Name="Elevation_Error_Starts_The_Emergency_Park" Id="{6190de19-41df-490b-93bf-4ae2a295f3a2}">
      <Declaration><![CDATA[// M:495-504 (#86): a new axis error on a telescope that is not parked starts the emergency park by itself: the brake is closed, the
// axes are disabled, the covers are closed and bIsParked is set; the error stays (READY_STATE -1.0) until it is reset.
METHOD PRIVATE Elevation_Error_Starts_The_Emergency_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Elevation_Error_Starts_The_Emergency_Park');
sTest := 'Elevation_Error_Starts_The_Emergency_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the elevation reports an error
	IF rig.Online THEN
		rig.InjectElevationError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the emergency park has finished
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive, Message := 'the park is over');
		F_Note(bFailed := (rig.fbTel.bParkActive), sText := CONCAT(sTest, 'the park is over'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'all three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'all three axes are disabled'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1, Message := 'the covers are closed');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers are closed'));
		AssertTrue(Condition := rig.fbTel.bError, Message := 'the error stays until it is reset');
		F_Note(bFailed := NOT (rig.fbTel.bError), sText := CONCAT(sTest, 'the error stays until it is reset'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'READY_STATE is -1.0 (error)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'READY_STATE is -1.0 (error)'));
		AssertTrue(Condition := rig.fbTel.bParkedInPlace, Message := 'the park ended in place');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'the park ended in place'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Error_At_Standstill_Parks_At_The_Park_Position" Id="{01032966-7411-4af2-a4d4-6b95b60bd9ac}">
      <Declaration><![CDATA[// #24 step 7 PR 8 (D8, row focus error; until 0.13.0 Focus_Error_Starts_The_Emergency_Park, which parked in place): a focus error
// alone (bHwError) still starts the emergency park (#86), but the axes are healthy, so the park drives to the park position. At
// standstill there is no ramp (bStop never set) and the axes stay enabled in the scan of the error; the elevation reaches
// elevationPark (60, from home 40), then the park disables the axes, the brake and the covers close, the hydraulics go off; bIsParked,
// not bParkedInPlace. The error stays (READY_STATE -1.0), no roof request (D9), and the faulty focus is not sent to focusPark (36).
METHOD PRIVATE Focus_Error_At_Standstill_Parks_At_The_Park_Position
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nDisable0	: UINT;
	bSeenError	: BOOL;
	bSawStop	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Error_At_Standstill_Parks_At_The_Park_Position');
sTest := 'Focus_Error_At_Standstill_Parks_At_The_Park_Position: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the focus reports an error
	IF rig.Online THEN
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.InjectFocusError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the emergency park drives to the park position
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	IF rig.fbTel.bError AND NOT bSeenError THEN	// the scan that saw the error
		bSeenError := TRUE;
		AssertTrue(Condition := rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable, Message := 'the axes stay enabled in the scan of the error');
		F_Note(bFailed := NOT (rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable), sText := CONCAT(sTest, 'the axes stay enabled in the scan of the error'));
	END_IF
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := bSawStop, Message := 'at standstill no ramp (bStop never set)');
		F_Note(bFailed := (bSawStop), sText := CONCAT(sTest, 'at standstill no ramp (bStop never set)'));
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bParkedInPlace, Message := 'the park is over and did not end in place');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'the park is over and did not end in place'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 60.0) < 0.001, Message := 'the elevation is at the park position (60)');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 60.0) < 0.001), sText := CONCAT(sTest, 'the elevation is at the park position (60)'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'all three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'all three axes are disabled'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1, Message := 'the covers are closed');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers are closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0, Message := 'the hydraulics are switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0), sText := CONCAT(sTest, 'the hydraulics are switched off'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0, Message := 'the error stays, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the error stays, READY_STATE -1.0'));
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no roof close request for a focus error (D9)');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no roof close request for a focus error (D9)'));
		AssertTrue(Condition := rig.fbFocus.Position <> 36.0, Message := 'the faulty focus is not sent to its park position');
		F_Note(bFailed := NOT (rig.fbFocus.Position <> 36.0), sText := CONCAT(sTest, 'the faulty focus is not sent to its park position'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Error_On_A_Parked_Telescope_Does_Not_Park_Again" Id="{e378877b-adb5-4ca0-af7e-8f895f4ccb2a}">
      <Declaration><![CDATA[// F_ErrorParkRequest: an error on a telescope that is already parked starts no park (nothing to protect).
METHOD PRIVATE Error_On_A_Parked_Telescope_Does_Not_Park_Again
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nCloses		: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Error_On_A_Parked_Telescope_Does_Not_Park_Again');
sTest := 'Error_On_A_Parked_Telescope_Does_Not_Park_Again: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: park
	IF rig.Online THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until it is parked, then an axis reports an error
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bParkedInPlace, Message := 'a park to the park position is not in place');
		F_Note(bFailed := (rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'a park to the park position is not in place'));
		nCloses := rig.fbCovers.nCloseCalls;
		rig.InjectElevationError(16#4550);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive, Message := 'no new park is started');
		F_Note(bFailed := (rig.fbTel.bParkActive), sText := CONCAT(sTest, 'no new park is started'));
		AssertTrue(Condition := rig.fbTel.bIsParked, Message := 'the telescope stays parked');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the telescope stays parked'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = nCloses, Message := 'the covers are not commanded again');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = nCloses), sText := CONCAT(sTest, 'the covers are not commanded again'));
		AssertTrue(Condition := rig.fbTel.bError, Message := 'the error is reported');
		F_Note(bFailed := NOT (rig.fbTel.bError), sText := CONCAT(sTest, 'the error is reported'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Error_During_Estop_Does_Not_Park" Id="{68bf4dbd-82a2-4cd3-ab08-78009e7319a9}">
      <Declaration><![CDATA[// F_ErrorParkRequest: with the E-stop pressed the park cannot do anything (the drives are cut), so an error starts none. Since #24
// step 7 PR 6 the E-stop itself holds a park in place until its release (MonetSafeState_Tests.Estop_During_Slew_Locks_Then_Parks_
// In_Place_After_The_Release); while it is pressed nothing parks and the covers are not commanded, as asserted here.
METHOD PRIVATE Error_During_Estop_Does_Not_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Error_During_Estop_Does_Not_Park');
sTest := 'Error_During_Estop_Does_Not_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the E-stop is pressed
	IF rig.Online THEN
		rig.SetEstop(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// a few scans later an axis reports an error
	IF nCycles >= 5 THEN
		rig.InjectElevationError(16#4550);
		nStep := 30;
		nCycles := 0;
	END_IF
30:
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'no park with the E-stop pressed');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park with the E-stop pressed'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers were not closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers were not closed'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="First_PowerOn_AzEl_Error_Is_Exempt_From_The_Park" Id="{b161a719-4601-485d-bf30-7cc1d9352e31}">
      <Declaration><![CDATA[// M:497-500 (#113, F_WakeShakeErrorExempt): the first power-on after a PLC restart may raise an azimuth/elevation error during the
// Wake&Shake: the error aborts the power-on but starts no emergency park.
METHOD PRIVATE First_PowerOn_AzEl_Error_Is_Exempt_From_The_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('First_PowerOn_AzEl_Error_Is_Exempt_From_The_Park');
sTest := 'First_PowerOn_AzEl_Error_Is_Exempt_From_The_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: the azimuth reports an error
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.InjectAzimuthError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'no emergency park');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no emergency park'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers the power-on opened stay open');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers the power-on opened stay open'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -1.0, Message := 'READY_STATE is -1.0 (error)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'READY_STATE is -1.0 (error)'));
		AssertFalse(Condition := rig.fbTel.fbStartup.Initializing, Message := 'the power-on is aborted');
		F_Note(bFailed := (rig.fbTel.fbStartup.Initializing), sText := CONCAT(sTest, 'the power-on is aborted'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Persisting_Error_Does_Not_Start_A_Second_Park" Id="{bccaf610-8410-4c63-88c9-7ae833230e4e}">
      <Declaration><![CDATA[// F_ErrorParkRequest: only the rising edge of the error parks. The error is still there after the emergency park; nothing parks
// again and the covers are not commanded again.
METHOD PRIVATE Persisting_Error_Does_Not_Start_A_Second_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nCloses		: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Persisting_Error_Does_Not_Start_A_Second_Park');
sTest := 'Persisting_Error_Does_Not_Start_A_Second_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the elevation reports an error
	IF rig.Online THEN
		rig.InjectElevationError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the emergency park has finished
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		nCloses := rig.fbCovers.nCloseCalls;
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 100 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive, Message := 'no second park');
		F_Note(bFailed := (rig.fbTel.bParkActive), sText := CONCAT(sTest, 'no second park'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = nCloses, Message := 'the covers are not commanded again');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = nCloses), sText := CONCAT(sTest, 'the covers are not commanded again'));
		AssertTrue(Condition := rig.fbTel.bIsParked AND rig.fbTel.bError, Message := 'parked, with the error still reported');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked AND rig.fbTel.bError), sText := CONCAT(sTest, 'parked, with the error still reported'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Power_Failure_At_Standstill_Parks_In_Place_And_Recovers" Id="{03d8a622-feb0-4c12-acf2-b4166da20358}">
      <Declaration><![CDATA[// #24 step 7 PR 7 (D8), reset path of the row power failure: online at standstill bMainReady FALSE parks in place without a ramp
// (nothing moves, the disable is the stop): covers closed, hydraulics off, READY_STATE -1.0. A telescope reset during the failure
// does not clear it and is not held (a held bReset would abort the park in every scan). When the supply is back bError drops by
// itself (not latched) and the telescope stays parked (READY_STATE 0.0); bCloseRoofRequest stays latched until the next telescope
// reset; then power=1 brings it online again.
METHOD PRIVATE Power_Failure_At_Standstill_Parks_In_Place_And_Recovers
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
	nDisable0	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Power_Failure_At_Standstill_Parks_In_Place_And_Recovers');
sTest := 'Power_Failure_At_Standstill_Parks_In_Place_And_Recovers: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the main power fails
	IF rig.Online THEN
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.SetMainReady(FALSE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the emergency park in place
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := bSawStop, Message := 'at standstill no ramp');
		F_Note(bFailed := (bSawStop), sText := CONCAT(sTest, 'at standstill no ramp'));
		AssertTrue(Condition := rig.fbTel.bParkedInPlace AND rig.fbCovers.bClosed, Message := 'parked in place, covers closed');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace AND rig.fbCovers.bClosed), sText := CONCAT(sTest, 'parked in place, covers closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0 AND NOT rig.fbBrakeHyd.BrakeOpen, Message := 'the hydraulics are switched off, the brake is closed');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0 AND NOT rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the hydraulics are switched off, the brake is closed'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0, Message := 'a telescope error, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'a telescope error, READY_STATE -1.0'));
		rig.fbTel.Reset();	// the power failure is still there
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.bIsParked, Message := 'a telescope reset does not clear the power failure');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.bIsParked), sText := CONCAT(sTest, 'a telescope reset does not clear the power failure'));
		AssertFalse(Condition := rig.fbTel.bResetActive, Message := 'the reset is not held on the power failure');
		F_Note(bFailed := (rig.fbTel.bResetActive), sText := CONCAT(sTest, 'the reset is not held on the power failure'));
		rig.SetMainReady(TRUE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// the supply is back
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'bError drops by itself when the supply is back');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'bError drops by itself when the supply is back'));
		AssertTrue(Condition := rig.fbTel.bIsParked AND rig.fbTel.ReadyState = 0.0, Message := 'still parked, READY_STATE 0.0');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked AND rig.fbTel.ReadyState = 0.0), sText := CONCAT(sTest, 'still parked, READY_STATE 0.0'));
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the roof request stays latched');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the roof request stays latched'));
		rig.fbTel.Reset();
		nStep := 50;
		nCycles := 0;
	END_IF
50:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the telescope reset clears the roof request');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the telescope reset clears the roof request'));
		rig.fbTel.Init();
		nStep := 60;
		nCycles := 0;
	END_IF
60:	// power=1: online again
	IF rig.Online THEN
		AssertTrue(Condition := TRUE, Message := 'online again after the supply, a reset and power=1');
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'not online again after the supply, a reset and power=1');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'not online again after the supply, a reset and power=1'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Power_Failure_On_A_Parked_Telescope_Does_Not_Park" Id="{be6ce1f6-02e4-4999-ac37-896b59fe2c10}">
      <Declaration><![CDATA[// #24 step 7 PR 7 (F_ErrorParkRequest unchanged): a power failure is a telescope error (bError, READY_STATE -1.0 instead of 0.0), but
// on a telescope that is already parked (here: the PLC start) it starts no park and no stop, and the covers are not commanded. A
// power=1 during the failure fails at once (bError in _PowerOn) instead of opening the covers and waiting for bMainReady in stage
// open_covers as until 0.13.0: the telescope stays parked. When the supply is back bError drops by itself. No clock needed.
METHOD PRIVATE Power_Failure_On_A_Parked_Telescope_Does_Not_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Power_Failure_On_A_Parked_Telescope_Does_Not_Park');
sTest := 'Power_Failure_On_A_Parked_Telescope_Does_Not_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
bSawStop := bSawStop OR rig.fbTel.bStopActive OR rig.fbTel.bParkActive;
CASE nStep OF
0:	// parked since the start: the main power fails
	IF nCycles >= 3 THEN
		rig.SetMainReady(FALSE);
		nStep := 10;
		nCycles := 0;
	END_IF
10:
	IF nCycles >= 60 THEN
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0, Message := 'the power failure is a telescope error, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the power failure is a telescope error, READY_STATE -1.0'));
		AssertFalse(Condition := bSawStop, Message := 'no stop and no park');
		F_Note(bFailed := (bSawStop), sText := CONCAT(sTest, 'no stop and no park'));
		AssertTrue(Condition := rig.fbTel.bIsParked AND rig.fbCovers.nCloseCalls = 0, Message := 'stays parked, the covers are not commanded');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked AND rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'stays parked, the covers are not commanded'));
		rig.fbTel.Init();	// power=1 during the failure
		nStep := 20;
		nCycles := 0;
	END_IF
20:
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.fbTel.bIsParked AND rig.fbCovers.nOpenCalls = 0, Message := 'power=1 during the failure opens nothing, stays parked');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked AND rig.fbCovers.nOpenCalls = 0), sText := CONCAT(sTest, 'power=1 during the failure opens nothing, stays parked'));
		AssertFalse(Condition := rig.fbTel.bPowerActive OR rig.fbTel.fbStartup.Initializing, Message := 'the power-on has ended');
		F_Note(bFailed := (rig.fbTel.bPowerActive OR rig.fbTel.fbStartup.Initializing), sText := CONCAT(sTest, 'the power-on has ended'));
		rig.SetMainReady(TRUE);
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// the supply is back
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'bError drops by itself when the supply is back');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'bError drops by itself when the supply is back'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hydraulics_Error_On_A_Parked_Telescope_Does_Not_Park" Id="{46d579f6-fa1a-4401-a192-f55339d8302e}">
      <Declaration><![CDATA[// #24 step 7 PR 3 (F_ErrorParkRequest unchanged): a hydraulics error is a telescope error (bError), but on a telescope that is
// already parked (here: the PLC start) it starts no park and no stop, and the covers are not commanded. No clock, no power-on.
METHOD PRIVATE Hydraulics_Error_On_A_Parked_Telescope_Does_Not_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hydraulics_Error_On_A_Parked_Telescope_Does_Not_Park');
sTest := 'Hydraulics_Error_On_A_Parked_Telescope_Does_Not_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
bSawStop := bSawStop OR rig.fbTel.bStopActive OR rig.fbTel.bParkActive;
CASE nStep OF
0:	// parked since the start: the hydraulics report an error
	IF nCycles >= 3 THEN
		rig.fbBrakeHyd.InjectError();
		nStep := 10;
		nCycles := 0;
	END_IF
10:
	IF nCycles >= 60 THEN
		AssertTrue(Condition := rig.fbTel.bError, Message := 'the hydraulics error is a telescope error');
		F_Note(bFailed := NOT (rig.fbTel.bError), sText := CONCAT(sTest, 'the hydraulics error is a telescope error'));
		AssertFalse(Condition := bSawStop, Message := 'no stop and no park');
		F_Note(bFailed := (bSawStop), sText := CONCAT(sTest, 'no stop and no park'));
		AssertTrue(Condition := rig.fbTel.bIsParked, Message := 'the telescope stays parked');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the telescope stays parked'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers are not commanded');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers are not commanded'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hydraulics_Error_During_Estop_Does_Not_Park" Id="{f1554025-9250-4236-b5a5-c6dc739a8ade}">
      <Declaration><![CDATA[// #24 step 7 PR 3: the E-stop exemption of F_ErrorParkRequest also holds for the hydraulics error (drives cut, people on site,
// covers are not commanded while it is pressed), and there is no ramp under the E-stop (STO: the lock is the stop). #24 step 7 PR 6:
// during the E-stop this still holds; the park in place that the E-stop holds runs after its release and closes the covers then
// (target "covers as possible after release"; until PR 6 this comment said the covers must not move on the release).
METHOD PRIVATE Hydraulics_Error_During_Estop_Does_Not_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hydraulics_Error_During_Estop_Does_Not_Park');
sTest := 'Hydraulics_Error_During_Estop_Does_Not_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the E-stop is pressed
	IF rig.Online THEN
		rig.SetEstop(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// a few scans later the hydraulics report an error
	IF nCycles >= 5 THEN
		rig.fbBrakeHyd.InjectError();
		nStep := 30;
		nCycles := 0;
	END_IF
30:
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'no park with the E-stop pressed');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park with the E-stop pressed'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers were not closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers were not closed'));
		AssertFalse(Condition := bSawStop, Message := 'no ramp under the E-stop');
		F_Note(bFailed := (bSawStop), sText := CONCAT(sTest, 'no ramp under the E-stop'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'the three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'the three axes are disabled'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hydraulics_Error_Park_Recovers_With_Hydraulics_Reset_And_Reset" Id="{aa897218-649e-4f97-902a-7d1fe57600a9}">
      <Declaration><![CDATA[// #24 step 7 PR 3, reset path of the row hydraulics error: online at standstill a hydraulics error parks in place without a ramp
// (nothing moves, the disable is the stop). A telescope reset while the hydraulics error is still there does not clear it and is
// not held (a held bReset would abort the park in every scan); the hydraulics reset (HalfBROT Reset(), MAIN reset button) clears
// bError by itself; bCloseRoofRequest stays latched until the next telescope reset; then power=1 brings it online again.
METHOD PRIVATE Hydraulics_Error_Park_Recovers_With_Hydraulics_Reset_And_Reset
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawStop	: BOOL;
	nDisable0	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hydraulics_Error_Park_Recovers_With_Hydraulics_Reset_And_Reset');
sTest := 'Hydraulics_Error_Park_Recovers_With_Hydraulics_Reset_And_Reset: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the hydraulics report an error
	IF rig.Online THEN
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.fbBrakeHyd.InjectError();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the emergency park in place
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := bSawStop, Message := 'at standstill no ramp');
		F_Note(bFailed := (bSawStop), sText := CONCAT(sTest, 'at standstill no ramp'));
		AssertTrue(Condition := rig.fbTel.bParkedInPlace AND rig.fbCovers.bClosed, Message := 'parked in place, covers closed');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace AND rig.fbCovers.bClosed), sText := CONCAT(sTest, 'parked in place, covers closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0, Message := 'the hydraulics are switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0), sText := CONCAT(sTest, 'the hydraulics are switched off'));
		rig.fbTel.Reset();	// the hydraulics error is still there
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.bIsParked, Message := 'a telescope reset does not clear the hydraulics error');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.bIsParked), sText := CONCAT(sTest, 'a telescope reset does not clear the hydraulics error'));
		AssertFalse(Condition := rig.fbTel.bResetActive, Message := 'the reset is not held on the hydraulics error');
		F_Note(bFailed := (rig.fbTel.bResetActive), sText := CONCAT(sTest, 'the reset is not held on the hydraulics error'));
		rig.fbBrakeHyd.Reset();
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'the hydraulics reset clears bError');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'the hydraulics reset clears bError'));
		AssertTrue(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the roof request stays latched');
		F_Note(bFailed := NOT (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the roof request stays latched'));
		rig.fbTel.Reset();
		nStep := 50;
		nCycles := 0;
	END_IF
50:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'the telescope reset clears the roof request');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'the telescope reset clears the roof request'));
		rig.fbTel.Init();
		nStep := 60;
		nCycles := 0;
	END_IF
60:	// power=1: online again
	IF rig.Online THEN
		AssertTrue(Condition := TRUE, Message := 'online again after the resets and power=1');
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'not online again after the resets and power=1');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'not online again after the resets and power=1'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cover_Error_Park_Recovers_With_Cover_Reset_And_Reset" Id="{1aed1f73-4b16-497e-b0a9-80d683867dc4}">
      <Declaration><![CDATA[// #24 step 7 PR 4, reset path of the row cover error: online at standstill a cover error starts a normal park (no telescope error),
// which ends without the covers closed (bIsParked, software error 16#21). A telescope reset alone clears 16#21 (parked, READY_STATE
// 0.0), but with the cover error still there power=1 fails (bPowerFailure, stays parked). The MAIN reset button (cover Reset() and
// telescope Reset()) clears the cover error; power=1 goes online, and a park then closes the covers.
METHOD PRIVATE Cover_Error_Park_Recovers_With_Cover_Reset_And_Reset
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cover_Error_Park_Recovers_With_Cover_Reset_And_Reset');
sTest := 'Cover_Error_Park_Recovers_With_Cover_Reset_And_Reset: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the covers report an error
	IF rig.Online THEN
		rig.fbCovers.InjectError();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park ends without the covers closed
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#21 AND NOT rig.fbCovers.bClosed, Message := 'parked with software error 16#21, covers not closed');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#21 AND NOT rig.fbCovers.bClosed), sText := CONCAT(sTest, 'parked with software error 16#21, covers not closed'));
		rig.fbTel.Reset();	// the cover error is still there
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not end');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not end'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bError OR rig.fbTel.bResetActive, Message := 'a telescope reset clears 16#21 and is not held');
		F_Note(bFailed := (rig.fbTel.bError OR rig.fbTel.bResetActive), sText := CONCAT(sTest, 'a telescope reset clears 16#21 and is not held'));
		AssertTrue(Condition := rig.fbTel.bIsParked AND rig.fbTel.ReadyState = 0.0, Message := 'parked, READY_STATE 0.0');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked AND rig.fbTel.ReadyState = 0.0), sText := CONCAT(sTest, 'parked, READY_STATE 0.0'));
		rig.fbTel.Init();
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// power=1 with the cover error still there fails
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.fbTel.bPowerFailure AND rig.fbTel.ReadyState = -1.0 AND rig.fbTel.bIsParked, Message := 'power=1 fails while the cover error is there, still parked');
		F_Note(bFailed := NOT (rig.fbTel.bPowerFailure AND rig.fbTel.ReadyState = -1.0 AND rig.fbTel.bIsParked), sText := CONCAT(sTest, 'power=1 fails while the cover error is there, still parked'));
		rig.fbCovers.Reset();	// the MAIN reset button: covers, then the telescope
		rig.fbTel.Reset();
		nStep := 50;
		nCycles := 0;
	END_IF
50:
	IF nCycles >= 5 THEN
		rig.fbTel.Init();
		nStep := 60;
		nCycles := 0;
	END_IF
60:	// power=1 after the reset button: online; then park
	IF rig.Online THEN
		AssertTrue(Condition := NOT rig.fbTel.bPowerFailure, Message := 'online again after the reset button and power=1');
		F_Note(bFailed := rig.fbTel.bPowerFailure, sText := CONCAT(sTest, 'online again after the reset button and power=1'));
		rig.fbTel.Park();
		nStep := 70;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'not online again after the reset button and power=1');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'not online again after the reset button and power=1'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
70:	// the park closes the covers
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbCovers.bClosed AND NOT rig.fbTel.bError, Message := 'parked with the covers closed, no error');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND NOT rig.fbTel.bError), sText := CONCAT(sTest, 'parked with the covers closed, no error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the park after the recovery did not end');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park after the recovery did not end'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cover_Error_During_Estop_Does_Not_Park" Id="{44fb406b-6817-4fcc-830a-795da88a3e6b}">
      <Declaration><![CDATA[// #24 step 7 PR 4: the E-stop exemption of F_ErrorParkRequest also holds for the cover error (drives cut, people on site, covers must
// not be commanded while it is pressed). #24 step 7 PR 6: after the release the cover error is no new edge, but the park in place
// that the E-stop held runs and, the covers being in error, ends without Closed (bIsParked, software error 16#21). Until PR 6 nothing
// parked after the release.
METHOD PRIVATE Cover_Error_During_Estop_Does_Not_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cover_Error_During_Estop_Does_Not_Park');
sTest := 'Cover_Error_During_Estop_Does_Not_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the E-stop is pressed
	IF rig.Online THEN
		rig.SetEstop(TRUE);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// a few scans later the covers report an error
	IF nCycles >= 5 THEN
		rig.fbCovers.InjectError();
		nStep := 30;
		nCycles := 0;
	END_IF
30:
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'no park with the E-stop pressed');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park with the E-stop pressed'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers were not commanded closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers were not commanded closed'));
		rig.SetEstop(FALSE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// released: the cover error is no new edge, but the park in place held by the E-stop runs (#24 step 7 PR 6) and ends without
	// Closed (PR 4): bIsParked, in place, software error 16#21
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbTel.bParkedInPlace AND NOT rig.fbTel.bParkActive, Message := 'the park held by the E-stop ran in place after the release');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace AND NOT rig.fbTel.bParkActive), sText := CONCAT(sTest, 'the park held by the E-stop ran in place after the release'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#21 AND NOT rig.fbCovers.bClosed, Message := 'parked with software error 16#21, covers not closed');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#21 AND NOT rig.fbCovers.bClosed), sText := CONCAT(sTest, 'parked with software error 16#21, covers not closed'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable OR rig.fbBrakeHyd.BrakeOpen, Message := 'axes disabled, brake closed');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable OR rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'axes disabled, brake closed'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the park after the release did not end');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park after the release did not end'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Error_While_Tracking_Ramps_Then_Parks_At_The_Park_Position" Id="{df2e8595-d308-4712-bc6a-f74d383712cd}">
      <Declaration><![CDATA[// #24 step 7 PR 8 (D8, row focus error): a focus error alone while tracking ramps first: in the scan of the error bStop is set (stop
// transaction, #96) and the axes stay enabled; every axis is sent its MC_Stop while still enabled (no 0x4257). After the stop has
// settled the emergency park queued behind it (bParkAfterStop) drives to the park position (elevation 60), then disables the axes,
// closes the brake and the covers and switches the hydraulics off: bIsParked, not bParkedInPlace. No roof request (D9).
METHOD PRIVATE Focus_Error_While_Tracking_Ramps_Then_Parks_At_The_Park_Position
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	nTracking	: UINT;
	sTest		: STRING(80);
	nEl0		: UINT;	// stop edges per axis before the error
	nAz0		: UINT;
	nDr0		: UINT;
	nExt0		: UINT;	// 0x4257 rejections of the three axes before the error
	nEdgesLast	: UINT;
	nEdgesNow	: UINT;
	nDisable0	: UINT;
	bSeenError	: BOOL;
	bSawStop	: BOOL;
	bStopOnDisabled	: BOOL;	// a stop edge came in a scan in which an axis was already disabled
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Error_While_Tracking_Ramps_Then_Parks_At_The_Park_Position');
sTest := 'Focus_Error_While_Tracking_Ramps_Then_Parks_At_The_Park_Position: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: track a circumpolar target (always above the horizon, any RA)
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -85.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until all three axes have tracked for a few scans, then the focus reports an error
	IF rig.fbAzim.Tracking AND rig.fbElev.Tracking AND rig.fbDero.Tracking THEN
		nTracking := nTracking + 1;
	ELSE
		nTracking := 0;
	END_IF
	IF nTracking >= 5 THEN
		nEl0 := rig.fbElev.nStopEdges;
		nAz0 := rig.fbAzim.nStopEdges;
		nDr0 := rig.fbDero.nStopEdges;
		nEdgesLast := nEl0 + nAz0 + nDr0;
		nExt0 := rig.fbElev.nExtErrors + rig.fbAzim.nExtErrors + rig.fbDero.nExtErrors;
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.InjectFocusError(16#4550);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not start tracking');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not start tracking'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// ramp, then the park to the park position
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	nEdgesNow := rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges;
	IF nEdgesNow > nEdgesLast AND NOT (rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable) THEN
		bStopOnDisabled := TRUE;
	END_IF
	nEdgesLast := nEdgesNow;
	IF rig.fbTel.bError AND NOT bSeenError THEN	// the scan that saw the error
		bSeenError := TRUE;
		AssertTrue(Condition := rig.fbTel.bStopActive, Message := 'the error stops the axes in its scan (bStop)');
		F_Note(bFailed := NOT (rig.fbTel.bStopActive), sText := CONCAT(sTest, 'the error stops the axes in its scan (bStop)'));
		AssertTrue(Condition := rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable, Message := 'the axes stay enabled for the ramp');
		F_Note(bFailed := NOT (rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable), sText := CONCAT(sTest, 'the axes stay enabled for the ramp'));
	END_IF
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := bSawStop, Message := 'the focus error ramped (bStop)');
		F_Note(bFailed := NOT (bSawStop), sText := CONCAT(sTest, 'the focus error ramped (bStop)'));
		AssertTrue(Condition := rig.fbElev.nStopEdges > nEl0 AND rig.fbAzim.nStopEdges > nAz0 AND rig.fbDero.nStopEdges > nDr0, Message := 'every axis was sent its MC_Stop');
		F_Note(bFailed := NOT (rig.fbElev.nStopEdges > nEl0 AND rig.fbAzim.nStopEdges > nAz0 AND rig.fbDero.nStopEdges > nDr0), sText := CONCAT(sTest, 'every axis was sent its MC_Stop'));
		AssertFalse(Condition := bStopOnDisabled, Message := 'the stops came before the disable');
		F_Note(bFailed := (bStopOnDisabled), sText := CONCAT(sTest, 'the stops came before the disable'));
		AssertTrue(Condition := rig.fbElev.nExtErrors + rig.fbAzim.nExtErrors + rig.fbDero.nExtErrors = nExt0, Message := 'no stop or move met the setpoint generator (0x4257)');
		F_Note(bFailed := NOT (rig.fbElev.nExtErrors + rig.fbAzim.nExtErrors + rig.fbDero.nExtErrors = nExt0), sText := CONCAT(sTest, 'no stop or move met the setpoint generator (0x4257)'));
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bParkedInPlace, Message := 'the park is over and did not end in place');
		F_Note(bFailed := (rig.fbTel.bParkActive OR rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'the park is over and did not end in place'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 60.0) < 0.001, Message := 'the elevation is at the park position (60)');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 60.0) < 0.001), sText := CONCAT(sTest, 'the elevation is at the park position (60)'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'all three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'all three axes are disabled'));
		AssertFalse(Condition := rig.fbBrakeHyd.BrakeOpen, Message := 'the brake is closed');
		F_Note(bFailed := (rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'the brake is closed'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1, Message := 'the covers are closed');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers are closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0, Message := 'the hydraulics are switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0), sText := CONCAT(sTest, 'the hydraulics are switched off'));
		AssertFalse(Condition := rig.fbTel.bTrackActive OR rig.fbAzim.Tracking OR rig.fbElev.Tracking OR rig.fbDero.Tracking, Message := 'nothing tracks any more');
		F_Note(bFailed := (rig.fbTel.bTrackActive OR rig.fbAzim.Tracking OR rig.fbElev.Tracking OR rig.fbDero.Tracking), sText := CONCAT(sTest, 'nothing tracks any more'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0, Message := 'the error stays, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the error stays, READY_STATE -1.0'));
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no roof close request for a focus error (D9)');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no roof close request for a focus error (D9)'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1000 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not park after the ramp');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not park after the ramp'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Error_With_An_Axis_Error_Parks_In_Place" Id="{f2528670-bf25-467f-ab22-a862eb2d87ea}">
      <Declaration><![CDATA[// #24 step 7 PR 8 (D8): a focus error together with an axis error (here the azimuth, in the same scan) is not a focus error alone:
// the axes are disabled in the scan of the errors (the brake lock is the stop, as for an axis error) and the emergency park parks in
// place, as before PR 8: bParkedInPlace, the elevation stays where it was, covers closed, hydraulics off.
METHOD PRIVATE Focus_Error_With_An_Axis_Error_Parks_In_Place
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	fEl0		: LREAL;	// elevation when the errors came
	nDisable0	: UINT;
	bSeenError	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Error_With_An_Axis_Error_Parks_In_Place');
sTest := 'Focus_Error_With_An_Axis_Error_Parks_In_Place: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the focus and the azimuth report an error
	IF rig.Online THEN
		fEl0 := rig.fbElev.fActualPosition;
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.InjectFocusError(16#4550);
		rig.InjectAzimuthError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bError AND NOT bSeenError THEN	// the scan that saw the errors
		bSeenError := TRUE;
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'disabled in the scan of the errors');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'disabled in the scan of the errors'));
	END_IF
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbTel.bParkedInPlace AND NOT rig.fbTel.bParkActive, Message := 'the park ended in place');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace AND NOT rig.fbTel.bParkActive), sText := CONCAT(sTest, 'the park ended in place'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - fEl0) < 0.001, Message := 'the elevation did not move');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - fEl0) < 0.001), sText := CONCAT(sTest, 'the elevation did not move'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1, Message := 'the covers are closed');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers are closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0, Message := 'the hydraulics are switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0), sText := CONCAT(sTest, 'the hydraulics are switched off'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Axis_Error_During_The_Focus_Error_Park_Parks_In_Place" Id="{f366f26e-855b-4284-9ac6-0481c3eff100}">
      <Declaration><![CDATA[// #24 step 7 PR 8: an axis error (here the azimuth) while the park of a focus error drives to the park position ends that drive: the
// axes are disabled (the brake lock is the stop) and the park starts again from its first stage, now in place (no new bError edge would
// reset it, and disabled axes never report Busy). It does not hang: bIsParked, bParkedInPlace, covers closed, hydraulics off.
METHOD PRIVATE Axis_Error_During_The_Focus_Error_Park_Parks_In_Place
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nDisable0	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Axis_Error_During_The_Focus_Error_Park_Parks_In_Place');
sTest := 'Axis_Error_During_The_Focus_Error_Park_Parks_In_Place: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the focus reports an error
	IF rig.Online THEN
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.InjectFocusError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park drives (the elevation moves to the park position): the azimuth reports an error
	IF rig.fbTel.bParkActive AND rig.fbElev.Busy THEN
		rig.InjectAzimuthError(16#4550);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the focus error park did not drive');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the focus error park did not drive'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbTel.bParkedInPlace AND NOT rig.fbTel.bParkActive, Message := 'the park ended in place');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace AND NOT rig.fbTel.bParkActive), sText := CONCAT(sTest, 'the park ended in place'));
		AssertFalse(Condition := rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable, Message := 'all three axes are disabled');
		F_Note(bFailed := (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable), sText := CONCAT(sTest, 'all three axes are disabled'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1, Message := 'the covers are closed');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers are closed'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0, Message := 'the hydraulics are switched off');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0), sText := CONCAT(sTest, 'the hydraulics are switched off'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 600 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish after the axis error (hang)');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish after the axis error (hang)'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stuck_Focus_Does_Not_Hold_The_Focus_Error_Park" Id="{ec8b9bca-0bc5-47ed-8a5f-4d900094c09a}">
      <Declaration><![CDATA[// #24 step 7 PR 8: a stuck focus (FB_FocusMock.InjectStuckError: a reset does not clear it) does not hold the park of the focus error.
// No park stage waits for the focus, and the faulty focus is not sent to focusPark (36). A telescope reset during the drive is not
// held while the focus stays faulty (a held reset would abort the park in every scan with the axes enabled): it restarts the park
// once, which drives on to the park position (elevation 60) and ends: bIsParked, not in place, hydraulics off, the error stays.
METHOD PRIVATE Stuck_Focus_Does_Not_Hold_The_Focus_Error_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nDisable0	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stuck_Focus_Does_Not_Hold_The_Focus_Error_Park');
sTest := 'Stuck_Focus_Does_Not_Hold_The_Focus_Error_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the focus is stuck
	IF rig.Online THEN
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		rig.fbFocus.InjectStuckError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park drives: a telescope reset, which cannot clear the stuck focus
	IF rig.fbTel.bParkActive AND rig.fbElev.Busy THEN
		rig.fbTel.Reset();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the focus error park did not drive');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the focus error park did not drive'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles = 5 THEN
		AssertFalse(Condition := rig.fbTel.bResetActive, Message := 'the reset is not held during the focus error park');
		F_Note(bFailed := (rig.fbTel.bResetActive), sText := CONCAT(sTest, 'the reset is not held during the focus error park'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.bParkActive, Message := 'the focus stays faulty, the park goes on');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.bParkActive), sText := CONCAT(sTest, 'the focus stays faulty, the park goes on'));
	END_IF
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bParkedInPlace, Message := 'the park did not end in place');
		F_Note(bFailed := (rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'the park did not end in place'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 60.0) < 0.001, Message := 'the elevation is at the park position (60)');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 60.0) < 0.001), sText := CONCAT(sTest, 'the elevation is at the park position (60)'));
		AssertTrue(Condition := rig.fbBrakeHyd.nDisableCalls > nDisable0 AND rig.fbCovers.bClosed, Message := 'hydraulics off, covers closed');
		F_Note(bFailed := NOT (rig.fbBrakeHyd.nDisableCalls > nDisable0 AND rig.fbCovers.bClosed), sText := CONCAT(sTest, 'hydraulics off, covers closed'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbFocus.Position <> 36.0, Message := 'the focus stays faulty and was not sent to its park position');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbFocus.Position <> 36.0), sText := CONCAT(sTest, 'the focus stays faulty and was not sent to its park position'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish with the stuck focus (hang)');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish with the stuck focus (hang)'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Error_Park_Recovers_With_Reset_And_Power_On" Id="{c890cb45-3f8c-4307-b056-83bf2d5413d9}">
      <Declaration><![CDATA[// #24 step 7 PR 8, reset path of the row focus error: after the park to the park position a telescope reset clears the focus error
// (fbFocus.Reset(), M resets the focus itself), bError goes, no roof request was ever set (D9), and power=1 brings the telescope online.
METHOD PRIVATE Focus_Error_Park_Recovers_With_Reset_And_Power_On
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	bSawRoof	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Error_Park_Recovers_With_Reset_And_Power_On');
sTest := 'Focus_Error_Park_Recovers_With_Reset_And_Power_On: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
bSawRoof := bSawRoof OR rig.fbTel.bCloseRoofRequest;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online at standstill: the focus reports an error
	IF rig.Online THEN
		rig.InjectFocusError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// parked at the park position: reset
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbTel.bError AND NOT rig.fbTel.bParkedInPlace, Message := 'parked at the park position with the error');
		F_Note(bFailed := NOT (rig.fbTel.bError AND NOT rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'parked at the park position with the error'));
		rig.fbTel.Reset();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the emergency park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the emergency park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 10 THEN
		AssertFalse(Condition := rig.fbTel.bError OR rig.fbTel.bResetActive, Message := 'the reset clears the focus error and is released');
		F_Note(bFailed := (rig.fbTel.bError OR rig.fbTel.bResetActive), sText := CONCAT(sTest, 'the reset clears the focus error and is released'));
		AssertTrue(Condition := rig.fbTel.bIsParked, Message := 'the telescope stays parked');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the telescope stays parked'));
		rig.fbTel.Init();
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// power=1: online again
	IF rig.Online THEN
		AssertFalse(Condition := bSawRoof, Message := 'no roof close request at any time (D9)');
		F_Note(bFailed := (bSawRoof), sText := CONCAT(sTest, 'no roof close request at any time (D9)'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'not online again after the reset and power=1');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'not online again after the reset and power=1'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
