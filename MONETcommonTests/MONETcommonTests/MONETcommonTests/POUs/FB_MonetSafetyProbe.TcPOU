<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetSafetyProbe" Id="{8bdf749b-59ea-44a1-a2c4-10542f40ef54}" SpecialFunc="None">
    <Declaration><![CDATA[// Test seam for FB_MonetSafetyHandling (X4, I_SafetyDiagnostics): the TwinSAFE info data is AT%I* inside the safety handling, so a test
// cannot write it from outside. This derived block writes it from its inputs (defaults: everything in its normal running state) and
// then runs the real body. Like FB_MonetCabinetProbe.
FUNCTION_BLOCK FB_MonetSafetyProbe EXTENDS MONETcommon.FB_MonetSafetyHandling
VAR_INPUT
	nGroupState	: USINT := 1;	// FB_InfoGroup: 1 RUN, 2 STOP, 3 SAFE, 4 ERROR, 5 RESET
	nEStopState	: USINT := 1;	// FB_InfoEStop: 1 RUN, 2 STOP, ... 5 RESET
	nEStopDiag	: USINT;
	nInState	: USINT := 104;	// FB_InfoConnection: 104 'State Data'
	nInDiag		: USINT;
	nInSignals	: BYTE;
	nOutState	: USINT := 104;
	nOutDiag	: USINT;
	nOutSignals	: BYTE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[stInfoGroup1.usiMapState := nGroupState;
stInfoEStop1.usiMapState := nEStopState;
stInfoEStop1.uiMapDiag := nEStopDiag;
stInfoSafetyIn.usiMapState := nInState;
stInfoSafetyIn.usiMapDiag := nInDiag;
stInfoSafetyIn.bySignal := nInSignals;
stInfoSafetyOut.usiMapState := nOutState;
stInfoSafetyOut.usiMapDiag := nOutDiag;
stInfoSafetyOut.bySignal := nOutSignals;
SUPER^();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
