<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_Note" Id="{ede2e7c8-ec34-48fd-8423-0303e2a84047}" SpecialFunc="None">
    <Declaration><![CDATA[// Records a failed check in GVL_Diag.sFailures (see there). Called next to the TcUnit assertion, which does the actual test result.
FUNCTION F_Note : BOOL
VAR_INPUT
	bFailed	: BOOL;
	sText	: STRING(255);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bFailed AND LEN(GVL_Diag.sFailures) < 700 THEN
	GVL_Diag.sFailures := CONCAT(CONCAT(GVL_Diag.sFailures, sText), '; ');
END_IF
F_Note := bFailed;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
