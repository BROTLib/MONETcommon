<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetParkLog_Tests" Id="{5ed42ce7-de2f-4b12-828d-6f98102c074c}" SpecialFunc="None">
    <Declaration><![CDATA[// #279: FB_MonetParkLog writes 'PARK commencing' before the progress and 'PARK completed' after it, also when the start or the
// end falls in the scan of a stage change, and logs every stage of a first or restarted park. One call per modelled PLC scan with the
// park stage at the end of that scan; the lines are read from FB_LogRecordingComm.
FUNCTION_BLOCK FB_MonetParkLog_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Emergency_Park_Logs_Commencing_Before_Progress();
Normal_Park_Logs_Every_Stage_In_Order();
End_Logs_Completed_After_The_Last_Progress();
Idle_Logs_Nothing();
Restarted_Park_Logs_Its_Stages_Again();
Stage_Kept_Over_Scans_Is_Logged_Once();
]]></ST>
    </Implementation>
    <Method Name="Emergency_Park_Logs_Commencing_Before_Progress" Id="{a6695d5c-93ba-4935-b884-838fe5739b92}">
      <Declaration><![CDATA[// MONET/N 2026-11-13 run B of #277: the emergency park starts and reaches stage secure (80) in the same scan. A new FB, as after an
// activation: the first park logs its stage too (MONET/N 2026-11-13 16:15 UTC, 0.26.0: no 'Parking progress: 80').
METHOD PRIVATE Emergency_Park_Logs_Commencing_Before_Progress
VAR
	comm	: FB_LogRecordingComm;
	fb		: FB_MonetParkLog;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Emergency_Park_Logs_Commencing_Before_Progress');
fb(bParkActive := TRUE, nStage := 80, comm := comm);
AssertEquals_INT(Expected := 2, Actual := comm.nCount, Message := 'two lines');
AssertEquals_STRING(Expected := 'PARK commencing', Actual := comm.aMessage[1], Message := 'the start first');
AssertEquals_STRING(Expected := 'Parking progress: 80', Actual := comm.aMessage[2], Message := 'then the progress');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Normal_Park_Logs_Every_Stage_In_Order" Id="{5fbd0957-3ced-474f-b0bf-0feef00233e8}">
      <Declaration><![CDATA[// park=1: the stages follow in consecutive scans; each one is logged once, a scan that stays in its stage logs nothing.
METHOD PRIVATE Normal_Park_Logs_Every_Stage_In_Order
VAR
	comm	: FB_LogRecordingComm;
	fb		: FB_MonetParkLog;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Normal_Park_Logs_Every_Stage_In_Order');
fb(bParkActive := TRUE, nStage := 10, comm := comm);
fb(bParkActive := TRUE, nStage := 20, comm := comm);
fb(bParkActive := TRUE, nStage := 20, comm := comm);
fb(bParkActive := TRUE, nStage := 40, comm := comm);
AssertEquals_INT(Expected := 4, Actual := comm.nCount, Message := 'four lines');
AssertEquals_STRING(Expected := 'PARK commencing', Actual := comm.aMessage[1], Message := 'start');
AssertEquals_STRING(Expected := 'Parking progress: 10', Actual := comm.aMessage[2], Message := 'stage 10');
AssertEquals_STRING(Expected := 'Parking progress: 20', Actual := comm.aMessage[3], Message := 'stage 20 in the next scan');
AssertEquals_STRING(Expected := 'Parking progress: 40', Actual := comm.aMessage[4], Message := 'stage 40');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="End_Logs_Completed_After_The_Last_Progress" Id="{79067c5b-cf60-45d7-ae8b-14af71a75229}">
      <Declaration><![CDATA[// The park ends in the scan of its last stage change: 'PARK completed' comes after it. Then the stage is back at prepare.
METHOD PRIVATE End_Logs_Completed_After_The_Last_Progress
VAR
	comm	: FB_LogRecordingComm;
	fb		: FB_MonetParkLog;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('End_Logs_Completed_After_The_Last_Progress');
fb(bParkActive := TRUE, nStage := 80, comm := comm);
comm.Clear();
fb(bParkActive := FALSE, nStage := 100, comm := comm);
AssertEquals_INT(Expected := 2, Actual := comm.nCount, Message := 'two lines');
AssertEquals_STRING(Expected := 'Parking progress: 100', Actual := comm.aMessage[1], Message := 'the progress first');
AssertEquals_STRING(Expected := 'PARK completed', Actual := comm.aMessage[2], Message := 'then the end');
fb(bParkActive := FALSE, nStage := 0, comm := comm);
AssertEquals_INT(Expected := 2, Actual := comm.nCount, Message := 'nothing in the next scan');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Idle_Logs_Nothing" Id="{8a22e75b-93bf-43c0-aa44-370e308523e8}">
      <Declaration><![CDATA[METHOD PRIVATE Idle_Logs_Nothing
VAR
	comm	: FB_LogRecordingComm;
	fb		: FB_MonetParkLog;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Idle_Logs_Nothing');
fb(bParkActive := FALSE, nStage := 0, comm := comm);
fb(bParkActive := FALSE, nStage := 0, comm := comm);
AssertEquals_INT(Expected := 0, Actual := comm.nCount, Message := 'no park, no line');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restarted_Park_Logs_Its_Stages_Again" Id="{f15eeaf2-f02c-44e4-a56b-0d35337f58bf}">
      <Declaration><![CDATA[// A reset during a park keeps bPark and sends the stage back to prepare (_ParkTelescope, F_StageAbort); the park starts again from
// its first stage, and those stages are logged again although they are below the stage reached before.
METHOD PRIVATE Restarted_Park_Logs_Its_Stages_Again
VAR
	comm	: FB_LogRecordingComm;
	fb		: FB_MonetParkLog;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Restarted_Park_Logs_Its_Stages_Again');
fb(bParkActive := TRUE, nStage := 10, comm := comm);
fb(bParkActive := TRUE, nStage := 40, comm := comm);
fb(bParkActive := TRUE, nStage := 0, comm := comm);
fb(bParkActive := TRUE, nStage := 10, comm := comm);
fb(bParkActive := TRUE, nStage := 20, comm := comm);
AssertEquals_INT(Expected := 5, Actual := comm.nCount, Message := 'five lines');
AssertEquals_STRING(Expected := 'Parking progress: 40', Actual := comm.aMessage[3], Message := 'stage 40 before the reset');
AssertEquals_STRING(Expected := 'Parking progress: 10', Actual := comm.aMessage[4], Message := 'stage 10 again');
AssertEquals_STRING(Expected := 'Parking progress: 20', Actual := comm.aMessage[5], Message := 'stage 20');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stage_Kept_Over_Scans_Is_Logged_Once" Id="{a0e7c560-9490-48a6-81bd-c2117391f1d5}">
      <Declaration><![CDATA[// The emergency park waits in stage secure (80) for the covers over many scans: its stage is logged once.
METHOD PRIVATE Stage_Kept_Over_Scans_Is_Logged_Once
VAR
	comm	: FB_LogRecordingComm;
	fb		: FB_MonetParkLog;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stage_Kept_Over_Scans_Is_Logged_Once');
fb(bParkActive := TRUE, nStage := 80, comm := comm);
fb(bParkActive := TRUE, nStage := 80, comm := comm);
fb(bParkActive := TRUE, nStage := 80, comm := comm);
AssertEquals_INT(Expected := 2, Actual := comm.nCount, Message := 'commencing and stage 80 once');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
