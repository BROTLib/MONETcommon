<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MonetTimeouts_Tests" Id="{43b7f318-afbf-4581-9ab8-c204570dc7c2}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of the long timeouts of FB_MonetTelescopeControl on mock axes, through the time seam (FB_MonetTelescopeControl.nTimeDivisor, per rig). Plan step 3 (decision 4). Failed checks are also noted
// in GVL_Diag.sFailures.
FUNCTION_BLOCK MonetTimeouts_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Slew_Times_Out_After_600_Seconds();
Idle_Telescope_Parks_After_12_Hours();
Suspend_Stuck_Stop_Hands_Over_And_Keeps_The_Abort();
Command_Timeout_From_stMotion_Fires_At_1_Minute();
Slew_Timeout_Ramps_Parks_And_Recovers_With_Reset();
Stop_During_The_Timeout_Ramp_Cancels_The_Park();
Goto_Window_Error_During_Motion_Ramps_Without_Park();
]]></ST>
    </Implementation>
    <Method Name="Slew_Times_Out_After_600_Seconds" Id="{0f1dac27-94df-4228-bf7c-9724d9d1204a}">
      <Declaration><![CDATA[// M:1592 (#17): a slew that is still running after 600 s is an error 16#40 and the slew is dropped. The time seam (rig.SetTimeDivisor, FB_TimeoutTimer
// of BROTLib) divides every timeout by 1000, so the 600 s are 0.6 s; the mock move takes far longer than that.
METHOD PRIVATE Slew_Times_Out_After_600_Seconds
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Times_Out_After_600_Seconds');
sTest := 'Slew_Times_Out_After_600_Seconds: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, short timeouts, slew
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bError THEN
		AssertTrue(Condition := rig.fbTel.nErrorID = 16#40, Message := 'the slew timeout is error 16#40');
		F_Note(bFailed := NOT (rig.fbTel.nErrorID = 16#40), sText := CONCAT(sTest, 'the slew timeout is error 16#40'));
		AssertTrue(Condition := NOT rig.fbTel.bSlewActive, Message := 'the slew is dropped');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the slew is dropped'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew never timed out');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew never timed out'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Idle_Telescope_Parks_After_12_Hours" Id="{3d589151-ded1-4c76-a1ab-19c0d2e2f681}">
      <Declaration><![CDATA[// M:431-441: an online telescope without a command for 12 h parks itself (tonPowerTimeout). The time seam divides by 1000000, so the
// 12 h are 43 ms.
METHOD PRIVATE Idle_Telescope_Parks_After_12_Hours
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Idle_Telescope_Parks_After_12_Hours');
sTest := 'Idle_Telescope_Parks_After_12_Hours: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	IF rig.Online THEN
		rig.SetTimeDivisor(nValue := 1000000);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bParkActive OR rig.fbTel.bIsParked THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'the idle telescope parked itself');
		F_Note(bFailed := NOT (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the idle telescope parked itself'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the idle telescope never parked');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the idle telescope never parked'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspend_Stuck_Stop_Hands_Over_And_Keeps_The_Abort" Id="{683a09be-2b17-4fad-9104-4e0835283972}">
      <Declaration><![CDATA[// M:1391-1409: the switch to manual under motion stops the axes; an axis that never reports standstill is handed to the pendant
// when the 15 s stop timeout elapses (here 15 ms with the time seam), and bMoveAbortPending stays set so the body stops again.
METHOD PRIVATE Suspend_Stuck_Stop_Hands_Over_And_Keeps_The_Abort
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Suspend_Stuck_Stop_Hands_Over_And_Keeps_The_Abort');
sTest := 'Suspend_Stuck_Stop_Hands_Over_And_Keeps_The_Abort: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetStopScans(nScans := 60000);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbElev.MoveAxis AND rig.fbAzim.MoveAxis AND rig.fbDero.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start the axis moves');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start the axis moves'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.SetTimeDivisor(nValue := 1000);
		rig.SetManual(TRUE);
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF NOT rig.fbTel.bSuspendStop AND nCycles > 2 THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := rig.fbTel.bMoveAbortPending, Message := 'the abort stop is still pending after the hand-over');
		F_Note(bFailed := NOT (rig.fbTel.bMoveAbortPending), sText := CONCAT(sTest, 'the abort stop is still pending after the hand-over'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the stuck stop was never handed over');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stuck stop was never handed over'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Command_Timeout_From_stMotion_Fires_At_1_Minute" Id="{36d10b2f-d29c-406d-a163-16f47bfed1ae}">
      <Declaration><![CDATA[// #24 step 2c: the command timeout of a slew is stMotion.tCommandTimeout (default 2 min, the old literal). Set to 1 min, the timer of
// the running slew expires with ET = 1 min / 1000 = 60 ms through the time seam (with the default it would be 120 ms). The mock move
// takes far longer and the 600 s state-machine timeout (0.6 s) comes later, so nothing else ends the slew first.
METHOD PRIVATE Command_Timeout_From_stMotion_Fires_At_1_Minute
VAR_INST
	rig			: FB_MonetRig;
	stCfg		: BROTLib.ST_MotionConfig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Command_Timeout_From_stMotion_Fires_At_1_Minute');
sTest := 'Command_Timeout_From_stMotion_Fires_At_1_Minute: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// the configuration of the test, then wait for the clock and power on
	stCfg.tCommandTimeout := T#1M;
	rig.SetMotion(stValue := stCfg);
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, short timeouts, slew
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.tonCommandTimeout.Q THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := rig.fbTel.TCS_command = BROTLib.E_TCSCommand.slew, Message := 'the timeout is the one of the slew command');
		F_Note(bFailed := NOT (rig.fbTel.TCS_command = BROTLib.E_TCSCommand.slew), sText := CONCAT(sTest, 'the timeout is the one of the slew command'));
		AssertTrue(Condition := rig.fbTel.tonCommandTimeout.ET = T#60MS, Message := 'the command timeout is stMotion.tCommandTimeout (1 min / 1000 = 60 ms)');
		F_Note(bFailed := NOT (rig.fbTel.tonCommandTimeout.ET = T#60MS), sText := CONCAT(sTest, 'the command timeout is stMotion.tCommandTimeout (1 min / 1000 = 60 ms)'));
		AssertFalse(Condition := rig.fbTel.bError, Message := 'the state-machine timeout has not fired yet');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'the state-machine timeout has not fired yet'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF rig.fbTel.bError OR nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the command timeout never fired before an error');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the command timeout never fired before an error'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Timeout_Ramps_Parks_And_Recovers_With_Reset" Id="{dcbfd63a-a48a-41f5-8927-f6968b40fa7d}">
      <Declaration><![CDATA[// #24 step 7 PR 5 (D8, row software error timeout in specs/design/monetcommon-safe-states.md), slew 16#40 and the reset path: the
// slew times out under motion (time seam 1000), in the next scan bStop ramps the still enabled axes, then the park drives to the
// park position (el 60; the slew target is el 45, the start el 40): axes disabled, brake and covers closed, hydraulics off,
// bIsParked, not bParkedInPlace; the error stays latched, no roof close request (D9). reset=1 clears the software error (and the
// reset is not held any more), still no roof request, and power=1 brings the telescope online again.
METHOD PRIVATE Slew_Timeout_Ramps_Parks_And_Recovers_With_Reset
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nEdges0		: UINT;	// stop edges of the three axes before the ramp
	nDisable0	: UINT;
	bSawStop	: BOOL;
	bParkMoveScans	: BOOL;	// the park move got the default 60 scans
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Timeout_Ramps_Parks_And_Recovers_With_Reset');
sTest := 'Slew_Timeout_Ramps_Parks_And_Recovers_With_Reset: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, short timeouts, slew
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the slew times out (the scan that raised 16#40)
	IF rig.fbTel.bError THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := rig.fbTel.nErrorID = 16#40 AND NOT rig.fbTel.bSlewActive, Message := 'the slew timeout is error 16#40, the slew is dropped');
		F_Note(bFailed := NOT (rig.fbTel.nErrorID = 16#40 AND NOT rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the slew timeout is error 16#40, the slew is dropped'));
		nEdges0 := rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges;
		nDisable0 := rig.fbBrakeHyd.nDisableCalls;
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew never timed out');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew never timed out'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the ramp, then the park to the park position
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	IF rig.fbTel.bParkActive AND NOT bParkMoveScans THEN	// the stop has settled (the slew move is aborted): the park move is a normal one
		rig.SetMoveScans(nScans := 60);
		bParkMoveScans := TRUE;
	END_IF
	IF nCycles = 1 THEN	// the scan after the one that raised the timeout
		AssertTrue(Condition := rig.fbTel.bStopActive AND rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable, Message := 'the timeout ramps (bStop) with the axes enabled');
		F_Note(bFailed := NOT (rig.fbTel.bStopActive AND rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable), sText := CONCAT(sTest, 'the timeout ramps (bStop) with the axes enabled'));
	END_IF
	IF rig.fbTel.bIsParked AND nCycles > 5 THEN
		AssertTrue(Condition := bSawStop AND rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges > nEdges0, Message := 'the timeout ramped (MC_Stop sent)');
		F_Note(bFailed := NOT (bSawStop AND rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges > nEdges0), sText := CONCAT(sTest, 'the timeout ramped (MC_Stop sent)'));
		AssertTrue(Condition := NOT rig.fbTel.bParkedInPlace AND ABS(rig.fbElev.fActualPosition - 60.0) < 0.001, Message := 'the park drove to the park position (el 60, not in place)');
		F_Note(bFailed := NOT (NOT rig.fbTel.bParkedInPlace AND ABS(rig.fbElev.fActualPosition - 60.0) < 0.001), sText := CONCAT(sTest, 'the park drove to the park position (el 60, not in place)'));
		AssertTrue(Condition := NOT (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable) AND NOT rig.fbBrakeHyd.BrakeOpen, Message := 'axes disabled, brake closed');
		F_Note(bFailed := NOT (NOT (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable) AND NOT rig.fbBrakeHyd.BrakeOpen), sText := CONCAT(sTest, 'axes disabled, brake closed'));
		AssertTrue(Condition := rig.fbCovers.bClosed AND rig.fbBrakeHyd.nDisableCalls > nDisable0, Message := 'covers closed, hydraulics switched off');
		F_Note(bFailed := NOT (rig.fbCovers.bClosed AND rig.fbBrakeHyd.nDisableCalls > nDisable0), sText := CONCAT(sTest, 'covers closed, hydraulics switched off'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#40 AND rig.fbTel.ReadyState = -1.0, Message := 'the error 16#40 is latched, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#40 AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the error 16#40 is latched, READY_STATE -1.0'));
		AssertFalse(Condition := rig.fbTel.bCloseRoofRequest, Message := 'no roof close request for 16#40');
		F_Note(bFailed := (rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'no roof close request for 16#40'));
		rig.fbTel.Reset();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not park after the timeout');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not park after the timeout'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:	// reset=1 clears the software error
	IF nCycles >= 10 THEN
		AssertTrue(Condition := NOT rig.fbTel.bError AND rig.fbTel.nErrorID = 0 AND NOT rig.fbTel.bResetActive, Message := 'reset=1 clears 16#40 and is not held');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError AND rig.fbTel.nErrorID = 0 AND NOT rig.fbTel.bResetActive), sText := CONCAT(sTest, 'reset=1 clears 16#40 and is not held'));
		AssertTrue(Condition := rig.fbTel.bIsParked AND NOT rig.fbTel.bCloseRoofRequest, Message := 'still parked, no roof close request');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked AND NOT rig.fbTel.bCloseRoofRequest), sText := CONCAT(sTest, 'still parked, no roof close request'));
		rig.fbTel.Init();
		nStep := 50;
		nCycles := 0;
	END_IF
50:	// power=1: online again
	IF rig.Online THEN
		AssertTrue(Condition := TRUE, Message := 'online again after reset=1 and power=1');
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'not online again after reset=1 and power=1');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'not online again after reset=1 and power=1'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_During_The_Timeout_Ramp_Cancels_The_Park" Id="{c6bfd24c-6396-44d8-a01c-98be91362720}">
      <Declaration><![CDATA[// MONETcommon#213 (6a, offline): a stop=1 that arrives while the state-machine timeout is still ramping the axes (bStop set, the park queued
// in bParkAfterStop) must end the park for good. The slew timeout (16#40, time seam 1000) raises the timeout and queues the park behind the ramp; stop=1
// in the next scan restarts the stop transaction. Expected: when the stop has settled no park starts (bParkActive and bParkAfterStop FALSE, not parked,
// axes not driven to the park position), the error stays latched. Code reading 2026-11-06: nothing but the stop release clears bParkAfterStop, so this
// is expected to FAIL until #213 is fixed.
METHOD PRIVATE Stop_During_The_Timeout_Ramp_Cancels_The_Park
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_During_The_Timeout_Ramp_Cancels_The_Park');
sTest := 'Stop_During_The_Timeout_Ramp_Cancels_The_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, short timeouts, slew
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the slew times out (16#40)
	IF rig.fbTel.bError THEN
		rig.SetTimeDivisor(nValue := 1);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew never timed out');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew never timed out'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the scan after the timeout: the ramp runs and the park is queued behind it; stop=1 now
	AssertTrue(Condition := rig.fbTel.bStopActive AND rig.fbTel.bParkAfterStop, Message := 'precondition: the timeout ramps and the park is queued (bParkAfterStop)');
	F_Note(bFailed := NOT (rig.fbTel.bStopActive AND rig.fbTel.bParkAfterStop), sText := CONCAT(sTest, 'precondition: the timeout ramps and the park is queued (bParkAfterStop)'));
	rig.fbTel.Stop();
	nStep := 40;
	nCycles := 0;
40:	// wait until the stop has settled
	IF NOT rig.fbTel.bStopActive AND nCycles > 5 THEN
		nStep := 50;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
50:	// the park must not start now or later
	IF nCycles >= 60 THEN
		AssertFalse(Condition := rig.fbTel.bParkActive OR rig.fbTel.bParkAfterStop, Message := 'no park is running or queued after the stop');
		F_Note(bFailed := rig.fbTel.bParkActive OR rig.fbTel.bParkAfterStop, sText := CONCAT(sTest, 'no park is running or queued after the stop'));
		AssertFalse(Condition := rig.fbTel.bIsParked OR ABS(rig.fbElev.fActualPosition - 60.0) < 0.001, Message := 'the telescope was not parked after the stop');
		F_Note(bFailed := rig.fbTel.bIsParked OR ABS(rig.fbElev.fActualPosition - 60.0) < 0.001, sText := CONCAT(sTest, 'the telescope was not parked after the stop'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#40, Message := 'the error 16#40 stays latched');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#40), sText := CONCAT(sTest, 'the error 16#40 stays latched'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Goto_Window_Error_During_Motion_Ramps_Without_Park" Id="{06a79f67-e26e-4359-bf01-8cd1feb2a6d5}">
      <Declaration><![CDATA[// #230: a goto target that leaves the elevation window while the axes travel (software error 16#16, here provoked by lowering
// stMotion.fGotoMaxElevation to 30 deg under a goto to dec -89, el about 32 deg) is stopped with the axes enabled first: bStop
// (MC_Stop sent), the drives are disabled only after the stop has settled, and there is no park (bParkActive and bIsParked stay FALSE,
// no emergency park). The error stays latched (16#16, READY_STATE -1.0) and the reset clears it. Before the fix the error branch disabled
// the moving axes in the scan after the error (NC 0x4260 on the real axes, then the emergency park of the axis error).
METHOD PRIVATE Goto_Window_Error_During_Motion_Ramps_Without_Park
VAR_INST
	rig			: FB_MonetRig;
	stCfg		: BROTLib.ST_MotionConfig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
	nEdges0		: UINT;	// stop edges of the three axes before the ramp
	bSawStop	: BOOL;
	bSawPark	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Goto_Window_Error_During_Motion_Ramps_Without_Park');
sTest := 'Goto_Window_Error_During_Motion_Ramps_Without_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow axes, goto to a target inside the default window
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 60000);
		rig.fbTel.Track(fRightAscension := 0.0, fDeclination := -89.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the axes travel: now the window shrinks below the target
	IF rig.fbTel.bGotoActive AND rig.fbTel.bSlewing AND nCycles > 20 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'the goto runs without an error before the window changes');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'the goto runs without an error before the window changes'));
		nEdges0 := rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges;
		stCfg.fGotoMaxElevation := 30.0;
		rig.SetMotion(stValue := stCfg);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the goto never started to move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the goto never started to move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the scan that raised 16#16
	IF rig.fbTel.bError THEN
		AssertTrue(Condition := rig.fbTel.nErrorID = 16#16 AND NOT rig.fbTel.bGotoActive, Message := 'the target above stMotion.fGotoMaxElevation is error 16#16, the goto is dropped');
		F_Note(bFailed := NOT (rig.fbTel.nErrorID = 16#16 AND NOT rig.fbTel.bGotoActive), sText := CONCAT(sTest, 'the target above stMotion.fGotoMaxElevation is error 16#16, the goto is dropped'));
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the target outside the window was not refused during the move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the target outside the window was not refused during the move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:	// the ramp: bStop with the axes still enabled, until the stop has settled
	bSawStop := bSawStop OR rig.fbTel.bStopActive;
	bSawPark := bSawPark OR rig.fbTel.bParkActive OR rig.fbTel.bIsParked OR rig.fbTel.bParkAfterStop;
	IF nCycles = 1 THEN	// the scan after the one that raised the error
		AssertTrue(Condition := rig.fbTel.bStopActive AND rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable, Message := 'the window error ramps (bStop) with the axes enabled');
		F_Note(bFailed := NOT (rig.fbTel.bStopActive AND rig.fbElev.bEnable AND rig.fbAzim.bEnable AND rig.fbDero.bEnable), sText := CONCAT(sTest, 'the window error ramps (bStop) with the axes enabled'));
	END_IF
	IF NOT rig.fbTel.bStopActive AND nCycles > 5 AND NOT (rig.fbElev.bEnable OR rig.fbAzim.bEnable OR rig.fbDero.bEnable) THEN
		AssertTrue(Condition := bSawStop AND rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges > nEdges0, Message := 'the moving axes got an MC_Stop');
		F_Note(bFailed := NOT (bSawStop AND rig.fbElev.nStopEdges + rig.fbAzim.nStopEdges + rig.fbDero.nStopEdges > nEdges0), sText := CONCAT(sTest, 'the moving axes got an MC_Stop'));
		AssertFalse(Condition := bSawPark, Message := 'no park, no emergency park');
		F_Note(bFailed := (bSawPark), sText := CONCAT(sTest, 'no park, no emergency park'));
		AssertTrue(Condition := rig.fbTel.bError AND rig.fbTel.nErrorID = 16#16 AND rig.fbTel.ReadyState = -1.0, Message := 'the error 16#16 stays latched, READY_STATE -1.0');
		F_Note(bFailed := NOT (rig.fbTel.bError AND rig.fbTel.nErrorID = 16#16 AND rig.fbTel.ReadyState = -1.0), sText := CONCAT(sTest, 'the error 16#16 stays latched, READY_STATE -1.0'));
		rig.fbTel.Reset();
		nStep := 50;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the axes were not disabled after the stop');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the axes were not disabled after the stop'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
50:	// reset=1 clears the software error
	IF nCycles >= 10 THEN
		AssertTrue(Condition := NOT rig.fbTel.bError AND rig.fbTel.nErrorID = 0 AND NOT rig.fbTel.bIsParked, Message := 'reset=1 clears 16#16, the telescope is not parked');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError AND rig.fbTel.nErrorID = 0 AND NOT rig.fbTel.bIsParked), sText := CONCAT(sTest, 'reset=1 clears 16#16, the telescope is not parked'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Stays_Active_Until_The_Move_Is_Done" Id="{b0905257-be01-4ab9-ac64-450212d40b44}">
      <Declaration><![CDATA[// MONETcommon#225 (MS-140): the slew stage machine must stay in the slew until the moves are done. On the telescope wait_standstill ended in its
// first scan on the stale bSlewing/bStopped of before the move, so bSlewActive was TRUE for 60 ms and tonSlewTimeout (IN := bSlewActive) never covered
// the travel. Slow mock moves (200 scans): bSlewActive stays TRUE for most of them, falls only when the axes have arrived (el 45), and the
// slew is not done in the first scans of wait_standstill. The mock may not reproduce the one-scan lag of the real axes; the test is the regression guard.
METHOD PRIVATE Slew_Stays_Active_Until_The_Move_Is_Done
VAR_INST
	rig			: FB_MonetRig;
	nStep		: INT;
	nCycles		: UINT;
	nActive		: UINT;	// scans with bSlewActive after the command
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Stays_Active_Until_The_Move_Is_Done');
sTest := 'Slew_Stays_Active_Until_The_Move_Is_Done: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slow moves, slew
	IF rig.Online THEN
		rig.SetMoveScans(nScans := 200);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
		nActive := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the slew runs; it ends only when the axes have arrived
	IF rig.fbTel.bSlewActive THEN
		nActive := nActive + 1;
	END_IF
	IF nCycles > 5 AND NOT rig.fbTel.bSlewActive THEN
		AssertTrue(Condition := nActive > 150, Message := 'bSlewActive stays TRUE for the travel of the slow moves');
		F_Note(bFailed := NOT (nActive > 150), sText := CONCAT(sTest, 'bSlewActive stays TRUE for the travel of the slow moves'));
		AssertTrue(Condition := ABS(rig.fbElev.fActualPosition - 45.0) < 0.001, Message := 'the slew ended at the target (el 45)');
		F_Note(bFailed := NOT (ABS(rig.fbElev.fActualPosition - 45.0) < 0.001), sText := CONCAT(sTest, 'the slew ended at the target (el 45)'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew never ended');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew never ended'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>