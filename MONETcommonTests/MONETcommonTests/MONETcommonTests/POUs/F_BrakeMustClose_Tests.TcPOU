<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_BrakeMustClose_Tests" Id="{f1ef2a39-409c-4656-86aa-5812827f5a5e}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for MONETcommon.F_BrakeMustClose, the brake close while the elevation is disabled (#121).
FUNCTION_BLOCK F_BrakeMustClose_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Disabled_Closes();
Enabled_Keeps();
Disabled_Window_Keeps();
Enabled_Window_Keeps();
]]></ST>
    </Implementation>
    <Method Name="Disabled_Closes" Id="{c46c572f-85fd-4982-94a7-7d1488620124}">
      <Declaration><![CDATA[// Elevation disabled: the brake must be commanded closed.
METHOD PRIVATE Disabled_Closes
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Disabled_Closes');
AssertTrue(Condition := MONETcommon.F_BrakeMustClose(FALSE, FALSE), Message := 'elevation disabled');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Enabled_Keeps" Id="{636f723d-8fce-4f77-b3b4-9a95c2d94aec}">
      <Declaration><![CDATA[// Elevation enabled: the brake is not touched.
METHOD PRIVATE Enabled_Keeps
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Enabled_Keeps');
AssertFalse(Condition := MONETcommon.F_BrakeMustClose(TRUE, FALSE), Message := 'elevation enabled');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Disabled_Window_Keeps" Id="{4f3535ab-bb30-4d3f-9f8b-023e64cbb9ae}">
      <Declaration><![CDATA[// Elevation disabled in the Wake&Shake window (#151): the brake that the operator opened stays open.
METHOD PRIVATE Disabled_Window_Keeps
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Disabled_Window_Keeps');
AssertFalse(Condition := MONETcommon.F_BrakeMustClose(FALSE, TRUE), Message := 'wake&shake window');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Enabled_Window_Keeps" Id="{bfcc6a2b-53c9-426e-adff-50dc63aee512}">
      <Declaration><![CDATA[// Elevation enabled in the window: the brake is not touched either.
METHOD PRIVATE Enabled_Window_Keeps
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Enabled_Window_Keeps');
AssertFalse(Condition := MONETcommon.F_BrakeMustClose(TRUE, TRUE), Message := 'enabled in the window');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
