<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_RecordingComm" Id="{6c7f5539-3428-4d74-97a7-9411d92a762a}" SpecialFunc="None">
    <Declaration><![CDATA[// #24 step 4a: FB_NullComm that also records every publish (not PublishLog): the method used ('Publish', 'PublishLREAL',
// 'PublishINT', 'PublishBOOL', 'PublishString'), the topic (parameter) and the value, in call order. Up to 64 records; more
// are counted in nOverflow and dropped. A publish to another domain/location than 'telescope'/'dome' is counted in
// nOtherAddress (and recorded). Clear() empties it.
FUNCTION_BLOCK FB_RecordingComm EXTENDS FB_NullComm
VAR_OUTPUT
	nCount			: INT;
	nOverflow		: INT;
	nOtherAddress	: INT;
	aMethod			: ARRAY[1..64] OF STRING(16);
	aTopic			: ARRAY[1..64] OF STRING(80);
	aLREAL			: ARRAY[1..64] OF LREAL;	// PublishLREAL
	aINT			: ARRAY[1..64] OF LINT;		// PublishINT
	aBOOL			: ARRAY[1..64] OF BOOL;		// PublishBOOL
	aString			: ARRAY[1..64] OF STRING(80);	// Publish, PublishString
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Clear" Id="{cbbcc2ec-1d22-4f42-9652-6fc00b1a36d7}">
      <Declaration><![CDATA[METHOD Clear
VAR
	i	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nCount := 0;
nOverflow := 0;
nOtherAddress := 0;
FOR i := 1 TO 64 DO
	aMethod[i] := '';
	aTopic[i] := '';
	aLREAL[i] := 0.0;
	aINT[i] := 0;
	aBOOL[i] := FALSE;
	aString[i] := '';
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Record" Id="{f03ce946-d1f4-4e17-aeac-06390c60dd18}">
      <Declaration><![CDATA[// The index of the new record, 0 when full.
METHOD PRIVATE _Record : INT
VAR_INPUT
	sMethod		: STRING(16);
	domain		: STRING(255);
	location	: STRING(255);
	parameter	: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF domain <> 'telescope' OR location <> 'dome' THEN
	nOtherAddress := nOtherAddress + 1;
END_IF
IF nCount >= 64 THEN
	nOverflow := nOverflow + 1;
	_Record := 0;
	RETURN;
END_IF
nCount := nCount + 1;
aMethod[nCount] := sMethod;
aTopic[nCount] := parameter;
_Record := nCount;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Publish" Id="{3c8d9bb1-0980-49b7-9609-965a73c68e6d}">
      <Declaration><![CDATA[METHOD Publish : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
VAR
	n	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := _Record(sMethod := 'Publish', domain := domain, location := location, parameter := parameter);
IF n > 0 THEN
	aString[n] := value;
END_IF
Publish := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLREAL" Id="{9f12f066-0e50-4b93-ab61-e3ad6a66bed4}">
      <Declaration><![CDATA[METHOD PublishLREAL : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: LREAL;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
VAR
	n	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := _Record(sMethod := 'PublishLREAL', domain := domain, location := location, parameter := parameter);
IF n > 0 THEN
	aLREAL[n] := value;
END_IF
PublishLREAL := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishINT" Id="{48ed5e25-ada0-40bd-a259-43c6fcea7a39}">
      <Declaration><![CDATA[METHOD PublishINT : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: LINT;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
VAR
	n	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := _Record(sMethod := 'PublishINT', domain := domain, location := location, parameter := parameter);
IF n > 0 THEN
	aINT[n] := value;
END_IF
PublishINT := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishBOOL" Id="{88e5186f-9e71-4e0f-bf8a-ebd5d84d4cc0}">
      <Declaration><![CDATA[METHOD PublishBOOL : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: BOOL;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
VAR
	n	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := _Record(sMethod := 'PublishBOOL', domain := domain, location := location, parameter := parameter);
IF n > 0 THEN
	aBOOL[n] := value;
END_IF
PublishBOOL := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishString" Id="{25943ff7-958f-4c91-83f9-93cb252b995d}">
      <Declaration><![CDATA[METHOD PublishString : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
VAR
	n	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := _Record(sMethod := 'PublishString', domain := domain, location := location, parameter := parameter);
IF n > 0 THEN
	aString[n] := value;
END_IF
PublishString := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
