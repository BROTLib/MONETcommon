<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusDriveEnable_Tests" Id="{32820bb0-baf6-4e92-8e66-8b88ec9072b2}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for HalfBROT.FB_FocusDriveEnable, the single place that decides the focus drive enable (HalfBROT#108, #110, #111, #114).
// Pure logic. The times are T#0S ("now") or T#1H ("never within a test"), so no test depends on the PLC cycle time.
FUNCTION_BLOCK FB_FocusDriveEnable_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Move_Wanted_Enables();
Home_Wanted_Enables();
Manual_Never_Enables();
Error_Is_Not_Wanted();
Brake_Delay_Locks_At_Rest();
Brake_Delay_Not_Elapsed();
Moving_Axis_Not_Locked();
Uncalibrated_Not_Locked();
Wanted_Blocks_Lock();
Lock_Request_At_Rest();
Lock_Request_Waits_For_Rest();
Lock_Request_Dropped_By_Move();
Lock_Request_In_Error();
]]></ST>
    </Implementation>
    <Method Name="Move_Wanted_Enables" Id="{4dd3fae2-5be1-4095-80d2-2456df23d493}">
      <Declaration><![CDATA[// A wanted move in automatic positioning switches the drive on.
METHOD PRIVATE Move_Wanted_Enables
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Move_Wanted_Enables');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := TRUE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertTrue(Condition := fb.bEnableOn, Message := 'on');
AssertFalse(Condition := fb.bEnableOff, Message := 'not off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home_Wanted_Enables" Id="{7ef7625c-3a27-40b9-b91c-1eb56139226c}">
      <Declaration><![CDATA[// A wanted homing switches the drive on.
METHOD PRIVATE Home_Wanted_Enables
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Home_Wanted_Enables');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := TRUE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertTrue(Condition := fb.bEnableOn, Message := 'on');
AssertFalse(Condition := fb.bEnableOff, Message := 'not off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Manual_Never_Enables" Id="{0bbcd6df-b84a-4903-a498-af408768d68e}">
      <Declaration><![CDATA[// Not automatic positioning (manual unlock): no enable from this block.
METHOD PRIVATE Manual_Never_Enables
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Manual_Never_Enables');
fb(bAutomatic := FALSE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := TRUE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertFalse(Condition := fb.bEnableOn, Message := 'not on');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Error_Is_Not_Wanted" Id="{3dc3d862-09f2-45fc-8b38-14e46feda0a5}">
      <Declaration><![CDATA[// A move in error is not wanted any more (MC blocks keep Execute until Reset, #114): no enable.
METHOD PRIVATE Error_Is_Not_Wanted
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Error_Is_Not_Wanted');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := TRUE, bMoveWanted := TRUE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertFalse(Condition := fb.bEnableOn, Message := 'not on in error');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Brake_Delay_Locks_At_Rest" Id="{3eaa111c-f540-4f92-bc80-2252d8036755}">
      <Declaration><![CDATA[// Nothing wanted, at rest, calibrated, brake delay elapsed: the drive is locked.
METHOD PRIVATE Brake_Delay_Locks_At_Rest
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Brake_Delay_Locks_At_Rest');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := TRUE, tBrakeDelay := T#0S);
AssertFalse(Condition := fb.bEnableOn, Message := 'not on');
AssertTrue(Condition := fb.bEnableOff, Message := 'off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Brake_Delay_Not_Elapsed" Id="{7e66ca2e-3180-48f6-8430-ca707c56c71c}">
      <Declaration><![CDATA[// Same, but the brake delay has not elapsed: the drive stays on.
METHOD PRIVATE Brake_Delay_Not_Elapsed
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Brake_Delay_Not_Elapsed');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := TRUE, tBrakeDelay := T#1H);
AssertFalse(Condition := fb.bEnableOff, Message := 'not off yet');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Moving_Axis_Not_Locked" Id="{cb253d2c-8e3a-48ed-b8e3-e6badae449fc}">
      <Declaration><![CDATA[// Nothing wanted but the axis is not at rest (decelerating): never lock.
METHOD PRIVATE Moving_Axis_Not_Locked
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Moving_Axis_Not_Locked');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#0S);
AssertFalse(Condition := fb.bEnableOff, Message := 'not off while moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Uncalibrated_Not_Locked" Id="{95591a4d-f1b7-452a-82d6-404a7d44ffba}">
      <Declaration><![CDATA[// An uncalibrated axis is not locked by the brake delay (it may be about to home).
METHOD PRIVATE Uncalibrated_Not_Locked
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Uncalibrated_Not_Locked');
fb(bAutomatic := TRUE, bCalibrated := FALSE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := TRUE, tBrakeDelay := T#0S);
AssertFalse(Condition := fb.bEnableOff, Message := 'not off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Wanted_Blocks_Lock" Id="{f0d7dd2e-96dd-43bf-8169-e2c1db50b8da}">
      <Declaration><![CDATA[// A wanted move keeps the drive on even at rest with an elapsed brake delay.
METHOD PRIVATE Wanted_Blocks_Lock
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Wanted_Blocks_Lock');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := TRUE, bHomeWanted := FALSE, bAtRest := TRUE, tBrakeDelay := T#0S);
AssertTrue(Condition := fb.bEnableOn, Message := 'on');
AssertFalse(Condition := fb.bEnableOff, Message := 'not off');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Lock_Request_At_Rest" Id="{e3ad49a2-f444-4384-be77-ff71d3490d3f}">
      <Declaration><![CDATA[// RequestLock locks as soon as the axis is at rest, without a brake delay, also when not calibrated.
METHOD PRIVATE Lock_Request_At_Rest
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Lock_Request_At_Rest');
fb.RequestLock();
fb(bAutomatic := TRUE, bCalibrated := FALSE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := TRUE, tBrakeDelay := T#1H);
AssertTrue(Condition := fb.bEnableOff, Message := 'off');
AssertFalse(Condition := fb.bLockPending, Message := 'request done');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Lock_Request_Waits_For_Rest" Id="{728b27b3-f11c-4c54-ae01-9fb26a88769c}">
      <Declaration><![CDATA[// RequestLock while the axis still moves: pending until it is at rest.
METHOD PRIVATE Lock_Request_Waits_For_Rest
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Lock_Request_Waits_For_Rest');
fb.RequestLock();
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertFalse(Condition := fb.bEnableOff, Message := 'not off while moving');
AssertTrue(Condition := fb.bLockPending, Message := 'pending');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := TRUE, tBrakeDelay := T#1H);
AssertTrue(Condition := fb.bEnableOff, Message := 'off at rest');
AssertFalse(Condition := fb.bLockPending, Message := 'request done');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Lock_Request_Dropped_By_Move" Id="{e4752243-2cde-411a-8f60-f13e92f275cd}">
      <Declaration><![CDATA[// A new move takes over a pending lock; the brake delay locks after it.
METHOD PRIVATE Lock_Request_Dropped_By_Move
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Lock_Request_Dropped_By_Move');
fb.RequestLock();
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := TRUE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertTrue(Condition := fb.bEnableOn, Message := 'on');
AssertFalse(Condition := fb.bLockPending, Message := 'dropped');
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := FALSE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertFalse(Condition := fb.bEnableOff, Message := 'no lock after the move started');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Lock_Request_In_Error" Id="{f579e802-fb64-4207-a643-ef2b622d2073}">
      <Declaration><![CDATA[// RequestLock in error: the drive is already off, the lock is released at once.
METHOD PRIVATE Lock_Request_In_Error
VAR
	fb	: HalfBROT.FB_FocusDriveEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Lock_Request_In_Error');
fb.RequestLock();
fb(bAutomatic := TRUE, bCalibrated := TRUE, bError := TRUE, bMoveWanted := FALSE, bHomeWanted := FALSE, bAtRest := FALSE, tBrakeDelay := T#1H);
AssertTrue(Condition := fb.bEnableOff, Message := 'off in error');
AssertFalse(Condition := fb.bLockPending, Message := 'request done');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
