<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_BrakeSettleEnable_Tests" Id="{3fdfb582-ef13-4b1a-b691-0355443a2e23}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for HalfBROT.FB_BrakeSettleEnable, the axis enable that waits for the brake (HalfBROT#130). Pure logic. The times are T#0S
// ("now") or T#1H ("never within a test"), so no test depends on the PLC cycle time.
FUNCTION_BLOCK FB_BrakeSettleEnable_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Waits_For_Settle();
Zero_Settle_Follows_Inputs();
Brake_Closed_No_Enable();
Not_Wanted_No_Enable();
Drops_In_The_Same_Cycle();
Ready_Waits_For_Ready_Delay();
]]></ST>
    </Implementation>
    <Method Name="Waits_For_Settle" Id="{80afe64d-9b91-4b23-aa6e-238aafc27668}">
      <Declaration><![CDATA[// Enable and brake open, tSettle not elapsed: the axis is not enabled yet, settling is reported.
METHOD PRIVATE Waits_For_Settle
VAR
	fb	: HalfBROT.FB_BrakeSettleEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Waits_For_Settle');
fb(bEnable := TRUE, bBrakeOpen := TRUE, tSettle := T#1H, tReadyDelay := T#1H);
AssertFalse(Condition := fb.bAxisEnable, Message := 'not enabled');
AssertTrue(Condition := fb.bSettling, Message := 'settling');
AssertFalse(Condition := fb.bReady, Message := 'not ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Zero_Settle_Follows_Inputs" Id="{c06086ac-d2fa-4fee-b966-415cdaa4664a}">
      <Declaration><![CDATA[// tSettle = T#0S is the old behaviour: the enable follows bEnable AND bBrakeOpen directly.
METHOD PRIVATE Zero_Settle_Follows_Inputs
VAR
	fb	: HalfBROT.FB_BrakeSettleEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Zero_Settle_Follows_Inputs');
fb(bEnable := TRUE, bBrakeOpen := TRUE, tSettle := T#0S, tReadyDelay := T#0S);
AssertTrue(Condition := fb.bAxisEnable, Message := 'enabled');
AssertFalse(Condition := fb.bSettling, Message := 'not settling');
AssertTrue(Condition := fb.bReady, Message := 'ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Brake_Closed_No_Enable" Id="{76175d7b-bff1-478c-924b-d913f05123b6}">
      <Declaration><![CDATA[// The brake is not reported open: no enable and no settling, whatever tSettle is.
METHOD PRIVATE Brake_Closed_No_Enable
VAR
	fb	: HalfBROT.FB_BrakeSettleEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Brake_Closed_No_Enable');
fb(bEnable := TRUE, bBrakeOpen := FALSE, tSettle := T#0S, tReadyDelay := T#0S);
AssertFalse(Condition := fb.bAxisEnable, Message := 'no enable');
AssertFalse(Condition := fb.bSettling, Message := 'not settling');
AssertFalse(Condition := fb.bReady, Message := 'not ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Not_Wanted_No_Enable" Id="{75f0015c-c906-4704-ab58-312b0695a243}">
      <Declaration><![CDATA[// bEnable off: nothing happens, also with the brake open.
METHOD PRIVATE Not_Wanted_No_Enable
VAR
	fb	: HalfBROT.FB_BrakeSettleEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Not_Wanted_No_Enable');
fb(bEnable := FALSE, bBrakeOpen := TRUE, tSettle := T#0S, tReadyDelay := T#0S);
AssertFalse(Condition := fb.bAxisEnable, Message := 'no enable');
AssertFalse(Condition := fb.bSettling, Message := 'not settling');
AssertFalse(Condition := fb.bReady, Message := 'not ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Drops_In_The_Same_Cycle" Id="{a86eeda5-ea19-4914-9443-ff5d6838c839}">
      <Declaration><![CDATA[// The enable drops in the same cycle as the brake report or bEnable, not one cycle later.
METHOD PRIVATE Drops_In_The_Same_Cycle
VAR
	fb	: HalfBROT.FB_BrakeSettleEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Drops_In_The_Same_Cycle');
fb(bEnable := TRUE, bBrakeOpen := TRUE, tSettle := T#0S, tReadyDelay := T#0S);
AssertTrue(Condition := fb.bAxisEnable, Message := 'enabled');
fb(bEnable := TRUE, bBrakeOpen := FALSE, tSettle := T#0S, tReadyDelay := T#0S);
AssertFalse(Condition := fb.bAxisEnable, Message := 'brake lost');
AssertFalse(Condition := fb.bReady, Message := 'brake lost, not ready');
fb(bEnable := TRUE, bBrakeOpen := TRUE, tSettle := T#0S, tReadyDelay := T#0S);
AssertTrue(Condition := fb.bAxisEnable, Message := 'enabled again');
fb(bEnable := FALSE, bBrakeOpen := TRUE, tSettle := T#0S, tReadyDelay := T#0S);
AssertFalse(Condition := fb.bAxisEnable, Message := 'enable removed');
AssertFalse(Condition := fb.bReady, Message := 'enable removed, not ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ready_Waits_For_Ready_Delay" Id="{985d604f-3591-4aa3-ae0c-0c3474a04ad8}">
      <Declaration><![CDATA[// bReady only after tReadyDelay of bAxisEnable (MONETcommon#121).
METHOD PRIVATE Ready_Waits_For_Ready_Delay
VAR
	fb	: HalfBROT.FB_BrakeSettleEnable;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Ready_Waits_For_Ready_Delay');
fb(bEnable := TRUE, bBrakeOpen := TRUE, tSettle := T#0S, tReadyDelay := T#1H);
AssertTrue(Condition := fb.bAxisEnable, Message := 'enabled');
AssertFalse(Condition := fb.bReady, Message := 'ready delay not elapsed');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
