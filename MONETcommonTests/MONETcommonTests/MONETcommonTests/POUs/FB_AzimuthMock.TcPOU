<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AzimuthMock" Id="{f2ffd774-8a4d-4067-a41a-a990b1c8eab7}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of FB_AzimuthControl for the telescope state machine tests (MONETcommon#36, BROTLib plan 2026-10-21-telescope-state-machine-unification D1).
FUNCTION_BLOCK FB_AzimuthMock EXTENDS HalfBROT.FB_AzimuthControl
VAR_INPUT
	nMockMoveScans	: UINT := 60;	// scans a move takes (the telescope sees Busy meanwhile)
	nMockStopScans	: UINT := 3;	// scans an MC_Stop takes until Done
	nMockHomeScans	: UINT := 3;	// scans a homing takes
	nMockDisableScans	: UINT := 1;	// scans MC_ExtSetPointGenDisable takes (BROTLib#101)
END_VAR
VAR_OUTPUT
	nStopEdges		: UINT;			// stop requests the telescope made (rising edges of StopAxis)
	nExtErrors		: UINT;			// stop or move requests that met the external setpoint generator (0x4257)
	nResetEdges		: UINT;			// resets the telescope sent to the axis (Reset())
END_VAR
VAR
	fbCore	: FB_AxisMockCore;
	pBool	: POINTER TO BOOL;
	pLreal	: POINTER TO LREAL;
	bInjected	: BOOL;
	nInjectedId	: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// No SUPER^(): the real body (MC_* blocks, AXIS_REF) does not run. The real property setters (MoveAxis -> fbAxis.MoveTo(),
// StopAxis -> fbAxis.Stop(), HomeAxis -> _StartHoming) stay, so the telescope sees the real command interface. The model
// is driven by the levels the telescope writes and writes what the telescope reads: the base outputs and, through pointers
// (FB_Axis outputs are not writable from outside), the nested fbAxis outputs.
fbCore(bEnable := bEnable, bHome := bHomeAxis, bMove := bMoveAxis, bStop := bStopAxis, fTarget := fPosition, fHomePosition := fCalibPosition,
	bTracking := bTracking, nMoveScans := nMockMoveScans, nStopScans := nMockStopScans, nHomeScans := nMockHomeScans,
	nDisableScans := nMockDisableScans);

pBool := ADR(fbAxis.Ready);			pBool^ := fbCore.bReady;
pBool := ADR(fbAxis.Calibrated);	pBool^ := fbCore.bCalibrated;
pBool := ADR(fbAxis.HomeDone);		pBool^ := fbCore.bCalibrated;
pBool := ADR(fbAxis.HomeActive);	pBool^ := fbCore.bHoming;
pBool := ADR(fbAxis.Homing);		pBool^ := fbCore.bHoming;
pBool := ADR(fbAxis.InMotion);		pBool^ := fbCore.bInMotion OR fbCore.bTrackActive OR fbCore.bCoast;
pBool := ADR(fbAxis.isTracking);	pBool^ := fbCore.bTrackActive;
pBool := ADR(fbAxis.StandStill);	pBool^ := fbCore.bStandStill AND NOT fbCore.bTrackActive AND NOT fbCore.bCoast;
pBool := ADR(fbAxis.MoveDone);		pBool^ := fbCore.bMoveDone;
pBool := ADR(fbAxis.Stopping);		pBool^ := fbCore.bStopping;
pBool := ADR(fbAxis.StopDone);		pBool^ := fbCore.bStopDone;
pBool := ADR(fbAxis.Busy);			pBool^ := fbCore.bInMotion OR fbCore.bHoming;
pLreal := ADR(fbAxis.ActualPosition);	pLreal^ := fbCore.fPosition;

bReady := fbCore.bReady AND fbCore.bStandStill;
bCalibrated := fbCore.bCalibrated;
fActualPosition := fbCore.fPosition;
nStopEdges := fbCore.nStopEdges;
nExtErrors := fbCore.nExtErrors;
IF fbCore.bExtError THEN
	bInjected := TRUE;
	nInjectedId := 16#4257;	// Motion commands are not allowed for external setpoint generated axis
END_IF

// the real control body clears the levels like this: the move on MoveDone, the stop on StopDone, the homing request
// once the axis is calibrated and the homing procedure is over
IF fbCore.bMoveDone THEN
	bMoveAxis := FALSE;
END_IF
IF fbCore.bStopDone THEN
	bStopAxis := FALSE;
END_IF
IF fbCore.bCalibrated AND NOT fbCore.bHoming THEN
	bHomeAxis := FALSE;
END_IF
IF bReset THEN
	nResetEdges := nResetEdges + 1;
	bReset := FALSE;	// ResetDone at once
	bInjected := FALSE;
END_IF
bError := bInjected;
nErrorID := nInjectedId;
]]></ST>
    </Implementation>
    <Method Name="InjectError" Id="{dc1b30d6-0f40-4255-b9fe-5a574cb322c0}">
      <Declaration><![CDATA[// the axis reports an error with this id until the telescope resets it (bError/nErrorID are what the telescope reads)
METHOD InjectError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bInjected := TRUE;
nInjectedId := nId;
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_AzimuthMock">
      <LineId Id="3" Count="49" />
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_AzimuthMock.InjectError">
      <LineId Id="3" Count="1" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>