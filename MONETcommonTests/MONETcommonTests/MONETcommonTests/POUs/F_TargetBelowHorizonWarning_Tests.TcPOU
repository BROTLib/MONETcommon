<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_TargetBelowHorizonWarning_Tests" Id="{8414dcaf-3e5f-4b6a-bcaf-783b9d825edd}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for MONETcommon.F_TargetBelowHorizonWarning, the 'Target below safe horizon' condition (#94).
FUNCTION_BLOCK F_TargetBelowHorizonWarning_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Idle_Stale_Target_Does_Not_Warn();
Goto_Below_Horizon_Warns();
Track_Below_Horizon_Warns();
Target_Above_Horizon_Does_Not_Warn();
Slew_Alone_Does_Not_Warn();
Horizon_Boundary();
]]></ST>
    </Implementation>
    <Method Name="Idle_Stale_Target_Does_Not_Warn" Id="{09c530e8-dede-453d-ad0f-bf3bf9d549c9}">
      <Declaration><![CDATA[// Parked or idle telescope, stale RA/Dec target below the horizon: the case of #94.
METHOD PRIVATE Idle_Stale_Target_Does_Not_Warn
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Idle_Stale_Target_Does_Not_Warn');
AssertFalse(Condition := MONETcommon.F_TargetBelowHorizonWarning(FALSE, FALSE, -20.0, 1.0), Message := 'idle, target -20');
AssertFalse(Condition := MONETcommon.F_TargetBelowHorizonWarning(FALSE, FALSE, 0.5, 1.0), Message := 'idle, target 0.5');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Goto_Below_Horizon_Warns" Id="{27748576-ec09-414c-9739-36b2dab0a63b}">
      <Declaration><![CDATA[METHOD PRIVATE Goto_Below_Horizon_Warns
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Goto_Below_Horizon_Warns');
AssertTrue(Condition := MONETcommon.F_TargetBelowHorizonWarning(TRUE, FALSE, -20.0, 1.0), Message := 'goto, target -20');
AssertTrue(Condition := MONETcommon.F_TargetBelowHorizonWarning(TRUE, FALSE, 0.5, 1.0), Message := 'goto, target 0.5');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Track_Below_Horizon_Warns" Id="{478c1dc0-2658-4602-bfa5-05d307e33247}">
      <Declaration><![CDATA[METHOD PRIVATE Track_Below_Horizon_Warns
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Track_Below_Horizon_Warns');
AssertTrue(Condition := MONETcommon.F_TargetBelowHorizonWarning(FALSE, TRUE, -20.0, 1.0), Message := 'track, target -20');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Target_Above_Horizon_Does_Not_Warn" Id="{3d6b1193-c152-40fe-850e-9d738bb63d7c}">
      <Declaration><![CDATA[METHOD PRIVATE Target_Above_Horizon_Does_Not_Warn
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Target_Above_Horizon_Does_Not_Warn');
AssertFalse(Condition := MONETcommon.F_TargetBelowHorizonWarning(TRUE, FALSE, 45.0, 1.0), Message := 'goto, target 45');
AssertFalse(Condition := MONETcommon.F_TargetBelowHorizonWarning(FALSE, TRUE, 45.0, 1.0), Message := 'track, target 45');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Alone_Does_Not_Warn" Id="{e75a985d-4085-4bcb-b3da-1e9734ef4536}">
      <Declaration><![CDATA[// A slew is alt/az: a stale RA/Dec target below the horizon is irrelevant (bGoto and bTrack are FALSE).
METHOD PRIVATE Slew_Alone_Does_Not_Warn
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Alone_Does_Not_Warn');
AssertFalse(Condition := MONETcommon.F_TargetBelowHorizonWarning(FALSE, FALSE, -20.0, 1.0), Message := 'slew with stale target');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Horizon_Boundary" Id="{b93e74c6-034b-4de2-aa18-5d51246f47d2}">
      <Declaration><![CDATA[// The comparison is strict: a target exactly at fHorizon does not warn.
METHOD PRIVATE Horizon_Boundary
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Horizon_Boundary');
AssertFalse(Condition := MONETcommon.F_TargetBelowHorizonWarning(TRUE, FALSE, 1.0, 1.0), Message := 'exactly at the horizon');
AssertTrue(Condition := MONETcommon.F_TargetBelowHorizonWarning(TRUE, FALSE, 0.99, 1.0), Message := 'just below the horizon');
AssertTrue(Condition := MONETcommon.F_TargetBelowHorizonWarning(TRUE, FALSE, 4.9, 5.0), Message := 'raised horizon 5');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
